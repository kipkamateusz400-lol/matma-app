<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dzienna dawka matmy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
<style>
/* VOICE: rzeczowy, spokojny, jak dobry zeszyt do powtórek
   IDEA: kartka z zeszytu w kratkę z zadaniami na dziś
   PICTURE: lista zadań na dziś na kratce, odpowiedzi chowane jak na odwrocie
   COLOUR and TYPE: biel papieru, niebieska kratka i atrament, czerwony margines jako akcent; Kalam + Source Sans 3
   LAYOUT: tytuł z postępem, sterowanie, działy, potem karty zadań w jednej kolumnie */
:root{color-scheme:light;--bg:#fbfcff;--grid:#e1e9f5;--ink:#16213a;--mut:#596783;--blue:#1f4fd6;--red:#d42c44;--card:#ffffff;--line:#cdd9ea;--soft:#eef3fc;--ok:#1b8048}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){color-scheme:dark;--bg:#111721;--grid:#1a2330;--ink:#e5ebf5;--mut:#97a5ba;--blue:#86a9ff;--red:#ff7184;--card:#171f2b;--line:#2a3546;--soft:#1d2736;--ok:#5ed492}}
:root[data-theme=dark]{color-scheme:dark;--bg:#111721;--grid:#1a2330;--ink:#e5ebf5;--mut:#97a5ba;--blue:#86a9ff;--red:#ff7184;--card:#171f2b;--line:#2a3546;--soft:#1d2736;--ok:#5ed492}
*{box-sizing:border-box;min-width:0}
body{margin:0;color:var(--ink);font:17px/1.55 "Source Sans 3",system-ui,sans-serif;overflow-x:clip;background-color:var(--bg);background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:24px 24px}
.wrap{max-width:820px;margin:0 auto;padding:clamp(20px,4vw,48px) max(4vw,14px) 64px;border-left:2px solid color-mix(in srgb,var(--red) 55%,transparent)}
header{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 24px;margin-bottom:18px}
h1{font:700 clamp(34px,6vw,48px)/1.05 Kalam,cursive;margin:0;color:var(--blue);text-wrap:balance}
.date{color:var(--mut);margin-top:4px;font-size:16px}
.prog{min-width:180px;flex:0 1 240px}
.prog b{font:700 26px/1 Kalam,cursive;color:var(--ink)}
.prog span{color:var(--mut);font-size:15px}
.bar{height:8px;border-radius:8px;background:var(--soft);margin-top:6px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--ok);border-radius:8px;transition:width .35s}
.panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin-bottom:14px}
.ctrl{display:flex;flex-wrap:wrap;gap:12px 22px;align-items:center}
.step{display:flex;align-items:center;gap:8px}
.step label{font-weight:600;font-size:15px}
.step output{min-width:2ch;text-align:center;font-weight:700;font-size:18px}
button{font:inherit;cursor:pointer;border-radius:10px;min-height:44px;padding:0 14px;border:1px solid var(--line);background:var(--card);color:var(--ink)}
button:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
.sq{width:44px;padding:0;font-size:20px;font-weight:700}
.main{background:var(--blue);color:var(--card);border-color:transparent;font-weight:700;margin-left:auto}
details summary{cursor:pointer;font-weight:700;min-height:32px;display:flex;align-items:center;gap:8px;list-style:none}
details summary::before{content:"▸";color:var(--red);transition:transform .2s}
details[open] summary::before{transform:rotate(90deg)}
.cnt{color:var(--mut);font-weight:400}
.topics{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));gap:4px 16px;margin-top:10px}
.topics label{display:flex;gap:10px;align-items:center;min-height:40px;font-size:16px;cursor:pointer}
.topics input{width:20px;height:20px;accent-color:var(--blue);flex:none}
.quick{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap}
.quick button{min-height:36px;font-size:14px}
.note{color:var(--mut);font-size:15px;margin:8px 0 0}
#list{display:grid;gap:14px;margin-top:6px}
.task{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px;transition:opacity .25s}
.task.is-done{opacity:.62}
.meta{display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;font-size:14px;color:var(--mut)}
.lvl{font-weight:700;padding:2px 9px;border-radius:20px;font-size:13px}
.lvl.b{background:color-mix(in srgb,var(--blue) 14%,transparent);color:var(--blue)}
.lvl.r{background:color-mix(in srgb,var(--red) 14%,transparent);color:var(--red)}
.task h3{font:700 22px/1.2 Kalam,cursive;margin:8px 0 2px}
.q{line-height:2.05}
.acts{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.chk[aria-pressed=true]{background:var(--ok);color:var(--card);border-color:transparent}
.ans{margin-top:12px;padding:10px 14px;border-radius:10px;background:var(--soft);line-height:2.05}
.ans b{color:var(--blue)}
.sol{margin:12px 0 0;padding:10px 14px 10px 36px;border-radius:10px;border:1px dashed var(--line);background:var(--card);line-height:2.05}
.sol li{margin:2px 0;padding-left:2px}.sol li::marker{color:var(--red);font-weight:700}
.soldet{margin-top:10px}.soldet summary{font-weight:600;color:var(--blue)}
.fr{display:inline-flex;flex-direction:column;vertical-align:middle;text-align:center;font-size:.86em;line-height:1.2;margin:0 .12em}
.fr>span{padding:0 .22em}.fr>span:first-child{border-bottom:1.5px solid currentColor}.fr.nw>span:first-child{border-bottom:0}.fr.nw{margin:0}.nwp{font-size:1.6em;font-weight:300;vertical-align:middle;line-height:1}
.ov{border-top:1.5px solid currentColor;padding-top:1px}
sub,sup{font-size:.72em}
.fg{margin:12px 0 4px}.fg svg{display:block;width:100%;max-width:340px;height:auto;overflow:visible}.fg .m{fill:none;stroke:var(--ink);stroke-width:1.7;stroke-linejoin:round}.fg .x{fill:none;stroke:var(--red);stroke-width:1.7;stroke-dasharray:6 4}.fg .h1{fill:color-mix(in srgb,var(--blue) 16%,transparent)}.fg .h2{fill:color-mix(in srgb,var(--red) 14%,transparent)}.fg .pt{fill:var(--ink)}.fg text{fill:var(--ink);font:italic 600 14px 'Source Sans 3',sans-serif;text-anchor:middle}.fg figcaption{font-size:13px;color:var(--mut);line-height:1.4;margin-top:4px}
.fg .gr{stroke:var(--grid);stroke-width:1}.fg .ax{stroke:var(--mut);stroke-width:1.4}.fg .tk{font:400 10px 'Source Sans 3',sans-serif;fill:var(--mut);text-anchor:middle}.fg .fn{fill:none;stroke:var(--blue);stroke-width:2.4;stroke-linejoin:round}.fg .fn0{fill:none;stroke:var(--mut);stroke-width:1.6;stroke-dasharray:4 3;opacity:.7}.fg .fn2{fill:none;stroke:var(--red);stroke-width:2.6;stroke-linejoin:round}.fg .cd{fill:var(--ink)}.fg .od{fill:var(--card);stroke:var(--ink);stroke-width:1.6}.fg .hd{stroke:var(--mut);stroke-width:1.3;stroke-dasharray:3 3}.fg .bar{fill:color-mix(in srgb,var(--blue) 70%,transparent)}
.mc{display:grid;gap:6px;margin:8px 0}.opt{text-align:left;min-height:44px;line-height:1.5;padding:6px 12px}.opt.good{background:color-mix(in srgb,var(--ok) 22%,var(--card));border-color:var(--ok)}.opt.bad{background:color-mix(in srgb,var(--red) 18%,var(--card));border-color:var(--red)}
.pf{display:grid;grid-template-columns:1fr 48px 48px;gap:6px;align-items:center;padding:6px 0;border-top:1px solid var(--line)}.pf .opt{text-align:center;padding:0}.note2{font-size:14px;color:var(--mut);margin-top:6px}
.tb{border-collapse:collapse;margin:8px 0;font-size:15px}.tb td,.tb th{border:1px solid var(--line);padding:4px 9px;text-align:center}.tb th{text-align:left;font-weight:600}
.tabs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}.tabs button{min-height:40px;font-weight:600}.tabs button[aria-current=true]{background:var(--ink);color:var(--bg);border-color:transparent}.tabs .th{margin-left:auto;font-weight:400;color:var(--mut)}
.einfo{margin:0 0 10px;color:var(--mut);font-size:15px}.einfo b{color:var(--ink)}.escore{margin:10px 0 0}.escore:empty{display:none}#examUI .main{margin-left:0}
.opt.sel{border-color:var(--blue);background:color-mix(in srgb,var(--blue) 15%,var(--card));font-weight:600}.pts{font:400 16px 'Source Sans 3',sans-serif;color:var(--mut)}
.score{display:flex;align-items:center;gap:8px;margin-top:10px;font-weight:600}select{font:inherit;min-height:40px;border-radius:8px;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:0 8px}button:disabled{opacity:.45;cursor:default}
@media(max-width:600px){.tabs .th{margin-left:0}}
.empty{background:var(--card);border:1px dashed var(--line);border-radius:14px;padding:16px 18px;color:var(--mut)}
footer{margin-top:22px;color:var(--mut);font-size:14px}
@media(max-width:600px){.wrap{border-left:0}.main{margin-left:0;width:100%}.task{padding:14px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1>Dzienna dawka matmy</h1>
      <div class="date" id="date"></div>
    </div>
    <div class="prog" aria-live="polite"><b id="pn">0 / 0</b> <span id="pl">zrobione</span><div class="bar"><i id="pb"></i></div></div>
  </header>
  <nav class="tabs" aria-label="Tryb"><button data-mode="d">Dzienna dawka</button><button data-mode="p">Arkusz: podstawa</button><button data-mode="r">Arkusz: rozszerzenie</button><button id="theme" class="th">Motyw: automatyczny</button></nav>
  <div id="examUI" class="panel" hidden>
    <p id="einfo" class="einfo"></p>
    <div class="ctrl"><button class="main" id="estart">Start (180 min)</button><button id="efinish">Zakończ i sprawdź</button><button id="enew">Nowy arkusz</button></div>
    <p id="escore" class="escore"></p>
  </div>
  <div id="dailyUI">

  <div class="panel ctrl">
    <div class="step"><label for="nb">Podstawa</label><button class="sq" data-s="b" data-d="-1" aria-label="Mniej zadań z podstawy">−</button><output id="nb">5</output><button class="sq" data-s="b" data-d="1" aria-label="Więcej zadań z podstawy">+</button></div>
    <div class="step"><label for="nr">Rozszerzenie</label><button class="sq" data-s="r" data-d="-1" aria-label="Mniej zadań z rozszerzenia">−</button><output id="nr">3</output><button class="sq" data-s="r" data-d="1" aria-label="Więcej zadań z rozszerzenia">+</button></div>
    <button class="main" id="roll">Wylosuj inny zestaw</button>
  </div>

  <details class="panel" id="det">
    <summary>Przerobione działy z rozszerzenia <span class="cnt" id="tc"></span></summary>
    <div class="topics" id="topics"></div>
    <div class="quick"><button id="all">Zaznacz wszystkie</button><button id="none">Odznacz wszystkie</button></div>
    <p class="note">Zadania z rozszerzenia są losowane tylko z zaznaczonych działów. Zadania z podstawy są losowane ze wszystkich działów.</p>
  </details>
  </div>

  <div id="list"></div>
  <footer>Zestaw zmienia się codziennie o północy. Zadania i odpowiedzi są generowane automatycznie, a w dowodach zamiast odpowiedzi jest wskazówka. Zaznaczone działy i postęp zapisują się w tej przeglądarce.</footer>
</div>

<script>
{
/* ---------- losowanie ---------- */
const hashStr=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
const mulberry=a=>()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296};
let rnd=Math.random;
const ri=(a,b)=>a+Math.floor(rnd()*(b-a+1));
const riNZ=(a,b)=>{let x;do x=ri(a,b);while(x===0);return x};
const pick=a=>a[Math.floor(rnd()*a.length)];
const shuffle=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(rnd()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const sg=()=>rnd()<.5?1:-1;

/* ---------- liczby i zapis ---------- */
const gcd=(a,b)=>{a=Math.abs(a);b=Math.abs(b);while(b)[a,b]=[b,a%b];return a};
const F=(n,d=1)=>{if(d<0){n=-n;d=-d}const g=gcd(n,d)||1;return{n:n/g,d:d/g}};
const toF=x=>typeof x==='number'?F(x):x;
const M='−';
const N=n=>n<0?M+(-n):''+n;
const fr=(t,b)=>`<span class="fr"><span>${t}</span><span>${b}</span></span>`;
const fH=f=>{f=toF(f);return f.d===1?N(f.n):(f.n<0?M:'')+fr(Math.abs(f.n),f.d)};
const SUP={2:'²',3:'³',4:'⁴',5:'⁵'};
function poly(cs,v='x'){const deg=cs.length-1;let out='';
  cs.forEach((c,i)=>{c=toF(c);if(c.n===0)return;const p=deg-i,neg=c.n<0,a=F(Math.abs(c.n),c.d);
    let body=(p>0&&a.n===1&&a.d===1)?'':fH(a);if(p>0)body+=v+(p>1?SUP[p]:'');
    out+=out===''?(neg?M:'')+body:(neg?' − ':' + ')+body});
  return out||'0'}
const sh=(r,v='x')=>{r=toF(r);return poly([1,F(-r.n,r.d)],v)};
const tail=cs=>{const s=poly(cs);if(s==='0')return'';return s.startsWith(M)?' − '+s.slice(1):' + '+s};
const term=(c,v)=>c===0?'':(c<0?' − ':' + ')+(Math.abs(c)===1&&v?'':Math.abs(c))+v;
const lead=(c,v)=>(c===1?'':c===-1?M:N(c))+v;
function simp(n){let k=1,m=n;for(let i=2;i*i<=m;i++)while(m%(i*i)===0){m/=i*i;k*=i}return{k,m}}
const sq=n=>{const{k,m}=simp(n);return m===1?''+k:(k===1?'':k)+'√'+m};
const fsq=(f,m)=>{f=toF(f);if(m===1)return fH(f);const an=Math.abs(f.n),top=(an===1?'':an)+'√'+m;return(f.n<0?M:'')+(f.d===1?top:fr(top,f.d))};
const C=(n,k)=>{let r=1;for(let i=1;i<=k;i++)r=r*(n-k+i)/i;return Math.round(r)};
const expand=(roots,l=1)=>{let c=[l];for(const r of roots){const nc=Array(c.length+1).fill(0);c.forEach((v,i)=>{nc[i]+=v;nc[i+1]-=r*v});c=nc}return c};
const ev=(cs,x)=>cs.reduce((s,c)=>s*x+c,0);
const REL={'<':'<','<=':'≤','>':'>','>=':'≥'};
const RELS=Object.keys(REL);
const dec=v=>(Math.round(v*100)/100).toString().replace('.',',');
function signSolve(pts,ld,rel){
  pts=pts.map(p=>({v:toF(p.v),den:!!p.den})).sort((a,b)=>a.v.n/a.v.d-b.v.n/b.v.d);
  const n=pts.length,strict=rel.length===1,pos=rel[0]==='>',parts=[];
  for(let i=0;i<=n;i++){const s=ld*((n-i)%2===0?1:-1);if((s>0)!==pos)continue;
    const L=i===0?null:pts[i-1],R=i===n?null:pts[i];
    parts.push((L&&!strict&&!L.den?'⟨':'(')+(L?fH(L.v):M+'∞')+', '+(R?fH(R.v):'+∞')+(R&&!strict&&!R.den?'⟩':')'))}
  return 'x ∈ '+parts.join(' ∪ ')}
const distinct=(k,a,b)=>{let r;do{r=Array.from({length:k},()=>ri(a,b))}while(new Set(r).size<k);return r};
const hint=t=>'<b>Wskazówka:</b> '+t;
/* ---------- rozwiązania krok po kroku (bez wywołań rnd, żeby nie zmieniać losowania) ---------- */
const pN=n=>n<0?`(${N(n)})`:N(n);
/* trójki pitagorejskie pierwotne (wzór Euklidesa), żeby zadania z trójkątami miały więcej wariantów */
const TRIPLES=(()=>{const o=[];for(let m=2;m<10;m++)for(let n=1;n<m;n++)if((m-n)%2&&gcd(m,n)===1){const a=m*m-n*n,b=2*m*n,c=m*m+n*n;if(c<=85)o.push([Math.min(a,b),Math.max(a,b),c])}return o.sort((x,y)=>x[2]-y[2])})();
const pickTriple=(maxC=85)=>pick(TRIPLES.filter(t=>t[2]<=maxC)).slice();
const pF=f=>{f=toF(f);return f.n<0?`(${fH(f)})`:fH(f)};
function deltaSteps(a,b,c){const D=b*b-4*a*c,out=[`Δ = b² − 4ac = ${pN(b)}² − 4 · ${pN(a)} · ${pN(c)} = ${N(D)}`];
  if(D<0)out.push('Δ < 0, więc trójmian nie ma miejsc zerowych.');
  else if(D===0)out.push(`Δ = 0, więc jest jeden pierwiastek podwójny x<sub>0</sub> = ${fr('−b','2a')} = ${fH(F(-b,2*a))}`);
  else{const s=Math.round(Math.sqrt(D));if(s*s===D){const r=[F(-b-s,2*a),F(-b+s,2*a)].sort((u,v)=>u.n/u.d-v.n/v.d);out.push(`√Δ = ${s}, x<sub>1</sub> = ${fr('−b − √Δ','2a')} = ${fH(r[0])}, x<sub>2</sub> = ${fr('−b + √Δ','2a')} = ${fH(r[1])}`)}
    else out.push(`√Δ = ${sq(D)}, x<sub>1,2</sub> = ${fr(`${N(-b)} ± ${sq(D)}`,N(2*a))}`)}
  return out}
const parabSign=(ld,rel)=>`Parabola ma ramiona skierowane ${ld>0?'w górę':'w dół'}, więc wartości ${rel[0]==='>'?'dodatnie':'ujemne'} są ${(ld>0)===(rel[0]==='>')?'na zewnątrz przedziału między pierwiastkami':'między pierwiastkami'}. Nierówność jest ${rel.length>1?'nieostra, więc pierwiastki należą do rozwiązania':'ostra, więc pierwiastki nie należą do rozwiązania'}.`;
const snake=(ld,rel)=>`Szkicujemy wykres znaków („wężyk”): zaczynamy z prawej strony ${ld>0?'nad':'pod'} osią i w każdym pierwiastku jednokrotnym przechodzimy na drugą stronę osi. Odczytujemy przedziały, gdzie wyrażenie jest ${rel[0]==='>'?'dodatnie':'ujemne'}${rel.length>1?' lub równe zero':''}.`;

/* ---------- PODSTAWA ---------- */
function gLog(){const b=pick([2,3,5,6,10]);let k,n,ds;do{k=ri(1,3);if(b===6&&k===3)k=2;n=b**k;ds=[];for(let m=2;m<n;m++)if(n%m===0)ds.push(m)}while(!ds.length);const m=pick(ds);
  return{q:`Oblicz: log<sub>${b}</sub>${m} + log<sub>${b}</sub>${n/m}`,a:`${k}, bo ${m} · ${n/m} = ${n} = ${b}<sup>${k}</sup>`,
  s:[`Korzystamy ze wzoru log<sub>a</sub>x + log<sub>a</sub>y = log<sub>a</sub>(x · y).`,`log<sub>${b}</sub>${m} + log<sub>${b}</sub>${n/m} = log<sub>${b}</sub>(${m} · ${n/m}) = log<sub>${b}</sub>${n}`,`${n} = ${b}<sup>${k}</sup>, więc log<sub>${b}</sub>${n} = ${k}.`]}}
function gPow(){const a=ri(1,4),b=ri(1,3),c=ri(1,6);
  return{q:`Zapisz w postaci potęgi liczby 2: ${fr(`4<sup>${a}</sup> · 8<sup>${b}</sup>`,`2<sup>${c}</sup>`)}`,a:`2<sup>${N(2*a+3*b-c)}</sup>, bo 4 = 2², 8 = 2³`,
  s:[`Zamieniamy podstawy na 2: 4<sup>${a}</sup> = (2²)<sup>${a}</sup> = 2<sup>${2*a}</sup>, 8<sup>${b}</sup> = (2³)<sup>${b}</sup> = 2<sup>${3*b}</sup>.`,`Mnożenie potęg o tej samej podstawie: dodajemy wykładniki, 2<sup>${2*a}</sup> · 2<sup>${3*b}</sup> = 2<sup>${2*a+3*b}</sup>.`,`Dzielenie: odejmujemy wykładniki, 2<sup>${2*a+3*b} − ${c}</sup> = 2<sup>${N(2*a+3*b-c)}</sup>.`]}}
function gProc(){const p=pick([10,20,25,30,40,50]),q=pick([10,20,25,30,40,50]);const v=((100+p)*(100-q)-10000)/100;
  return{q:`Cenę towaru najpierw podwyższono o ${p}%, a następnie obniżono o ${q}%. O ile procent zmieniła się cena początkowa?`,
  a:(v===0?'Cena się nie zmieniła.':`Cena ${v>0?'wzrosła':'spadła'} o ${dec(Math.abs(v))}%.`)+` Mnożnik: ${dec(1+p/100)} · ${dec(1-q/100)} = ${dec(1+v/100)}`,
  s:[`Oznaczamy cenę początkową przez c. Podwyżka o ${p}% to mnożenie przez ${dec(1+p/100)}, a obniżka o ${q}% to mnożenie przez ${dec(1-q/100)}.`,`Cena końcowa: c · ${dec(1+p/100)} · ${dec(1-q/100)} = ${dec(1+v/100)}c.`,v===0?'Mnożnik jest równy 1, więc cena się nie zmieniła.':`${dec(1+v/100)}c − c = ${v>0?'':M}${dec(Math.abs(v)/100)}c, czyli cena ${v>0?'wzrosła':'spadła'} o ${dec(Math.abs(v))}%.`,`Uwaga: zmiany procentowe nie sumują się (to nie jest ${p}% − ${q}% = ${N(p-q)}%), bo druga zmiana liczy się od nowej ceny.`]}}
function gAbsB(){const a=riNZ(-6,6),b=ri(1,7),rel=pick(RELS);
  return{q:`Rozwiąż nierówność |${sh(a)}| ${REL[rel]} ${b}`,a:signSolve([{v:a-b},{v:a+b}],1,rel),
  s:[`|${sh(a)}| to odległość liczby x od liczby ${N(a)} na osi liczbowej.`,`Liczby oddalone od ${N(a)} dokładnie o ${b}: ${N(a)} − ${b} = ${N(a-b)} oraz ${N(a)} + ${b} = ${N(a+b)}.`,rel[0]==='<'?`Szukamy liczb ${rel==='<'?'bliższych':'nie dalszych'} niż ${b} od ${N(a)}, czyli leżących między tymi punktami: ${N(a-b)} ${REL[rel]} x ${REL[rel]} ${N(a+b)}.`:`Szukamy liczb ${rel==='>'?'dalszych':'nie bliższych'} niż ${b} od ${N(a)}, czyli leżących na zewnątrz: x ${rel==='>'?'<':'≤'} ${N(a-b)} lub x ${REL[rel]} ${N(a+b)}.`,`Odpowiedź: ${signSolve([{v:a-b},{v:a+b}],1,rel)}`]}}
function gQuadIneq(){const[r1,r2]=distinct(2,-6,6),k=pick([1,-1,2,-2,3,-3]),rel=pick(RELS),cs=expand([r1,r2],k);
  return{q:`Rozwiąż nierówność ${poly(cs)} ${REL[rel]} 0`,a:signSolve([{v:r1},{v:r2}],Math.sign(k),rel)+`<br>Pierwiastki: ${N(Math.min(r1,r2))} i ${N(Math.max(r1,r2))}`,
  s:[`Wyznaczamy miejsca zerowe trójmianu (a = ${N(cs[0])}, b = ${N(cs[1])}, c = ${N(cs[2])}).`,...deltaSteps(...cs),parabSign(k,rel),`Odpowiedź: ${signSolve([{v:r1},{v:r2}],Math.sign(k),rel)}`]}}
function gSystem(){const x=ri(-5,5),y=ri(-5,5);let a1,b1,a2,b2;do{a1=riNZ(-4,4);b1=riNZ(-4,4);a2=riNZ(-4,4);b2=riNZ(-4,4)}while(a1*b2-a2*b1===0);
  const c1=a1*x+b1*y,c2=a2*x+b2*y,dy=b1*a2-b2*a1;
  return{q:`Rozwiąż układ równań:<br>${lead(a1,'x')}${term(b1,'y')} = ${N(c1)}<br>${lead(a2,'x')}${term(b2,'y')} = ${N(c2)}`,a:`x = ${N(x)}, y = ${N(y)}`,
  s:[`Metoda przeciwnych współczynników: mnożymy pierwsze równanie przez ${pN(a2)}, a drugie przez ${pN(a1)}, żeby współczynniki przy x były równe.`,`${lead(a1*a2,'x')}${term(b1*a2,'y')} = ${N(c1*a2)}<br>${lead(a1*a2,'x')}${term(b2*a1,'y')} = ${N(c2*a1)}`,`Odejmujemy równania stronami: ${lead(dy,'y')} = ${N(c1*a2-c2*a1)}, więc y = ${N(y)}.`,`Podstawiamy y do pierwszego równania: ${lead(a1,'x')}${term(b1*y,'')} = ${N(c1)}, czyli ${lead(a1,'x')} = ${N(c1-b1*y)}, więc x = ${N(x)}.`,`Sprawdzenie w drugim równaniu: ${pN(a2)} · ${pN(x)} + ${pN(b2)} · ${pN(y)} = ${N(c2)} ✓`]}}
function gRatEq(){const x0=ri(-5,6);let b;do b=ri(-5,5);while(b===x0);const c=pick([2,3,4,-1,-2]),a=c*(x0-b)-x0;
  return{q:`Rozwiąż równanie ${fr(sh(-a),sh(b))} = ${N(c)}`,a:`x = ${N(x0)} (dziedzina: x ≠ ${N(b)})`,
  s:[`Dziedzina: mianownik nie może być zerem, więc x ≠ ${N(b)}.`,`Mnożymy obie strony przez (${sh(b)}): ${sh(-a)} = ${N(c)}(${sh(b)}), czyli ${sh(-a)} = ${poly([c,-c*b])}.`,`Przenosimy wyrazy z x na lewą stronę: ${lead(1-c,'x')} = ${N(-c*b-a)}, więc x = ${N(x0)}.`,`${N(x0)} ≠ ${N(b)}, więc rozwiązanie należy do dziedziny.`]}}
function gLine2(){const a=riNZ(-4,4),b=ri(-6,6),[x1,x2]=distinct(2,-5,5),y1=a*x1+b,y2=a*x2+b;
  return{q:`Wyznacz równanie prostej przechodzącej przez punkty A = (${N(x1)}, ${N(y1)}) i B = (${N(x2)}, ${N(y2)}).`,a:`y = ${poly([a,b])}`,
  s:[`Prosta ma równanie y = ax + b. Współczynnik kierunkowy: a = ${fr('y<sub>B</sub> − y<sub>A</sub>','x<sub>B</sub> − x<sub>A</sub>')} = ${fr(`${N(y2)} − ${pN(y1)}`,`${N(x2)} − ${pN(x1)}`)} = ${fr(N(y2-y1),N(x2-x1))} = ${N(a)}.`,`Podstawiamy punkt A: ${N(y1)} = ${N(a)} · ${pN(x1)} + b, więc b = ${N(y1)} − ${pN(a*x1)} = ${N(b)}.`,`Odpowiedź: y = ${poly([a,b])}`]}}
function gPerp(){const[n,d]=pick([[1,1],[-1,1],[2,1],[-2,1],[1,2],[-1,2],[3,1],[1,3],[-1,3]]),b0=ri(-5,5),x0=Math.abs(n)*ri(-3,3),y0=ri(-5,5),b=y0+d*x0/n;
  return{q:`Wyznacz równanie prostej prostopadłej do prostej y = ${poly([F(n,d),b0])} i przechodzącej przez punkt P = (${N(x0)}, ${N(y0)}).`,a:`y = ${poly([F(-d,n),b])}`,
  s:[`Proste y = a<sub>1</sub>x + b<sub>1</sub> i y = a<sub>2</sub>x + b<sub>2</sub> są prostopadłe, gdy a<sub>1</sub> · a<sub>2</sub> = −1.`,`a<sub>1</sub> = ${fH(F(n,d))}, więc a<sub>2</sub> = ${fr(-1,'a<sub>1</sub>')} = ${fH(F(-d,n))}.`,`Szukana prosta: y = ${fH(F(-d,n))}x + b. Podstawiamy P: ${N(y0)} = ${fH(F(-d,n))} · ${pN(x0)} + b, więc b = ${N(b)}.`,`Odpowiedź: y = ${poly([F(-d,n),b])}`]}}
function quadF(){const a=pick([1,-1,2,-2]),p=ri(-5,5),q=ri(-8,8);return{a,p,q,cs:[a,-2*a*p,a*p*p+q]}}
function gVertex(){const{a,p,q,cs}=quadF();
  return{q:`Wyznacz współrzędne wierzchołka paraboli będącej wykresem funkcji f(x) = ${poly(cs)} oraz zbiór wartości tej funkcji.`,a:`W = (${N(p)}, ${N(q)}), ZW = ${a>0?`⟨${N(q)}, +∞)`:`(${M}∞, ${N(q)}⟩`}`,
  s:[`a = ${N(cs[0])}, b = ${N(cs[1])}, c = ${N(cs[2])}. Pierwsza współrzędna wierzchołka: p = ${fr('−b','2a')} = ${fr(N(-cs[1]),N(2*a))} = ${N(p)}.`,`Druga współrzędna: q = f(${N(p)}) = ${N(q)} (albo q = ${fr('−Δ','4a')}).`,`Ramiona paraboli są skierowane ${a>0?'w górę (a > 0), więc q to najmniejsza wartość':'w dół (a < 0), więc q to największa wartość'}: ZW = ${a>0?`⟨${N(q)}, +∞)`:`(${M}∞, ${N(q)}⟩`}.`]}}
function gQuadInt(){const{a,p,cs}=quadF(),m=ri(-6,3),n=m+ri(2,6);const xs=[m,n];if(p>m&&p<n)xs.push(p);const vs=xs.map(x=>ev(cs,x));
  return{q:`Wyznacz najmniejszą i największą wartość funkcji f(x) = ${poly(cs)} w przedziale ⟨${N(m)}, ${N(n)}⟩.`,a:`f<sub>min</sub> = ${N(Math.min(...vs))}, f<sub>max</sub> = ${N(Math.max(...vs))}`+(xs.length>2?` (wierzchołek x = ${N(p)} leży w przedziale)`:` (wierzchołek x = ${N(p)} leży poza przedziałem)`),
  s:[`Pierwsza współrzędna wierzchołka: p = ${fr('−b','2a')} = ${N(p)}.`,xs.length>2?`${N(p)} ∈ ⟨${N(m)}, ${N(n)}⟩, więc wartość w wierzchołku też bierzemy pod uwagę.`:`${N(p)} ∉ ⟨${N(m)}, ${N(n)}⟩, więc funkcja jest w tym przedziale monotoniczna i ekstrema są na końcach.`,`Liczymy wartości: ${xs.map((x,i)=>`f(${N(x)}) = ${N(vs[i])}`).join(', ')}.`,`Najmniejsza z nich to ${N(Math.min(...vs))}, największa to ${N(Math.max(...vs))}.`]}}
function gArith(){const a1=ri(-10,10),r=riNZ(-5,5),i=ri(2,4),j=ri(i+2,9),ai=a1+(i-1)*r,aj=a1+(j-1)*r;
  return{q:`Ciąg arytmetyczny (a<sub>n</sub>) spełnia warunki: a<sub>${i}</sub> = ${N(ai)} oraz a<sub>${j}</sub> = ${N(aj)}. Oblicz pierwszy wyraz, różnicę ciągu oraz sumę dziesięciu początkowych wyrazów.`,a:`a<sub>1</sub> = ${N(a1)}, r = ${N(r)}, S<sub>10</sub> = ${N(5*(2*a1+9*r))}`,
  s:[`Między a<sub>${i}</sub> a a<sub>${j}</sub> jest ${j-i} „kroków” o r: a<sub>${j}</sub> = a<sub>${i}</sub> + ${j-i}r.`,`${N(aj)} = ${N(ai)} + ${j-i}r, więc ${j-i}r = ${N(aj-ai)} i r = ${N(r)}.`,`a<sub>1</sub> = a<sub>${i}</sub> − ${i-1}r = ${N(ai)} − ${pN((i-1)*r)} = ${N(a1)}.`,`S<sub>10</sub> = ${fr('2a<sub>1</sub> + 9r',2)} · 10 = ${fr(`${pN(2*a1)} + ${pN(9*r)}`,2)} · 10 = ${N(5*(2*a1+9*r))}.`]}}
function gGeom(){const a1=riNZ(-5,5),k=pick([2,-2,3,-3]);
  return{q:`Ciąg geometryczny (a<sub>n</sub>) spełnia warunki: a<sub>2</sub> = ${N(a1*k)} oraz a<sub>5</sub> = ${N(a1*k**4)}. Wyznacz iloraz, pierwszy wyraz oraz sumę pięciu początkowych wyrazów.`,a:`q = ${N(k)}, a<sub>1</sub> = ${N(a1)}, S<sub>5</sub> = ${N(a1*(k**5-1)/(k-1))}`,
  s:[`a<sub>5</sub> = a<sub>2</sub> · q³, więc q³ = ${fr(N(a1*k**4),N(a1*k))} = ${N(k**3)} i q = ${N(k)}.`,`a<sub>1</sub> = ${fr('a<sub>2</sub>','q')} = ${fr(N(a1*k),N(k))} = ${N(a1)}.`,`S<sub>5</sub> = a<sub>1</sub> · ${fr('1 − q<sup>5</sup>','1 − q')} = ${N(a1)} · ${fr(`1 − ${pN(k**5)}`,`1 − ${pN(k)}`)} = ${N(a1*(k**5-1)/(k-1))}.`]}}
function gTrigB(){let[a,b,c]=pickTriple();if(rnd()<.5)[a,b]=[b,a];const s=rnd()<.5,g=s?'sin':'cos',o=s?'cos':'sin';
  return{q:`Kąt α jest ostry i ${g} α = ${fH(F(a,c))}. Oblicz ${o} α oraz tg α.`,a:s?`cos α = ${fH(F(b,c))}, tg α = ${fH(F(a,b))}`:`sin α = ${fH(F(b,c))}, tg α = ${fH(F(b,a))}`,
  s:[`Z jedynki trygonometrycznej: ${o}²α = 1 − ${g}²α = 1 − ${fr(a*a,c*c)} = ${fr(b*b,c*c)}.`,`Kąt jest ostry, więc ${o} α > 0: ${o} α = ${fH(F(b,c))}.`,`tg α = ${fr('sin α','cos α')} = ${s?fH(F(a,b)):fH(F(b,a))}.`,`Można też narysować trójkąt prostokątny o bokach ${a}, ${b}, ${c} (${a}² + ${b}² = ${c}²).`]}}
function gTales(){const a=ri(2,6),s=ri(2,4),b=a*s,c=ri(2,9);
  return{q:`Ramiona kąta o wierzchołku O przecięto dwiema prostymi równoległymi. Pierwsza prosta przecina ramiona w punktach A i C, druga w punktach B i D (punkty A, B leżą na jednym ramieniu, a C, D na drugim). Wiadomo, że |OA| = ${a}, |AB| = ${b}, |OC| = ${c}. Oblicz |CD| oraz |OD|.`,a:`|CD| = ${s*c}, |OD| = ${c+s*c} (z twierdzenia Talesa: ${fr('|OA|','|AB|')} = ${fr('|OC|','|CD|')})`,
  s:[`Z twierdzenia Talesa odcinki na jednym ramieniu są proporcjonalne do odpowiednich odcinków na drugim: ${fr('|OA|','|AB|')} = ${fr('|OC|','|CD|')}.`,`${fr(a,b)} = ${fr(c,'|CD|')}, więc |CD| = ${fr(`${c} · ${b}`,a)} = ${s*c}.`,`|OD| = |OC| + |CD| = ${c} + ${s*c} = ${c+s*c}.`]}}
function gEquil(){const m=ri(0,2);
  if(m===0){const a=ri(2,24);
    return{q:`Trójkąt równoboczny ma bok długości ${a}. Oblicz jego wysokość, pole oraz promienie okręgów wpisanego i opisanego.`,a:`h = ${fsq(F(a,2),3)}, P = ${fsq(F(a*a,4),3)}, r = ${fsq(F(a,6),3)}, R = ${fsq(F(a,3),3)}`,
    s:[`h = ${fr('a√3',2)} = ${fr(`${a}√3`,2)} = ${fsq(F(a,2),3)}.`,`P = ${fr('a²√3',4)} = ${fr(`${a*a}√3`,4)} = ${fsq(F(a*a,4),3)}.`,`Środek okręgu wpisanego i opisanego dzieli wysokość w stosunku 2 : 1, więc r = ${fr('h',3)} = ${fsq(F(a,6),3)}, R = ${fr('2h',3)} = ${fsq(F(a,3),3)}.`]}}
  if(m===1){const k=ri(1,12),a=2*k;
    return{q:`Wysokość trójkąta równobocznego ma długość ${fsq(k,3)}. Oblicz długość boku, pole trójkąta oraz promień okręgu opisanego na nim.`,a:`a = ${a}, P = ${fsq(k*k,3)}, R = ${fsq(F(a,3),3)}`,
    s:[`h = ${fr('a√3',2)}, więc a = ${fr('2h','√3')} = ${fr(`2 · ${fsq(k,3)}`,'√3')} = ${a}.`,`P = ${fr('a²√3',4)} = ${fr(`${a*a}√3`,4)} = ${fsq(k*k,3)} (albo P = ½ · a · h).`,`R = ${fr('2h',3)} = ${fsq(F(a,3),3)}.`]}}
  const a=ri(2,16);
  return{q:`Pole trójkąta równobocznego jest równe ${fsq(F(a*a,4),3)}. Oblicz długość boku i promień okręgu wpisanego w ten trójkąt.`,a:`a = ${a}, r = ${fsq(F(a,6),3)}`,
  s:[`P = ${fr('a²√3',4)}, więc ${fr('a²√3',4)} = ${fsq(F(a*a,4),3)}.`,`Dzielimy obie strony przez ${fr('√3',4)}: a² = ${a*a}, a = ${a}.`,`r = ${fr('h',3)} = ${fr('a√3',6)} = ${fsq(F(a,6),3)}.`]}}
function gInscribed(){const al=ri(20,85),m=ri(0,2);
  if(m===0)return{q:`Kąt środkowy AOB ma miarę ${2*al}°. Punkt C leży na dłuższym łuku AB. Oblicz miarę kąta wpisanego ACB.`,a:`${al}° (kąt wpisany to połowa kąta środkowego opartego na tym samym łuku)`};
  if(m===1)return{q:`Kąt środkowy AOB ma miarę ${2*al}°. Punkt C leży na krótszym łuku AB. Oblicz miarę kąta wpisanego ACB.`,a:`${180-al}° (C leży na krótszym łuku, więc kąt jest oparty na dłuższym łuku: (360° − ${2*al}°) : 2)`};
  return{q:`Kąt wpisany ACB ma miarę ${al}°. Oblicz miarę kąta środkowego AOB opartego na tym samym łuku.`,a:`${2*al}°`}}
function gSeg(){const x1=ri(-6,6),y1=ri(-6,6),t=pick([[3,4,5],[4,3,5],[6,8,10],[8,6,10],[5,12,13],[12,5,13]]),dx=t[0]*sg(),dy=t[1]*sg();
  return{q:`Dane są punkty A = (${N(x1)}, ${N(y1)}) i B = (${N(x1+dx)}, ${N(y1+dy)}). Oblicz długość odcinka AB i wyznacz współrzędne jego środka.`,a:`|AB| = ${t[2]}, S = (${fH(F(2*x1+dx,2))}, ${fH(F(2*y1+dy,2))})`,
  s:[`|AB| = √((x<sub>B</sub> − x<sub>A</sub>)² + (y<sub>B</sub> − y<sub>A</sub>)²) = √(${pN(dx)}² + ${pN(dy)}²) = √${dx*dx+dy*dy} = ${t[2]}.`,`Środek: S = (${fr('x<sub>A</sub> + x<sub>B</sub>',2)}, ${fr('y<sub>A</sub> + y<sub>B</sub>',2)}) = (${fr(N(2*x1+dx),2)}, ${fr(N(2*y1+dy),2)}) = (${fH(F(2*x1+dx,2))}, ${fH(F(2*y1+dy,2))}).`]}}
function gCube(){const a=ri(2,15),m=ri(0,3);
  if(m===1)return{q:`Przekątna sześcianu ma długość ${fsq(a,3)}. Oblicz pole powierzchni całkowitej i objętość tego sześcianu.`,a:`a = ${a}, P<sub>c</sub> = ${6*a*a}, V = ${a**3}`,
    s:[`Przekątna sześcianu o krawędzi a ma długość a√3.`,`a√3 = ${fsq(a,3)}, więc a = ${a}.`,`P<sub>c</sub> = 6a² = ${6*a*a}, V = a³ = ${a**3}.`]};
  if(m===2)return{q:`Pole powierzchni całkowitej sześcianu jest równe ${6*a*a}. Oblicz objętość sześcianu i długość jego przekątnej.`,a:`a = ${a}, V = ${a**3}, d = ${fsq(a,3)}`,
    s:[`P<sub>c</sub> = 6a², więc 6a² = ${6*a*a}, a² = ${a*a}, a = ${a}.`,`V = a³ = ${a**3}.`,`d = a√3 = ${fsq(a,3)}.`]};
  if(m===3)return{q:`Przekątna ściany sześcianu ma długość ${fsq(a,2)}. Oblicz objętość sześcianu oraz długość jego przekątnej.`,a:`a = ${a}, V = ${a**3}, d = ${fsq(a,3)}`,
    s:[`Ściana to kwadrat, jego przekątna ma długość a√2.`,`a√2 = ${fsq(a,2)}, więc a = ${a}.`,`V = ${a**3}, d = a√3 = ${fsq(a,3)}.`]};
  return{q:`Sześcian ma krawędź długości ${a}. Oblicz długość przekątnej sześcianu, długość przekątnej ściany, pole powierzchni całkowitej i objętość.`,a:`d = ${fsq(a,3)}, przekątna ściany = ${fsq(a,2)}, P<sub>c</sub> = ${6*a*a}, V = ${a**3}`,
  s:[`Przekątna ściany (kwadratu): z twierdzenia Pitagorasa √(${a}² + ${a}²) = ${fsq(a,2)}.`,`Przekątna sześcianu: trójkąt prostokątny z krawędzią i przekątną ściany, d = √(${a}² + (${fsq(a,2)})²) = √${3*a*a} = ${fsq(a,3)}.`,`P<sub>c</sub> = 6a² = 6 · ${a*a} = ${6*a*a}, V = a³ = ${a**3}.`]}}
function gPrism(){const a=ri(2,8),h=ri(2,10);
  return{q:`Graniastosłup prawidłowy czworokątny ma krawędź podstawy ${a} i wysokość ${h}. Oblicz długość przekątnej graniastosłupa, pole powierzchni całkowitej i objętość.`,a:`d = ${sq(2*a*a+h*h)}, P<sub>c</sub> = ${2*a*a+4*a*h}, V = ${a*a*h}`,
  s:[`Podstawa jest kwadratem, jej przekątna: ${fsq(a,2)}.`,`Przekątna graniastosłupa: d² = (${fsq(a,2)})² + ${h}² = ${2*a*a} + ${h*h} = ${2*a*a+h*h}, d = ${sq(2*a*a+h*h)}.`,`P<sub>c</sub> = 2 · ${a}² + 4 · ${a} · ${h} = ${2*a*a} + ${4*a*h} = ${2*a*a+4*a*h}.`,`V = ${a}² · ${h} = ${a*a*h}.`]}}
function dice(f){let k=0;for(let x=1;x<=6;x++)for(let y=1;y<=6;y++)if(f(x,y))k++;return k}
const dicePairs=f=>{const o=[];for(let x=1;x<=6;x++)for(let y=1;y<=6;y++)if(f(x,y))o.push(`(${x}, ${y})`);return o};
function gDiceB(){const m=ri(0,3);let t,k,f,how;
  if(m===0){const s=ri(3,11);t=`suma wyrzuconych oczek będzie równa ${s}`;f=(x,y)=>x+y===s}
  else if(m===1){const s=ri(4,10);t=`suma wyrzuconych oczek będzie większa od ${s}`;f=(x,y)=>x+y>s}
  else if(m===2){t='iloczyn wyrzuconych oczek będzie liczbą parzystą';f=(x,y)=>x*y%2===0;how='Łatwiej policzyć zdarzenie przeciwne: iloczyn jest nieparzysty tylko wtedy, gdy obie liczby są nieparzyste, czyli w 3 · 3 = 9 przypadkach. Zatem sprzyjających jest 36 − 9 = 27.'}
  else{const s=ri(1,4);t=`za każdym razem wypadnie więcej niż ${s} ${s===1?'oczko':'oczka'}`;f=(x,y)=>x>s&&y>s;how=`W każdym rzucie jest ${6-s} korzystnych wyników (od ${s+1} do 6), więc sprzyjających par jest ${6-s} · ${6-s} = ${(6-s)**2}.`}
  k=dice(f);const ps=dicePairs(f);
  return{q:`Rzucamy dwa razy symetryczną sześcienną kostką do gry. Oblicz prawdopodobieństwo, że ${t}.`,a:`P = ${fr(k,36)}${F(k,36).d!==36?' = '+fH(F(k,36)):''}`,
  s:[`Wynikiem doświadczenia jest para (wynik 1. rzutu, wynik 2. rzutu), więc |Ω| = 6 · 6 = 36. Wszystkie wyniki są jednakowo prawdopodobne.`,how||`Wypisujemy pary sprzyjające: ${ps.join(', ')}. Jest ich ${k}.`,`P = ${fr('|A|','|Ω|')} = ${fr(k,36)}${F(k,36).d!==36?' = '+fH(F(k,36)):''}.`]}}
function gDigits(n){const W={3:'trzycyfrowych',4:'czterocyfrowych',5:'pięciocyfrowych'};
  for(let tries=0;tries<30;tries++){const S=ri(n+2,9*n-6);
    const pool=[['parzystych',x=>x%2===0],['podzielnych przez 5',x=>x%5===0],['o różnych cyfrach',x=>{const s=''+x;return new Set(s).size===s.length}],
      ['o wszystkich cyfrach nieparzystych',x=>[...''+x].every(c=>c%2===1)],['w których zapisie cyfra 7 występuje dokładnie raz',x=>[...''+x].filter(c=>c==='7').length===1],
      [`o sumie cyfr równej ${S}`,x=>[...''+x].reduce((s,c)=>s+ +c,0)===S]];
    const cs=shuffle(pool).slice(0,ri(1,2)).sort((a,b)=>pool.indexOf(a)-pool.indexOf(b)).sort((a,b)=>a[0].startsWith('w ')-b[0].startsWith('w '));let k=0;for(let x=10**(n-1);x<10**n;x++)if(cs.every(c=>c[1](x)))k++;
    if(k>0)return{q:`Ile jest wszystkich liczb ${W[n]}${cs.map((c,i)=>(i||c[0].startsWith('w ')?', ':' ')+c[0]).join('')}?`,a:''+k}}}
function gChoose(){const g=ri(5,12),b=ri(5,12),k=ri(3,5),j=ri(1,k-1);
  const w=j===1?'będzie dokładnie 1 dziewczyna':j<5?`będą dokładnie ${j} dziewczyny`:`będzie dokładnie ${j} dziewcząt`;
  return{q:`W klasie jest ${g} dziewcząt i ${b} chłopców. Na ile sposobów można wybrać ${k}-osobową delegację, w której ${w}?`,a:`C(${g}, ${j}) · C(${b}, ${k-j}) = ${C(g,j)} · ${C(b,k-j)} = ${C(g,j)*C(b,k-j)}`,
  s:[`Delegacja to zbiór osób (kolejność nie ma znaczenia), więc liczymy kombinacje C(n, k) = ${fr('n!','k! · (n − k)!')}.`,`Wybór ${j} z ${g} dziewcząt: C(${g}, ${j}) = ${C(g,j)}.`,`Pozostałe ${k-j} ${k-j===1?'osobę':'osoby'} wybieramy spośród ${b} chłopców: C(${b}, ${k-j}) = ${C(b,k-j)}.`,`Oba wybory są niezależne, więc z reguły mnożenia: ${C(g,j)} · ${C(b,k-j)} = ${C(g,j)*C(b,k-j)}.`]}}
function gStats(){const n=ri(6,8),arr=Array.from({length:n},()=>ri(1,9)),s=arr.slice().sort((a,b)=>a-b),sum=arr.reduce((a,b)=>a+b,0);
  const med=n%2?F(s[(n-1)/2]):F(s[n/2-1]+s[n/2],2);
  return{q:`Dane są liczby: ${arr.join(', ')}. Oblicz średnią arytmetyczną i medianę tych liczb.`,a:`średnia = ${fH(F(sum,n))}${F(sum,n).d>1?' ≈ '+dec(sum/n):''}, mediana = ${fH(med)} (uporządkowane: ${s.join(', ')})`,
  s:[`Średnia: ${fr(arr.join(' + '),n)} = ${fr(sum,n)}${F(sum,n).d!==n?' = '+fH(F(sum,n)):''}${F(sum,n).d>1?' ≈ '+dec(sum/n):''}.`,`Do mediany porządkujemy liczby rosnąco: ${s.join(', ')}.`,n%2?`Liczb jest ${n} (nieparzyście), więc mediana to środkowa, ${(n+1)/2}. liczba: ${fH(med)}.`:`Liczb jest ${n} (parzyście), więc mediana to średnia ${n/2}. i ${n/2+1}. liczby: ${fr(`${s[n/2-1]} + ${s[n/2]}`,2)} = ${fH(med)}.`]}}
const PROOF_B=[
 ['Wykaż, że dla każdej liczby całkowitej n liczba n² + n jest parzysta.','n² + n = n(n + 1) to iloczyn dwóch kolejnych liczb całkowitych, więc jedna z nich jest parzysta.'],
 ['Wykaż, że suma trzech kolejnych liczb całkowitych jest podzielna przez 3.','(n − 1) + n + (n + 1) = 3n.'],
 ['Wykaż, że dla każdej liczby rzeczywistej x prawdziwa jest nierówność x² − 6x + 10 > 0.','x² − 6x + 10 = (x − 3)² + 1 ≥ 1 > 0.'],
 ['Wykaż, że dla dowolnych liczb rzeczywistych a, b prawdziwa jest nierówność a² + b² ≥ 2ab.','a² + b² − 2ab = (a − b)² ≥ 0.'],
 ['Wykaż, że różnica kwadratów dwóch kolejnych liczb nieparzystych jest podzielna przez 8.','(2n + 1)² − (2n − 1)² = 8n.'],
 ['Wykaż, że dla każdej liczby dodatniej x prawdziwa jest nierówność x + 1/x ≥ 2.','Pomnóż obie strony przez x > 0: x² − 2x + 1 = (x − 1)² ≥ 0.']];
const staticGen=L=>()=>{const[q,a,f]=pick(L);return{q,a:hint(a)+(f?f():'')}};

/* ---------- ROZSZERZENIE ---------- */
function gLogExpr(){const[p,q]=pick([[2,3],[2,5],[3,5],[2,7],[3,2],[5,2],[3,7]]),[i,j]=pick([[1,1],[1,1],[2,1],[1,2]]);let m,n;do{m=ri(0,3);n=ri(0,3)}while(!m&&!n||m*j===n*i);
  const lin=(u,w)=>[u?''+u:'',w?(w===1?'c':w+'c'):''].filter(Boolean).join(' + ')||'0',pw=(b,e)=>e?b+(e>1?SUP[e]:''):'',num=p**m*q**n,base=p**i*q**j,fac=(x,y)=>[pw(p,x),pw(q,y)].filter(Boolean).join(' · ');
  return{q:`Wiadomo, że log<sub>${p}</sub>${q} = c. Wyraź log<sub>${base}</sub>${num} za pomocą c.`,a:fr(lin(m,n),lin(i,j)),
  s:[`Zamieniamy podstawę na ${p}: log<sub>${base}</sub>${num} = ${fr(`log<sub>${p}</sub>${num}`,`log<sub>${p}</sub>${base}`)}.`,`${num} = ${fac(m,n)}, więc log<sub>${p}</sub>${num} = ${[m?`${m === 1 ? '' : m}log<sub>${p}</sub>${p}`:'',n?`${n===1?'':n}log<sub>${p}</sub>${q}`:''].filter(Boolean).join(' + ')} = ${lin(m,n)}.`,`${base} = ${fac(i,j)}, więc log<sub>${p}</sub>${base} = ${lin(i,j)}.`,`Wynik: ${fr(lin(m,n),lin(i,j))}.`]}}
function gAbsR(){const[a,b]=distinct(2,-6,6).sort((x,y)=>x-y),c=b-a+2*ri(1,4),L=(a+b-c)/2,R=(a+b+c)/2,rel=pick([...RELS,'=']);
  const eq=rel==='=',ans=eq?`x = ${N(L)} lub x = ${N(R)}`:signSolve([{v:L},{v:R}],1,rel),mid=c-(b-a);
  return{q:`Rozwiąż ${eq?'równanie':'nierówność'} |${sh(a)}| + |${sh(b)}| ${eq?'=':REL[rel]} ${c}`,a:ans,
  s:[`Wyrażenia pod modułami zerują się w x = ${N(a)} i x = ${N(b)}. Dzielimy oś na trzy przedziały.`,`Dla x < ${N(a)}: oba wyrażenia są ujemne, więc −(${sh(a)}) − (${sh(b)}) = ${poly([-2,a+b])}. Warunek ${poly([-2,a+b])} ${eq?'=':REL[rel]} ${c} daje x ${eq?'=':REL[{'<':'>','<=':'>=','>':'<','>=':'<='}[rel]]} ${N(L)}${L<a?' (ta wartość leży w przedziale)':''}.`,`Dla ${N(a)} ≤ x < ${N(b)}: (${sh(a)}) − (${sh(b)}) = ${N(b-a)}, a ${eq?'równość':'nierówność'} ${N(b-a)} ${eq?'=':REL[rel]} ${c} jest ${(eq?false:{'<':b-a<c,'<=':b-a<=c,'>':b-a>c,'>=':b-a>=c}[rel])?'zawsze prawdziwa, więc cały ten przedział należy do rozwiązania':'fałszywa, więc w tym przedziale nie ma rozwiązań'} (${N(b-a)} to ${mid>0?'mniej':'więcej'} niż ${c}).`,`Dla x ≥ ${N(b)}: (${sh(a)}) + (${sh(b)}) = ${poly([2,-(a+b)])}. Warunek daje x ${eq?'=':REL[rel]} ${N(R)}.`,`Łączymy wyniki z przedziałów: ${ans}.`,`Skrót: |x − a| + |x − b| to suma odległości x od punktów ${N(a)} i ${N(b)}; między nimi jest stała i równa ${N(b-a)}.`]}}
function gAbsEq(){const a=ri(-6,6),b=riNZ(-6,6),s=[F(-a-b),F(a-b,3)];const u=s[0].n*s[1].d===s[1].n*s[0].d?[s[0]]:s.sort((p,q)=>p.n/p.d-q.n/q.d);
  return{q:`Rozwiąż równanie |${sh(a)}| = |${poly([2,b])}|`,a:`x ∈ {${u.map(fH).join(', ')}}<br>${hint('|u| = |v| ⇔ u = v lub u = −v')}`,
  s:[`|u| = |v| wtedy i tylko wtedy, gdy u = v lub u = −v.`,`Przypadek 1: ${sh(a)} = ${poly([2,b])}, czyli −x = ${N(a+b)}, x = ${N(-a-b)}.`,`Przypadek 2: ${sh(a)} = −(${poly([2,b])}), czyli 3x = ${N(a-b)}, x = ${fH(F(a-b,3))}.`,`Odpowiedź: x ∈ {${u.map(fH).join(', ')}}.`]}}
function gLinParam(){const k=ri(1,4),ds=[];for(let i=1;i<=k*k;i++)if(k*k%i===0)ds.push(i);const a=pick(ds),b=k*k/a,c1=ri(-5,5),c2=ri(-5,5);
  return{q:`Wyznacz wszystkie wartości parametru m, dla których układ równań<br>mx${term(a,'y')} = ${N(c1)}<br>${lead(b,'x')} + my = ${N(c2)}<br>ma dokładnie jedno rozwiązanie.`,a:`m ∈ ℝ \\ {${M}${k}, ${k}}<br>${hint(`wyznacznik W = m² − ${k*k} ≠ 0`)}`,
  s:[`Układ ma dokładnie jedno rozwiązanie, gdy jego wyznacznik główny jest różny od zera.`,`W = m · m − ${a} · ${b} = m² − ${k*k}.`,`m² − ${k*k} ≠ 0 ⇔ m ≠ ${M}${k} i m ≠ ${k}.`,`Odpowiedź: m ∈ ℝ \\ {${M}${k}, ${k}}. (Można też porównać współczynniki kierunkowe prostych: jedno rozwiązanie, gdy proste nie są równoległe.)`]}}
function gViete(){let p,q;do{p=riNZ(-7,7);q=riNZ(-6,6)}while(p*p-4*q<=0);
  return{q:`Równanie ${poly([1,p,q])} = 0 ma dwa pierwiastki x<sub>1</sub>, x<sub>2</sub>. Nie wyznaczając ich, oblicz x<sub>1</sub>² + x<sub>2</sub>² oraz ${fr(1,'x<sub>1</sub>')} + ${fr(1,'x<sub>2</sub>')}.`,
  a:`x<sub>1</sub>² + x<sub>2</sub>² = (x<sub>1</sub> + x<sub>2</sub>)² − 2x<sub>1</sub>x<sub>2</sub> = ${N(p*p-2*q)}; ${fr(1,'x<sub>1</sub>')} + ${fr(1,'x<sub>2</sub>')} = ${fr('x<sub>1</sub> + x<sub>2</sub>','x<sub>1</sub>x<sub>2</sub>')} = ${fH(F(-p,q))}`,
  s:[`Sprawdzamy, że pierwiastki istnieją: Δ = ${pN(p)}² − 4 · ${pN(q)} = ${p*p-4*q} > 0.`,`Wzory Viète'a: x<sub>1</sub> + x<sub>2</sub> = ${fr('−b','a')} = ${N(-p)}, x<sub>1</sub>x<sub>2</sub> = ${fr('c','a')} = ${N(q)}.`,`x<sub>1</sub>² + x<sub>2</sub>² = (x<sub>1</sub> + x<sub>2</sub>)² − 2x<sub>1</sub>x<sub>2</sub> = ${pN(-p)}² − 2 · ${pN(q)} = ${N(p*p-2*q)}.`,`${fr(1,'x<sub>1</sub>')} + ${fr(1,'x<sub>2</sub>')} = ${fr('x<sub>1</sub> + x<sub>2</sub>','x<sub>1</sub>x<sub>2</sub>')} = ${fr(N(-p),N(q))} = ${fH(F(-p,q))}.`]}}
function gParamDelta(){for(let tries=0;;tries++){const[u,v]=distinct(2,-6,6).sort((x,y)=>x-y),s=u+v,k=-u*v,ty=ri(0,3);
  if(!s&&ty>0&&tries<40)continue;
  const m0=s?-k/s:null,lab=x=>m0!==null&&Math.abs(x-m0)<1e-9?fH(F(-k,s)):N(x),pts=[u,v,0,...(m0!==null?[m0]:[])],ss=f=>setStr(f,pts,lab);
  const D=m=>(m-u)*(m-v)>1e-9,P=m=>s*m+k>1e-9,Pn=m=>s*m+k<-1e-9;
  const conds=[[D],[D,m=>m<0,P],[D,m=>m>0,P],[Pn]][ty],res=ss(m=>conds.every(c=>c(m)));
  if(ty>0&&res==='∅'&&tries<40)continue;
  const Q=['dwa różne rozwiązania rzeczywiste','dwa różne rozwiązania dodatnie','dwa różne rozwiązania ujemne','dwa rozwiązania różnych znaków'][ty],prod=poly([s,k],'m');
  const dSteps=[`Δ = (2m)² − 4(${prod}) = 4m²${term(-4*s,'m')}${term(-4*k,'')} = 4(${sh(u,'m')})(${sh(v,'m')}).`,`Δ > 0 ⇔ (${sh(u,'m')})(${sh(v,'m')}) > 0 ⇔ m ∈ ${ss(D)} (parabola z ramionami w górę, pierwiastki ${N(u)} i ${N(v)}).`];
  const st=ty===0?dSteps:ty===3?[`Pierwiastki są różnych znaków ⇔ x<sub>1</sub>x<sub>2</sub> < 0 (wtedy Δ > 0 automatycznie, bo ac < 0).`,`Ze wzorów Viète'a: x<sub>1</sub>x<sub>2</sub> = ${prod} < 0 ⇔ m ∈ ${ss(Pn)}.`]
    :[`Warunki: Δ > 0, x<sub>1</sub> + x<sub>2</sub> ${ty===1?'>':'<'} 0, x<sub>1</sub>x<sub>2</sub> > 0.`,...dSteps,`x<sub>1</sub> + x<sub>2</sub> = −2m ${ty===1?'> 0 ⇔ m < 0':'< 0 ⇔ m > 0'}.`,`x<sub>1</sub>x<sub>2</sub> = ${prod} > 0 ⇔ m ∈ ${ss(P)}.`];
  st.push(`Odpowiedź (część wspólna warunków): m ∈ ${res}${res==='∅'?' — takie m nie istnieje':''}.`);
  return{q:`Wyznacz wszystkie wartości parametru m, dla których równanie x² + 2mx${term(s,'m')}${term(k,'')} = 0 ma ${Q}.`,a:`m ∈ ${res}<br>${hint(ty===3?'x₁x₂ < 0':ty===0?'Δ > 0':'Δ > 0 i wzory Viète\'a')}`,s:st}}}
function gPolyIneq(){const nr=pick([3,3,4]),rs=distinct(nr,nr===4?-3:-4,nr===4?3:4),l=pick([1,-1]),rel=pick(RELS),cs=expand(rs,l),so=rs.slice().sort((a,b)=>a-b),r0=rs[0];
  return{q:`Rozwiąż nierówność ${poly(cs)} ${REL[rel]} 0`,a:signSolve(rs.map(v=>({v})),l,rel)+`<br>${hint('pierwiastki: '+so.map(N).join(', ')+'; szukaj ich wśród dzielników wyrazu wolnego')}`,
  s:[`Pierwiastków całkowitych szukamy wśród dzielników wyrazu wolnego ${N(cs[cs.length-1])}.`,`Sprawdzamy: W(${N(r0)}) = 0, więc W(x) dzieli się przez (${sh(r0)}) (twierdzenie Bézouta). Dzielimy (np. schematem Hornera) i rozkładamy dalej.`,`W(x) = ${l<0?M:''}${so.map(v=>`(${sh(v)})`).join('')}.`,snake(l,rel),`Odpowiedź: ${signSolve(rs.map(v=>({v})),l,rel)}`]}}
function gBezout(){const m=riNZ(-5,5),r=pick([1,-1,2,-2,3]),b=ri(-6,6),c=-(r**3+m*r*r+b*r);
  return{q:`Wyznacz wartość parametru m, dla której wielomian W(x) = x³ + mx²${tail([b,c])} jest podzielny przez dwumian (${sh(r)}).`,a:`m = ${N(m)}<br>${hint(`z twierdzenia Bézouta W(${N(r)}) = 0`)}`,
  s:[`Z twierdzenia Bézouta: W jest podzielny przez (${sh(r)}) ⇔ W(${N(r)}) = 0.`,`W(${N(r)}) = ${pN(r)}³ + m · ${pN(r)}² + ${pN(b)} · ${pN(r)} + ${pN(c)} = ${N(r**3+b*r+c)} + ${r*r}m.`,`${r*r}m + ${pN(r**3+b*r+c)} = 0, więc m = ${N(m)}.`]}}
function gRemainder(){const cs=[pick([1,2,-1]),ri(-5,5),ri(-6,6),ri(-8,8)],r=riNZ(-3,3),R=ev(cs,r);
  return{q:`Oblicz resztę z dzielenia wielomianu W(x) = ${poly(cs)} przez dwumian (${sh(r)}).`,a:`R = W(${N(r)}) = ${N(R)}`,
  s:[`Reszta z dzielenia wielomianu przez (x − a) jest równa W(a) (twierdzenie o reszcie).`,`Tutaj a = ${N(r)}: W(${N(r)}) = ${pN(cs[0])} · ${pN(r)}³ + ${pN(cs[1])} · ${pN(r)}² + ${pN(cs[2])} · ${pN(r)} + ${pN(cs[3])} = ${N(cs[0]*r**3)} + ${pN(cs[1]*r*r)} + ${pN(cs[2]*r)} + ${pN(cs[3])} = ${N(R)}.`]}}
function gRatIneq(){const[r1,r2,r3]=distinct(3,-5,5),rel=pick(RELS),ans=signSolve([{v:r1},{v:r2},{v:r3,den:true}],1,rel);
  return{q:`Rozwiąż nierówność ${fr(poly(expand([r1,r2])),sh(r3))} ${REL[rel]} 0`,a:ans+`<br>${hint(`dziedzina x ≠ ${N(r3)}; ta nierówność ma te same rozwiązania co (${sh(r1)})(${sh(r2)})(${sh(r3)}) ${REL[rel]} 0 przy x ≠ ${N(r3)}`)}`,
  s:[`Dziedzina: x ≠ ${N(r3)}.`,`Licznik rozkładamy na czynniki: ${poly(expand([r1,r2]))} = (${sh(r1)})(${sh(r2)}).`,`Znak ilorazu jest taki sam jak znak iloczynu, więc rozwiązujemy (${sh(r1)})(${sh(r2)})(${sh(r3)}) ${REL[rel]} 0 przy x ≠ ${N(r3)} (to jak pomnożenie obu stron przez (${sh(r3)})² > 0).`,snake(1,rel),`Punkt ${N(r3)} zawsze wykluczamy (mianownik). Odpowiedź: ${ans}`]}}
function gExpEq(){const base=pick([2,3]),[a,b]=distinct(2,0,base===2?4:3).sort((x,y)=>x-y),u=base**a,v=base**b;
  return{q:`Rozwiąż równanie ${base*base}<sup>x</sup> − ${u+v} · ${base}<sup>x</sup> + ${u*v} = 0`,a:`x = ${a} lub x = ${b}<br>${hint(`podstaw t = ${base}<sup>x</sup> > 0`)}`,
  s:[`${base*base}<sup>x</sup> = (${base}<sup>x</sup>)². Podstawiamy t = ${base}<sup>x</sup>, gdzie t > 0.`,`t² − ${u+v}t + ${u*v} = 0. ${deltaSteps(1,-(u+v),u*v).join('; ')}.`,`Oba pierwiastki t = ${u} i t = ${v} są dodatnie, więc oba są dobre.`,`${base}<sup>x</sup> = ${u} ⇒ x = ${a}; ${base}<sup>x</sup> = ${v} ⇒ x = ${b}.`]}}
function gLogEq(){const[i,j]=distinct(2,0,4),x0=ri(-3,5),p=2**i-x0,q=2**j-x0,x1=x0-2**i-2**j;
  return{q:`Rozwiąż równanie log<sub>2</sub>(${sh(-p)}) + log<sub>2</sub>(${sh(-q)}) = ${i+j}`,a:`x = ${N(x0)}<br>${hint(`równanie kwadratowe ma też pierwiastek x = ${N(x1)}, ale nie należy on do dziedziny x > ${N(Math.max(-p,-q))}`)}`,
  s:[`Dziedzina: ${sh(-p)} > 0 i ${sh(-q)} > 0, czyli x > ${N(Math.max(-p,-q))}.`,`Suma logarytmów: log<sub>2</sub>[(${sh(-p)})(${sh(-q)})] = ${i+j}, więc (${sh(-p)})(${sh(-q)}) = 2<sup>${i+j}</sup> = ${2**(i+j)}.`,`${poly([1,p+q,p*q-2**(i+j)])} = 0. ${deltaSteps(1,p+q,p*q-2**(i+j)).join('; ')}.`,`Sprawdzamy dziedzinę: x = ${N(x0)} spełnia x > ${N(Math.max(-p,-q))}, a x = ${N(x1)} nie spełnia.`,`Odpowiedź: x = ${N(x0)}.`]}}
function gSeriesInf(){const a1=riNZ(-9,9),k=F(...pick([[1,2],[-1,2],[1,3],[-1,3],[2,3],[-2,3],[1,4],[3,4]]));
  const t=[0,1,2].map(e=>F(a1*k.n**e,k.d**e));let s='';t.forEach((f,i)=>{s+=i===0?fH(f):(f.n<0?' − ':' + ')+fH(F(Math.abs(f.n),f.d))});
  return{q:`Oblicz sumę szeregu geometrycznego: ${s} + …`,a:`S = ${fr('a<sub>1</sub>','1 − q')} = ${fH(F(a1*k.d,k.d-k.n))} (iloraz q = ${fH(k)})`,
  s:[`Pierwszy wyraz a<sub>1</sub> = ${N(a1)}. Iloraz: q = ${fr('a<sub>2</sub>','a<sub>1</sub>')} = ${fH(k)}.`,`|q| = ${fH(F(Math.abs(k.n),k.d))} < 1, więc szereg jest zbieżny.`,`S = ${fr('a<sub>1</sub>','1 − q')} = ${fr(N(a1),`1 − ${pF(k)}`)} = ${fr(N(a1),fH(F(k.d-k.n,k.d)))} = ${fH(F(a1*k.d,k.d-k.n))}.`]}}
function gSeriesX(){const a=ri(-4,4),t=pick([1,2,3]),R=t===1?`(${sh(a)})`:`(${fr(sh(a),t)})`,den=a+t===0?M+'x':`${N(a+t)} − x`;
  return{q:`Wyznacz wszystkie wartości x, dla których szereg 1 + ${R} + ${R}<sup>2</sup> + ${R}<sup>3</sup> + … jest zbieżny, i oblicz jego sumę S(x).`,a:`x ∈ (${N(a-t)}, ${N(a+t)}), S(x) = ${fr(t,den)}<br>${hint(`warunek zbieżności: |q| < 1, gdzie q = ${R}`)}`}}
function gArithS(){const A=riNZ(-3,3),B=ri(-6,6);
  return{q:`Suma n początkowych wyrazów ciągu (a<sub>n</sub>) wyraża się wzorem S<sub>n</sub> = ${poly([A,B,0],'n')}. Wyznacz wzór ogólny ciągu i wykaż, że jest to ciąg arytmetyczny.`,a:`a<sub>n</sub> = S<sub>n</sub> − S<sub>n−1</sub> = ${poly([2*A,B-A],'n')}, a<sub>1</sub> = ${N(A+B)}, r = a<sub>n+1</sub> − a<sub>n</sub> = ${N(2*A)} (stała)`,
  s:[`a<sub>1</sub> = S<sub>1</sub> = ${N(A)} + ${pN(B)} = ${N(A+B)}.`,`Dla n ≥ 2: a<sub>n</sub> = S<sub>n</sub> − S<sub>n−1</sub> = ${poly([A,B,0],'n')} − [${lead(A,'')}(n − 1)²${B?` ${B<0?'−':'+'} ${Math.abs(B)===1?'':Math.abs(B)}(n − 1)`:''}] = ${poly([2*A,B-A],'n')}.`,`Ten wzór dla n = 1 daje ${N(A+B)} = a<sub>1</sub>, więc działa dla każdego n ≥ 1.`,`a<sub>n+1</sub> − a<sub>n</sub> = ${N(2*A)} jest stałe, więc ciąg jest arytmetyczny o różnicy r = ${N(2*A)}.`]}}
function gLimSeq(){const m=ri(0,2),a=riNZ(-6,6),d=riNZ(-5,5),b=ri(-5,5),c=ri(-5,5),e=riNZ(-5,5);let num,den,ans,st;
  if(m===0){num=poly([a,b,c],'n');den=poly([d,0,e],'n');ans=fH(F(a,d));st=[`Licznik i mianownik są stopnia 2. Dzielimy oba przez n²: ${fr(`${N(a)}${b?(b<0?' − ':' + ')+fr(Math.abs(b),'n'):''}${c?(c<0?' − ':' + ')+fr(Math.abs(c),'n²'):''}`,`${N(d)}${e<0?' − ':' + '}${fr(Math.abs(e),'n²')}`)}.`,`Wyrazy z n w mianowniku dążą do 0, więc granica = ${fr(N(a),N(d))} = ${ans}.`]}
  else if(m===1){num=poly([a,c],'n');den=poly([d,b,e],'n');ans='0';st=[`Stopień licznika (1) jest mniejszy niż stopień mianownika (2). Dzielimy licznik i mianownik przez n².`,`Licznik dąży do 0, a mianownik do ${N(d)} ≠ 0, więc granica = 0.`]}
  else{num=poly([a,0,b,c],'n');den=poly([d,e],'n');ans=a*d>0?'+∞':M+'∞';st=[`Stopień licznika (3) jest większy niż stopień mianownika (1). Dzielimy licznik i mianownik przez n: ${fr(`${lead(a,'n²')}${b?(b<0?' − ':' + ')+Math.abs(b):''}${c?(c<0?' − ':' + ')+fr(Math.abs(c),'n'):''}`,`${N(d)}${e<0?' − ':' + '}${fr(Math.abs(e),'n')}`)}.`,`Licznik dąży do ${a>0?'+∞':M+'∞'}, a mianownik do ${N(d)}, więc granica = ${ans}.`]}
  return{q:`Oblicz granicę: lim<sub>n→∞</sub> ${fr(num,den)}`,a:ans+`<br>${hint('podziel licznik i mianownik przez najwyższą potęgę n z mianownika')}`,s:st}}
function gLimFn(){const r=ri(-4,4);if(rnd()<.6){let s;do s=ri(-5,5);while(s===r);
  return{q:`Oblicz granicę: lim<sub>x→${N(r)}</sub> ${fr(poly(expand([r,s])),sh(r))}`,a:`${N(r-s)}<br>${hint(`licznik = (${sh(r)})(${sh(s)})`)}`,
  s:[`Podstawienie x = ${N(r)} daje symbol ${fr(0,0)}, więc trzeba przekształcić wyrażenie.`,`${N(r)} jest pierwiastkiem licznika, więc licznik dzieli się przez (${sh(r)}): ${poly(expand([r,s]))} = (${sh(r)})(${sh(s)}).`,`Skracamy (dla x ≠ ${N(r)}): ${fr(`(${sh(r)})(${sh(s)})`,sh(r))} = ${sh(s)}.`,`lim<sub>x→${N(r)}</sub> (${sh(s)}) = ${N(r)} − ${pN(s)} = ${N(r-s)}.`]}}
  const r2=r||2;return{q:`Oblicz granicę: lim<sub>x→${N(r2)}</sub> ${fr(poly([1,0,0,-(r2**3)]),sh(r2))}`,a:`${3*r2*r2}<br>${hint('wzór a³ − b³ = (a − b)(a² + ab + b²)')}`,
  s:[`Podstawienie daje ${fr(0,0)}. Licznik to x³ − ${pN(r2)}³, więc korzystamy ze wzoru a³ − b³ = (a − b)(a² + ab + b²).`,`x³ − ${pN(r2)}³ = (${sh(r2)})(${poly([1,r2,r2*r2])}).`,`Po skróceniu: lim<sub>x→${N(r2)}</sub> (${poly([1,r2,r2*r2])}) = ${r2*r2} + ${pN(r2*r2)} + ${r2*r2} = ${3*r2*r2}.`]}}
function gLimSqrt(){const k=riNZ(-16,16);
  return{q:`Oblicz granicę: lim<sub>n→∞</sub> (√<span class="ov">${poly([1,k,0],'n')}</span> − n)`,a:`${fH(F(k,2))}<br>${hint('pomnóż i podziel przez sumę √(…) + n')}`,
  s:[`To symbol ∞ − ∞. Mnożymy i dzielimy przez sprzężenie √(${poly([1,k,0],'n')}) + n.`,`Licznik: (${poly([1,k,0],'n')}) − n² = ${lead(k,'n')}, więc wyrażenie = ${fr(lead(k,'n'),`√(${poly([1,k,0],'n')}) + n`)}.`,`Dzielimy licznik i mianownik przez n: ${fr(N(k),`√(1 ${k<0?'−':'+'} ${fr(Math.abs(k),'n')}) + 1`)} → ${fr(N(k),'1 + 1')} = ${fH(F(k,2))}.`]}}
function gDeriv(){const a=pick([1,-1,2,-2]);let r1,r2;do{[r1,r2]=distinct(2,-4,4).sort((x,y)=>x-y)}while(a%2&&(r1+r2)%2);
  const cs=[a,-3*a*(r1+r2)/2,3*a*r1*r2,ri(-5,5)],f1=ev(cs,r1),f2=ev(cs,r2);
  const up=`(${M}∞, ${N(r1)}⟩ i ⟨${N(r2)}, +∞)`,mid=`⟨${N(r1)}, ${N(r2)}⟩`;
  return{q:`Wyznacz przedziały monotoniczności i ekstrema funkcji f(x) = ${poly(cs)}.`,
  a:`f'(x) = ${poly([3*a,-3*a*(r1+r2),3*a*r1*r2])}, miejsca zerowe pochodnej: ${N(r1)} i ${N(r2)}<br>`+(a>0?`f rośnie w ${up}, maleje w ${mid}; maksimum f(${N(r1)}) = ${N(f1)}, minimum f(${N(r2)}) = ${N(f2)}`:`f maleje w ${up}, rośnie w ${mid}; minimum f(${N(r1)}) = ${N(f1)}, maksimum f(${N(r2)}) = ${N(f2)}`),
  s:[`Dziedzina: ℝ. Pochodna: f'(x) = ${poly([3*a,-3*a*(r1+r2),3*a*r1*r2])} = ${N(3*a)}(${sh(r1)})(${sh(r2)}).`,`f'(x) = 0 dla x = ${N(r1)} i x = ${N(r2)}.`,`Parabola f' ma ramiona ${a>0?'w górę: f\' > 0 na zewnątrz pierwiastków, f\' < 0 między nimi':'w dół: f\' < 0 na zewnątrz pierwiastków, f\' > 0 między nimi'}.`,`Zatem f ${a>0?'rośnie':'maleje'} w ${up} oraz ${a>0?'maleje':'rośnie'} w ${mid}.`,`W x = ${N(r1)} pochodna zmienia znak z ${a>0?'+ na −, więc jest maksimum':'− na +, więc jest minimum'}: f(${N(r1)}) = ${N(f1)}. W x = ${N(r2)} z ${a>0?'− na +, więc jest minimum':'+ na −, więc jest maksimum'}: f(${N(r2)}) = ${N(f2)}.`]}}
function gTangent(){const cs=[pick([1,-1]),ri(-4,4),ri(-4,4),ri(-4,4)],x0=ri(-2,2),k=3*cs[0]*x0*x0+2*cs[1]*x0+cs[2],y0=ev(cs,x0);
  return{q:`Wyznacz równanie stycznej do wykresu funkcji f(x) = ${poly(cs)} w punkcie o odciętej x<sub>0</sub> = ${N(x0)}.`,a:`y = ${poly([k,y0-k*x0])}<br>${hint(`f'(${N(x0)}) = ${N(k)}, f(${N(x0)}) = ${N(y0)}`)}`,
  s:[`Równanie stycznej: y = f'(x<sub>0</sub>)(x − x<sub>0</sub>) + f(x<sub>0</sub>).`,`f(${N(x0)}) = ${N(y0)}.`,`f'(x) = ${poly([3*cs[0],2*cs[1],cs[2]])}, więc f'(${N(x0)}) = ${N(k)}.`,`y = ${N(k)}(${sh(x0)}) + ${pN(y0)}, czyli y = ${poly([k,y0-k*x0])}.`]}}
/* kartony a × b, dla których V'(x) = 0 ma wymierny pierwiastek: a² − ab + b² musi być kwadratem */
const OPTBOX=(()=>{const o=[];for(let a=4;a<=40;a++)for(let b=3;b<a;b++){const s=Math.round(Math.sqrt(a*a-a*b+b*b));if(s*s===a*a-a*b+b*b)o.push([a,b,s])}return o})();
function gOptBox(){const[a,b,s]=pick(OPTBOX),x=F(a+b-s,6),V=fmul(fmul(x,fadd(F(a),fmul(F(-2),x))),fadd(F(b),fmul(F(-2),x)));
  return{q:`Z prostokątnego kartonu o wymiarach ${a} cm × ${b} cm wycinamy w rogach cztery jednakowe kwadraty o boku x i zaginamy boki, tworząc otwarte pudełko. Dla jakiego x objętość pudełka jest największa? Oblicz tę objętość.`,
  a:`x = ${fH(x)} cm, V<sub>max</sub> = ${fH(V)} cm³<br>${hint(`V(x) = x(${a} − 2x)(${b} − 2x), x ∈ (0, ${fH(F(b,2))}); rozwiąż V'(x) = 0`)}`,
  s:[`Pudełko ma wymiary (${a} − 2x) × (${b} − 2x) × x, więc V(x) = x(${a} − 2x)(${b} − 2x), gdzie x ∈ (0, ${fH(F(b,2))}).`,`Po wymnożeniu: V(x) = 4x³ − ${2*(a+b)}x² + ${a*b}x, więc V'(x) = 12x² − ${4*(a+b)}x + ${a*b}.`,`V'(x) = 0: Δ = ${16*(a+b)**2} − ${48*a*b} = ${16*(a+b)**2-48*a*b} = (${4*s})², x = ${fr(`${4*(a+b)} ∓ ${4*s}`,24)}, czyli x = ${fH(x)} lub x = ${fH(F(a+b+s,6))}.`,`Tylko x = ${fH(x)} leży w dziedzinie (drugi pierwiastek jest większy od ${fH(F(b,2))}). V' zmienia tam znak z + na −, więc to maksimum.`,`V<sub>max</sub> = V(${fH(x)}) = ${fH(V)} cm³.`]}}
function gOptProd(){const[p,q]=pick([[1,2],[2,1],[1,3],[3,1],[2,3],[3,2],[1,1]]),k=ri(2,p+q>=5?4:8),S=(p+q)*k,x=p*k,y=q*k,val=x**p*y**q,pw=(v,e)=>v+(e>1?SUP[e]:'');
  return{q:`Liczbę ${S} przedstaw w postaci sumy dwóch liczb dodatnich x i y tak, aby iloczyn ${pw('x',p)} · ${pw('y',q)} był największy. Podaj tę największą wartość.`,a:`x = ${x}, y = ${y}, największy iloczyn = ${val}<br>${hint(`f(x) = ${pw('x',p)}(${S} − x)${q>1?SUP[q]:''}`)}`,
  s:[`y = ${S} − x, a z warunku x > 0 i y > 0 mamy x ∈ (0, ${S}).`,`Badamy f(x) = ${pw('x',p)}(${S} − x)${q>1?SUP[q]:''}. Pochodna iloczynu: f'(x) = ${p>1?p+pw('x',p-1):''}(${S} − x)${q>1?SUP[q]:''} − ${q>1?q:''}${pw('x',p)}${q>1?`(${S} − x)${q>2?SUP[q-1]:''}`:''}.`,(CF=>`Wyłączamy wspólny czynnik: f'(x) = ${CF?CF+' · ':''}[${p}(${S} − x) − ${q}x] = ${CF?CF+' · ':''}(${p*S} − ${p+q}x).`)(`${p>1?pw('x',p-1):''}${q>1?`(${S} − x)${q>2?SUP[q-1]:''}`:''}`),`W przedziale (0, ${S}) pochodna zeruje się tylko w x = ${fr(p*S,p+q)} = ${x}; przed tym punktem f' > 0, za nim f' < 0, więc to maksimum.`,`x = ${x}, y = ${S} − ${x} = ${y}, iloczyn = ${pw(x,p)} · ${pw(y,q)} = ${val}.`]}}
const TRIG_EQ=[
 [`sin x = ${fr(1,2)}`,`x ∈ {${fr('π',6)}, ${fr('5π',6)}}`],
 [`cos x = ${M}${fr('√2',2)}`,`x ∈ {${fr('3π',4)}, ${fr('5π',4)}}`],
 ['tg x = √3',`x ∈ {${fr('π',3)}, ${fr('4π',3)}}`],
 [`tg x = ${M}1`,`x ∈ {${fr('3π',4)}, ${fr('7π',4)}}`],
 ['2sin²x − sin x − 1 = 0',`x ∈ {${fr('π',2)}, ${fr('7π',6)}, ${fr('11π',6)}}`],
 ['2cos²x + 3cos x + 1 = 0',`x ∈ {${fr('2π',3)}, π, ${fr('4π',3)}}`],
 ['sin 2x = cos x',`x ∈ {${fr('π',6)}, ${fr('π',2)}, ${fr('5π',6)}, ${fr('3π',2)}}`],
 ['cos 2x + sin x = 0',`x ∈ {${fr('π',2)}, ${fr('7π',6)}, ${fr('11π',6)}}`],
 ['sin x + cos x = 1',`x ∈ {0, ${fr('π',2)}, 2π}`],
 ['2sin x cos x = sin x',`x ∈ {0, ${fr('π',3)}, π, ${fr('5π',3)}, 2π}`],
 [`sin²x = ${fr(3,4)}`,`x ∈ {${fr('π',3)}, ${fr('2π',3)}, ${fr('4π',3)}, ${fr('5π',3)}}`],
 ['2cos²x = 1 + sin x',`x ∈ {${fr('π',6)}, ${fr('5π',6)}, ${fr('3π',2)}}`],
 ['cos 2x = cos x',`x ∈ {0, ${fr('2π',3)}, ${fr('4π',3)}, 2π}`],
 [`sin x · cos x = ${fr('√3',4)}`,`x ∈ {${fr('π',6)}, ${fr('π',3)}, ${fr('7π',6)}, ${fr('4π',3)}}`],
 ['tg x = 2sin x',`x ∈ {0, ${fr('π',3)}, π, ${fr('5π',3)}, 2π}`]];
function gTrigEq(){const[e,a]=pick(TRIG_EQ);return{q:`Rozwiąż równanie ${e} w przedziale ⟨0, 2π⟩.`,a}}
function gTrigId(){let a,b;do{b=ri(2,9);a=ri(-b+1,Math.floor(b*1.41))}while(!a||Math.abs(a)===b||gcd(a,b)!==1);
  return{q:`Kąt α spełnia warunek sin α + cos α = ${fH(F(a,b))}. Oblicz sin α · cos α oraz (sin α − cos α)².`,a:`sin α · cos α = ${fH(F(a*a-b*b,2*b*b))}, (sin α − cos α)² = ${fH(F(2*b*b-a*a,b*b))}<br>${hint('podnieś warunek do kwadratu i skorzystaj z jedynki trygonometrycznej')}`,
  s:[`Podnosimy warunek do kwadratu: sin²α + 2sin α cos α + cos²α = ${fr(a*a,b*b)}.`,`sin²α + cos²α = 1, więc 1 + 2sin α cos α = ${fr(a*a,b*b)} i sin α · cos α = ${fH(F(a*a-b*b,2*b*b))}.`,`(sin α − cos α)² = 1 − 2sin α cos α = 1 − ${pF(F(a*a-b*b,b*b))} = ${fH(F(2*b*b-a*a,b*b))}.`]}}
function gTrigTg(){let n,d;do{n=ri(1,9);d=ri(1,9)}while(n===d||gcd(n,d)!==1);
  return{q:`Kąt α jest ostry i tg α = ${fH(F(n,d))}. Oblicz sin α · cos α oraz ${fr('sin α + cos α','sin α − cos α')}.`,a:`sin α · cos α = ${fH(F(n*d,n*n+d*d))}, ${fr('sin α + cos α','sin α − cos α')} = ${fH(F(n+d,n-d))}<br>${hint('podziel licznik i mianownik przez cos α; sin α cos α = tg α / (1 + tg²α)')}`,
  s:[`Dzielimy licznik i mianownik ułamka przez cos α ≠ 0: ${fr('sin α + cos α','sin α − cos α')} = ${fr('tg α + 1','tg α − 1')} = ${fr(`${fH(F(n,d))} + 1`,`${fH(F(n,d))} − 1`)} = ${fH(F(n+d,n-d))}.`,`sin α · cos α = ${fr('sin α · cos α','sin²α + cos²α')} = (dzielimy przez cos²α) ${fr('tg α','tg²α + 1')}.`,`= ${fr(fH(F(n,d)),`${fH(F(n*n,d*d))} + 1`)} = ${fH(F(n*d,n*n+d*d))}.`]}}
function gCosLaw(){const b=ri(2,9),c=ri(2,9),ang=pick([60,120]),a2=b*b+c*c+(ang===60?-1:1)*b*c;
  return{q:`W trójkącie ABC: |AC| = ${b}, |AB| = ${c}, a kąt BAC ma miarę ${ang}°. Oblicz długość boku BC oraz pole trójkąta.`,a:`|BC| = ${sq(a2)}, P = ${fsq(F(b*c,4),3)}<br>${hint(`|BC|² = ${b}² + ${c}² − 2 · ${b} · ${c} · cos ${ang}°`)}`,
  s:[`Twierdzenie cosinusów: |BC|² = |AC|² + |AB|² − 2 · |AC| · |AB| · cos ${ang}°.`,`cos ${ang}° = ${ang===60?fr(1,2):M+fr(1,2)}, więc |BC|² = ${b*b} + ${c*c} ${ang===60?'−':'+'} ${b*c} = ${a2}, |BC| = ${sq(a2)}.`,`Pole: P = ½ · |AC| · |AB| · sin ${ang}° = ½ · ${b} · ${c} · ${fr('√3',2)} = ${fsq(F(b*c,4),3)}.`]}}
function gSinLaw(){const ang=pick([30,45,60,90,120,135,150]),a=ri(2,12);
  const R={30:[F(a),1],150:[F(a),1],90:[F(a,2),1],45:[F(a,2),2],135:[F(a,2),2],60:[F(a,3),3],120:[F(a,3),3]}[ang],SV={30:fr(1,2),150:fr(1,2),90:'1',45:fr('√2',2),135:fr('√2',2),60:fr('√3',2),120:fr('√3',2)}[ang];
  return{q:`W trójkącie ABC bok BC ma długość ${a}, a kąt BAC ma miarę ${ang}°. Oblicz promień okręgu opisanego na tym trójkącie.`,a:`R = ${fsq(...R)}<br>${hint(`twierdzenie sinusów: ${fr('|BC|','sin α')} = 2R`)}`,
  s:[`Twierdzenie sinusów: ${fr('|BC|','sin ∢BAC')} = 2R (bok BC leży naprzeciw kąta A).`,`sin ${ang}° = ${SV}.`,`2R = ${fr(a,SV)}, więc R = ${fr(a,`2 · ${SV}`)} = ${fsq(...R)}${R[1]>1?' (po usunięciu niewymierności z mianownika)':''}.`]}}
/* ---------- rysunki ---------- */
const Pt=(x,y)=>({x,y}),sub=(a,b)=>Pt(a.x-b.x,a.y-b.y),add=(a,b,k=1)=>Pt(a.x+k*b.x,a.y+k*b.y),mid=(a,b)=>Pt((a.x+b.x)/2,(a.y+b.y)/2),nrm=v=>{const l=Math.hypot(v.x,v.y);return Pt(v.x/l,v.y/l)},dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);
const inter=(p1,p2,p3,p4)=>{const d=(p1.x-p2.x)*(p3.y-p4.y)-(p1.y-p2.y)*(p3.x-p4.x),t=((p1.x-p3.x)*(p3.y-p4.y)-(p1.y-p3.y)*(p3.x-p4.x))/d;return Pt(p1.x+t*(p2.x-p1.x),p1.y+t*(p2.y-p1.y))};
const foot=(p,a,b)=>{const d=sub(b,a),t=((p.x-a.x)*d.x+(p.y-a.y)*d.y)/(d.x*d.x+d.y*d.y);return Pt(a.x+t*d.x,a.y+t*d.y)};
const f1=v=>Math.round(v*10)/10,polar=(o,r,deg)=>Pt(o.x+r*Math.cos(deg*Math.PI/180),o.y+r*Math.sin(deg*Math.PI/180));
const SL=(a,b,c='m')=>`<line class="${c}" x1="${f1(a.x)}" y1="${f1(a.y)}" x2="${f1(b.x)}" y2="${f1(b.y)}"/>`;
const SP=(ps,c='m')=>`<polygon class="${c}" points="${ps.map(p=>f1(p.x)+','+f1(p.y)).join(' ')}"/>`;
const SC=(c,r,cl='m')=>`<circle class="${cl}" cx="${f1(c.x)}" cy="${f1(c.y)}" r="${f1(r)}"/>`;
const SD=p=>`<circle class="pt" cx="${f1(p.x)}" cy="${f1(p.y)}" r="2.6"/>`;
const LB=(p,t,c)=>{const d=nrm(sub(p,c));return SD(p)+`<text x="${f1(p.x+d.x*14)}" y="${f1(p.y+d.y*14+5)}">${t}</text>`};
const FIG=(inner,cap,vb='0 0 290 190')=>`<figure class="fg"><svg viewBox="${vb}" role="img" aria-label="${cap}">${inner}</svg><figcaption>${cap}</figcaption></figure>`;
const AUX='Rysunek poglądowy; linie pomocnicze są czerwone i przerywane.';
function figMid(){const A=Pt(30,165),B=Pt(255,165),C=Pt(105,30),M=mid(A,C),N=mid(B,C),c=Pt(130,120);
  return FIG(SP([A,B,C])+SL(M,N,'x')+LB(A,'A',c)+LB(B,'B',c)+LB(C,'C',c)+LB(M,'M',c)+LB(N,'N',c),'MN łączy środki boków; trójkąty MNC i ABC są podobne w skali ½.')}
function figTang(){const O=Pt(145,96),r=56,th=[-120,-20,60,150],T=th.map(t=>polar(O,r,t)),V=th.map((t,i)=>{const u=i<3?th[i+1]:th[0]+360,d=u-t;return polar(O,r/Math.cos(d/2*Math.PI/180),(t+u)/2)});
  return FIG(SC(O,r)+SP(V)+T.map(t=>SL(O,t,'x')+SD(t)).join('')+['B','C','D','A'].map((n,i)=>LB(V[i],n,O)).join('')+SD(O),'Z każdego wierzchołka wychodzą dwa równe odcinki stycznych. '+AUX)}
function figBis(){const O=Pt(150,150),R=polar(O,115,-62),r=nrm(sub(R,O)),b1=nrm(add(Pt(1,0),r)),b2=nrm(add(Pt(-1,0),r));
  return FIG(SL(Pt(20,150),Pt(275,150))+SL(O,R)+SL(O,add(O,b1,110),'x')+SL(O,add(O,b2,110),'x')+LB(O,'O',Pt(150,100)),'Dwusieczne dzielą kąty α i β na połowy: α/2 + β/2 = 90°. '+AUX)}
function figAlt(){const A=Pt(25,160),B=Pt(265,160),C=polar(Pt(145,160),120,-118),D=Pt(C.x,160),c=Pt(130,120);
  return FIG(SP([A,D,C],'h1')+SP([C,D,B],'h2')+SP([A,B,C])+SL(C,D)+LB(A,'A',c)+LB(B,'B',c)+LB(C,'C',c)+LB(D,'D',Pt(D.x,100)),'Trójkąty ADC i CDB są podobne (kkk).')}
function figHyp(){const A=Pt(40,150),B=Pt(240,150),M=Pt(140,150),C=polar(M,100,-124),c=Pt(140,110);
  return FIG(`<path class="x" d="M40,150 A100,100 0 0 1 240,150"/>`+SP([A,B,C])+SL(M,C,'x')+LB(A,'A',c)+LB(B,'B',c)+LB(C,'C',c)+LB(M,'M',Pt(140,100)),'Dorysuj okrąg o średnicy AB: C na nim leży, więc |MA| = |MB| = |MC|. '+AUX)}
function figCyc(){const O=Pt(145,95),r=78,[A,B,C,D]=[150,30,-60,-130].map(t=>polar(O,r,t));
  return FIG(SC(O,r)+SP([A,B,C,D])+SL(O,B,'x')+SL(O,D,'x')+LB(A,'A',O)+LB(B,'B',O)+LB(C,'C',O)+LB(D,'D',O)+SD(O),'Kąty środkowe BOD oparte na dwóch łukach sumują się do 360°. '+AUX)}
function figPara(){const A=Pt(25,150),B=Pt(185,150),C=Pt(260,50),D=Pt(100,50),c=Pt(142,100);
  return FIG(SP([A,B,C,D])+SL(A,C,'x')+SL(B,D,'x')+LB(A,'A',c)+LB(B,'B',c)+LB(C,'C',c)+LB(D,'D',c),'Twierdzenie cosinusów w trójkątach ABD i ABC. '+AUX)}
function figTrapPerp(){const A=Pt(30,150),B=Pt(200,150),C=Pt(150,30),D=Pt(80,30),E=Pt(270,150),H=Pt(150,150),c=Pt(140,90);
  return FIG(SP([A,B,C,D])+SL(A,C)+SL(B,D)+SL(C,E,'x')+SL(B,E,'x')+SL(C,H,'x')+LB(A,'A',c)+LB(B,'B',Pt(200,100))+LB(C,'C',c)+LB(D,'D',c)+LB(E,'E',c)+LB(H,'H',Pt(150,100)),'Przesuń przekątną BD do CE: trójkąt ACE jest prostokątny i równoramienny, |AE| = a + b. '+AUX)}
function figMedian(){const A=Pt(20,160),B=Pt(170,160),C=Pt(110,50),M=mid(B,C),A2=sub(Pt(2*M.x,2*M.y),A),c=Pt(140,105);
  return FIG(SP([A,B,C])+SL(A,M)+SL(M,A2,'x')+SL(B,A2,'x')+SL(C,A2,'x')+LB(A,'A',c)+LB(B,'B',c)+LB(C,'C',c)+LB(M,'M',Pt(120,130))+LB(A2,'A′',c),'Przedłuż środkową AM o jej długość: ABA′C jest równoległobokiem. '+AUX)}
function figCirc(m){const O1=Pt(80,110),r1=50,r2=30,O2=Pt(80+Math.sqrt(6000),130),A=Pt(80,160),B=Pt(O2.x,160),C=add(O1,sub(O2,O1),50/80),M=mid(A,B),K=Pt(80,130);
  let s=SC(O1,r1)+SC(O2,r2)+SL(Pt(15,160),Pt(230,160))+SD(O1)+SD(O2);
  if(m)s+=SL(O1,A,'x')+SL(O2,B,'x')+SL(O1,O2,'x')+SL(O2,K,'x')+LB(A,'A',Pt(A.x,120))+LB(B,'B',Pt(B.x,120))+LB(K,'K',Pt(120,120));
  else s+=SL(A,C)+SL(B,C)+SL(M,add(M,sub(C,M),1.7),'x')+LB(A,'A',Pt(A.x,120))+LB(B,'B',Pt(B.x,120))+LB(C,'C',Pt(C.x+25,175))+LB(M,'M',Pt(M.x,120));
  return FIG(s,(m?'Trójkąt O₁KO₂: przeciwprostokątna R + r, przyprostokątna R − r, druga przyprostokątna = |AB|. ':'Wspólna styczna wewnętrzna w C: |MA| = |MC| = |MB|. ')+AUX)}
function figEqui(){const A=Pt(50,170),B=Pt(230,170),C=Pt(140,14),P=Pt(128,112),c=Pt(140,118);
  return FIG(SP([A,B,C])+[[A,B],[B,C],[C,A]].map(([u,v])=>SL(P,foot(P,u,v))).join('')+SL(P,A,'x')+SL(P,B,'x')+SL(P,C,'x')+LB(A,'A',c)+LB(B,'B',c)+LB(C,'C',c)+LB(P,'P',Pt(160,60)),'Połącz P z wierzchołkami: pole ABC = suma pól trzech trójkątów. '+AUX)}
function figBisTh(){const A=Pt(20,160),B=Pt(230,160),C=Pt(170,60),u=add(nrm(sub(A,C)),nrm(sub(B,C))),D=inter(C,add(C,u),A,B),E=inter(B,add(B,sub(D,C)),A,C),c=Pt(150,120);
  return FIG(SP([A,B,C])+SL(C,D)+SL(C,E,'x')+SL(B,E,'x')+LB(A,'A',c)+LB(B,'B',c)+LB(C,'C',Pt(140,110))+LB(D,'D',Pt(D.x,120))+LB(E,'E',c),'Prosta BE ∥ CD: trójkąt BCE jest równoramienny. '+AUX,'0 -28 300 210')}
function figTrapRight(){const A=Pt(30,165),B=Pt(270,165),C=Pt(110,45),D=Pt(30,45),O=Pt(90,105),H=Pt(110,165),c=Pt(130,105);
  return FIG(SP([A,B,C,D])+SC(O,60)+SL(C,H,'x')+LB(A,'A',c)+LB(B,'B',c)+LB(C,'C',c)+LB(D,'D',c)+LB(H,'H',Pt(110,120)),'Wysokość CH = 2r; w czworokąt opisany na okręgu: a + b = c + d. '+AUX)}
const PROOF_T=[
 ['W trapezie równoramiennym ABCD (AB ∥ CD) przekątne są prostopadłe. Wykaż, że wysokość trapezu jest równa średniej arytmetycznej długości jego podstaw.','przez C poprowadź prostą równoległą do BD, przecinającą prostą AB w punkcie E. BECD to równoległobok, więc |BE| = |CD| i |CE| = |BD| = |AC|. Trójkąt ACE jest prostokątny (bo CE ∥ BD ⊥ AC) i równoramienny, więc jego wysokość CH to połowa przeciwprostokątnej: h = (a + b)/2.',figTrapPerp],
 ['Wykaż, że w każdym trójkącie ABC środkowa AM jest krótsza od połowy sumy boków AB i AC.','przedłuż środkową AM o jej długość do punktu A′. Przekątne czworokąta ABA′C dzielą się na połowy, więc to równoległobok i |BA′| = |AC|. Z nierówności trójkąta w ABA′: 2|AM| = |AA′| < |AB| + |BA′| = |AB| + |AC|.',figMedian],
 ['Dwa okręgi są styczne zewnętrznie w punkcie C. Prosta k jest ich wspólną styczną zewnętrzną w punktach A i B. Wykaż, że kąt ACB jest prosty.','dorysuj wspólną styczną wewnętrzną w punkcie C; przecina ona AB w punkcie M. Odcinki stycznych z punktu M są równe: |MA| = |MC| = |MB|. Zatem C leży na okręgu o średnicy AB, czyli kąt ACB jest prosty.',()=>figCirc(0)],
 ['Dwa okręgi o promieniach R i r (R > r) są styczne zewnętrznie. Wykaż, że odcinek wspólnej stycznej zewnętrznej między punktami styczności ma długość 2√(Rr).','dorysuj promienie O₁A i O₂B (prostopadłe do stycznej) i poprowadź przez O₂ prostą równoległą do AB, przecinającą O₁A w punkcie K. W trójkącie prostokątnym O₁KO₂: |O₁O₂| = R + r, |O₁K| = R − r, więc |AB|² = |KO₂|² = (R + r)² − (R − r)² = 4Rr.',()=>figCirc(1)],
 ['Dwusieczna kąta ACB trójkąta ABC przecina bok AB w punkcie D. Wykaż, że |AD| : |DB| = |AC| : |BC|.','przez B poprowadź prostą równoległą do CD; przecina ona prostą AC w punkcie E. Kąty CBE i CEB są równe połowie kąta C (naprzemianległe i odpowiadające), więc |CE| = |CB|. Z twierdzenia Talesa: |AD| : |DB| = |AC| : |CE| = |AC| : |BC|.',figBisTh],
 ['Punkt P leży wewnątrz trójkąta równobocznego ABC o boku a. Wykaż, że suma odległości punktu P od boków trójkąta jest równa jego wysokości.','połącz P z wierzchołkami. Pole ABC jest sumą pól trójkątów ABP, BCP i CAP: ½a·d₁ + ½a·d₂ + ½a·d₃ = ½a·h, więc d₁ + d₂ + d₃ = h.',figEqui]];
function gTrapPerp(){const b=ri(2,8),a=b+2*ri(1,5);
  return{q:`W trapezie równoramiennym podstawy mają długości ${a} i ${b}, a przekątne są prostopadłe. Oblicz wysokość i pole tego trapezu.`,a:`h = ${fH(F(a+b,2))}, P = ${fH(F((a+b)**2,4))}<br>${hint('przesuń jedną przekątną równolegle do wierzchołka drugiej podstawy: powstaje trójkąt prostokątny równoramienny o przeciwprostokątnej a + b, a h to połowa przeciwprostokątnej')}${figTrapPerp()}`}}
function gCommonTangent(){const t=ri(1,3),[u,v]=distinct(2,1,6).sort((x,y)=>x-y),r=t*u*u,R=t*v*v;
  return{q:`Dwa okręgi o promieniach ${R} i ${r} są styczne zewnętrznie. Prosta jest ich wspólną styczną zewnętrzną w punktach A i B. Oblicz |AB|.`,a:`|AB| = 2√(${R} · ${r}) = ${2*Math.sqrt(R*r)}<br>${hint('dorysuj promienie do punktów styczności i przez środek mniejszego okręgu poprowadź prostą równoległą do AB')}${figCirc(1)}`}}
function gTrapRight(){const k=ri(1,2),[p,q,c]=pickTriple(k===1?65:37).map(v=>v*k),useP=p%2===0&&(q%2||rnd()<.5),L=useP?p:q,d=useP?q:p,r=L/2,s=c+2*r,a=(s+d)/2,b=(s-d)/2;
  return{q:`W trapez prostokątny wpisano okrąg o promieniu ${r}. Dłuższe ramię trapezu ma długość ${c}. Oblicz długości podstaw i pole trapezu.`,a:`podstawy: ${a} i ${b}, P = ${s*r}<br>${hint(`wysokość = 2r = ${2*r}; dorysuj wysokość CH: z trójkąta prostokątnego a − b = √(${c}² − ${2*r}²) = ${d}; z warunku czworokąta opisanego a + b = ${c} + ${2*r}`)}${figTrapRight()}`}}
function gEquiDist(){const a=ri(2,30);
  return{q:`Punkt P leży wewnątrz trójkąta równobocznego o boku ${a}. Oblicz sumę odległości punktu P od boków trójkąta.`,a:`${fsq(F(a,2),3)} (wysokość trójkąta, niezależnie od położenia P)<br>${hint('połącz P z wierzchołkami i porównaj pola')}${figEqui()}`}}
function gMedianPara(){for(;;){const[a,b,c]=[ri(3,10),ri(3,10),ri(3,10)];if(a+b<=c||a+c<=b||b+c<=a)continue;const n=2*b*b+2*c*c-a*a,{k,m}=simp(n);
  return{q:`Trójkąt ABC ma boki |BC| = ${a}, |AC| = ${b}, |AB| = ${c}. Oblicz długość środkowej AM.`,a:`|AM| = ${fsq(F(k,2),m)}<br>${hint(`przedłuż AM o jej długość do A′; w równoległoboku ABA′C suma kwadratów przekątnych = suma kwadratów boków: (2|AM|)² + ${a}² = 2 · ${b}² + 2 · ${c}²`)}${figMedian()}`}}}

const PROOF_A=[
 ['Wykaż, że dla dowolnych liczb rzeczywistych a, b, c prawdziwa jest nierówność a² + b² + c² ≥ ab + bc + ca.','pomnóż przez 2 i zapisz jako (a − b)² + (b − c)² + (c − a)² ≥ 0.'],
 ['Wykaż, że dla dowolnych liczb dodatnich a, b prawdziwa jest nierówność (a + b)(1/a + 1/b) ≥ 4.','po wymnożeniu: a/b + b/a ≥ 2; pomnóż przez ab > 0: a² + b² − 2ab = (a − b)² ≥ 0.'],
 ['Wykaż, że dla każdej liczby całkowitej n liczba n³ − n jest podzielna przez 6.','n³ − n = (n − 1)n(n + 1) to iloczyn trzech kolejnych liczb całkowitych: jest wśród nich liczba parzysta i liczba podzielna przez 3.'],
 ['Wykaż, że dla każdej liczby rzeczywistej x prawdziwa jest nierówność x⁴ − 4x + 3 ≥ 0.','x⁴ − 4x + 3 = (x − 1)²(x² + 2x + 3), a x² + 2x + 3 = (x + 1)² + 2 > 0.'],
 ['Wykaż, że jeśli a + b = 2, to ab ≤ 1.','podstaw b = 2 − a: ab = 2a − a² = 1 − (a − 1)² ≤ 1.'],
 ['Wykaż, że dla dowolnych liczb nieujemnych a, b prawdziwa jest nierówność (a + b)/2 ≥ √(ab).','(√a − √b)² ≥ 0, więc a + b ≥ 2√(ab).'],
 ['Wykaż, że dla każdej liczby całkowitej n liczba n⁵ − n jest podzielna przez 30.','n⁵ − n = (n − 1)n(n + 1)(n² + 1). Podzielność przez 2 i 3 wynika z iloczynu kolejnych liczb; dla 5 rozpatrz reszty z dzielenia n przez 5 (gdy reszta to 2 lub 3, przez 5 dzieli się n² + 1).'],
 ['Wykaż, że dla każdej liczby naturalnej n ≥ 1 liczba 10ⁿ + 8 jest podzielna przez 9.','suma cyfr liczby 10…08 wynosi 9 (albo: 10ⁿ daje resztę 1 z dzielenia przez 9).'],
 ['Wykaż, że jeśli a > 0, b > 0 i a + b = 1, to 1/a + 1/b ≥ 4.','1/a + 1/b = (a + b)/(ab) = 1/(ab), a ab ≤ ((a + b)/2)² = 1/4.'],
 ['Wykaż, że dla dowolnych liczb rzeczywistych x, y prawdziwa jest nierówność x² + y² + 2 ≥ 2(x + y).','(x − 1)² + (y − 1)² ≥ 0.'],
 ['Wykaż, że suma kwadratów trzech kolejnych liczb całkowitych przy dzieleniu przez 3 daje resztę 2.','(n − 1)² + n² + (n + 1)² = 3n² + 2.'],
 ['Wykaż, że dla każdej liczby x ≥ 0 prawdziwa jest nierówność x³ + 2 ≥ 3x.','x³ − 3x + 2 = (x − 1)²(x + 2) ≥ 0 dla x ≥ 0.']];
const PROOF_G=[
 ['W trójkącie ABC punkty M i N są środkami boków AC i BC. Wykaż, że MN ∥ AB oraz |MN| = ½|AB|.','trójkąty MNC i ABC są podobne w skali ½ (cecha bkb: wspólny kąt C, boki w stosunku 1 : 2).',figMid],
 ['Wykaż, że jeśli w czworokąt wypukły ABCD można wpisać okrąg, to |AB| + |CD| = |BC| + |AD|.','odcinki stycznych poprowadzonych z jednego wierzchołka do okręgu są równe. Rozpisz każdy bok jako sumę dwóch takich odcinków.',figTang],
 ['Wykaż, że dwusieczne dwóch kątów przyległych są prostopadłe.','α + β = 180°, a kąt między dwusiecznymi to α/2 + β/2 = 90°.',figBis],
 ['W trójkącie prostokątnym ABC z kątem prostym przy wierzchołku C poprowadzono wysokość CD. Wykaż, że |CD|² = |AD| · |DB|.','trójkąty ADC i CDB są podobne (cecha kkk).',figAlt],
 ['Wykaż, że środek przeciwprostokątnej trójkąta prostokątnego jest równo oddalony od wszystkich wierzchołków trójkąta.','kąt wpisany oparty na średnicy jest prosty, więc przeciwprostokątna jest średnicą okręgu opisanego.',figHyp],
 ['Czworokąt ABCD jest wpisany w okrąg. Wykaż, że |∢A| + |∢C| = 180°.','kąty A i C są kątami wpisanymi opartymi na łukach, które razem tworzą cały okrąg; każdy z nich to połowa odpowiedniego kąta środkowego.',figCyc],
 ['Wykaż, że w równoległoboku suma kwadratów długości przekątnych jest równa sumie kwadratów długości wszystkich boków.','zastosuj twierdzenie cosinusów w trójkątach ABD i ABC; cosinusy kątów A i B mają przeciwne znaki.',figPara]];
function gCircle(){const a=ri(-5,5),b=ri(-5,5),r=ri(1,6);
  return{q:`Wyznacz współrzędne środka i promień okręgu o równaniu x² + y²${term(-2*a,'x')}${term(-2*b,'y')}${term(a*a+b*b-r*r,'')} = 0.`,a:`S = (${N(a)}, ${N(b)}), r = ${r}<br>${hint('sprowadź do postaci (x − a)² + (y − b)² = r²')}`,
  s:[`Grupujemy wyrazy z x i z y i uzupełniamy do pełnych kwadratów.`,[a?`x²${term(-2*a,'x')} = (${sh(a)})² − ${a*a}`:'wyraz x² zostaje bez zmian',b?`y²${term(-2*b,'y')} = (${sh(b,'y')})² − ${b*b}`:'wyraz y² zostaje bez zmian'].join(', ')+'.',`Równanie: (${sh(a)})² + (${sh(b,'y')})² − ${a*a} − ${b*b}${term(a*a+b*b-r*r,'')} = 0, czyli (${sh(a)})² + (${sh(b,'y')})² = ${r*r}.`,`Środek S = (${N(a)}, ${N(b)}), promień r = √${r*r} = ${r}.`]}}
function gDistPL(){const t=pick([[3,4,5],[4,3,5],[5,12,13],[12,5,13],[6,8,10],[8,6,10]]),A=t[0]*sg(),B=t[1]*sg(),Cc=ri(-10,10),x0=ri(-5,5),y0=ri(-5,5),d=F(Math.abs(A*x0+B*y0+Cc),t[2]);
  const line=`${lead(A,'x')}${term(B,'y')}${term(Cc,'')} = 0`;
  const st=[`Wzór na odległość punktu (x<sub>0</sub>, y<sub>0</sub>) od prostej Ax + By + C = 0: d = ${fr('|Ax<sub>0</sub> + By<sub>0</sub> + C|','√(A² + B²)')}.`,`d = ${fr(`|${N(A)} · ${pN(x0)} + ${pN(B)} · ${pN(y0)} + ${pN(Cc)}|`,`√(${pN(A)}² + ${pN(B)}²)`)} = ${fr(`|${N(A*x0+B*y0+Cc)}|`,`√${t[2]*t[2]}`)} = ${fH(d)}.`];
  if(rnd()<.5)return{q:`Oblicz odległość punktu P = (${N(x0)}, ${N(y0)}) od prostej o równaniu ${line}.`,a:`d = ${fH(d)}<br>${hint(`d = ${fr('|Ax<sub>0</sub> + By<sub>0</sub> + C|','√(A² + B²)')}`)}`,s:st};
  const rho=d.d===1&&rnd()<.4&&d.n>0?d.n:ri(1,6),dv=d.n/d.d,rel=Math.abs(dv-rho)<1e-9?'styczna do okręgu':dv<rho?'sieczna (przecina okrąg w dwóch punktach)':'rozłączna z okręgiem';
  return{q:`Określ wzajemne położenie prostej ${line} i okręgu o środku S = (${N(x0)}, ${N(y0)}) i promieniu ${rho}.`,a:`odległość środka od prostej d = ${fH(d)}, więc prosta jest ${rel}.`,
  s:['Położenie prostej względem okręgu zależy od odległości d środka od prostej: d < r (sieczna), d = r (styczna), d > r (rozłączna).',...st,`Porównujemy: d = ${fH(d)} ${Math.abs(dv-rho)<1e-9?'=':dv<rho?'<':'>'} r = ${rho}, więc prosta jest ${rel}.`]}}
function gPyramid(){const k=ri(1,2),[p,q,hs]=pickTriple(k===1?41:29).map(v=>v*k),sw=rnd()<.5,h2=sw?p:q,H=sw?q:p,a=2*h2;
  return{q:`Ostrosłup prawidłowy czworokątny ma krawędź podstawy ${a} i wysokość ${H}. Oblicz wysokość ściany bocznej, pole powierzchni całkowitej, objętość oraz tangens kąta nachylenia ściany bocznej do płaszczyzny podstawy.`,
  a:`h<sub>s</sub> = ${hs}, P<sub>c</sub> = ${a*a} + ${2*a*hs} = ${a*a+2*a*hs}, V = ${fH(F(a*a*H,3))}, tg α = ${fH(F(H,h2))}`,
  s:[`Wysokość ostrosłupa H, połowa krawędzi podstawy (${h2}) i wysokość ściany bocznej h<sub>s</sub> tworzą trójkąt prostokątny.`,`h<sub>s</sub> = √(${H}² + ${h2}²) = √${hs*hs} = ${hs}.`,`P<sub>c</sub> = a² + 4 · ½ · a · h<sub>s</sub> = ${a*a} + ${2*a*hs} = ${a*a+2*a*hs}.`,`V = ⅓ · a² · H = ⅓ · ${a*a} · ${H} = ${fH(F(a*a*H,3))}.`,`Kąt nachylenia ściany bocznej leży przy podstawie tego trójkąta: tg α = ${fr('H',h2)} = ${fH(F(H,h2))}.`]}}
function gCone(){const k=ri(1,3),[p,q,l]=pickTriple(k===1?41:k===2?29:17).map(v=>v*k),sw=rnd()<.5,r=sw?p:q,h=sw?q:p,V=F(r*r*h,3),Vs=V.d===1?V.n:fH(V),giv=rnd()<.4;
  return{q:giv?`Tworząca stożka ma długość ${l}, a promień podstawy ${r}. Oblicz wysokość, pole powierzchni całkowitej i objętość stożka.`:`Stożek ma promień podstawy ${r} i wysokość ${h}. Oblicz długość tworzącej, pole powierzchni całkowitej i objętość stożka.`,
  a:`${giv?`h = ${h}`:`l = ${l}`}, P<sub>c</sub> = ${r*(r+l)}π, V = ${Vs}π`,
  s:[giv?`Wysokość, promień i tworząca tworzą trójkąt prostokątny: h = √(${l}² − ${r}²) = √${h*h} = ${h}.`:`Tworząca, promień i wysokość tworzą trójkąt prostokątny: l = √(${r}² + ${h}²) = √${l*l} = ${l}.`,`P<sub>c</sub> = πr² + πrl = ${r*r}π + ${r*l}π = ${r*(r+l)}π.`,`V = ⅓πr²h = ⅓ · ${r*r} · ${h} · π = ${Vs}π.`]}}
function gBernoulli(){const m=ri(0,2);
  const BS='Schemat Bernoullego: n niezależnych prób, w każdej sukces z prawdopodobieństwem p. P(k sukcesów) = C(n, k) · p<sup>k</sup> · (1 − p)<sup>n − k</sup>.';
  if(m===0){const n=ri(4,8),k=ri(1,n-1);return{q:`Rzucamy ${n} razy symetryczną monetą. Oblicz prawdopodobieństwo otrzymania dokładnie ${k===1?'jednego orła':k+' orłów'}.`,a:`P = C(${n}, ${k}) · ${fr(1,`2<sup>${n}</sup>`)} = ${fH(F(C(n,k),2**n))}`,
    s:[BS,`Tu n = ${n}, k = ${k}, p = ${fr(1,2)}, więc p<sup>k</sup>(1 − p)<sup>n − k</sup> = (${fr(1,2)})<sup>${n}</sup> = ${fr(1,2**n)}.`,`C(${n}, ${k}) = ${C(n,k)} (tyle jest sposobów wyboru rzutów, w których wypadł orzeł).`,`P = ${C(n,k)} · ${fr(1,2**n)} = ${fH(F(C(n,k),2**n))}.`]}}
  if(m===1){const n=ri(3,5),k=ri(1,n-1);return{q:`Rzucamy ${n} razy symetryczną sześcienną kostką. Oblicz prawdopodobieństwo, że szóstka wypadnie dokładnie ${k} ${k===1?'raz':'razy'}.`,a:`P = C(${n}, ${k}) · (${fr(1,6)})<sup>${k}</sup> · (${fr(5,6)})<sup>${n-k}</sup> = ${fH(F(C(n,k)*5**(n-k),6**n))}`,
    s:[BS,`Sukces: wypadła szóstka, p = ${fr(1,6)}, porażka: 1 − p = ${fr(5,6)}. n = ${n}, k = ${k}.`,`P = C(${n}, ${k}) · (${fr(1,6)})<sup>${k}</sup> · (${fr(5,6)})<sup>${n-k}</sup> = ${C(n,k)} · ${fr(5**(n-k),6**n)} = ${fH(F(C(n,k)*5**(n-k),6**n))}.`]}}
  const n=ri(2,5);return{q:`Rzucamy ${n} razy symetryczną sześcienną kostką. Oblicz prawdopodobieństwo, że szóstka wypadnie co najmniej raz.`,a:`P = 1 − (${fr(5,6)})<sup>${n}</sup> = ${fH(F(6**n-5**n,6**n))}`,
    s:[`„Co najmniej raz” najłatwiej policzyć przez zdarzenie przeciwne: szóstka nie wypadła ani razu.`,`P(ani razu) = (${fr(5,6)})<sup>${n}</sup> = ${fr(5**n,6**n)}.`,`P = 1 − ${fr(5**n,6**n)} = ${fH(F(6**n-5**n,6**n))}.`]}}
function gCond(){for(let t=0;t<30;t++){const S=ri(4,10),S2=ri(5,9);
  const A=pick([[`suma oczek jest równa ${S}`,(x,y)=>x+y===S],[`suma oczek jest większa od ${S2}`,(x,y)=>x+y>S2],['iloczyn oczek jest parzysty',(x,y)=>x*y%2===0],['na obu kostkach wypadła ta sama liczba oczek',(x,y)=>x===y]]);
  const B=pick([['co najmniej raz wypadła szóstka',(x,y)=>x===6||y===6],['na pierwszej kostce wypadła liczba parzysta',x=>x%2===0],['suma oczek jest parzysta',(x,y)=>(x+y)%2===0],['na obu kostkach wypadły różne liczby oczek',(x,y)=>x!==y]]);
  const nb=dice(B[1]),nab=dice((x,y)=>A[1](x,y)&&B[1](x,y));if(nab===0||nab===nb)continue;
  return{q:`Rzucamy dwa razy symetryczną sześcienną kostką do gry. Oblicz prawdopodobieństwo, że ${A[0]}, pod warunkiem że ${B[0]}.`,a:`P(A|B) = ${fr('|A ∩ B|','|B|')} = ${fr(nab,nb)}${F(nab,nb).d!==nb?' = '+fH(F(nab,nb)):''}`,
  s:[`A: ${A[0]}; B: ${B[0]}. Wszystkich wyników jest 36 i są jednakowo prawdopodobne.`,`P(A|B) = ${fr('P(A ∩ B)','P(B)')} = ${fr('|A ∩ B|','|B|')} (liczymy tylko wśród wyników, w których zaszło B).`,`|B| = ${nb}.`,`A ∩ B: ${nab<=12?dicePairs((x,y)=>A[1](x,y)&&B[1](x,y)).join(', ')+', ':''}razem ${nab}.`,`P(A|B) = ${fr(nab,nb)}${F(nab,nb).d!==nb?' = '+fH(F(nab,nb)):''}.`]}}}

function gLogVal(){const b=pick([2,3,5]),n=ri(1,3);
  const[x,v]=pick([[`${b**n}`,F(n)],[fr(1,b**n),F(-n)],[`√${b}`,F(1,2)],[`${b**n}√${b}`,F(2*n+1,2)],[fr(1,`√${b}`),F(-1,2)],[fr(1,`${b**n}√${b}`),F(-2*n-1,2)]]);
  return{q:`Oblicz: log<sub>${b}</sub>${x}`,a:`${fH(v)}<br>${hint(`zapisz liczbę jako potęgę ${b}: √${b} = ${b}<sup>1/2</sup>`)}`}}
function gLogDiff(){const b=pick([2,3,5]);let m;do m=ri(2,5);while(m%b===0);const i=ri(0,2),j=ri(0,2),A=m*b**i,B=m*m*b**j;
  return{q:`Oblicz: 2log<sub>${b}</sub>${A} − log<sub>${b}</sub>${B}`,a:`${N(2*i-j)}, bo ${fr(`${A}²`,B)} = ${fH(F(A*A,B))} = ${b}<sup>${N(2*i-j)}</sup><br>${hint('2log a = log a², a log x − log y = log (x/y)')}`}}
function gExpIneq(){const B=pick([2,3]),inv=rnd()<.5,a=riNZ(-3,3),b=ri(-4,4),c=ri(-3,3),rel=pick(RELS);
  const base=inv?`(${fr(1,B)})`:''+B,val=inv?(c>=0?F(1,B**c):F(B**-c)):(c>=0?F(B**c):F(1,B**-c));
  let r=rel;const flip=x=>({'<':'>','>':'<','<=':'>=','>=':'<='})[x];if(inv)r=flip(r);if(a<0)r=flip(r);
  const t=F(c-b,a),T=fH(t),ans=r[0]==='>'?`(${T}${r==='>='?'⟩':')'}`:'';
  const sol=r[0]==='>'?`${r==='>='?'⟨':'('}${T}, +∞)`:`(${M}∞, ${T}${r==='<='?'⟩':')'}`;
  return{q:`Rozwiąż nierówność ${base}<sup>${poly([a,b])}</sup> ${REL[rel]} ${fH(val)}`,a:`x ∈ ${sol}<br>${hint(`zapisz prawą stronę jako ${base}<sup>${N(c)}</sup>${inv?'; podstawa mniejsza od 1 odwraca znak nierówności':''}`)}`}}
function setStr(pred,pts,lab=N){const ps=[...new Set(pts)].sort((a,b)=>a-b),n=ps.length,el=[];
  for(let i=0;i<=n;i++){const lo=i?ps[i-1]:ps[0]-10,hi=i<n?ps[i]:ps[n-1]+10;el.push({g:1,i,in:pred((lo+hi)/2)});if(i<n)el.push({g:0,i,in:pred(ps[i])})}
  const out=[];let k=0;while(k<el.length){if(!el[k].in){k++;continue}let j=k;while(j+1<el.length&&el[j+1].in)j++;
    const s=el[k],e=el[j];
    if(s===e&&!s.g)out.push(`{${lab(ps[s.i])}}`);
    else out.push((s.g?(s.i?`(${lab(ps[s.i-1])}`:`(${M}∞`):`⟨${lab(ps[s.i])}`)+', '+(e.g?(e.i<n?`${lab(ps[e.i])})`:'+∞)'):`${lab(ps[e.i])}⟩`));k=j+1}
  return out.length?(out.length===1&&out[0]===`(${M}∞, +∞)`?'ℝ':out.join(' ∪ ')):'∅'}
function rIv(){const[a,b]=distinct(2,-6,6).sort((x,y)=>x-y),t=ri(0,3);
  if(t===0)return{l:-Infinity,r:b,lc:0,rc:rnd()<.5};if(t===1)return{l:a,r:Infinity,lc:rnd()<.5,rc:0};return{l:a,r:b,lc:rnd()<.5,rc:rnd()<.5}}
const ivIn=(v,x)=>(x>v.l||(v.lc&&x===v.l))&&(x<v.r||(v.rc&&x===v.r));
const ivS=v=>(v.l===-Infinity?`(${M}∞`:(v.lc?'⟨':'(')+N(v.l))+', '+(v.r===Infinity?'+∞)':N(v.r)+(v.rc?'⟩':')'));
function gSets(){for(let t=0;t<20;t++){const A=rIv(),B=rIv(),ops=[['A ∩ B',x=>ivIn(A,x)&&ivIn(B,x)],['A ∪ B',x=>ivIn(A,x)||ivIn(B,x)],['A \\ B',x=>ivIn(A,x)&&!ivIn(B,x)],['B \\ A',x=>ivIn(B,x)&&!ivIn(A,x)]];
  const o=shuffle(ops).slice(0,2),pts=[A.l,A.r,B.l,B.r].filter(isFinite),res=o.map(([n,f])=>`${n} = ${setStr(f,pts)}`);if(res.some(r=>r.endsWith('∅')))continue;
  return{q:`Dane są zbiory A = ${ivS(A)} oraz B = ${ivS(B)}. Wyznacz ${o[0][0]} oraz ${o[1][0]}.`,a:res.join('<br>')+`<br>${hint('zaznacz oba zbiory na jednej osi liczbowej i uważaj na końce przedziałów')}`}}}

/* ---------- typy z informatorów CKE i matur 2023–2025 ---------- */
const fadd=(a,b)=>F(a.n*b.d+b.n*a.d,a.d*b.d),fmul=(a,b)=>F(a.n*b.n,a.d*b.d);
const money=v=>v.toFixed(2).replace('.',',');
const pct=v=>Math.abs(v-Math.round(v))<1e-9?''+Math.round(v):'≈ '+dec(v);
function gLokata(){const K=pick([1000,2000,5000,10000]),p=pick([2,3,4,5,6]),n=ri(2,4);
  return{q:`Na lokatę wpłacono ${K} zł. Oprocentowanie wynosi ${p}% w skali roku (po uwzględnieniu podatków), a odsetki są doliczane co roku zgodnie z procentem składanym. Jaka kwota będzie na lokacie po ${n} latach? Wynik zaokrąglij do 1 grosza.`,a:`${K} · ${dec(1+p/100)}<sup>${n}</sup> ≈ ${money(K*(1+p/100)**n)} zł`,
  s:[`Co roku kwota rośnie o ${p}%, czyli jest mnożona przez ${dec(1+p/100)} (odsetki liczą się też od wcześniejszych odsetek).`,`Wzór na procent składany: K<sub>n</sub> = K · (1 + ${fr('p',100)})<sup>n</sup> = ${K} · ${dec(1+p/100)}<sup>${n}</sup>.`,`${dec(1+p/100)}<sup>${n}</sup> ≈ ${(Math.round((1+p/100)**n*1e6)/1e6).toString().replace('.',',')}, więc K<sub>${n}</sub> ≈ ${money(K*(1+p/100)**n)} zł.`]}}
function gPensja(){const p=pick([10,20,25,30,40,50,60]),q=pick([10,20,25,40,50]);
  return{q:`Pensja pana X jest o ${p}% wyższa od średniej krajowej, a pensja pana Y jest o ${q}% niższa od średniej krajowej. O ile procent pensja X jest wyższa od pensji Y? O ile procent pensja Y jest niższa od pensji X?`,
  a:`X = ${dec(1+p/100)}s, Y = ${dec(1-q/100)}s<br>X jest wyższa o ${pct(100*(p+q)/(100-q))}%, Y jest niższa o ${pct(100*(p+q)/(100+p))}%`,
  s:[`Oznaczamy średnią krajową przez s. Wtedy X = ${dec(1+p/100)}s, Y = ${dec(1-q/100)}s, a różnica X − Y = ${dec((p+q)/100)}s.`,`„O ile procent X jest wyższa od Y” — porównujemy z Y: ${fr(`${dec((p+q)/100)}s`,`${dec(1-q/100)}s`)} · 100% ${pct(100*(p+q)/(100-q))[0]==='≈'?'':'= '}${pct(100*(p+q)/(100-q))}%.`,`„O ile procent Y jest niższa od X” — porównujemy z X: ${fr(`${dec((p+q)/100)}s`,`${dec(1+p/100)}s`)} · 100% ${pct(100*(p+q)/(100+p))[0]==='≈'?'':'= '}${pct(100*(p+q)/(100+p))}%.`,`Wyniki są różne, bo za każdym razem dzielimy przez inną wielkość.`]}}
function gCbrt(){const m=pick([2,3,5,6,7]),a=ri(1,4),b=ri(2,5);
  return{q:`Oblicz: ∛${a**3*m} + ∛${b**3*m}`,a:`${a+b}∛${m}<br>${hint(`∛${a**3*m} = ${a===1?'':a}∛${m}, ∛${b**3*m} = ${b}∛${m}`)}`}}
function gAbsRoot(){const n=pick([2,3,5,6,7,10,11,13]),s=Math.sqrt(n),a=Math.max(1,Math.floor(s)-ri(0,1)),b=Math.ceil(s)+ri(0,1),k=ri(2,3);
  return{q:`Oblicz: |√${n} − ${a}| − ${k}|${b} − √${n}|`,a:`${1+k}√${n} − ${a+k*b}<br>${hint(`√${n} ≈ ${dec(s)}, więc obie wartości pod modułem są dodatnie`)}`}}
function gLinIneqFrac(){const[p,q]=shuffle([2,3,4,5,6]).slice(0,2);let a,b,c,d,k;do{a=riNZ(-4,4);b=ri(-5,5);c=riNZ(-4,4);d=ri(-5,5);k=q*a-p*c}while(k===0);
  const rd=pick([1,p*q]),rn=ri(-3,3),rhs=F(rn,rd),R=F(rn*p*q/rd-q*b+p*d,k),rel=pick(RELS);let r=rel;if(k<0)r=({'<':'>','>':'<','<=':'>=','>=':'<='})[r];
  const B=fH(R),sol=r[0]==='>'?`${r==='>='?'⟨':'('}${B}, +∞)`:`(${M}∞, ${B}${r==='<='?'⟩':')'}`,R2=rn*p*q/rd;
  return{q:`Rozwiąż nierówność ${fr(poly([a,b]),p)} − ${fr(poly([c,d]),q)} ${REL[rel]} ${fH(rhs)}`,a:`x ∈ ${sol}<br>${hint(`pomnóż obie strony przez ${p*q}`)}`,
  s:[`Mnożymy obie strony przez wspólny mianownik ${p*q} (liczba dodatnia, więc znak się nie zmienia): ${q}(${poly([a,b])}) − ${p}(${poly([c,d])}) ${REL[rel]} ${N(R2)}.`,`Wymnażamy nawiasy: ${poly([q*a,q*b])} − (${poly([p*c,p*d])}) ${REL[rel]} ${N(R2)}, czyli ${poly([k,q*b-p*d])} ${REL[rel]} ${N(R2)}.`,`${lead(k,'x')} ${REL[rel]} ${N(R2-q*b+p*d)}.`,k<0?`Dzielimy przez ${N(k)} < 0, więc zmieniamy zwrot nierówności: x ${REL[r]} ${B}.`:k===1?`x ${REL[r]} ${B}.`:`Dzielimy przez ${k} > 0: x ${REL[r]} ${B}.`,`Odpowiedź: x ∈ ${sol}`]}}
function gQuadIneq2(){for(;;){const k=pick([1,2,3]),[r1,r2]=distinct(2,-4,5),c=riNZ(-4,4);if((k*r1*r2)%c)continue;const b=k*r1*r2/c,e=k*c+b+k*(r1+r2);if(!e||!b)continue;const rel=pick(RELS);
  return{q:`Rozwiąż nierówność (${poly([k,b])})(${poly([1,c])}) ${REL[rel]} ${poly([e,0])}`,a:signSolve([{v:r1},{v:r2}],1,rel)+`<br>${hint(`po uporządkowaniu: ${poly(expand([r1,r2],k))} ${REL[rel]} 0`)}`}}}
function gQuadFromAxis(){const x1=ri(-5,5);let p;do p=ri(-5,5);while(p===x1);const x2=2*p-x1,a=riNZ(-3,3);let x0;do x0=ri(-5,5);while(x0===x1||x0===x2);
  return{q:`Osią symetrii wykresu funkcji kwadratowej f jest prosta x = ${N(p)}, jednym z miejsc zerowych jest x<sub>1</sub> = ${N(x1)}, a do wykresu należy punkt (${N(x0)}, ${N(a*(x0-x1)*(x0-x2))}). Wyznacz wzór funkcji f w postaci iloczynowej i ogólnej.`,
  a:`f(x) = ${lead(a,'')}(${sh(x1)})(${sh(x2)}) = ${poly(expand([x1,x2],a))}<br>${hint(`drugie miejsce zerowe jest symetryczne względem osi: x<sub>2</sub> = ${N(x2)}`)}`,
  s:[`Miejsca zerowe paraboli leżą symetrycznie względem osi x = ${N(p)}: ${fr('x<sub>1</sub> + x<sub>2</sub>',2)} = ${N(p)}, więc x<sub>2</sub> = 2 · ${pN(p)} − ${pN(x1)} = ${N(x2)}.`,`Postać iloczynowa: f(x) = a(${sh(x1)})(${sh(x2)}).`,`Podstawiamy punkt (${N(x0)}, ${N(a*(x0-x1)*(x0-x2))}): ${N(a*(x0-x1)*(x0-x2))} = a · ${pN(x0-x1)} · ${pN(x0-x2)} = ${N((x0-x1)*(x0-x2))}a, więc a = ${N(a)}.`,`f(x) = ${lead(a,'')}(${sh(x1)})(${sh(x2)}) = ${poly(expand([x1,x2],a))}.`]}}
function gFence(){const g=pick([0,5,10]),S=12*ri(5,20),L=S-2*g;
  return{q:`Teren składa się z dwóch identycznych prostokątnych działek o wspólnym boku. Całość ogradzamy płotem, a działki rozdziela wspólny płot. Łączna długość płotu wynosi ${L} m${g?`, a w zewnętrznym ogrodzeniu będą dwie bramy, każda o szerokości ${g} m (bramy nie są częścią płotu)`:''}. Jakie wymiary powinien mieć cały teren, aby jego pole było największe? Oblicz to pole.`,
  a:`boki równoległe do płotu dzielącego: ${S/6} m, drugi wymiar całego terenu: ${S/4} m, P<sub>max</sub> = ${S*S/24} m²<br>${hint(`3x + 2y = ${S}, P(x) = x · ${fr(`${S} − 3x`,2)}`)}`,
  s:[`Niech x to długość boków równoległych do płotu dzielącego (są trzy takie odcinki), a y to drugi wymiar całego terenu (dwa odcinki).`,g?`Bramy nie są częścią płotu, więc gdyby ich nie było, płotu byłoby ${L} + 2 · ${g} = ${S} m: 3x + 2y = ${S}.`:`Długość płotu: 3x + 2y = ${S}.`,`y = ${fr(`${S} − 3x`,2)}, więc P(x) = x · ${fr(`${S} − 3x`,2)} = −1,5x² + ${S/2}x, x ∈ (0, ${S/3}).`,`To parabola z ramionami w dół; maksimum w wierzchołku: x = ${fr(`−${S/2}`,'2 · (−1,5)')} = ${S/6}.`,`y = ${fr(`${S} − ${S/2}`,2)} = ${S/4}, P<sub>max</sub> = ${S/6} · ${S/4} = ${S*S/24} m².`]}}
function gRecur(){const a1=ri(-4,4),c=riNZ(-5,5),k=pick([2,-1,3]),m=rnd()<.5;let v=a1;const vs=[a1];for(let n=1;n<4;n++){v=m?n*v+c:k*v+c;vs.push(v)}
  return{q:`Ciąg (a<sub>n</sub>) jest określony rekurencyjnie: a<sub>1</sub> = ${N(a1)}, a<sub>n+1</sub> = ${m?'n · a<sub>n</sub>':lead(k,'a<sub>n</sub>')}${term(c,'')} dla n ≥ 1. Oblicz a<sub>4</sub>.`,a:`a<sub>2</sub> = ${N(vs[1])}, a<sub>3</sub> = ${N(vs[2])}, a<sub>4</sub> = ${N(vs[3])}`}}
function gArithProof(){const p=riNZ(-6,6),q=ri(-9,9);
  return{q:`Ciąg (a<sub>n</sub>) jest określony wzorem a<sub>n</sub> = ${poly([p,q],'n')} dla n ≥ 1. Wykaż, że jest to ciąg arytmetyczny, i podaj jego różnicę.`,a:`a<sub>n+1</sub> − a<sub>n</sub> = ${N(p)}: różnica jest stała, więc ciąg jest arytmetyczny, r = ${N(p)}`}}
function gTrigObt(){let[a,b,c]=pickTriple();if(rnd()<.5)[a,b]=[b,a];
  return{q:`Kąt α spełnia warunki: sin α = ${fH(F(a,c))} oraz 90° < α < 180°. Oblicz cos α oraz tg α.`,a:`cos α = ${M}${fH(F(b,c))}, tg α = ${M}${fH(F(a,b))}<br>${hint('w II ćwiartce cosinus i tangens są ujemne')}`,
  s:[`Z jedynki trygonometrycznej: cos²α = 1 − sin²α = 1 − ${fr(a*a,c*c)} = ${fr(b*b,c*c)}, więc |cos α| = ${fH(F(b,c))}.`,`Kąt jest rozwarty (II ćwiartka), więc cos α < 0: cos α = ${M}${fH(F(b,c))}.`,`tg α = ${fr('sin α','cos α')} = ${fr(fH(F(a,c)),M+fH(F(b,c)))} = ${M}${fH(F(a,b))}.`]}}
function gMedian(){const c=ri(4,12),a=2*ri(2,6),B=pick([60,120]),h=a/2,d2=c*c+h*h+(B===60?-1:1)*c*h;
  return{q:`W trójkącie ABC: |AB| = ${c}, |BC| = ${a}, |∢ABC| = ${B}°. Oblicz długość środkowej AD poprowadzonej z wierzchołka A.`,a:`|AD| = ${sq(d2)}<br>${hint(`D jest środkiem BC, |BD| = ${h}; twierdzenie cosinusów w trójkącie ABD`)}`}}
function gSinSmall(){for(;;){const[a,b,c]=distinct(3,2,9).sort((x,y)=>x-y);if(a+b<=c)continue;const cs=F(b*b+c*c-a*a,2*b*c),{k,m}=simp(cs.d*cs.d-cs.n*cs.n);
  return{q:`Trójkąt ma boki długości ${a}, ${b} i ${c}. Oblicz sinus najmniejszego kąta tego trójkąta.`,a:`cos α = ${fH(cs)}, sin α = ${fsq(F(k,cs.d),m)}<br>${hint(`najmniejszy kąt leży naprzeciw boku ${a}; twierdzenie cosinusów, potem jedynka trygonometryczna`)}`}}}
function gIncircleRight(){const k=ri(1,3),[a,b,c]=pickTriple(k===1?65:k===2?41:29).map(v=>v*k);
  return{q:`Trójkąt prostokątny ma przyprostokątne długości ${a} i ${b}. Oblicz promienie okręgów wpisanego w ten trójkąt i opisanego na nim.`,a:`c = ${c}, r = ${fH(F(a+b-c,2))}, R = ${fH(F(c,2))}<br>${hint('r = (a + b − c)/2, R = c/2')}`,
  s:[`Przeciwprostokątna z twierdzenia Pitagorasa: c = √(${a}² + ${b}²) = √${c*c} = ${c}.`,`W trójkącie prostokątnym promień okręgu wpisanego: r = ${fr('a + b − c',2)} = ${fr(`${a} + ${b} − ${c}`,2)} = ${fH(F(a+b-c,2))}. (Albo z pola: r = ${fr('2P','a + b + c')} = ${fr(a*b,a+b+c)}.)`,`Środek okręgu opisanego to środek przeciwprostokątnej, więc R = ${fr('c',2)} = ${fH(F(c,2))}.`]}}
function gCentroid(){const t=ri(2,18);return rnd()<.5?{q:`Punkt S jest środkiem ciężkości trójkąta ABC, a |SA| = ${2*t}. Oblicz długość środkowej trójkąta poprowadzonej z wierzchołka A.`,a:`${3*t}<br>${hint('środek ciężkości dzieli środkową w stosunku 2 : 1, licząc od wierzchołka')}`}
  :{q:`Środkowa AD trójkąta ABC ma długość ${3*t}. Oblicz odległość środka ciężkości S tego trójkąta od wierzchołka A i od punktu D.`,a:`|AS| = ${2*t}, |SD| = ${t}`}}
function gTangentChord(){const al=ri(20,80);
  return{q:`Prosta k jest styczna do okręgu o środku S w punkcie A. Cięciwa AB tworzy z prostą k kąt ostry o mierze ${al}°. Punkt C leży na okręgu, a kąt wpisany ACB jest ostry. Oblicz miary kątów ACB i ASB.`,a:`|∢ACB| = ${al}°, |∢ASB| = ${2*al}°<br>${hint('kąt między styczną a cięciwą jest równy kątowi wpisanemu opartemu na tej cięciwie')}`}}
function gIsoOx(){for(;;){const p=ri(-5,5),u=riNZ(-6,6),v=riNZ(-6,6);if(Math.abs(u)===Math.abs(v))continue;const A=[p+u,v],B=pick([[p+v,u],[p-v,-u],[p-u,v]]);if(A[0]===B[0])continue;
  return{q:`Punkty A = (${N(A[0])}, ${N(A[1])}) i B = (${N(B[0])}, ${N(B[1])}) są wierzchołkami trójkąta równoramiennego ABP, w którym |AP| = |BP|. Wierzchołek P leży na osi Ox. Wyznacz współrzędne punktu P.`,a:`P = (${N(p)}, 0)<br>${hint('P = (x, 0); z warunku |AP|² = |BP|² dostajesz równanie liniowe')}`}}}
function gDiagInter(){for(;;){const S=[ri(-4,4),ri(-4,4)],d1=[riNZ(-3,3),ri(-3,3)],d2=[ri(-3,3),riNZ(-3,3)];if(d1[0]*d2[1]-d1[1]*d2[0]===0)continue;
  const t=[ri(1,3),ri(1,3),ri(1,3),ri(1,3)],P=(s,d,k)=>`(${N(S[0]+s*k*d[0])}, ${N(S[1]+s*k*d[1])})`;
  return{q:`Punkty A = ${P(-1,d1,t[0])}, B = ${P(-1,d2,t[1])}, C = ${P(1,d1,t[2])} i D = ${P(1,d2,t[3])} są wierzchołkami czworokąta ABCD. Oblicz współrzędne punktu przecięcia przekątnych tego czworokąta.`,a:`S = (${N(S[0])}, ${N(S[1])})<br>${hint('wyznacz równania prostych AC i BD i rozwiąż układ')}`}}}
function gSimilarSolids(){const k=ri(2,5),P=ri(5,40);
  return{q:`Dwa prostopadłościany są podobne. Objętość drugiego jest ${k**3} razy większa od objętości pierwszego. Pole powierzchni całkowitej pierwszego jest równe ${P}. Oblicz pole powierzchni całkowitej drugiego.`,a:`skala k = ${k}, P<sub>2</sub> = ${k*k} · ${P} = ${k*k*P}<br>${hint('stosunek objętości to k³, stosunek pól to k²')}`}}
function gPyrAngle(){const al=pick([30,45,60]),t=ri(1,10);let a,V,Pc;
  if(al===30){a=fsq(2*t,3);V=''+4*t**3;Pc=`${12*t*t} + ${8*t*t}√3`}else if(al===45){a=''+2*t;V=fH(F(4*t**3,3));Pc=`${4*t*t} + ${4*t*t}√2`}else{a=''+2*t;V=fsq(F(4*t**3,3),3);Pc=''+12*t*t}
  return{q:`Ściana boczna ostrosłupa prawidłowego czworokątnego jest nachylona do płaszczyzny podstawy pod kątem ${al}°, a krawędź podstawy ma długość ${a}. Oblicz objętość i pole powierzchni całkowitej tego ostrosłupa.`,a:`V = ${V}, P<sub>c</sub> = ${Pc}<br>${hint(`trójkąt prostokątny: wysokość ostrosłupa, połowa krawędzi podstawy i wysokość ściany bocznej, kąt ${al}° przy podstawie`)}`}}
function gCylinder(){const r=ri(1,6),h=ri(2,10);
  return{q:`Pole powierzchni bocznej walca jest równe ${2*r*h}π, a promień jego podstawy ma długość ${r}. Oblicz wysokość, objętość i pole powierzchni całkowitej walca.`,a:`h = ${h}, V = ${r*r*h}π, P<sub>c</sub> = ${2*r*(r+h)}π`,
  s:[`Powierzchnia boczna walca to prostokąt o bokach 2πr i h: P<sub>b</sub> = 2πrh.`,`2π · ${r} · h = ${2*r*h}π, więc h = ${fr(2*r*h,2*r)} = ${h}.`,`V = πr²h = π · ${r*r} · ${h} = ${r*r*h}π.`,`P<sub>c</sub> = 2πr² + P<sub>b</sub> = ${2*r*r}π + ${2*r*h}π = ${2*r*(r+h)}π.`]}}
function digitPool(n){const S=ri(n+2,9*n-6),dg=pick([2,7]);return[
  ['parzystych','parzystą',x=>x%2===0],['podzielnych przez 5','podzielną przez 5',x=>x%5===0],['o różnych cyfrach','o różnych cyfrach',x=>{const s=''+x;return new Set(s).size===s.length}],
  ['o wszystkich cyfrach nieparzystych','o wszystkich cyfrach nieparzystych',x=>[...''+x].every(c=>c%2===1)],
  [`w których zapisie cyfra ${dg} występuje dokładnie raz`,`w której zapisie cyfra ${dg} występuje dokładnie raz`,x=>[...''+x].filter(c=>c===''+dg).length===1],
  [`o sumie cyfr równej ${S}`,`o sumie cyfr równej ${S}`,x=>[...''+x].reduce((s,c)=>s+ +c,0)===S]]}
function gProbDigits(n=pick([3,4])){const W={3:'trzycyfrowych',4:'czterocyfrowych'};for(let t=0;t<30;t++){const pool=digitPool(n),cs=shuffle(pool).slice(0,ri(1,2)).sort((a,b)=>a[1].startsWith('w ')-b[1].startsWith('w '));
  let k=0;for(let x=10**(n-1);x<10**n;x++)if(cs.every(c=>c[2](x)))k++;if(!k)continue;const all=9*10**(n-1);
  return{q:`Spośród wszystkich liczb ${W[n]} losujemy jedną. Oblicz prawdopodobieństwo, że wylosujemy liczbę${cs.map((c,i)=>(i||c[1].startsWith('w ')?(c[1].startsWith('w ')?', ':' i '):' ')+c[1]).join('')}.`,a:`P = ${fr(k,all)}${F(k,all).d!==all?' = '+fH(F(k,all)):''}`}}}
function gBraille(){const n=ri(4,8);return rnd()<.5?{q:`Znak kodu tworzy ${n} ${pl(n,'pole','pola','pól')}, z których każde może być wypukłe lub płaskie. Znak musi mieć co najmniej jedno pole wypukłe. Ile różnych znaków można utworzyć?`,a:`2<sup>${n}</sup> − 1 = ${2**n-1}`}
  :(k=>({q:`Znak kodu tworzy ${n} pól, z których każde może być wypukłe lub płaskie. Ile jest znaków, w których dokładnie ${k} pola są wypukłe?`.replace(`${k} pola są`,k===1?'1 pole jest':k<5?`${k} pola są`:`${k} pól jest`),a:`C(${n}, ${k}) = ${C(n,k)}`}))(ri(1,n-1))}
function gReplace(){const n=ri(5,9);const E=pick([['pierwsza wylosowana liczba będzie większa od drugiej',(x,y)=>x>y],['suma wylosowanych liczb będzie parzysta',(x,y)=>(x+y)%2===0],['iloczyn wylosowanych liczb będzie podzielny przez 3',(x,y)=>x*y%3===0],['obie wylosowane liczby będą różne',(x,y)=>x!==y]]);
  let k=0;for(let x=1;x<=n;x++)for(let y=1;y<=n;y++)if(E[1](x,y))k++;
  return{q:`Ze zbioru {1, 2, …, ${n}} losujemy ze zwracaniem kolejno dwa razy po jednej liczbie. Oblicz prawdopodobieństwo, że ${E[0]}.`,a:`P = ${fr(k,n*n)}${F(k,n*n).d!==n*n?' = '+fH(F(k,n*n)):''}`}}
function gModProof(){const mm=pick([3,5,7]),a=ri(1,4),b=mm*ri(1,2);let c=mm*ri(1,3)-a*a;while(c<=0)c+=mm;let d,rem;do{d=ri(-20,20);rem=((b*b+d)%mm+mm)%mm}while(!rem);
  return{q:`Wykaż, że dla każdej liczby całkowitej n liczba (${poly([a,b],'n')})²${term(c,'n²')}${term(d,'')} przy dzieleniu przez ${mm} daje resztę ${rem}.`,
  a:hint(`po wymnożeniu: ${poly([a*a+c,2*a*b,b*b+d],'n')} = ${mm}(${poly([(a*a+c)/mm,2*a*b/mm,(b*b+d-rem)/mm],'n')})${rem?' + '+rem:''}`)}}
function gPowProof(){const b=pick([2,3,5]),j=ri(1,4),e=3*(2*j+1);
  return{q:`Wykaż, że liczba ${b}<sup>${e+2}</sup> + ${b*b}<sup>${(e+1)/2}</sup> + ${b**3}<sup>${e/3}</sup> jest podzielna przez ${b*b+b+1}.`,a:hint(`zapisz wszystko jako potęgi ${b}: ${b}<sup>${e+2}</sup> + ${b}<sup>${e+1}</sup> + ${b}<sup>${e}</sup> = ${b}<sup>${e}</sup>(${b*b} + ${b} + 1) = ${b*b+b+1} · ${b}<sup>${e}</sup>`)}}
/* rozszerzenie */
function gLogExpr2(){const b=pick([2,3,5,7]),c=pick([3,5,6,7,10,11].filter(x=>x!==b)),k=ri(1,4);
  return{q:`Oblicz: log<sub>√${b}</sub>${c} · log<sub>${c}</sub>${b**k}`,a:`${2*k}<br>${hint(`log<sub>√${b}</sub>${c} = 2log<sub>${b}</sub>${c}, a log<sub>${b}</sub>${c} · log<sub>${c}</sub>${b} = 1`)}`}}
function gLattice(){const a=riNZ(-4,4),c=riNZ(-6,6),D=pick([4,6,8,9,10,12,15])*sg(),b=D-a*c,ds=[];for(let d=1;d<=Math.abs(D);d++)if(D%d===0)ds.push(d,-d);
  const pts=ds.map(d=>[c+d,a+D/d]).sort((p,q)=>p[0]-q[0]);
  return{q:`Funkcja f jest określona wzorem f(x) = ${fr(poly([a,b]),sh(c))} dla x ≠ ${N(c)}. Wyznacz wszystkie punkty kratowe (o obu współrzędnych całkowitych) należące do wykresu tej funkcji.`,
  a:pts.map(p=>`(${N(p[0])}, ${N(p[1])})`).join(', ')+`<br>${hint(`f(x) = ${N(a)} + ${fr(N(D),sh(c))}, więc ${sh(c)} musi być dzielnikiem liczby ${N(D)}`)}`}}
function gPolyOneRoot(){const s=ri(1,4),mode=ri(0,2);let r;if(mode===0)r=s;else if(mode===1)r=-s;else do r=ri(-5,5);while(Math.abs(r)===s);
  const ans=r===s?`m ∈ ⟨${M}${s}, ${s})`:r===-s?`m ∈ (${M}${s}, ${s}⟩`:`m ∈ (${M}${s}, ${s})`;
  return{q:`Wielomian W jest określony wzorem W(x) = (${sh(r)})(x² + 2mx + ${s*s}). Wyznacz wszystkie wartości parametru m, dla których wielomian W ma dokładnie jeden pierwiastek rzeczywisty.`,
  a:ans+`<br>${hint(`trójmian nie może mieć pierwiastków (Δ < 0) albo jego jedyny pierwiastek podwójny musi być równy ${N(r)} (sprawdź Δ = 0)`)}`}}
function gDarboux(){for(;;){const cs=[pick([1,-1,2]),ri(-5,5),ri(-6,6),ri(-6,6)];for(let a=-3;a<=3;a++){const u=ev(cs,a),v=ev(cs,a+1);if(u*v<0)
  return{q:`Wykaż, że równanie ${poly(cs)} = 0 ma rozwiązanie w przedziale (${N(a)}, ${N(a+1)}).`,a:hint(`W(${N(a)}) = ${N(u)}, W(${N(a+1)}) = ${N(v)}; wartości mają przeciwne znaki, a wielomian jest funkcją ciągłą, więc z własności Darboux ma pierwiastek w tym przedziale`)}}}}
function gRootsDiff(){let t,d;do{t=ri(2,9);d=ri(1,t-1)}while((t-d)%2);const c=(t*t-d*d)/4;
  return{q:`Wyznacz wszystkie wartości parametru m, dla których równanie x² + mx${term(c,'')} = 0 ma dwa rozwiązania różniące się o ${d}.`,a:`m = ${M}${t} lub m = ${t}<br>${hint('|x<sub>1</sub> − x<sub>2</sub>| = √Δ, więc m² − '+(4*c)+' = '+(d*d))}`}}
function gSumSqParam(){const t=ri(2,6);let c;do c=ri(-5,Math.floor((t*t-1)/4));while(!c);
  return{q:`Wyznacz wszystkie wartości parametru m, dla których równanie x² + mx${term(c,'')} = 0 ma dwa różne rozwiązania x<sub>1</sub>, x<sub>2</sub> spełniające warunek x<sub>1</sub>² + x<sub>2</sub>² = ${t*t-2*c}.`,a:`m = ${M}${t} lub m = ${t}<br>${hint(`x<sub>1</sub>² + x<sub>2</sub>² = m²${term(-2*c,'')}; sprawdź warunek Δ = m²${term(-4*c,'')} > 0`)}`}}
function gParamLines(){const a=ri(-4,4),b=ri(-6,6),lo=Math.max(-a,-b/2);
  return{q:`Proste o równaniach x + y − 3m${term(-(a+b),'')} = 0 oraz 2x − y${term(-(2*a-b),'')} = 0 przecinają się w punkcie P. Wyznacz współrzędne P w zależności od m oraz wszystkie wartości m, dla których obie współrzędne P są dodatnie.`,
  a:`P = (${poly([1,a],'m')}, ${poly([2,b],'m')}), m ∈ (${fH(F(Math.round(lo*2),2))}, +∞)`}}
function gMonoProof(){let a,b,c,D;do{a=riNZ(-5,5);b=ri(-6,6);c=ri(-4,4);D=a*c-b}while(!D);
  return{q:`Wykaż, że funkcja f(x) = ${fr(poly([a,b]),poly([1,c]))} jest ${D>0?'rosnąca':'malejąca'} w przedziale (${N(-c)}, +∞).`,a:hint(`f'(x) = ${fr(N(D),c?`(${poly([1,c])})²`:'x²')} ${D>0?'> 0':'< 0'} dla każdego x z tego przedziału`)}}
function gLimRoot(){const[a,b]=distinct(2,2,9).sort((x,y)=>x-y);
  return{q:`Oblicz granicę: lim<sub>n→∞</sub> <sup>n</sup>√<span class="ov">${a}<sup>n</sup> + ${b}<sup>n</sup></span>`,a:`${b}<br>${hint(`${b}<sup>n</sup> ≤ ${a}<sup>n</sup> + ${b}<sup>n</sup> ≤ 2 · ${b}<sup>n</sup>; twierdzenie o trzech ciągach`)}`}}
function gLimParam(){const L=riNZ(-4,4),k=riNZ(-5,5),c=ri(-6,6),d=ri(-6,6),e=pick([1,2,3]),f=riNZ(-5,5);
  return{q:`Wyznacz wartość parametru p, dla której lim<sub>n→∞</sub> ${fr(`(p${term(-k,'')})n²${term(c,'n')}${term(d,'')}`,poly([e,0,f],'n'))} = ${N(L)}.`,a:`p = ${N(e*L+k)}<br>${hint(`granica jest równa ${fr(`p${term(-k,'')}`,e)}`)}`}}
function gProfit(){const c=ri(5,30),A=c+2*ri(10,40),F0=pick([500,1000,2000]),Q=5*(A-c);
  return{q:`Cena jednostkowa produktu zależy od liczby Q sprzedanych sztuk: P(Q) = ${A} − 0,1Q dla Q ∈ ⟨0, ${10*A}⟩. Koszt wytworzenia Q sztuk wynosi K(Q) = ${c}Q + ${F0}. Ile sztuk należy sprzedać, aby zysk był największy? Oblicz ten zysk i cenę jednostkową.`,
  a:`Q = ${Q}, zysk = ${dec(2.5*(A-c)**2-F0)}, cena = ${dec((A+c)/2)}<br>${hint(`Z(Q) = Q · P(Q) − K(Q) = −0,1Q² + ${A-c}Q − ${F0}`)}`}}
function gMotion(){const a=3*ri(2,6),b=ri(10,120);
  return{q:`Położenie ciała opisuje wzór s(t) = −t³ + ${a}t² + ${b}t dla t ∈ ⟨0, ${a}⟩ (t w godzinach, s w km). W której chwili prędkość ciała v(t) = s'(t) jest największa? Oblicz tę prędkość.`,a:`t = ${a/3} h, v<sub>max</sub> = ${a*a/3+b} km/h<br>${hint(`v(t) = −3t² + ${2*a}t + ${b}; wierzchołek paraboli`)}`}}
function gQuarticMin(){const k=ri(1,4),c=ri(-20,20);
  return{q:`Oblicz najmniejszą wartość funkcji f(x) = x⁴ − ${2*k*k}x²${term(c,'')}.`,a:`f<sub>min</sub> = f(±${k}) = ${N(c-k**4)}<br>${hint(`f'(x) = 4x³ − ${4*k*k}x = 4x(x − ${k})(x + ${k})`)}`}}
function gGeomOddEven(){const q=F(...pick([[1,2],[1,3],[-1,2],[2,3],[-1,3],[1,4]])),a1=ri(1,9),S=F(a1*q.d,q.d-q.n),So=F(a1*q.d*q.d,q.d*q.d-q.n*q.n);
  return{q:`Nieskończony ciąg geometryczny ma sumę wszystkich wyrazów równą ${fH(S)}, a suma jego wyrazów o numerach nieparzystych jest równa ${fH(So)}. Wyznacz pierwszy wyraz i iloraz tego ciągu.`,a:`a<sub>1</sub> = ${a1}, q = ${fH(q)}<br>${hint(`S = ${fr('a<sub>1</sub>','1 − q')}, S<sub>niep</sub> = ${fr('a<sub>1</sub>','1 − q²')}, więc S : S<sub>niep</sub> = 1 + q`)}`}}
function gArithGeom(){for(;;){const a=riNZ(-4,6),k=pick([2,3,-2]),kk=ri(-5,5),b=a*k-kk,r=b-a,c=b+r,m=a*k*k-c,r2=-m-r;if(!r||!b)continue;
  const sols=[[a,b,c]];if(r2!==r)sols.push([b-r2,b,b+r2]);
  return{q:`Liczby a, b, c, których suma jest równa ${N(3*b)}, tworzą w podanej kolejności ciąg arytmetyczny. Liczby a, b${term(kk,'')}, c${term(m,'')} tworzą w podanej kolejności ciąg geometryczny. Wyznacz liczby a, b, c.`,
  a:sols.map(s=>`(${s.map(N).join(', ')})`).join(' lub ')+`<br>${hint(`b = ${N(b)}, a = b − r, c = b + r; warunek (b${term(kk,'')})² = a(c${term(m,'')})`)}`}}}
function gTangentLines(){const t=pick([[3,4,5],[4,3,5]]),A=t[0]*sg(),B=t[1]*sg(),a=ri(-4,4),b=ri(-4,4),r=ri(1,4),C0=-A*a-B*b;
  const L=C=>`${lead(A,'x')}${term(B,'y')}${term(C,'')} = 0`;
  return{q:`Wyznacz równania stycznych do okręgu ${sqT(a)} + ${sqT(b,'y')} = ${r*r}, równoległych do prostej ${lead(A,'x')}${term(B,'y')} = 0.`,a:`${L(C0-5*r)} oraz ${L(C0+5*r)}<br>${hint(`szukana prosta ${lead(A,'x')}${term(B,'y')} + C = 0 ma odległość ${r} od środka okręgu`)}`}}
function gTriArea(){for(;;){const P=[0,0,0,0,0,0].map(()=>ri(-6,6)),u=[P[2]-P[0],P[3]-P[1]],v=[P[4]-P[0],P[5]-P[1]],d=u[0]*v[1]-u[1]*v[0];if(!d)continue;
  return{q:`Oblicz pole trójkąta o wierzchołkach A = (${N(P[0])}, ${N(P[1])}), B = (${N(P[2])}, ${N(P[3])}), C = (${N(P[4])}, ${N(P[5])}).`,a:`P = ${fH(F(Math.abs(d),2))}<br>${hint(`wektory AB = [${N(u[0])}, ${N(u[1])}], AC = [${N(v[0])}, ${N(v[1])}], P = ½|det(AB, AC)|`)}`}}}
function gParaVec(){for(;;){const v=[riNZ(-9,9),ri(-9,9)],w=[ri(-9,9),riNZ(-9,9)],d=v[0]*w[1]-v[1]*w[0];if(!d)continue;const s=[v[0]+w[0],v[1]+w[1]];
  return{q:`Czworokąt ABCD jest równoległobokiem, w którym wektor AB = [${N(v[0])}, ${N(v[1])}], a wektor AD = [${N(w[0])}, ${N(w[1])}]. Oblicz pole tego równoległoboku i długość przekątnej AC.`,a:`P = |det(AB, AD)| = ${Math.abs(d)}, |AC| = ${sq(s[0]**2+s[1]**2)}<br>${hint('wektor AC = AB + AD')}`}}}
const QUADS=(()=>{const o=[];for(let a=1;a<=12;a++)for(let b=a;b<=12;b++)for(let c=1;c<=14;c++){const d=Math.round(Math.sqrt(a*a+b*b+c*c));if(d*d===a*a+b*b+c*c&&gcd(gcd(a,b),gcd(c,d))===1)o.push([a,b,c,d])}return o})();
function gCuboidDiag(){const[a,b,c,d]=pick(QUADS),k=ri(1,2);
  return{q:`Prostopadłościan ma krawędzie podstawy ${a*k} i ${b*k} oraz wysokość ${c*k}. Oblicz długość przekątnej prostopadłościanu oraz sinus i cosinus kąta nachylenia tej przekątnej do płaszczyzny podstawy.`,a:`d = ${d*k}, sin α = ${fH(F(c,d))}, cos α = ${fsq(F(simp(a*a+b*b).k,d),simp(a*a+b*b).m)}`}}
function gBernoulliN(){const p=pick([.2,.3,.4,.5]),thr=pick([.9,.95,.99]);let n=1;while(1-(1-p)**n<=thr)n++;
  return{q:`Prawdopodobieństwo wygrania jednej partii wynosi ${dec(p)}, a wyniki kolejnych partii są niezależne. Ile co najmniej partii trzeba rozegrać, aby prawdopodobieństwo wygrania co najmniej jednej z nich było większe od ${dec(thr)}?`,
  a:`n = ${n}<br>${hint(`1 − ${dec(1-p)}<sup>n</sup> > ${dec(thr)}; ${dec(1-p)}<sup>${n-1}</sup> ≈ ${(1-p)**(n-1)>=1e-4?(Math.round((1-p)**(n-1)*1e4)/1e4).toString().replace('.',','):'0'}, ${dec(1-p)}<sup>${n}</sup> ≈ ${(Math.round((1-p)**n*1e4)/1e4).toString().replace('.',',')}`)}`}}
function gBayes(){const pr=pick([.002,.01,.02,.05]),se=pick([.9,.95,.99]),sp=pick([.9,.95,.98]),pp=pr*se+(1-pr)*(1-sp),d4=v=>v.toFixed(4).replace('.',',');
  return{q:`Pewna choroba dotyka ${dec(pr*100)}% populacji. Test daje wynik pozytywny u osoby chorej z prawdopodobieństwem ${dec(se)}, a wynik negatywny u osoby zdrowej z prawdopodobieństwem ${dec(sp)}. Oblicz prawdopodobieństwo, że test losowo wybranej osoby da wynik pozytywny, oraz prawdopodobieństwo, że osoba z wynikiem pozytywnym jest chora.`,
  a:`P(+) = ${dec(pr)} · ${dec(se)} + ${dec(1-pr)} · ${dec(1-sp)} ≈ ${d4(pp)}<br>P(chory | +) ≈ ${d4(pr*se/pp)} (ok. ${dec(100*pr*se/pp)}%)<br>${hint('prawdopodobieństwo całkowite, potem wzór Bayesa')}`}}
function gUrns(){const w1=ri(1,6),b1=ri(1,6),w2=ri(1,6),b2=ri(1,6),k=ri(1,5),pI=F(k,6),pII=F(6-k,6),PA=fadd(fmul(pI,F(w1,w1+b1)),fmul(pII,F(w2,w2+b2))),PB=fmul(pI,F(w1,w1+b1));
  return{q:`W urnie I są kule: ${w1} ${pl(w1,'biała','białe','białych')} i ${b1} ${pl(b1,'czarna','czarne','czarnych')}, a w urnie II: ${w2} ${pl(w2,'biała','białe','białych')} i ${b2} ${pl(b2,'czarna','czarne','czarnych')}. Rzucamy kostką: jeśli wypadnie co najwyżej ${k} ${k===1?'oczko':k<5?'oczka':'oczek'}, losujemy kulę z urny I, w przeciwnym razie z urny II. Oblicz prawdopodobieństwo wylosowania kuli białej oraz prawdopodobieństwo, że kula pochodziła z urny I, jeśli wiadomo, że jest biała.`,
  a:`P(B) = ${fH(PA)}, P(I | B) = ${fH(F(PB.n*PA.d,PB.d*PA.n))}`}}
function gNoReplace(){const w=ri(2,7),c=ri(2,7),n=w+c,T=C(n,2),E=pick([['wylosujemy kule różnych kolorów',w*c],['obie kule będą białe',C(w,2)],['co najmniej jedna kula będzie biała',T-C(c,2)]]);
  return{q:`W urnie są kule: ${w} ${pl(w,'biała','białe','białych')} i ${c} ${pl(c,'czarna','czarne','czarnych')}. Losujemy jednocześnie dwie kule. Oblicz prawdopodobieństwo, że ${E[0]}.`,a:`P = ${fr(E[1],T)}${F(E[1],T).d!==T?' = '+fH(F(E[1],T)):''}`}}
function gGridPaths(){const m=ri(3,6),n=ri(2,5);if(rnd()<.5)return{q:`Siatka ulic tworzy prostokąt złożony z ${m} × ${n} kwartałów. Samochód jedzie z lewego dolnego rogu A do prawego górnego rogu B, poruszając się tylko w prawo lub w górę. Ile jest takich tras?`,a:`C(${m+n}, ${m}) = ${C(m+n,m)}`};
  const i=ri(1,m-1),j=ri(1,n-1);return{q:`Siatka ulic tworzy prostokąt złożony z ${m} × ${n} kwartałów. Samochód jedzie z lewego dolnego rogu A do prawego górnego rogu B, poruszając się tylko w prawo lub w górę. Ile jest tras przechodzących przez skrzyżowanie położone ${i} ${i===1?'kwartał':i<5?'kwartały':'kwartałów'} na prawo i ${j} ${j===1?'kwartał':'kwartały'} w górę od A?`,a:`C(${i+j}, ${i}) · C(${m-i+n-j}, ${m-i}) = ${C(i+j,i)*C(m-i+n-j,m-i)}`}}

/* ---------- wykresy funkcji ---------- */
function plot(series,cap=''){const xs=[0],ys=[0];series.forEach(s=>s.pts.forEach(([x,y])=>{xs.push(x);ys.push(y)}));
  const x0=Math.floor(Math.min(...xs))-1,x1=Math.ceil(Math.max(...xs))+1,y0=Math.floor(Math.min(...ys))-1,y1=Math.ceil(Math.max(...ys))+1;
  const u=Math.min(26,330/(x1-x0)),W=(x1-x0)*u,H=(y1-y0)*u,X=x=>f1((x-x0)*u),Y=y=>f1((y1-y)*u);let g='';
  for(let x=x0;x<=x1;x++)g+=`<line class="gr" x1="${X(x)}" y1="0" x2="${X(x)}" y2="${f1(H)}"/>`;
  for(let y=y0;y<=y1;y++)g+=`<line class="gr" x1="0" y1="${Y(y)}" x2="${f1(W)}" y2="${Y(y)}"/>`;
  g+=`<line class="ax" x1="0" y1="${Y(0)}" x2="${f1(W)}" y2="${Y(0)}"/><line class="ax" x1="${X(0)}" y1="${f1(H)}" x2="${X(0)}" y2="0"/>`;
  for(let x=x0+1;x<x1;x++)if(x)g+=`<text class="tk" x="${X(x)}" y="${f1(+Y(0)+12)}">${N(x)}</text>`;
  for(let y=y0+1;y<y1;y++)if(y)g+=`<text class="tk" x="${f1(+X(0)-8)}" y="${f1(+Y(y)+3.5)}">${N(y)}</text>`;
  g+=`<text class="tk" x="${f1(+X(0)-7)}" y="${f1(+Y(0)+12)}">0</text><text x="${f1(W-6)}" y="${f1(+Y(0)-6)}">x</text><text x="${f1(+X(0)+10)}" y="10">y</text>`;
  series.forEach(s=>{g+=`<polyline class="${s.cls||'fn'}" points="${s.pts.map(([x,y])=>X(x)+','+Y(y)).join(' ')}"/>`;(s.dots||[]).forEach(([x,y,open])=>{g+=`<circle class="${open?'od':'cd'}" cx="${X(x)}" cy="${Y(y)}" r="3.4"/>`})});
  return `<figure class="fg"><svg viewBox="-14 -14 ${f1(W+28)} ${f1(H+28)}" role="img" aria-label="wykres funkcji">${g}</svg>${cap?`<figcaption>${cap}</figcaption>`:''}</figure>`}
function rndPL(zero){for(;;){const n=ri(4,6),xs=[ri(-6,-2)];while(xs.length<n)xs.push(xs[xs.length-1]+ri(1,3));if(xs[n-1]>7)continue;if(zero&&!xs.includes(0))continue;
  const ys=xs.map(()=>ri(-4,4));let ok=ys.some(y=>y>0)&&ys.some(y=>y<0);for(let i=0;i+1<n;i++)if(ys[i]===ys[i+1]||ys[i]*ys[i+1]<0)ok=false;if(ok)return xs.map((x,i)=>[x,ys[i]])}}
const plv=(p,x)=>{for(let i=0;i+1<p.length;i++){const[a,b]=p[i],[c,d]=p[i+1];if(x>=a&&x<=c)return b+(d-b)*(x-a)/(c-a)}return NaN};
function plInfo(p){const xs=p.map(q=>q[0]),ys=p.map(q=>q[1]),x0=xs[0],xn=xs[xs.length-1],mn=Math.min(...ys),mx=Math.max(...ys),z=p.filter(q=>q[1]===0).map(q=>q[0]);
  const pos=setStr(x=>x>=x0&&x<=xn&&plv(p,x)>0,xs),neg=setStr(x=>x>=x0&&x<=xn&&plv(p,x)<=0,xs);
  const mono=[];p.slice(1).forEach((q,i)=>{const s=Math.sign(q[1]-p[i][1]),L=mono[mono.length-1];if(L&&L.s===s)L.b=q[0];else mono.push({s,a:p[i][0],b:q[0]})});
  return{D:`⟨${N(x0)}, ${N(xn)}⟩`,ZW:`⟨${N(mn)}, ${N(mx)}⟩`,z:z.length?z.map(N).join(', '):'brak',pos,neg,mx,mn,
    xmax:p.filter(q=>q[1]===mx).map(q=>N(q[0])).join(' i '),xmin:p.filter(q=>q[1]===mn).map(q=>N(q[0])).join(' i '),
    up:mono.filter(m=>m.s>0).map(m=>`⟨${N(m.a)}, ${N(m.b)}⟩`).join(', '),down:mono.filter(m=>m.s<0).map(m=>`⟨${N(m.a)}, ${N(m.b)}⟩`).join(', ')}}
const dotsOf=p=>[[...p[0]],[...p[p.length-1]]];
function gGraphRead(){const p=rndPL(),I=plInfo(p);
  return{q:`Na rysunku przedstawiono wykres funkcji f. Odczytaj z wykresu: dziedzinę, zbiór wartości, miejsca zerowe, zbiór rozwiązań nierówności f(x) > 0, przedziały monotoniczności oraz największą wartość funkcji.${plot([{pts:p,dots:dotsOf(p)}])}`,
  a:`D = ${I.D}, ZW = ${I.ZW}, miejsca zerowe: ${I.z}<br>f(x) > 0 dla x ∈ ${I.pos}<br>rosnąca w: ${I.up||'—'}; malejąca w: ${I.down||'—'}<br>f<sub>max</sub> = ${N(I.mx)} dla x = ${I.xmax}`}}
function transformT(ext){const kinds=ext?['shift','abs','absx','shiftneg']:['shift','neg','mirror','shift'],k=pick(kinds),p0=rndPL(k==='absx');let g,lab;const P=ri(-3,3),Q=ri(-3,3);
  if(k==='shift'){g=p0.map(([x,y])=>[x+P,y+Q]);lab=`g(x) = f(${sh(P)})${term(Q,'')}`}
  else if(k==='neg'){g=p0.map(([x,y])=>[x,-y]);lab='g(x) = −f(x)'}
  else if(k==='mirror'){g=p0.map(([x,y])=>[-x,y]).reverse();lab='g(x) = f(−x)'}
  else if(k==='abs'){g=p0.map(([x,y])=>[x,Math.abs(y)]);lab='g(x) = |f(x)|'}
  else if(k==='shiftneg'){g=p0.map(([x,y])=>[x+P,-y+Q]);lab=`g(x) = −f(${sh(P)})${term(Q,'')}`}
  else{const pos=p0.filter(q=>q[0]>=0);g=[...pos.slice(1).map(([x,y])=>[-x,y]).reverse(),...pos];lab='g(x) = f(|x|)'}
  const I=plInfo(g);
  return{q:`Na rysunku przedstawiono wykres funkcji f. Funkcja g jest określona wzorem ${lab}. Naszkicuj wykres funkcji g i podaj jej dziedzinę, zbiór wartości oraz miejsca zerowe.${plot([{pts:p0,dots:dotsOf(p0)}])}`,
  a:`D<sub>g</sub> = ${I.D}, ZW<sub>g</sub> = ${I.ZW}, miejsca zerowe: ${I.z}${plot([{pts:p0,cls:'fn0'},{pts:g,cls:'fn2',dots:dotsOf(g)}],'Szary: wykres f, czerwony: wykres g.')}`}}
const gTransform=()=>transformT(false),gTransformR=()=>transformT(true);
function gQuadGraph(){const a=F(...pick([[1,1],[-1,1],[2,1],[-2,1],[1,2],[-1,2]])),p=ri(-3,3),q=ri(-3,3),dx=a.d===2?2:1,av=a.n/a.d;
  const pts=[];for(let x=p-4;x<=p+4.001;x+=.1){const y=q+av*(x-p)**2;if(Math.abs(y-q)<=5.5)pts.push([f1(x),y])}const P2=[p+dx,q+av*dx*dx];
  const cs=[a,fmul(F(-2*p),a),fadd(fmul(F(p*p),a),F(q))];
  return{q:`Na rysunku przedstawiono fragment paraboli będącej wykresem funkcji kwadratowej f. Zaznaczone punkty (wierzchołek i punkt na paraboli) mają współrzędne całkowite. Wyznacz wzór funkcji f w postaci kanonicznej i ogólnej.${plot([{pts,dots:[[p,q],P2]}])}`,
  a:`f(x) = ${a.n===a.d?'':a.n===-a.d?M:fH(a)}(${sh(p)})²${term(q,'')} = ${poly(cs)}<br>${hint(`wierzchołek W = (${N(p)}, ${N(q)}); współczynnik a z punktu (${N(P2[0])}, ${N(P2[1])})`)}`}}
function gPiecewise(){const c=ri(-2,2),a1=riNZ(-3,3),z1=ri(-6,c+1),b1=-a1*z1,a2=riNZ(-3,3),z2=ri(c-1,c+6),b2=-a2*z2,f=x=>x<c?a1*x+b1:a2*x+b2,u=c-ri(1,3),v=c+ri(0,3);
  const zs=[];if(z1<c)zs.push(z1);if(z2>=c)zs.push(z2);const L=c-4,R=c+4;
  return{q:`Funkcja f jest określona wzorem: f(x) = ${poly([a1,b1])} dla x < ${N(c)} oraz f(x) = ${poly([a2,b2])} dla x ≥ ${N(c)}. Oblicz f(${N(u)}) i f(${N(v)}), wyznacz miejsca zerowe funkcji f i naszkicuj jej wykres w przedziale ⟨${N(L)}, ${N(R)}⟩.`,
  a:`f(${N(u)}) = ${N(f(u))}, f(${N(v)}) = ${N(f(v))}; miejsca zerowe: ${zs.length?zs.map(N).join(', '):'brak'}${plot([{pts:[[L,f(L)],[c,a1*c+b1]],dots:[[L,f(L)],[c,a1*c+b1,1]]},{pts:[[c,f(c)],[R,f(R)]],dots:[[c,f(c)],[R,f(R)]]}],'Pusta kropka: punkt nie należy do wykresu.')}`}}
/* ---------- zadania zamknięte ---------- */
const LET='ABCD';
/* zapasowe dystraktory: wiarygodne wartości „obok” poprawnej odpowiedzi (bez losowania) */
function nearOpts(ok){const out=[],FR=/^(−?)<span class="fr"><span>(\d+)<\/span><span>(\d+)<\/span><\/span>$/,m=ok.match(/^(−?)(\d+)(\D.*)?$/),f=ok.match(FR);
  if(m){const v=(m[1]?-1:1)*+m[2],sfx=m[3]||'';for(const x of[v+1,v-1,-v,2*v,v+2,v-2,v+10]){if(sfx&&x===0)continue;out.push((sfx&&/^[√∛π]/.test(sfx)&&Math.abs(x)===1?(x<0?M:''):N(x))+sfx)}}
  else if(f){const s=f[1]?-1:1,n=+f[2],d=+f[3];for(const[a,b]of[[n+1,d],[n,d+1],[-n,d],[d,n],[n-1,d],[n,d-1]])if(a&&b>0&&b!==1)out.push(fH(F(s*a,b)))}
  out.push(ok.startsWith(M)?ok.slice(1):M+ok);return out}
function mc(stem,ok,wrong,expl=''){const seen=new Set([ok]),w=[];for(const x of wrong)if(!seen.has(x)&&w.length<3){seen.add(x);w.push(x)}
  for(const x of nearOpts(ok))if(w.length<3&&!seen.has(x)){seen.add(x);w.push(x)}let k=1;while(w.length<3)w.push(ok+' + '+k++);
  const opts=shuffle([ok,...w]),i=opts.indexOf(ok);
  return{q:`${stem}<div class="mc" data-ok="${LET[i]}">${opts.map((o,j)=>`<button class="opt" data-k="${LET[j]}"><b>${LET[j]}.</b> ${o}</button>`).join('')}</div>`,a:`Poprawna odpowiedź: <b>${LET[i]}</b> (${opts[i]})${expl?'<br>'+expl:''}`}}
function pf(stem,st){return{q:`${stem}<div class="note2">Oceń prawdziwość zdań: P (prawda) lub F (fałsz).</div>${st.map(([s,t])=>`<div class="pf" data-ok="${t?'P':'F'}"><span>${s}</span><button class="opt" data-k="P">P</button><button class="opt" data-k="F">F</button></div>`).join('')}`,a:st.map(([s,t],i)=>`${i+1}. ${t?'P':'F'}`).join(', ')}}
function cLog(){const b=pick([2,3,5,6]);let k,n,ds;do{k=ri(2,3);n=b**k;ds=[];for(let m=2;m<n;m++)if(n%m===0)ds.push(m)}while(!ds.length);const m=pick(ds);
  return mc(`Liczba log<sub>${b}</sub>${m} + log<sub>${b}</sub>${n/m} jest równa`,''+k,[''+(k+1),''+(2*k),`log<sub>${b}</sub>${m+n/m}`,''+(k-1)])}
function cPow(){const a=ri(1,4),b=ri(1,3),c=ri(1,6),e=2*a+3*b-c;
  return mc(`Liczba ${fr(`4<sup>${a}</sup> · 8<sup>${b}</sup>`,`2<sup>${c}</sup>`)} jest równa`,`2<sup>${N(e)}</sup>`,[`2<sup>${N(e+2*c)}</sup>`,`2<sup>${N(a+b-c)}</sup>`,`2<sup>${N(e+1)}</sup>`,`2<sup>${N(e-1)}</sup>`])}
function cProc(){const p=pick([10,20,25,50]),q=pick([10,20,25,40]),v=((100+p)*(100-q)-10000)/100,t=x=>x===0?'nie zmieniła się':x>0?`wzrosła o ${dec(x)}%`:`zmalała o ${dec(-x)}%`;
  return mc(`Cenę podwyższono o ${p}%, a następnie obniżono o ${q}%. W wyniku obu zmian cena`,t(v),[t(p-q),t(q-p),t(v===0?p:-v),t(p)],`mnożnik ${dec(1+p/100)} · ${dec(1-q/100)} = ${dec(1+v/100)}; procentów nie wolno po prostu odjąć`)}
function cArith(){const a1=ri(-8,8),r=riNZ(-4,4),n=ri(6,15);
  return mc(`W ciągu arytmetycznym a<sub>1</sub> = ${N(a1)} i r = ${N(r)}. Wyraz a<sub>${n}</sub> jest równy`,N(a1+(n-1)*r),[N(a1+n*r),N(a1+(n-2)*r),N(a1*n+r),N(a1+(n-1)*r+1)])}
function cTrig(){let[a,b,c]=pickTriple(41);if(rnd()<.5)[a,b]=[b,a];const ob=rnd()<.5;
  return mc(`Kąt α spełnia warunki sin α = ${fH(F(a,c))} oraz ${ob?'90° < α < 180°':'0° < α < 90°'}. Wtedy cos α jest równy`,(ob?M:'')+fH(F(b,c)),[(ob?'':M)+fH(F(b,c)),fH(F(a,b)),(ob?M:'')+fH(F(a,b))])}
function cVertex(){const a=pick([1,-1,2,-2]),p=riNZ(-5,5),q=riNZ(-6,6);
  return mc(`Wierzchołkiem paraboli y = ${poly([a,-2*a*p,a*p*p+q])} jest punkt`,`(${N(p)}, ${N(q)})`,[`(${N(-p)}, ${N(q)})`,`(${N(p)}, ${N(-q)})`,`(${N(-p)}, ${N(-q)})`])}
function cParallel(){const a=riNZ(-4,4),b=ri(-5,5),x0=ri(-4,4),y0=ri(-5,5),bb=y0-a*x0;
  return mc(`Prosta równoległa do prostej y = ${poly([a,b])} przechodząca przez punkt (${N(x0)}, ${N(y0)}) ma równanie`,`y = ${poly([a,bb])}`,[`y = ${poly([a,y0+a*x0])}`,`y = ${poly([F(-1,a),y0+x0/a===Math.round(y0+x0/a)?y0+x0/a:y0])}`,`y = ${poly([-a,y0+a*x0])}`,`y = ${poly([a,b+y0])}`])}
function cCircle(){const a=riNZ(-5,5),b=riNZ(-5,5),r=ri(2,6);
  return mc(`Okrąg o równaniu (${sh(a)})² + (${sh(b,'y')})² = ${r*r} ma środek S i promień r. Wtedy`,`S = (${N(a)}, ${N(b)}), r = ${r}`,[`S = (${N(-a)}, ${N(-b)}), r = ${r}`,`S = (${N(a)}, ${N(b)}), r = ${r*r}`,`S = (${N(-a)}, ${N(-b)}), r = ${r*r}`])}
function cDice(){const m=ri(0,2);let t,k;
  if(m===0){const s=ri(3,11);t=`suma oczek będzie równa ${s}`;k=dice((x,y)=>x+y===s)}
  else if(m===1){const s=ri(4,10);t=`suma oczek będzie większa od ${s}`;k=dice((x,y)=>x+y>s)}
  else{const d=ri(1,4);t=`różnica między większą a mniejszą liczbą oczek będzie równa ${d}`;k=dice((x,y)=>Math.abs(x-y)===d)}
  return mc(`Rzucamy dwa razy symetryczną kostką. Prawdopodobieństwo, że ${t}, jest równe`,fH(F(k,36)),[fH(F(k+1,36)),...(k<11?[fH(F(k,11))]:[]),...(k<21?[fH(F(k,21))]:[]),fH(F(k-1||2,36)),fH(F(k+2,36))],'wszystkich wyników (par uporządkowanych) jest 36')}
function cCubeMC(){const a=ri(2,16);return mc(`Przekątna sześcianu o krawędzi ${a} ma długość`,fsq(a,3),[fsq(a,2),''+3*a,fsq(a*a,3),''+a*a])}
function cStat(){const arr=Array.from({length:ri(5,8)},()=>ri(1,9)),s=arr.slice().sort((x,y)=>x-y),n=s.length,med=n%2?F(s[(n-1)/2]):F(s[n/2-1]+s[n/2],2),mean=F(arr.reduce((x,y)=>x+y,0),n);
  return mc(`Mediana liczb ${arr.join(', ')} jest równa`,fH(med),[fH(mean),N(arr[Math.floor(n/2)]),fH(F(s[0]+s[n-1],2)),N(s[Math.floor(n/2)]+1)],`uporządkuj: ${s.join(', ')}`)}
function cPFLinear(){const a=riNZ(-4,4),b=riNZ(-6,6),k=ri(-3,3),t=[rnd()<.5,rnd()<.5,rnd()<.5];
  return pf(`Funkcja liniowa f jest określona wzorem f(x) = ${poly([a,b])}.`,[[`Funkcja f jest ${(a>0)===t[0]?'rosnąca':'malejąca'}.`,t[0]],[`Miejscem zerowym funkcji f jest x = ${fH(t[1]?F(-b,a):F(b,a))}.`,t[1]||F(b,a).n===F(-b,a).n],[`f(${N(k)}) = ${N(t[2]?a*k+b:a*k+b+riNZ(-2,2))}.`,t[2]]])}
function cPFQuad(){const a=pick([1,-1,2,-1/2*0-2]),p=ri(-4,4),q=ri(-5,5),t=[rnd()<.5,rnd()<.5,rnd()<.5],up=a>0;
  return pf(`Funkcja kwadratowa jest określona wzorem f(x) = ${lead(a,'')}(${sh(p)})²${term(q,'')}.`,[[`Osią symetrii wykresu jest prosta x = ${N(t[0]?p:-p)}.`,t[0]||p===0],[`Zbiorem wartości funkcji jest przedział ${(up===t[1])?`⟨${N(q)}, +∞)`:`(${M}∞, ${N(q)}⟩`}.`,t[1]],[`Funkcja jest rosnąca w przedziale ${(up===t[2])?`⟨${N(p)}, +∞)`:`(${M}∞, ${N(p)}⟩`}.`,t[2]]])}
function cDelta(){const t=ri(0,2);let cs;if(t===0){const[r1,r2]=distinct(2,-5,5);cs=expand([r1,r2],pick([1,-1,2]))}else if(t===1){const r=ri(-4,4);cs=expand([r,r],pick([1,-1]))}else{const p=ri(-3,3);cs=[1,-2*p,p*p+ri(1,5)]}
  const L=['dwa miejsca zerowe','dokładnie jedno miejsce zerowe','nie ma miejsc zerowych'],U=['Δ > 0','Δ = 0','Δ < 0'],o=shuffle([0,1,2]),o2=shuffle([0,1,2]);
  return{q:`Funkcja kwadratowa f(x) = ${poly(cs)}<div class="mc" data-ok="${'ABC'[o.indexOf(t)]}">${o.map((v,j)=>`<button class="opt" data-k="${'ABC'[j]}"><b>${'ABC'[j]}.</b> ma ${L[v]}</button>`).join('')}</div>ponieważ<div class="mc" data-ok="${'123'[o2.indexOf(t)]}">${o2.map((v,j)=>`<button class="opt" data-k="${'123'[j]}"><b>${j+1}.</b> ${U[v]}</button>`).join('')}</div>`,
  a:`${'ABC'[o.indexOf(t)]}${o2.indexOf(t)+1} (Δ = ${N(cs[1]*cs[1]-4*cs[0]*cs[2])})`}}
/* ---------- statystyka ---------- */
function statData(){for(;;){const k=ri(4,6),vals=Array.from({length:k},(_,i)=>i+1+(k<6?ri(0,6-k):0)).filter((v,i,a)=>a.indexOf(v)===i),cnt=vals.map(()=>ri(1,7)),n=cnt.reduce((a,b)=>a+b,0);if(n>=8&&n<=30)return{vals,cnt,n}}}
function statAns({vals,cnt,n}){const sum=vals.reduce((s,v,i)=>s+v*cnt[i],0),mean=F(sum,n),all=[];vals.forEach((v,i)=>{for(let j=0;j<cnt[i];j++)all.push(v)});
  const med=n%2?F(all[(n-1)/2]):F(all[n/2-1]+all[n/2],2),mxc=Math.max(...cnt),mode=vals.filter((v,i)=>cnt[i]===mxc),m=sum/n,vr=vals.reduce((s,v,i)=>s+cnt[i]*(v-m)**2,0)/n;
  return{mean,med,mode,vr,txt:`średnia = ${fH(mean)}${mean.d>1?' ≈ '+dec(sum/n):''}, mediana = ${fH(med)}, dominanta = ${mode.join(' i ')}, odchylenie standardowe σ ≈ ${dec(Math.sqrt(vr))}`}}
function gStatTable(){const d=statData(),A=statAns(d);
  return{q:`W tabeli przedstawiono oceny z pracy klasowej w pewnej klasie.<table class="tb"><tr><th>Ocena</th>${d.vals.map(v=>`<td>${v}</td>`).join('')}</tr><tr><th>Liczba uczniów</th>${d.cnt.map(v=>`<td>${v}</td>`).join('')}</tr></table>Oblicz średnią, medianę, dominantę i odchylenie standardowe ocen (odchylenie z dokładnością do 0,01).`,
  a:`${A.txt}<br>${hint(`uczniów jest ${d.n}; mediana to ${d.n%2?`${(d.n+1)/2}. wynik`:`średnia ${d.n/2}. i ${d.n/2+1}. wyniku`} po uporządkowaniu; σ² = ${dec(A.vr)}`)}`}}
function gStatBars(){const d=statData(),A=statAns(d),mx=Math.max(...d.cnt),bw=40,H=150,W=d.vals.length*bw*1.4+30;let s='';
  d.vals.forEach((v,i)=>{const h=d.cnt[i]/mx*(H-30),x=30+i*bw*1.4;s+=`<rect class="bar" x="${f1(x)}" y="${f1(H-h)}" width="${bw}" height="${f1(h)}"/><text class="tk" x="${f1(x+bw/2)}" y="${H+14}">${v}</text><text class="tk" x="${f1(x+bw/2)}" y="${f1(H-h-5)}">${d.cnt[i]}</text>`});
  const thr=d.vals[Math.floor(d.vals.length/2)],k=d.vals.reduce((s,v,i)=>s+(v>=thr?d.cnt[i]:0),0);
  return{q:`Na diagramie przedstawiono liczbę uczniów, którzy otrzymali poszczególne oceny.<figure class="fg"><svg viewBox="0 -10 ${f1(W)} ${H+30}" role="img" aria-label="diagram słupkowy">${s}<line class="ax" x1="20" y1="${H}" x2="${f1(W)}" y2="${H}"/></svg></figure>Oblicz średnią i medianę ocen oraz jaki procent uczniów otrzymał ocenę co najmniej ${thr}.`,
  a:`${A.txt.split(', dominanta')[0]}; ocenę co najmniej ${thr} otrzymało ${k} z ${d.n} uczniów, czyli ${pct(100*k/d.n)}%`}}
/* ---------- stereometria: przekroje i kąty ---------- */
function cube(sec,cap){const A=Pt(40,175),B=Pt(165,175),C=Pt(225,130),D=Pt(100,130),u=Pt(0,-125),E=add(A,u),Fp=add(B,u),G=add(C,u),H=add(D,u),c=Pt(132,95);
  const S=sec({A,B,C,D,E,F:Fp,G,H});return FIG(SP(S.poly,'h2')+SL(A,B)+SL(B,C)+SL(A,E)+SL(B,Fp)+SL(C,G)+SL(E,Fp)+SL(Fp,G)+SL(G,H)+SL(H,E)+SL(A,D,'hd')+SL(D,C,'hd')+SL(D,H,'hd')+SP(S.poly,'x')+
  [['A',A],['B',B],['C',C],['D',D],['E',E],['F',Fp],['G',G],['H',H]].map(([n,p])=>LB(p,n,c)).join('')+(S.extra||''),cap,'0 -16 275 212')}
function gCubeSec(){const a=ri(2,8),m=ri(0,1);
  if(m===0)return{q:`Sześcian ABCDEFGH ma krawędź długości ${a}. Oblicz pole przekroju sześcianu płaszczyzną przechodzącą przez przekątną BD podstawy i wierzchołek G oraz tangens kąta nachylenia tej płaszczyzny do płaszczyzny podstawy.`,
    a:`przekrój to trójkąt równoboczny BDG o boku ${fsq(a,2)}: P = ${fsq(F(a*a,2),3)}; tg α = √2<br>${hint('kąt nachylenia: trójkąt OCG, gdzie O to środek podstawy; |CG| = a, |OC| = a√2/2')}${cube(V=>({poly:[V.B,V.D,V.G]}),'Przekrój BDG. '+AUX)}`};
  return{q:`Sześcian ABCDEFGH ma krawędź długości ${2*a}. Punkt P jest środkiem krawędzi CG. Oblicz pole przekroju sześcianu płaszczyzną BDP oraz tangens kąta nachylenia tej płaszczyzny do płaszczyzny podstawy.`,
    a:`przekrój to trójkąt równoramienny BDP: |BD| = ${fsq(2*a,2)}, wysokość |OP| = ${fsq(a,3)}, P = ${fsq(a*a,6)}; tg α = ${fr('√2',2)}<br>${hint('O to środek BD; w trójkącie OCP: |CP| = a/2, |OC| = a√2/2')}${cube(V=>{const P2=mid(V.C,V.G);return{poly:[V.B,V.D,P2],extra:LB(P2,'P',Pt(160,40))}},'Przekrój BDP. '+AUX)}`}}
function gCuboidSec(){const[a,b,d]=pick([[3,4,5],[6,8,10],[5,12,13],[8,6,10]]),h=ri(2,9);
  return{q:`Prostopadłościan ABCDEFGH ma krawędzie podstawy ${a} i ${b} oraz wysokość ${h}. Oblicz pole przekroju płaszczyzną ACGE (przekrój przekątny) oraz tangens kąta między przekątną AG a podstawą.`,
  a:`|AC| = ${d}, P = ${d*h}, tg α = ${fH(F(h,d))}${cube(V=>({poly:[V.A,V.C,V.G,V.E]}),'Przekrój przekątny ACGE (rysunek sześcianu poglądowy). '+AUX)}`}}
function gPyrEdge(){const a=2*ri(1,5),H=ri(2,9),s2=a*a/2,le2=H*H+s2,ang=Math.atan(H/Math.sqrt(s2))*180/Math.PI;
  return{q:`Ostrosłup prawidłowy czworokątny ma krawędź podstawy ${a} i wysokość ${H}. Oblicz długość krawędzi bocznej oraz tangens kąta nachylenia krawędzi bocznej do płaszczyzny podstawy (i miarę tego kąta z dokładnością do 1°).`,
  a:`krawędź boczna = ${sq(le2)}, tg α = ${fsq(F(H,a),2)} (bo połowa przekątnej podstawy = ${fsq(a/2,2)}), α ≈ ${Math.round(ang)}°`}}
function gDihedral(){const a=2*ri(1,4),H=ri(1,6),s=a/2,cs=F(-s*s,H*H+s*s),ang=Math.acos(cs.n/cs.d)*180/Math.PI;
  return{q:`Ostrosłup prawidłowy czworokątny ma krawędź podstawy ${a} i wysokość ${H}. Oblicz cosinus kąta dwuściennego między sąsiednimi ścianami bocznymi (i miarę tego kąta z dokładnością do 1°).`,
  a:`cos φ = ${fH(cs)}, φ ≈ ${Math.round(ang)}°<br>${hint('poprowadź wysokości dwóch sąsiednich ścian na wspólną krawędź boczną (spotkają się w jednym punkcie); z twierdzenia cosinusów w trójkącie z przekątną podstawy. Kąt jest rozwarty.')}`}}
/* ---------- zadania z treścią ---------- */
function gField(){const L=8*ri(5,30);
  return{q:`Prostokątną działkę położoną nad rzeką trzeba ogrodzić z trzech stron (od strony rzeki płot nie jest potrzebny). Mamy ${L} m siatki. Jakie wymiary powinna mieć działka, aby jej pole było największe? Oblicz to pole.`,
  a:`boki prostopadłe do rzeki: ${L/4} m, bok równoległy do rzeki: ${L/2} m, P<sub>max</sub> = ${L*L/8} m²<br>${hint(`P(x) = x(${L} − 2x)`)}`,
  s:[`Niech x to długość boków prostopadłych do rzeki (są dwa), a y to bok równoległy do rzeki (jeden). Siatki: 2x + y = ${L}.`,`y = ${L} − 2x, więc P(x) = x(${L} − 2x) = −2x² + ${L}x, x ∈ (0, ${L/2}).`,`Parabola ma ramiona w dół, maksimum w wierzchołku: x = ${fr(`−${L}`,'2 · (−2)')} = ${L/4}.`,`y = ${L} − 2 · ${L/4} = ${L/2}, P<sub>max</sub> = ${L/4} · ${L/2} = ${L*L/8} m².`]}}
function gAmphi(){const a=ri(10,30),d=ri(1,4),n=ri(10,25),S=n*(2*a+(n-1)*d)/2,T=Math.round(S*1.3);let k=1;while(k*(2*a+(k-1)*d)/2<T)k++;
  return{q:`W pierwszym rzędzie widowni jest ${a} miejsc, a w każdym następnym o ${d} więcej niż w poprzednim. Rzędów jest ${n}. Ile miejsc jest na widowni? Ile co najmniej rzędów trzeba by mieć, aby miejsc było co najmniej ${T}?`,
  a:`S<sub>${n}</sub> = ${S}; potrzeba co najmniej ${k} rzędów<br>${hint(`S<sub>k</sub> = ${fr(`k(${2*a} + (k − 1) · ${d})`,2)} ≥ ${T}`)}`}}
function gBacteria(){const N0=pick([100,200,500,1000]),T=pick([2,3,4,5,6]),k=ri(3,8),t=ri(2,5)*T;
  return{q:`Liczba bakterii w próbce podwaja się co ${T} godziny. Na początku było ${N0} bakterii. Ile bakterii będzie po ${t} godzinach? Po ilu godzinach liczba bakterii osiągnie ${N0*2**k}?`,
  a:`N(${t}) = ${N0} · 2<sup>${t/T}</sup> = ${N0*2**(t/T)}; ${N0*2**k} bakterii będzie po ${k*T} godzinach<br>${hint(`N(t) = ${N0} · 2<sup>t/${T}</sup>`)}`}}
function gTravel(){const a=pick([10,12,15,20,30]),v1=ri(2,6),v2=ri(1,5),den=v1*v1+v2*v2,t=F(a*v1,den),d2=F(a*a*v2*v2,den),{k,m}=simp(d2.n*d2.d);
  return{q:`Dwie drogi przecinają się pod kątem prostym w punkcie O. O godzinie 9:00 turysta A wyrusza z punktu oddalonego o ${a} km od O i idzie w stronę O z prędkością ${v1} km/h, a turysta B wyrusza z punktu O drugą drogą z prędkością ${v2} km/h. Po jakim czasie odległość między nimi będzie najmniejsza? Oblicz tę odległość.`,
  a:`t = ${fH(t)} h, d<sub>min</sub> = ${fsq(F(k,d2.d),m)} km<br>${hint(`d²(t) = (${a} − ${v1}t)² + (${v2}t)² — funkcja kwadratowa, szukaj wierzchołka`)}`}}
function gBoxMin(){if(rnd()<.5){const x=2*ri(1,10),V=x**3/2;
  return{q:`Prostopadłościenne pudełko bez pokrywki ma podstawę kwadratową i objętość ${V} cm³. Jakie powinny być jego wymiary, aby zużyć jak najmniej materiału? Oblicz to najmniejsze pole powierzchni.`,
  a:`krawędź podstawy ${x} cm, wysokość ${x/2} cm, P<sub>min</sub> = ${3*x*x} cm²<br>${hint(`P(x) = x² + ${fr(4*V,'x')}, P'(x) = 2x − ${fr(4*V,'x²')}`)}`,
  s:[`Niech x — krawędź podstawy, h — wysokość. x²h = ${V}, więc h = ${fr(V,'x²')}.`,`Bez pokrywki: P = x² + 4xh = x² + ${fr(4*V,'x')}, x > 0.`,`P'(x) = 2x − ${fr(4*V,'x²')} = ${fr(`2(x³ − ${x**3})`,'x²')}. P' = 0 dla x = ${x}; wcześniej P' < 0, później P' > 0, więc to minimum.`,`x = ${x} cm, h = ${fr(V,x*x)} = ${x/2} cm, P<sub>min</sub> = ${x*x} + ${2*x*x} = ${3*x*x} cm².`]}}
  const x=ri(2,12),V=x**3;
  return{q:`Prostopadłościenne pudełko z pokrywką ma podstawę kwadratową i objętość ${V} cm³. Jakie powinny być jego wymiary, aby zużyć jak najmniej materiału? Oblicz to najmniejsze pole powierzchni.`,
  a:`sześcian o krawędzi ${x} cm, P<sub>min</sub> = ${6*x*x} cm²<br>${hint(`P(x) = 2x² + ${fr(4*V,'x')}`)}`,
  s:[`x²h = ${V}, więc h = ${fr(V,'x²')}.`,`Z pokrywką: P = 2x² + 4xh = 2x² + ${fr(4*V,'x')}, x > 0.`,`P'(x) = 4x − ${fr(4*V,'x²')} = ${fr(`4(x³ − ${V})`,'x²')} = 0 dla x = ${x}; tam P' zmienia znak z − na +, więc to minimum.`,`h = ${fr(V,x*x)} = ${x}, czyli najlepszy jest sześcian; P<sub>min</sub> = 6 · ${x*x} = ${6*x*x} cm².`]}}
function gCanMin(){const r=ri(2,12),open=rnd()<.4;
  if(open)return{q:`Naczynie w kształcie walca bez pokrywki ma objętość ${r**3}π cm³. Jaki promień i jaką wysokość powinno mieć naczynie, aby jego pole powierzchni było najmniejsze? Oblicz to pole.`,
    a:`r = ${r} cm, h = ${r} cm, P<sub>min</sub> = ${3*r*r}π cm²<br>${hint(`h = ${fr(r**3,'r²')}, P(r) = πr² + ${fr(`${2*r**3}π`,'r')}`)}`,
    s:[`πr²h = ${r**3}π, więc h = ${fr(r**3,'r²')}.`,`Bez pokrywki: P = πr² + 2πrh = πr² + ${fr(`${2*r**3}π`,'r')}, r > 0.`,`P'(r) = 2πr − ${fr(`${2*r**3}π`,'r²')} = ${fr(`2π(r³ − ${r**3})`,'r²')} = 0 dla r = ${r}; to minimum (P' zmienia znak z − na +).`,`h = ${r} cm, P<sub>min</sub> = ${r*r}π + ${2*r*r}π = ${3*r*r}π cm².`]};
  return{q:`Puszka w kształcie walca (z pokrywką) ma objętość ${2*r**3}π cm³. Jaki promień i jaką wysokość powinna mieć puszka, aby jej pole powierzchni całkowitej było najmniejsze? Oblicz to pole.`,
  a:`r = ${r} cm, h = ${2*r} cm, P<sub>min</sub> = ${6*r*r}π cm²<br>${hint(`h = ${fr(2*r**3,'r²')}, P(r) = 2πr² + ${fr(`${4*r**3}π`,'r')}`)}`,
  s:[`πr²h = ${2*r**3}π, więc h = ${fr(2*r**3,'r²')}.`,`P = 2πr² + 2πrh = 2πr² + ${fr(`${4*r**3}π`,'r')}, r > 0.`,`P'(r) = 4πr − ${fr(`${4*r**3}π`,'r²')} = ${fr(`4π(r³ − ${r**3})`,'r²')} = 0 dla r = ${r}; to minimum.`,`h = ${2*r} cm (wysokość równa średnicy), P<sub>min</sub> = ${2*r*r}π + ${4*r*r}π = ${6*r*r}π cm².`]}}
function gBounce(){const h=pick([1,2,3,4,5,6,8,10]),q=F(...pick([[1,2],[2,3],[3,4],[3,5],[1,3]])),tot=fadd(F(h),F(2*h*q.n,q.d-q.n));
  return{q:`Piłkę upuszczono z wysokości ${h} m. Po każdym odbiciu wznosi się na wysokość równą ${fH(q)} poprzedniej. Jaką łączną drogę pokona piłka, zanim się zatrzyma (przyjmij, że odbija się nieskończenie wiele razy)?`,
  a:`${fH(tot)} m<br>${hint(`droga = ${h} + 2 · (${fH(fmul(F(h),q))} + ${fH(fmul(fmul(F(h),q),q))} + …) = ${h} + 2 · ${fr(`${fH(fmul(F(h),q))}`,`1 − ${fH(q)}`)}`)}`}}
/* ---------- zadania wieloczęściowe ---------- */
function gMultiQuad(){let r1,r2;do[r1,r2]=distinct(2,-5,5).sort((x,y)=>x-y);while((r1+r2)%2);const a=pick([1,-1,2]),cs=expand([r1,r2],a),p=(r1+r2)/2,q=ev(cs,p),m=ri(-5,0),n=m+ri(3,6),xs=[m,n];if(p>m&&p<n)xs.push(p);const vs=xs.map(x=>ev(cs,x));
  return{q:`Dana jest funkcja f(x) = ${poly(cs)}.<br>a) Wyznacz miejsca zerowe funkcji f.<br>b) Podaj współrzędne wierzchołka paraboli i zbiór wartości funkcji.<br>c) Rozwiąż nierówność f(x) ≥ 0.<br>d) Wyznacz najmniejszą i największą wartość funkcji w przedziale ⟨${N(m)}, ${N(n)}⟩.`,
  a:`a) ${N(r1)} i ${N(r2)}<br>b) W = (${N(p)}, ${N(q)}), ZW = ${a>0?`⟨${N(q)}, +∞)`:`(${M}∞, ${N(q)}⟩`}<br>c) ${signSolve([{v:r1},{v:r2}],a,'>=')}<br>d) min = ${N(Math.min(...vs))}, max = ${N(Math.max(...vs))}`}}
const lineGen=(A,B,C)=>{const g=gcd(gcd(A,B),C)||1;let a=A/g,b=B/g,c=C/g;if(a<0||(a===0&&b<0)){a=-a;b=-b;c=-c}return`${a?lead(a,'x'):''}${a?term(b,'y'):lead(b,'y')}${term(c,'')} = 0`};
function gMultiTri(){for(;;){const[x1,y1,x2,y2,x3,y3]=[0,0,0,0,0,0].map(()=>ri(-6,6)),d=(x2-x1)*(y3-y1)-(y2-y1)*(x3-x1);if(!d)continue;const t=pick([[3,4,5],[6,8,10],[5,12,13]]);const X2=x1+t[0]*sg(),Y2=y1+t[1]*sg();const D2=(X2-x1)*(y3-y1)-(Y2-y1)*(x3-x1);if(!D2)continue;
  const bx=X2,by=Y2,dx=x3-bx,dy=y3-by;
  return{q:`Dany jest trójkąt o wierzchołkach A = (${N(x1)}, ${N(y1)}), B = (${N(bx)}, ${N(by)}), C = (${N(x3)}, ${N(y3)}).<br>a) Oblicz długość boku AB.<br>b) Wyznacz równanie ogólne prostej BC.<br>c) Wyznacz równanie ogólne prostej zawierającej wysokość trójkąta poprowadzoną z wierzchołka A.<br>d) Oblicz pole trójkąta ABC.`,
  a:`a) |AB| = ${t[2]}<br>b) ${lineGen(dy,-dx,dx*by-dy*bx)}<br>c) ${lineGen(dx,dy,-(dx*x1+dy*y1))}<br>d) P = ${fH(F(Math.abs(D2),2))}<br>${hint('wektor BC jest wektorem normalnym prostej wysokości')}`}}}
function gMultiPoly(){const rs=distinct(3,-4,4),cs=expand(rs),r=rs[0],k=riNZ(-3,3);
  return{q:`Dany jest wielomian W(x) = ${poly(cs)}.<br>a) Sprawdź, że liczba ${N(r)} jest pierwiastkiem wielomianu W.<br>b) Rozłóż wielomian W na czynniki liniowe.<br>c) Rozwiąż nierówność W(x) ≤ 0.<br>d) Wyznacz resztę z dzielenia W przez dwumian (${sh(k)}).`,
  a:`a) W(${N(r)}) = 0<br>b) W(x) = ${rs.slice().sort((a,b)=>a-b).map(v=>`(${sh(v)})`).join('')}<br>c) ${signSolve(rs.map(v=>({v})),1,'<=')}<br>d) R = W(${N(k)}) = ${N(ev(cs,k))}`}}

/* ---------- trygonometria: generator równań i nierówności ---------- */
const piF=f=>{f=toF(f);if(f.n===0)return'0';const a=Math.abs(f.n),t=(a===1?'':a)+'π';return(f.n<0?M:'')+(f.d===1?t:fr(t,f.d))};
const TV={sin:Math.sin,cos:Math.cos,tg:x=>Math.abs(Math.cos(x))<1e-9?NaN:Math.tan(x)};
const SC_V=[[0,'0'],[.5,fr(1,2)],[Math.SQRT2/2,fr('√2',2)],[Math.sqrt(3)/2,fr('√3',2)],[1,'1']];
const TG_V=[[0,'0'],[Math.sqrt(3)/3,fr('√3',3)],[1,'1'],[Math.sqrt(3),'√3']];
const INTS=[[0,2,1,1],[0,1,1,1],[-1,1,1,1],[0,2,0,0],[0,2,1,0]];
const ivPi=([L,R,lc,rc])=>`${lc?'⟨':'('}${piF(F(L))}, ${piF(F(R))}${rc?'⟩':')'}`;
function trigSolve(G,a,[L,R,lc,rc]){const out=[],k=12*a;for(let j=Math.ceil(L*k);j<=Math.floor(R*k);j++){const x=j*Math.PI/k;if((j===L*k&&!lc)||(j===R*k&&!rc))continue;const v=G(x);if(isFinite(v)&&Math.abs(v)<1e-9)out.push(F(j,k))}return out}
const tpoly=(c2,c1,c0,f)=>{let s='';[[c2,`${f}²x`],[c1,`${f} x`],[c0,'']].forEach(([c,v])=>{c=toF(c);if(!c.n)return;const neg=c.n<0,ab=F(Math.abs(c.n),c.d),body=(v&&ab.n===1&&ab.d===1?'':fH(ab))+v;s+=s===''?(neg?M:'')+body:(neg?' − ':' + ')+body});return s||'0'};
function gTrigEqGen(){const I=pick(INTS),m=ri(0,3);let disp,G,a=1,h='';
  if(m===0){const fn=pick(['sin','cos','tg']);a=pick([1,1,2,3]);const[v,vs]=pick(fn==='tg'?TG_V:SC_V),sgn=v===0?1:sg();disp=`${fn} ${a>1?a:''}x = ${sgn<0?M:''}${vs}`;G=x=>TV[fn](a*x)-sgn*v;h=a>1?`podstaw t = ${a}x i pamiętaj o przedziale dla t`:'skorzystaj z wykresu lub okręgu jednostkowego'}
  else if(m===1){const fn=pick(['sin','cos']),R0=[F(-1),F(-1,2),F(0),F(1,2),F(1)],R1=[...R0,F(2),F(-2),F(3,2)];let r1,r2;do{r1=pick(R0);r2=pick(R1)}while(r1.n*r2.d===r2.n*r1.d);
    let A=1;for(const t of[1,2,4]){const c1=fmul(F(-t),fadd(r1,r2)),c0=fmul(F(t),fmul(r1,r2));if(c1.d===1&&c0.d===1){A=t;break}}const c1=fmul(F(-A),fadd(r1,r2)).n,c0=fmul(F(A),fmul(r1,r2)).n;
    const v2=rnd(),oth=fn==='sin'?'cos':'sin';G=x=>{const s=TV[fn](x);return A*(s-r1.n/r1.d)*(s-r2.n/r2.d)};
    if(A===2&&v2<.35&&fn==='sin'){disp=`cos 2x${term(-c1,'sin x')}${term(-(c0+1),'')} = 0`;h='cos 2x = 1 − 2sin²x, potem podstaw t = sin x'}
    else if(v2<.65){disp=`${tpoly(-A,c1,A+c0,oth)} = 0`;h=`${oth}²x = 1 − ${fn}²x, potem podstaw t = ${fn} x`}
    else{disp=`${tpoly(A,c1,c0,fn)} = 0`;h=`podstaw t = ${fn} x, t ∈ ⟨−1, 1⟩`}}
  else{const[v,vs]=pick(SC_V.slice(1,4)),sgn=sg(),c=2*v*sgn,cs=(sgn<0?M:'')+(v===.5?'':v>.8?'√3':'√2'),w=rnd()<.5;
    disp=w?`sin 2x = ${cs} sin x`:`sin 2x = ${cs} cos x`;G=w?x=>Math.sin(2*x)-c*Math.sin(x):x=>Math.sin(2*x)-c*Math.cos(x);h=w?'sin 2x = 2sin x cos x; wyłącz sin x przed nawias':'sin 2x = 2sin x cos x; wyłącz cos x przed nawias'}
  const sol=trigSolve(G,a,I);
  return{q:`Rozwiąż równanie ${disp} w przedziale ${ivPi(I)}.`,a:(sol.length?`x ∈ {${sol.map(piF).join(', ')}}`:'brak rozwiązań w tym przedziale')+`<br>${hint(h)}`}}
function gTrigIneq(){const fn=pick(['sin','cos']),[v,vs]=pick(SC_V.slice(0,4)),sgn=v===0?1:sg(),val=sgn*v,rel=pick(RELS),cmp={'<':(a,b)=>a<b-1e-9,'<=':(a,b)=>a<=b+1e-9,'>':(a,b)=>a>b+1e-9,'>=':(a,b)=>a>=b-1e-9}[rel];
  const pts=[0,2];for(let j=0;j<=24;j++)if(Math.abs(TV[fn](j*Math.PI/12)-val)<1e-9)pts.push(j/12);
  const res=setStr(x=>x>=0&&x<=2&&cmp(TV[fn](x*Math.PI),val),pts,x=>piF(F(Math.round(x*12),12)));
  return{q:`Rozwiąż nierówność ${fn} x ${REL[rel]} ${sgn<0?M:''}${vs} w przedziale ⟨0, 2π⟩.`,a:`x ∈ ${res}<br>${hint(`narysuj wykres y = ${fn} x i prostą y = ${sgn<0?M:''}${vs}`)}`}}
function cRedukcja(){const ang=pick([120,135,150,210,225,240,300,315,330]),fn=pick(['sin','cos','tg']),v=TV[fn](ang*Math.PI/180),opts=[[0,'0'],[.5,fr(1,2)],[Math.SQRT2/2,fr('√2',2)],[Math.sqrt(3)/2,fr('√3',2)],[1,'1'],[Math.sqrt(3)/3,fr('√3',3)],[Math.sqrt(3),'√3']];
  const lab=x=>{const o=opts.find(p=>Math.abs(p[0]-Math.abs(x))<1e-9);return(x<-1e-9?M:'')+o[1]},ok=lab(v),alt=opts.filter(p=>Math.abs(p[0]-Math.abs(v))>1e-9&&p[0]>0).map(p=>p[1]);
  return mc(`Wartość wyrażenia ${fn} ${ang}° jest równa`,ok,[lab(-v),(v<0?'':M)+pick(alt),(v<0?M:'')+pick(alt)],hint('wzory redukcyjne: sprowadź kąt do ostrego i ustal znak w ćwiartce'))}
/* ---------- dowody: generatory ---------- */
function gProofGen(){const t=ri(0,8),a=riNZ(-6,6),b=riNZ(-6,6),k=ri(1,9);
  const P=[()=>[`Wykaż, że dla każdej liczby rzeczywistej x prawdziwa jest nierówność ${poly([1,-2*a,a*a+k])} > 0.`,`${poly([1,-2*a,a*a+k])} = (${sh(a)})² + ${k} ≥ ${k} > 0.`],
   ()=>{const c=Math.abs(a);return[`Wykaż, że dla każdej liczby całkowitej n liczba (n + ${c})² − (n − ${c})² jest podzielna przez ${4*c}.`,`(n + ${c})² − (n − ${c})² = ${4*c}n.`]},
   ()=>{const m=pick([3,5,7]);return[`Wykaż, że suma ${m} kolejnych liczb całkowitych jest podzielna przez ${m}.`,`oznacz środkową liczbę przez n: suma = (n − ${(m-1)/2}) + … + n + … + (n + ${(m-1)/2}) = ${m}n.`]},
   ()=>[`Wykaż, że dla dowolnych liczb rzeczywistych x, y prawdziwa jest nierówność x² + y² + ${a*a+b*b} ≥ ${2*a}x + ${2*b}y.`.replace(/\+ -/g,'− ').replace(/≥ -/,'≥ −'),`przenieś wszystko na lewą stronę: (${sh(a)})² + (${sh(b,'y')})² ≥ 0.`],
   ()=>{const kk=ri(1,4);return[`Wykaż, że dla każdej liczby całkowitej n liczba n³ + ${6*kk-1}n jest podzielna przez 6.`,`n³ + ${6*kk-1}n = (n³ − n) + ${6*kk}n = (n − 1)n(n + 1) + ${6*kk}n; iloczyn trzech kolejnych liczb całkowitych dzieli się przez 6.`]},
   ()=>{const s=riNZ(-8,8);return[`Wykaż, że jeśli a + b = ${N(s)}, to ab ≤ ${fH(F(s*s,4))}.`,`podstaw b = ${N(s)} − a: ab = ${s}a − a² = ${fH(F(s*s,4))} − (a ${s<0?'+':'−'} ${fH(F(Math.abs(s),2))})² ≤ ${fH(F(s*s,4))}.`]},
   ()=>[`Wykaż, że dla każdej liczby dodatniej x prawdziwa jest nierówność x + ${fr(k*k,'x')} ≥ ${2*k}.`,`pomnóż przez x > 0: x² − ${2*k}x + ${k*k} = (x − ${k})² ≥ 0.`],
   ()=>{const c=pick([8,17,26,35]);return[`Wykaż, że dla każdej liczby naturalnej n ≥ 1 liczba 10ⁿ + ${c} jest podzielna przez 9.`,`10ⁿ daje resztę 1 z dzielenia przez 9, a ${c} daje resztę 8; suma reszt 9.`]},
   ()=>[`Wykaż, że dla dowolnych liczb dodatnich a, b prawdziwa jest nierówność a³ + b³ ≥ a²b + ab².`,'a³ + b³ − a²b − ab² = a²(a − b) − b²(a − b) = (a − b)²(a + b) ≥ 0.']];
  const[q,h]=P[t]();return{q,a:hint(h)}}
function figChords(){const O=Pt(145,95),r=75,[A,B,C,D]=[200,20,115,300].map(t=>polar(O,r,t)),P=inter(A,B,C,D);
  return FIG(SC(O,r)+SL(A,B)+SL(C,D)+SL(A,C,'x')+SL(B,D,'x')+LB(A,'A',O)+LB(B,'B',O)+LB(C,'C',O)+LB(D,'D',O)+LB(P,'P',Pt(P.x+20,P.y+30)),'Trójkąty APC i DPB są podobne (kąty wpisane oparte na tych samych łukach). '+AUX)}
function figTangents(){const O=Pt(90,95),r=55,P=Pt(255,95),th=Math.acos(r/dist(O,P))*180/Math.PI,T1=polar(O,r,-th),T2=polar(O,r,th);
  return FIG(SC(O,r)+SL(P,T1)+SL(P,T2)+SL(O,T1,'x')+SL(O,T2,'x')+SL(O,P,'x')+SD(O)+LB(O,'O',Pt(60,95))+LB(P,'P',Pt(200,95))+LB(T1,'A',O)+LB(T2,'B',O),'Promienie OA i OB są prostopadłe do stycznych. '+AUX)}
function figIso(){const A=Pt(40,165),B=Pt(240,165),C=Pt(140,25),D=Pt(140,165),c=Pt(140,110);
  return FIG(SP([A,B,C])+SL(C,D,'x')+LB(A,'A',c)+LB(B,'B',c)+LB(C,'C',c)+LB(D,'D',Pt(140,120)),'Wysokość CD dzieli trójkąt na dwa przystające trójkąty. '+AUX)}
function figVarignon(){const A=Pt(30,160),B=Pt(220,178),C=Pt(262,62),D=Pt(92,28),K=mid(A,B),L=mid(B,C),Mm=mid(C,D),Nn=mid(D,A),c=Pt(150,105);
  return FIG(SP([A,B,C,D])+SP([K,L,Mm,Nn])+SL(A,C,'x')+LB(A,'A',c)+LB(B,'B',c)+LB(C,'C',c)+LB(D,'D',c)+LB(K,'K',c)+LB(L,'L',c)+LB(Mm,'M',c)+LB(Nn,'N',c),'KL ∥ AC ∥ NM (odcinki łączące środki boków w trójkątach ABC i ACD). '+AUX)}
const PROOF_G2=[
 ['W równoległoboku ABCD przekątne przecinają się w punkcie S. Wykaż, że S jest środkiem obu przekątnych.','trójkąty ABS i CDS są przystające (cecha kbk: |AB| = |CD|, kąty naprzemianległe przy AB i CD są równe).',figPara],
 ['Wykaż, że środkowa trójkąta dzieli go na dwa trójkąty o równych polach.','oba trójkąty mają tę samą wysokość opuszczoną z wierzchołka A i równe podstawy |BM| = |MC|.',figMedian],
 ['W trójkącie prostokątnym ABC (kąt prosty przy C) poprowadzono wysokość CD. Wykaż, że |AC|² = |AD| · |AB|.','trójkąty ADC i ACB są podobne (wspólny kąt A i kąt prosty), więc |AD| : |AC| = |AC| : |AB|.',figAlt],
 ['Wykaż, że kąt wpisany oparty na półokręgu jest kątem prostym.','połącz C ze środkiem M średnicy AB: trójkąty AMC i BMC są równoramienne, więc 2α + 2β = 180°, czyli α + β = 90°.',figHyp],
 ['Cięciwy AB i CD okręgu przecinają się w punkcie P. Wykaż, że |AP| · |PB| = |CP| · |PD|.','dorysuj cięciwy AC i BD. Trójkąty APC i DPB są podobne (kąty wpisane ∢CAB = ∢CDB oraz kąty wierzchołkowe przy P).',figChords],
 ['Z punktu P leżącego poza okręgiem o środku O poprowadzono dwie styczne do okręgu w punktach A i B. Wykaż, że |PA| = |PB|.','dorysuj promienie OA, OB i odcinek OP. Trójkąty OAP i OBP są prostokątne, mają wspólną przeciwprostokątną OP i równe przyprostokątne OA = OB, więc są przystające.',figTangents],
 ['W trójkącie równoramiennym ABC (|AC| = |BC|) poprowadzono wysokość CD. Wykaż, że D jest środkiem AB i że CD jest dwusieczną kąta ACB.','trójkąty ADC i BDC są prostokątne, mają wspólną przyprostokątną CD i równe przeciwprostokątne, więc są przystające.',figIso],
 ['Wykaż, że środki boków dowolnego czworokąta wypukłego są wierzchołkami równoległoboku.','dorysuj przekątną AC. W trójkącie ABC: KL ∥ AC i |KL| = ½|AC|; w trójkącie ACD: NM ∥ AC i |NM| = ½|AC|. Zatem KL i NM są równoległe i równe.',figVarignon],
 ['Wykaż, że suma miar kątów wewnętrznych n-kąta wypukłego jest równa (n − 2) · 180°.','z jednego wierzchołka poprowadź wszystkie przekątne: dzielą one wielokąt na n − 2 trójkątów, a w każdym suma kątów to 180°.']];
/* ---------- nowe typy ---------- */
function gSymPoint(){let x,y;do{x=riNZ(-7,7);y=riNZ(-7,7)}while(x===y);const t=ri(0,4);const[n,p]=[['osi Ox',[x,-y]],['osi Oy',[-x,y]],['początku układu współrzędnych',[-x,-y]],['prostej y = x',[y,x]]][Math.min(t,3)];
  if(t===4){const s=[ri(-4,4),ri(-4,4)];return{q:`Punkt B jest obrazem punktu A = (${N(x)}, ${N(y)}) w symetrii względem punktu S = (${N(s[0])}, ${N(s[1])}). Wyznacz współrzędne punktu B.`,a:`B = (${N(2*s[0]-x)}, ${N(2*s[1]-y)})<br>${hint('S jest środkiem odcinka AB')}`}}
  return{q:`Wyznacz współrzędne punktu symetrycznego do punktu A = (${N(x)}, ${N(y)}) względem ${n}.`,a:`(${N(p[0])}, ${N(p[1])})`}}
function gPolygon(){const n=ri(5,12),m=ri(0,2);if(m===0)return{q:`Oblicz miarę kąta wewnętrznego ${n}-kąta foremnego oraz liczbę jego przekątnych.`,a:`kąt = ${fH(F((n-2)*180,n))}°${(n-2)*180%n?' ≈ '+dec((n-2)*180/n)+'°':''}, przekątnych: ${n*(n-3)/2}<br>${hint('kąt = (n − 2) · 180° / n, przekątnych n(n − 3)/2')}`};
  if(m===1)return{q:`Wielokąt wypukły ma ${n*(n-3)/2} przekątnych. Ile ma boków?`,a:`${n}<br>${hint(`n(n − 3)/2 = ${n*(n-3)/2}, równanie kwadratowe`)}`};
  const k=pick([3,4,5,6,8,9,10,12]);return{q:`Kąt wewnętrzny wielokąta foremnego ma miarę ${(k-2)*180/k}°. Ile boków ma ten wielokąt?`,a:`${k}<br>${hint('kąt zewnętrzny = 180° − kąt wewnętrzny = 360°/n')}`}}
function gSimilarArea(){const a=ri(2,6),b=(x=>x===a?x+1:x)(ri(2,9)),P=ri(3,20);return rnd()<.5?{q:`Trójkąty ABC i A′B′C′ są podobne w skali ${fH(F(b,a))}. Pole trójkąta ABC jest równe ${P}. Oblicz pole trójkąta A′B′C′.`,a:`${fH(F(P*b*b,a*a))}<br>${hint('stosunek pól to kwadrat skali')}`}
  :{q:`Pola dwóch wielokątów podobnych są równe ${a*a*P} i ${b*b*P}. Oblicz skalę podobieństwa (drugi do pierwszego) i stosunek ich obwodów.`,a:`k = ${fH(F(b,a))}, stosunek obwodów = ${fH(F(b,a))}`}}
function gSeqMono(){const p=riNZ(-5,5),r=ri(0,5);let q;do q=ri(-9,9);while(p*r-q===0);const D=p*r-q;
  return{q:`Zbadaj monotoniczność ciągu określonego wzorem a<sub>n</sub> = ${fr(poly([p,q],'n'),poly([1,r],'n'))} dla n ≥ 1.`,a:`ciąg jest ${D>0?'rosnący':'malejący'}<br>${hint(`a<sub>n+1</sub> − a<sub>n</sub> = ${fr(N(D),`(${poly([1,r],'n')})(${poly([1,r+1],'n')})`)} ${D>0?'> 0':'< 0'}`)}`}}
function gExpFn(){const b=pick([2,3,F(1,2),F(1,3)]),p=ri(-3,3),q=ri(-4,4),B=toF(b),bs=B.d===1?''+B.n:`(${fH(B)})`,v0=fadd(F(B.d===1?B.n**0:1),F(0));
  const f0=fadd(B.d===1?(p<=0?F(B.n**(-p)):F(1,B.n**p)):(p<=0?F(1,B.d**(-p)):F(B.d**p)),F(q));
  return{q:`Funkcja f jest określona wzorem f(x) = ${bs}<sup>${sh(p)}</sup>${term(q,'')}. Podaj zbiór wartości funkcji, równanie asymptoty poziomej jej wykresu, oblicz f(0) i określ monotoniczność.`,
  a:`ZW = (${N(q)}, +∞), asymptota y = ${N(q)}, f(0) = ${fH(f0)}, funkcja jest ${B.d===1?'rosnąca':'malejąca'}<br>${hint(`wykres y = ${bs}<sup>x</sup> przesunięty o ${N(p)} w poziomie i ${N(q)} w pionie`)}`}}
function gAbsParam(){const k=ri(1,8),t=ri(0,2),Q=['dokładnie cztery rozwiązania','dokładnie trzy rozwiązania','dokładnie dwa rozwiązania'][t],A=[`m ∈ (0, ${k*k})`,`m = ${k*k}`,`m ∈ {0} ∪ (${k*k}, +∞)`][t];
  return{q:`Wyznacz wszystkie wartości parametru m, dla których równanie |x² − ${k*k}| = m ma ${Q}.`,a:`${A}<br>${hint(`narysuj wykres y = |x² − ${k*k}| (parabola odbita w górę między ${M}${k} a ${k}, lokalne maksimum ${k*k} w x = 0) i przecinaj go prostymi y = m`)}`}}
function gWordPerm(){const w=pick(['MATURA','KAJAK','ANANAS','PAPUGA','BANAN','LALKA','KAKAO','TATAR','POTOP','KALINA']),perm=new Set(),go=(s,r)=>{if(!r.length){perm.add(s);return}for(let i=0;i<r.length;i++)go(s+r[i],r.slice(0,i)+r.slice(i+1))};go('',w);
  const all=[...perm],cnt={};[...w].forEach(c=>cnt[c]=(cnt[c]||0)+1),rep=Object.entries(cnt).filter(e=>e[1]>1),L=rep[0][0];
  const m=ri(0,2);let q,k;if(m===0){q=`Ile różnych „słów” (niekoniecznie mających sens) można ułożyć, przestawiając wszystkie litery wyrazu ${w}?`;k=all.length}
  else if(m===1){q=`Ile różnych „słów” można ułożyć z liter wyrazu ${w} (używając wszystkich liter), w których litery ${L} stoją obok siebie?`;k=all.filter(s=>new RegExp(L+'{'+cnt[L]+'}').test(s)).length}
  else{q=`Ile różnych „słów” można ułożyć z liter wyrazu ${w} (używając wszystkich liter), które zaczynają się od litery ${w[0]}?`;k=all.filter(s=>s[0]===w[0]).length}
  return{q,a:`${k}<br>${hint(`permutacje z powtórzeniami: ${w.length}! / (${rep.map(e=>e[1]+'!').join(' · ')})`+(m===1?`; sklej litery ${L} w jeden blok`:''))}`}}
function gVector(){const u=[ri(-5,5),ri(-5,5)],v=[ri(-5,5),ri(-5,5)],a=riNZ(-3,3),b=riNZ(-3,3),w=[a*u[0]+b*v[0],a*u[1]+b*v[1]],dot=u[0]*v[0]+u[1]*v[1];
  return{q:`Dane są wektory u = [${N(u[0])}, ${N(u[1])}] i v = [${N(v[0])}, ${N(v[1])}]. Wyznacz współrzędne wektora ${lead(a,'u')} ${b<0?'−':'+'} ${Math.abs(b)===1?'':Math.abs(b)}v, oblicz jego długość i sprawdź, czy wektory u i v są prostopadłe.`,
  a:`[${N(w[0])}, ${N(w[1])}], długość = ${sq(w[0]**2+w[1]**2)}; u · v = ${N(dot)}, więc wektory ${dot===0?'są':'nie są'} prostopadłe`}}

/* ---------- nowe działy podstawy: wyrażenia algebraiczne, notacja wykładnicza, proporcjonalność odwrotna ---------- */
function gShortMult(){const m=ri(0,3),a=ri(1,4),b=riNZ(-6,6),B=Math.abs(b),ax=a===1?'x':a+'x',sgn=b<0?'−':'+';
  if(m===0)return{q:`Zapisz wyrażenie (${ax} ${sgn} ${B})² w postaci sumy algebraicznej.`,a:poly([a*a,2*a*b,b*b]),
    s:[`Wzór skróconego mnożenia: (p ${sgn} q)² = p² ${sgn} 2pq + q².`,`Tu p = ${ax}, q = ${B}: (${ax})² ${sgn} 2 · ${ax} · ${B} + ${B}².`,`Wynik: ${poly([a*a,2*a*b,b*b])}.`,`Częsty błąd: (p ${sgn} q)² ≠ p² ${sgn} q² — nie zapominaj o wyrazie 2pq.`]};
  if(m===1)return{q:`Zapisz wyrażenie (${ax} − ${B})(${ax} + ${B}) w postaci sumy algebraicznej.`,a:poly([a*a,0,-B*B]),
    s:[`Wzór skróconego mnożenia: (p − q)(p + q) = p² − q².`,`(${ax})² − ${B}² = ${poly([a*a,0,-B*B])}.`]};
  if(m===2){const c=riNZ(-5,5),k=riNZ(-4,4),v=2*c*k+c*c+B*B;
    return{q:`Uprość wyrażenie (${sh(-c)})² − (x − ${B})(x + ${B}) i oblicz jego wartość dla x = ${N(k)}.`,a:`${poly([2*c,c*c+B*B])}; dla x = ${N(k)} wartość ${N(v)}`,
    s:[`(${sh(-c)})² = ${poly([1,2*c,c*c])} (kwadrat sumy/różnicy).`,`(x − ${B})(x + ${B}) = x² − ${B*B} (różnica kwadratów).`,`Odejmujemy (uwaga na nawias i zmianę znaków): ${poly([1,2*c,c*c])} − x² + ${B*B} = ${poly([2*c,c*c+B*B])}.`,`Dla x = ${N(k)}: ${N(2*c)} · ${pN(k)} + ${c*c+B*B} = ${N(v)}.`]}}
  if(rnd()<.5)return{q:`Rozłóż na czynniki: ${poly([a*a,0,-B*B])}`,a:`(${ax} − ${B})(${ax} + ${B})`,s:[`Wyrażenie ma postać p² − q², gdzie p = ${ax}, q = ${B}.`,`p² − q² = (p − q)(p + q), więc ${poly([a*a,0,-B*B])} = (${ax} − ${B})(${ax} + ${B}).`]};
  return{q:`Rozłóż na czynniki: ${poly([a*a,2*a*b,b*b])}`,a:`(${ax} ${sgn} ${B})²`,s:[`Pierwszy i ostatni wyraz to kwadraty: ${a*a===1?'x²':a*a+'x²'} = (${ax})², ${b*b} = ${B}².`,`Środkowy wyraz ${N(2*a*b)}x = ${sgn==='−'?M:''}2 · ${ax} · ${B}, więc to wzór (p ${sgn} q)² = p² ${sgn} 2pq + q².`,`${poly([a*a,2*a*b,b*b])} = (${ax} ${sgn} ${B})².`]}}
function gIrrDen(){const m=pick([2,3,5,6,7,10,11]),k=ri(1,6);
  if(rnd()<.35){const f=F(k,m);return{q:`Usuń niewymierność z mianownika: ${fr(k,'√'+m)}`,a:fsq(f,m),s:[`Mnożymy licznik i mianownik przez √${m} (to nie zmienia wartości ułamka).`,`${fr(`${k}√${m}`,`√${m} · √${m}`)} = ${fr(`${k===1?'':k}√${m}`,m)}${f.d!==m?' = '+fsq(f,m):''}.`]}}
  let n;do n=ri(1,3);while(n*n===m);const D=m-n*n,c=F(k,D),minus=rnd()<.5,den=`√${m} ${minus?'−':'+'} ${n}`,conj=`√${m} ${minus?'+':'−'} ${n}`;
  const res=c.d===1?(c.n===1?'':c.n===-1?M:N(c.n))+`(${conj})`:(c.n<0?M:'')+fr(`${Math.abs(c.n)===1?'':Math.abs(c.n)}(${conj})`,c.d);
  return{q:`Usuń niewymierność z mianownika: ${fr(k,den)}`,a:res,
  s:[`Mnożymy licznik i mianownik przez sprzężenie mianownika: ${conj}.`,`Mianownik: (${den})(${conj}) = (√${m})² − ${n}² = ${m} − ${n*n} = ${N(D)} (wzór (p − q)(p + q) = p² − q²).`,`${fr(`${k===1?'':k}(${conj})`,N(D))} = ${res}.`]}}
function gSciNot(){const m=ri(0,2);
  if(m===0){const a=ri(2,9),b=ri(2,9),e1=ri(-6,8),e2=ri(-6,8),P=a*b,big=P>=10,c=big?dec(P/10):''+P,e=e1+e2+(big?1:0);
    return{q:`Oblicz iloczyn (${a} · 10<sup>${N(e1)}</sup>) · (${b} · 10<sup>${N(e2)}</sup>) i zapisz wynik w notacji wykładniczej.`,a:`${c} · 10<sup>${N(e)}</sup>`,
    s:[`Mnożymy osobno liczby i potęgi dziesiątki: ${a} · ${b} = ${P}, 10<sup>${N(e1)}</sup> · 10<sup>${N(e2)}</sup> = 10<sup>${N(e1+e2)}</sup>.`,big?`W notacji wykładniczej pierwszy czynnik musi być z przedziału ⟨1, 10): ${P} = ${c} · 10, więc wynik to ${c} · 10<sup>${N(e1+e2)} + 1</sup> = ${c} · 10<sup>${N(e)}</sup>.`:`${P} ∈ ⟨1, 10), więc wynik ma już właściwą postać: ${P} · 10<sup>${N(e)}</sup>.`]}}
  const d1=ri(1,9),d2=ri(1,9),e=ri(3,8);
  if(m===1){const s=`0,${'0'.repeat(e-1)}${d1}${d2}`;return{q:`Zapisz liczbę ${s} w notacji wykładniczej.`,a:`${d1},${d2} · 10<sup>${M}${e}</sup>`,
    s:[`Szukamy postaci a · 10<sup>k</sup>, gdzie 1 ≤ a < 10, czyli a = ${d1},${d2}.`,`Żeby z ${d1},${d2} dostać ${s}, przesuwamy przecinek o ${e} miejsc w lewo, czyli dzielimy przez 10<sup>${e}</sup>.`,`${s} = ${d1},${d2} · 10<sup>${M}${e}</sup>.`]}}
  const s=`${d1}${d2}${'0'.repeat(e-1)}`;return{q:`Zapisz liczbę ${s} w notacji wykładniczej.`,a:`${d1},${d2} · 10<sup>${e}</sup>`,
    s:[`Szukamy postaci a · 10<sup>k</sup>, gdzie 1 ≤ a < 10, czyli a = ${d1},${d2}.`,`Żeby z ${d1},${d2} dostać ${s}, przesuwamy przecinek o ${e} miejsc w prawo.`,`${s} = ${d1},${d2} · 10<sup>${e}</sup>.`]}}
function gInverse(){const m=ri(0,2);
  if(m===1){const n=pick([2,3,4,5,6,8,10,12]),d=pick([3,4,5,6,8,9,10,12,15]),T=n*d,ms=[];for(let i=2;i<=30;i++)if(T%i===0&&i!==n)ms.push(i);const w=pick(ms);
    return{q:`${n} jednakowo pracujących robotników wykonuje pewną pracę w ${d} dni. W ile dni wykona tę samą pracę ${w} takich robotników?`,a:`${T/w} dni`,
    s:[`Liczba robotników i czas pracy są odwrotnie proporcjonalne: im więcej robotników, tym krócej — ich iloczyn jest stały.`,`Cała praca to ${n} · ${d} = ${T} „robotnikodni”.`,`${w} robotników potrzebuje ${fr(T,w)} = ${T/w} dni.`]}}
  const p=riNZ(-6,6),q=riNZ(-6,6),a=p*q,ds=[];for(let i=-12;i<=12;i++)if(i&&a%i===0&&i!==p)ds.push(i);const k=pick(ds);
  if(m===0)return{q:`Wykres funkcji f(x) = ${fr('a','x')} przechodzi przez punkt P = (${N(p)}, ${N(q)}). Wyznacz a, oblicz f(${N(k)}) i podaj, w których ćwiartkach układu współrzędnych leży wykres.`,a:`a = ${N(a)}, f(${N(k)}) = ${N(a/k)}, ćwiartki ${a>0?'I i III':'II i IV'}`,
    s:[`P leży na wykresie, więc f(${N(p)}) = ${N(q)}: ${fr('a',N(p))} = ${N(q)}, czyli a = ${N(p)} · ${pN(q)} = ${N(a)}.`,`f(${N(k)}) = ${fr(N(a),N(k))} = ${N(a/k)}.`,`a ${a>0?'> 0: x i y mają te same znaki, więc wykres (hiperbola) leży w I i III ćwiartce':'< 0: x i y mają przeciwne znaki, więc wykres (hiperbola) leży w II i IV ćwiartce'}.`]};
  return{q:`Wielkości x i y są odwrotnie proporcjonalne. Dla x = ${N(p)} wartość y = ${N(q)}. Oblicz y dla x = ${N(k)}.`,a:`y = ${N(a/k)}`,
    s:[`Odwrotna proporcjonalność: x · y = a (stała), czyli y = ${fr('a','x')}.`,`a = ${N(p)} · ${pN(q)} = ${N(a)}.`,`Dla x = ${N(k)}: y = ${fr(N(a),N(k))} = ${N(a/k)}.`]}}

/* ---------- trudniejsze typy na rozszerzenie ---------- */
function gSetsR(){for(let t=0;;t++){const a=ri(-4,4),b=ri(1,5),[p,q]=distinct(2,-6,6).sort((x,y)=>x-y),r1=pick(['<','<=']),r2=pick(['>','>=']);
  const inA=x=>{const d=Math.abs(x-a);return r1==='<'?d<b-1e-9:d<=b+1e-9},fq=x=>(x-p)*(x-q),inB=x=>r2==='>'?fq(x)>1e-9:fq(x)>=-1e-9,pts=[a-b,a+b,p,q];
  const ops=shuffle([['A ∩ B',x=>inA(x)&&inB(x)],['A ∪ B',x=>inA(x)||inB(x)],['A \\ B',x=>inA(x)&&!inB(x)],['B \\ A',x=>inB(x)&&!inA(x)]]).slice(0,2),res=ops.map(([n,f])=>`${n} = ${setStr(f,pts)}`);
  if(res.some(r=>r.endsWith('∅'))&&t<30)continue;
  return{q:`Dane są zbiory A = {x ∈ ℝ: |${sh(a)}| ${REL[r1]} ${b}} oraz B = {x ∈ ℝ: ${poly(expand([p,q]))} ${REL[r2]} 0}. Wyznacz ${ops[0][0]} oraz ${ops[1][0]}.`,a:res.join('<br>'),
  s:[`A: |${sh(a)}| ${REL[r1]} ${b} ⇔ ${N(a-b)} ${REL[r1]} x ${REL[r1]} ${N(a+b)}, więc A = ${setStr(inA,pts)}.`,`B: ${poly(expand([p,q]))} = (${sh(p)})(${sh(q)}), parabola z ramionami w górę, więc B = ${setStr(inB,pts)}.`,`Zaznaczamy oba zbiory na jednej osi i uważnie sprawdzamy końce przedziałów.`,...res.map(r=>r+'.')]}}}
const ABSQ=(()=>{const o=[];for(let p=2;p<=10;p++)for(let q=1;q<=30;q++){const u=p*p+4*q,w=p*p-4*q,su=Math.round(Math.sqrt(u)),sw=w>0?Math.round(Math.sqrt(w)):-1;if(su*su===u&&sw>0&&sw*sw===w)o.push([p,q])}return o})();
function gAbsQuad(){const[p,q]=pick(ABSQ),sgn=rnd()<.5?1:-1,P=sgn*p,rel=pick(['<','<=','>','>=','=']),f=x=>x*x-P*x;
  const t1=Math.round(Math.sqrt(p*p+4*q)),t2=Math.round(Math.sqrt(p*p-4*q)),R=[(P-t1)/2,(P+t1)/2],S=[(P-t2)/2,(P+t2)/2],pts=[...R,...S];
  const cmp={'<':v=>v<q-1e-9,'<=':v=>v<=q+1e-9,'>':v=>v>q+1e-9,'>=':v=>v>=q-1e-9,'=':v=>Math.abs(v-q)<1e-9}[rel],ans=rel==='='?`x ∈ {${pts.slice().sort((x,y)=>x-y).map(N).join(', ')}}`:`x ∈ ${setStr(x=>cmp(Math.abs(f(x))),pts)}`,ex=poly([1,-P,0]);
  return{q:`Rozwiąż ${rel==='='?'równanie':'nierówność'} |${ex}| ${rel==='='?'=':REL[rel]} ${q}.`,a:ans,
  s:[rel==='='?`|u| = ${q} ⇔ u = ${q} lub u = −${q}.`:rel[0]==='<'?`|u| ${REL[rel]} ${q} ⇔ −${q} ${REL[rel]} u ${REL[rel]} ${q}, czyli dwie nierówności naraz.`:`|u| ${REL[rel]} ${q} ⇔ u ${REL[rel]} ${q} lub u ${REL[{'>':'<','>=':'<='}[rel]]} −${q}.`,
    `${ex} − ${q} = 0: Δ = ${p*p+4*q}, pierwiastki ${N(R[0])} i ${N(R[1])}.`,`${ex} + ${q} = 0: Δ = ${p*p-4*q}, pierwiastki ${N(S[0])} i ${N(S[1])}.`,
    rel==='='?'Wszystkie cztery liczby są rozwiązaniami.':`Rozwiązujemy obie nierówności kwadratowe (parabole z ramionami w górę) i bierzemy ${rel[0]==='<'?'część wspólną':'sumę'} rozwiązań.`,`Odpowiedź: ${ans}.`]}}
function gLinParam2(){const k=ri(1,4),ds=[];for(let i=1;i<=k*k;i++)if(k*k%i===0)ds.push(i,-i);let a=pick(ds);const c=k*k/a;let b,d;
  if(rnd()<.6){d=riNZ(-4,4);b=rnd()<.5?d*k/c:-d*k/c;if(!Number.isInteger(b)){b=d*k;d=d*c}}else{b=riNZ(-6,6);d=riNZ(-6,6)}
  const cons=m=>b*c===d*m,txt=m=>cons(m)?'nieskończenie wiele rozwiązań (równania opisują tę samą prostą)':'brak rozwiązań (proste równoległe)';
  return{q:`Zbadaj liczbę rozwiązań układu równań<br>mx${term(a,'y')} = ${N(b)}<br>${lead(c,'x')} + my = ${N(d)}<br>w zależności od parametru m.`,
  a:`m ∉ {${M}${k}, ${k}}: dokładnie jedno rozwiązanie; m = ${k}: ${txt(k)}; m = ${M}${k}: ${txt(-k)}`,
  s:[`Wyznacznik główny: W = m · m − ${pN(a)} · ${pN(c)} = m² − ${k*k}.`,`W ≠ 0 ⇔ m ≠ ±${k}: wtedy układ ma dokładnie jedno rozwiązanie.`,`m = ${k}: układ to ${k}x${term(a,'y')} = ${N(b)} i ${lead(c,'x')}${term(k,'y')} = ${N(d)}. Współczynniki przy x i y są proporcjonalne; sprawdzamy, czy wyrazy wolne też: ${cons(k)?'tak':'nie'}, więc ${txt(k)}.`,`m = ${M}${k}: układ to ${M}${k}x${term(a,'y')} = ${N(b)} i ${lead(c,'x')}${term(-k,'y')} = ${N(d)}; wyrazy wolne ${cons(-k)?'są':'nie są'} proporcjonalne, więc ${txt(-k)}.`]}}
function gRemainder2(){const[a,b]=(()=>{let t;do t=distinct(2,-4,4);while(t.includes(0));return t.sort((x,y)=>x-y)})(),r=riNZ(-5,5),s=ri(-8,8),pa=r*a+s,pb=r*b+s;
  return{q:`Reszta z dzielenia wielomianu W przez dwumian (${sh(a)}) jest równa ${N(pa)}, a reszta z dzielenia W przez dwumian (${sh(b)}) jest równa ${N(pb)}. Wyznacz resztę z dzielenia W przez wielomian ${poly(expand([a,b]))}.`,a:`R(x) = ${poly([r,s])}`,
  s:[`Dzielnik ${poly(expand([a,b]))} = (${sh(a)})(${sh(b)}) jest stopnia 2, więc reszta ma postać R(x) = px + q, a W(x) = (${sh(a)})(${sh(b)}) · Q(x) + px + q.`,`Z twierdzenia o reszcie: W(${N(a)}) = ${N(pa)} i W(${N(b)}) = ${N(pb)}.`,`Podstawiamy: ${N(a)}p + q = ${N(pa)} oraz ${N(b)}p + q = ${N(pb)}.`,`Odejmujemy: ${N(b-a)}p = ${N(pb-pa)}, więc p = ${N(r)}, q = ${N(s)}.`,`R(x) = ${poly([r,s])}.`]}}
/* podstawa: więcej typów w działach, w których było ich mało */
function gAbsB2(){const a=pick([2,3,4]),b=riNZ(-9,9),c=ri(1,9),rel=pick(RELS),L=F(b-c,a),R=F(b+c,a),ans=signSolve([{v:L},{v:R}],1,rel);
  return{q:`Rozwiąż nierówność |${a}x ${b<0?'+':'−'} ${Math.abs(b)}| ${REL[rel]} ${c}`,a:ans,
  s:[rel[0]==='<'?`|u| ${REL[rel]} ${c} ⇔ −${c} ${REL[rel]} u ${REL[rel]} ${c}: −${c} ${REL[rel]} ${a}x ${b<0?'+':'−'} ${Math.abs(b)} ${REL[rel]} ${c}.`:`|u| ${REL[rel]} ${c} ⇔ u ${REL[rel]} ${c} lub u ${REL[{'>':'<','>=':'<='}[rel]]} −${c}.`,`Dodajemy ${N(b)} do każdej strony i dzielimy przez ${a} > 0 (znak się nie zmienia).`,`Punkty graniczne: x = ${fr(`${N(b)} − ${c}`,a)} = ${fH(L)} oraz x = ${fr(`${N(b)} + ${c}`,a)} = ${fH(R)}.`,`Odpowiedź: ${ans}`]}}
function gLineProps(){const a=pick([F(1),F(-1),F(2),F(-2),F(3),F(-3),F(1,2),F(-1,2),F(1,3),F(2,3),F(-3,2)]),x0=ri(-6,6)||3,b=fmul(fmul(F(-1),a),F(x0)),bs=poly([a,b]),Pt=fmul(F(Math.abs(x0)),F(Math.abs(b.n),2*b.d));
  return{q:`Funkcja liniowa jest określona wzorem f(x) = ${bs}. Wyznacz miejsce zerowe, punkt przecięcia wykresu z osią Oy, określ monotoniczność i oblicz pole trójkąta, który wykres tworzy z osiami układu współrzędnych.`,
  a:`x<sub>0</sub> = ${N(x0)}, (0, ${fH(b)}), funkcja ${a.n>0?'rosnąca':'malejąca'}, P = ${fH(Pt)}`,
  s:[`Miejsce zerowe: ${bs} = 0 ⇔ x = ${N(x0)}.`,`Przecięcie z osią Oy: f(0) = ${fH(b)}, czyli punkt (0, ${fH(b)}).`,`Współczynnik kierunkowy a = ${fH(a)} ${a.n>0?'> 0, więc funkcja jest rosnąca':'< 0, więc funkcja jest malejąca'}.`,`Trójkąt ma przyprostokątne ${Math.abs(x0)} i ${fH(F(Math.abs(b.n),b.d))}: P = ½ · ${Math.abs(x0)} · ${fH(F(Math.abs(b.n),b.d))} = ${fH(Pt)}.`]}}
function gLineParamB(){const p=pick([1,2,3,-1,-2,-3]),q=ri(-8,8),c=ri(-5,5),ty=pick(['rosnąca','malejąca','stała']),m0=F(-q,p),rel=ty==='stała'?'=':(ty==='rosnąca')===(p>0)?'>':'<';
  const ans=ty==='stała'?`m = ${fH(m0)}`:`m ${rel} ${fH(m0)}`;
  return{q:`Wyznacz wszystkie wartości parametru m, dla których funkcja f(x) = (${poly([p,q],'m')})x${term(c,'')} jest ${ty}.`,a:ans,
  s:[`Funkcja liniowa f(x) = ax + b jest rosnąca, gdy a > 0, malejąca, gdy a < 0, i stała, gdy a = 0.`,`Tu a = ${poly([p,q],'m')}, więc warunek: ${poly([p,q],'m')} ${ty==='stała'?'=':ty==='rosnąca'?'>':'<'} 0.`,p<0&&ty!=='stała'?`Dzielimy przez ${p} < 0 i zmieniamy zwrot nierówności: ${ans}.`:`${ans}.`]}}

/* ---------- dodatkowe dowody (z pełnym rozwiązaniem) ---------- */
const staticProof=L=>()=>{const[q,h,s]=pick(L);return{q,a:hint(h),s}};
const PROOF_B2=[
 ['Wykaż, że dla każdej liczby całkowitej n liczba n² − n jest parzysta.','n² − n = (n − 1)n.',['n² − n = n(n − 1).','n − 1 i n to dwie kolejne liczby całkowite, więc jedna z nich jest parzysta.','Iloczyn, w którym jeden czynnik jest parzysty, jest parzysty. ∎']],
 ['Wykaż, że suma czterech kolejnych liczb całkowitych nie jest podzielna przez 4.','n + (n + 1) + (n + 2) + (n + 3) = 4n + 6.',['Oznaczmy liczby: n, n + 1, n + 2, n + 3, gdzie n jest całkowite.','Suma: 4n + 6 = 4(n + 1) + 2.','4(n + 1) dzieli się przez 4, więc suma daje resztę 2 z dzielenia przez 4 — nie jest podzielna przez 4. ∎']],
 ['Wykaż, że kwadrat każdej liczby nieparzystej przy dzieleniu przez 8 daje resztę 1.','(2k + 1)² = 4k(k + 1) + 1.',['Liczba nieparzysta: 2k + 1, gdzie k jest całkowite.','(2k + 1)² = 4k² + 4k + 1 = 4k(k + 1) + 1.','k(k + 1) to iloczyn dwóch kolejnych liczb całkowitych, więc jest parzysty: k(k + 1) = 2m.','Zatem (2k + 1)² = 8m + 1, czyli reszta z dzielenia przez 8 wynosi 1. ∎']],
 ['Wykaż, że dla każdej liczby rzeczywistej x prawdziwa jest nierówność x² + 4 ≥ 4x.','x² − 4x + 4 = (x − 2)².',['Przenosimy wszystko na lewą stronę: x² − 4x + 4 ≥ 0.','x² − 4x + 4 = (x − 2)² (kwadrat różnicy).','Kwadrat liczby rzeczywistej jest nieujemny, więc nierówność jest prawdziwa dla każdego x. ∎']],
 ['Wykaż, że jeśli a > b > 0, to (a + 1)/(b + 1) < a/b.','pomnóż obie strony przez b(b + 1) > 0.',['b > 0 i b + 1 > 0, więc mnożymy obie strony przez dodatnią liczbę b(b + 1), nie zmieniając zwrotu.','Dostajemy b(a + 1) < a(b + 1), czyli ab + b < ab + a.','To jest równoważne b < a, co jest prawdą z założenia. ∎']],
 ['Wykaż, że dla każdej liczby naturalnej n liczba 2<sup>n+2</sup> − 2<sup>n</sup> jest podzielna przez 3.','wyłącz 2<sup>n</sup> przed nawias.',['2<sup>n+2</sup> = 4 · 2<sup>n</sup>.','2<sup>n+2</sup> − 2<sup>n</sup> = 2<sup>n</sup>(4 − 1) = 3 · 2<sup>n</sup>.','Liczba ma czynnik 3, więc jest podzielna przez 3. ∎']],
 ['Wykaż, że dla każdej liczby naturalnej n liczba 5<sup>n+1</sup> + 5<sup>n</sup> jest podzielna przez 6.','wyłącz 5<sup>n</sup> przed nawias.',['5<sup>n+1</sup> + 5<sup>n</sup> = 5<sup>n</sup>(5 + 1) = 6 · 5<sup>n</sup>.','Liczba ma czynnik 6, więc dzieli się przez 6. ∎']],
 ['Wykaż, że jeśli a + b = 1, to a² + b² ≥ ½.','podstaw b = 1 − a i zwiń do pełnego kwadratu.',['Z założenia b = 1 − a.','a² + b² = a² + (1 − a)² = 2a² − 2a + 1.','2a² − 2a + 1 = 2(a − ½)² + ½.','Kwadrat jest nieujemny, więc 2(a − ½)² + ½ ≥ ½. ∎']],
 ['Wykaż, że dla dowolnych liczb rzeczywistych a, b prawdziwa jest nierówność (a + b)² ≤ 2(a² + b²).','2(a² + b²) − (a + b)² = (a − b)².',['Badamy różnicę prawej i lewej strony: 2a² + 2b² − (a² + 2ab + b²).','= a² − 2ab + b² = (a − b)² ≥ 0.','Różnica jest nieujemna, więc prawa strona jest nie mniejsza od lewej. ∎']],
 ['Wykaż, że różnica liczby dwucyfrowej i liczby zapisanej tymi samymi cyframi w odwrotnej kolejności jest podzielna przez 9.','(10a + b) − (10b + a) = 9(a − b).',['Liczba dwucyfrowa o cyfrach a (dziesiątki) i b (jedności) to 10a + b. Po przestawieniu cyfr: 10b + a.','Różnica: 10a + b − 10b − a = 9a − 9b = 9(a − b).','To wielokrotność 9. ∎']],
 ['Wykaż, że suma liczby dwucyfrowej i liczby zapisanej tymi samymi cyframi w odwrotnej kolejności jest podzielna przez 11.','(10a + b) + (10b + a) = 11(a + b).',['Liczby: 10a + b oraz 10b + a.','Suma: 11a + 11b = 11(a + b).','To wielokrotność 11. ∎']],
 ['Trójkąt ma boki długości 3k, 4k i 5k, gdzie k > 0. Wykaż, że jest to trójkąt prostokątny.','sprawdź twierdzenie odwrotne do twierdzenia Pitagorasa.',['Najdłuższy bok to 5k.','(3k)² + (4k)² = 9k² + 16k² = 25k² = (5k)².','Z twierdzenia odwrotnego do twierdzenia Pitagorasa trójkąt jest prostokątny (kąt prosty naprzeciw boku 5k). ∎']]];
const PROOF_A2=[
 ['Wykaż, że dla dowolnych liczb rzeczywistych a, b prawdziwa jest nierówność a⁴ + b⁴ ≥ a³b + ab³.','a⁴ + b⁴ − a³b − ab³ = (a − b)²(a² + ab + b²).',['Przenosimy wszystko na lewą stronę: a⁴ − a³b + b⁴ − ab³ ≥ 0.','Grupujemy: a³(a − b) − b³(a − b) = (a − b)(a³ − b³).','a³ − b³ = (a − b)(a² + ab + b²), więc wyrażenie = (a − b)²(a² + ab + b²).','(a − b)² ≥ 0, a a² + ab + b² = (a + b/2)² + 3b²/4 ≥ 0, więc iloczyn jest nieujemny. ∎']],
 ['Wykaż, że dla każdej liczby całkowitej n liczba n⁴ + 2n³ − n² − 2n jest podzielna przez 24.','to iloczyn czterech kolejnych liczb całkowitych.',['n⁴ + 2n³ − n² − 2n = n³(n + 2) − n(n + 2) = n(n + 2)(n² − 1).','= (n − 1)n(n + 1)(n + 2) — iloczyn czterech kolejnych liczb całkowitych.','Wśród czterech kolejnych liczb są dwie parzyste, z których jedna jest podzielna przez 4, więc iloczyn dzieli się przez 8.','Wśród nich jest też liczba podzielna przez 3. Ponieważ NWD(8, 3) = 1, iloczyn dzieli się przez 24. ∎']],
 ['Wykaż, że dla każdej liczby całkowitej n liczba n³ + 5n jest podzielna przez 6.','n³ + 5n = (n³ − n) + 6n.',['n³ + 5n = (n³ − n) + 6n.','n³ − n = (n − 1)n(n + 1) to iloczyn trzech kolejnych liczb całkowitych, więc dzieli się przez 2 i przez 3, czyli przez 6.','6n też dzieli się przez 6, więc suma dzieli się przez 6. ∎']],
 ['Wykaż, że jeśli x > 0, y > 0 i x + y = 2, to 1/x + 1/y ≥ 2.','1/x + 1/y = 2/(xy), a xy ≤ 1.',['1/x + 1/y = (x + y)/(xy) = 2/(xy).','Z nierówności między średnimi (albo z (x − y)² ≥ 0): xy ≤ ((x + y)/2)² = 1.','xy ∈ (0, 1⟩, więc 2/(xy) ≥ 2. ∎']],
 ['Wykaż, że równanie x³ + x − 1 = 0 ma dokładnie jedno rozwiązanie rzeczywiste.','f(x) = x³ + x − 1 jest rosnąca, a f(0) i f(1) mają różne znaki.',['Niech f(x) = x³ + x − 1. f′(x) = 3x² + 1 > 0, więc f jest rosnąca na ℝ i ma co najwyżej jedno miejsce zerowe.','f(0) = −1 < 0, f(1) = 1 > 0, a f jest ciągła.','Z własności Darboux f ma miejsce zerowe w przedziale (0, 1).','Zatem równanie ma dokładnie jedno rozwiązanie. ∎']],
 ['Wykaż, że dla każdej liczby x > 0 prawdziwa jest nierówność x + 4/x² ≥ 3.','zbadaj najmniejszą wartość funkcji f(x) = x + 4/x² za pomocą pochodnej.',['Niech f(x) = x + 4/x², x > 0. f′(x) = 1 − 8/x³ = (x³ − 8)/x³.','f′(x) < 0 dla x ∈ (0, 2), f′(x) > 0 dla x > 2, więc w x = 2 jest minimum.','f(2) = 2 + 4/4 = 3, więc f(x) ≥ 3 dla każdego x > 0. ∎']],
 ['Wykaż, że liczba log<sub>2</sub>3 jest niewymierna.','załóż, że log<sub>2</sub>3 = p/q, i doprowadź do sprzeczności parzystości.',['Przypuśćmy, że log<sub>2</sub>3 = p/q, gdzie p, q są naturalne (log<sub>2</sub>3 > 0).','Wtedy 2<sup>p/q</sup> = 3, czyli 2<sup>p</sup> = 3<sup>q</sup>.','Lewa strona jest parzysta (p ≥ 1), a prawa nieparzysta — sprzeczność.','Zatem log<sub>2</sub>3 jest niewymierny. ∎']],
 ['Wykaż, że dla dowolnych liczb dodatnich a, b prawdziwa jest nierówność a/b + b/a ≥ 2.','pomnóż przez ab > 0.',['ab > 0, więc mnożymy obie strony przez ab: a² + b² ≥ 2ab.','a² − 2ab + b² = (a − b)² ≥ 0 — prawda.','Przekształcenia były równoważne, więc wyjściowa nierówność jest prawdziwa. ∎']]];
const PROOF_G3=[
 ['Przekątne trapezu ABCD (AB ∥ CD) przecinają się w punkcie S. Wykaż, że |AS| : |SC| = |AB| : |CD|.','trójkąty ABS i CDS są podobne.',['Kąty ∢BAS i ∢DCS są naprzemianległe (AB ∥ CD), więc są równe. Tak samo ∢ABS = ∢CDS.','Kąty ∢ASB i ∢CSD są wierzchołkowe, więc równe.','Trójkąty ABS i CDS są podobne (cecha kkk), więc |AS| : |CS| = |AB| : |CD|. ∎']],
 ['Wykaż, że pole równoległoboku o bokach a, b i kącie ostrym α jest równe ab · sin α.','wysokość opuszczona na bok a ma długość b · sin α.',['Pole równoległoboku: P = a · h, gdzie h to wysokość opuszczona na bok a.','Wysokość, bok b i część boku a tworzą trójkąt prostokątny, w którym h jest naprzeciw kąta α: h = b · sin α.','P = a · b · sin α. ∎']],
 ['Wykaż, że przekątne rombu są prostopadłe.','wierzchołki B i D są równo oddalone od A i od C.',['W rombie ABCD: |AB| = |BC| i |AD| = |DC|.','Punkt B jest równo oddalony od A i C, więc leży na symetralnej odcinka AC. Tak samo punkt D.','Zatem prosta BD jest symetralną odcinka AC, czyli BD ⊥ AC. ∎']],
 ['W trójkącie ABC środkowa CM ma długość równą połowie boku AB. Wykaż, że kąt ACB jest prosty.','|MA| = |MB| = |MC| — trójkąty AMC i BMC są równoramienne.',['M jest środkiem AB, więc |MA| = |MB| = |MC|.','Trójkąt AMC jest równoramienny: ∢MAC = ∢MCA = α. Trójkąt BMC też: ∢MBC = ∢MCB = β.','Suma kątów trójkąta ABC: α + β + (α + β) = 180°, więc α + β = 90°.','∢ACB = α + β = 90°. ∎']],
 ['Wykaż, że pole trójkąta o bokach a, b, c wpisanego w okrąg o promieniu R jest równe abc/(4R).','P = ½ab · sin γ oraz twierdzenie sinusów.',['P = ½ · a · b · sin γ, gdzie γ to kąt między bokami a i b (naprzeciw boku c).','Z twierdzenia sinusów: c / sin γ = 2R, więc sin γ = c/(2R).','P = ½ · a · b · c/(2R) = abc/(4R). ∎']],
 ['Wykaż, że pole trójkąta jest równe r · p, gdzie r to promień okręgu wpisanego, a p to połowa obwodu.','połącz środek okręgu wpisanego z wierzchołkami.',['Niech I będzie środkiem okręgu wpisanego. Odcinki IA, IB, IC dzielą trójkąt na trójkąty ABI, BCI, CAI.','Każdy z nich ma wysokość r (promień jest prostopadły do boku w punkcie styczności).','P = ½ar + ½br + ½cr = r · (a + b + c)/2 = r · p. ∎']]];

/* ---------- działy ---------- */
/* ---------- UZUPEŁNIENIE WYMAGAŃ CKE (podstawa programowa 2019, matura od 2023) ---------- */
const pl=(n,one,few,many)=>{n=Math.abs(n);return n===1?one:(n%10>=2&&n%10<=4&&(n%100<12||n%100>14))?few:many};
const pmul=(a,b)=>{const o=Array(a.length+b.length-1).fill(0);a.forEach((x,i)=>b.forEach((y,j)=>o[i+j]+=x*y));return o};
const padd=(a,b,s=1)=>{const n=Math.max(a.length,b.length),A=Array(n-a.length).fill(0).concat(a),B=Array(n-b.length).fill(0).concat(b);return A.map((x,i)=>x+s*B[i])};
const pp=r=>r===0?'x':`(${sh(r)})`;
const plusN=(x,c)=>c===0?N(x):N(x)+(c<0?' − '+(-c):' + '+c);
const sqT=(a,v='x')=>a===0?v+'²':`(${sh(a,v)})²`;
const sqF=(f,v='x')=>{f=toF(f);return f.n===0?v+'²':`(${v} ${f.n>0?'−':'+'} ${fH(F(Math.abs(f.n),f.d))})²`};
const bn=(n,k)=>`<span class="nwp">(</span><span class="fr nw"><span>${n}</span><span>${k}</span></span><span class="nwp">)</span>`;
const genEq=(A,B,Cc)=>{let s=A?lead(A,'x'):'';if(B)s+=s?term(B,'y'):lead(B,'y');return s+term(Cc,'')+' = 0'};
const genCirc=(a,b,r2)=>`x² + y²${term(-2*a,'x')}${term(-2*b,'y')}${term(a*a+b*b-r2,'')} = 0`;
const pt=(x,y)=>`(${fH(x)}, ${fH(y)})`;
const mcV=(stem,okS,okV,W,ex)=>mc(stem,okS,W.filter(w=>w[1]!==okV).map(w=>w[0]),ex);
const lattice=r=>{const P=[];for(let x=-r;x<=r;x++){const y=Math.round(Math.sqrt(r*r-x*x));if(x*x+y*y===r*r){P.push([x,y]);if(y)P.push([x,-y])}}return P};

/* --- podstawa: liczby, przedziały, przybliżenia --- */
function gIntervals(){const[p1,p2,p3,p4]=distinct(4,-9,9).sort((x,y)=>x-y),aL=rnd()<.5,aR=rnd()<.5,bL=rnd()<.5,bR=rnd()<.5;
  const iv=(l,x,y,r)=>`${l?'⟨':'('}${N(x)}, ${N(y)}${r?'⟩':')'}`,A=iv(aL,p1,p3,aR),B=iv(bL,p2,p4,bR),I=iv(bL,p2,p3,aR),U=iv(aL,p1,p4,bR),AB=iv(aL,p1,p2,!bL);
  const ints=[];for(let n=p2;n<=p3;n++)if((n>p2||bL)&&(n<p3||aR))ints.push(n);
  return{q:`Dane są przedziały A = ${A} oraz B = ${B}. Wyznacz A ∩ B, A ∪ B oraz A \\ B. Ile liczb całkowitych należy do zbioru A ∩ B?`,
  a:`A ∩ B = ${I}, A ∪ B = ${U}, A \\ B = ${AB}; liczb całkowitych w A ∩ B: ${ints.length}`,
  s:[`Zaznaczamy oba przedziały na jednej osi: A od ${N(p1)} do ${N(p3)}, B od ${N(p2)} do ${N(p4)}. Nawias ⟨ ⟩ (kółko zamalowane) oznacza, że koniec należy do zbioru, a nawias ( ) (kółko puste), że nie należy.`,
    `Część wspólna to fragment zaznaczony dwa razy: od ${N(p2)} (początek B) do ${N(p3)} (koniec A): ${I}.`,`Suma to wszystko, co zaznaczone choć raz: ${U}.`,
    `A \\ B to liczby z A, których nie ma w B: od ${N(p1)} do ${N(p2)}. Liczba ${N(p2)} ${bL?'należy do B, więc jej nie bierzemy':'nie należy do B, więc ją bierzemy'}: ${AB}.`,
    `Liczby całkowite w A ∩ B: ${ints.length?ints.map(N).join(', '):'brak'}, czyli ${ints.length}.`]}}
function cMonoPow(){const B=[['2',1],['3',1],['5',1],['√2',1],['1,5',1],[fr(1,2),-1],[fr(2,3),-1],['0,7',-1],[fr(3,5),-1],['0,2',-1]],E=[-3,-2,-1,F(-1,2),F(1,3),F(1,2),1,F(3,2),2,3];
  const[b,d]=pick(B),[i,j]=distinct(2,0,E.length-1),bb=b.includes('fr')?`(${b})`:b,lt=(d>0)===(i<j);
  return mc(`Dane są liczby x = ${bb}<sup>${fH(E[i])}</sup> oraz y = ${bb}<sup>${fH(E[j])}</sup>. Wtedy`,lt?'x < y':'x > y',[lt?'x > y':'x < y','x = y','x · y < 0'],`podstawa ${d>0?'jest większa od 1, więc potęgowanie jest rosnące: większy wykładnik daje większą potęgę':'należy do (0, 1), więc potęgowanie jest malejące: większy wykładnik daje mniejszą potęgę'}`)}
function gApprox(){let v,ap;do{v=ri(105,995);ap=Math.round(v/10)*10}while(v===ap);const ab=Math.abs(v-ap),rel=ab/v*100,d2=n=>(n/100).toFixed(2).replace('.',','),rs=rel.toFixed(2).replace('.',',');
  return{q:`Liczbę ${d2(v)} zaokrąglono do części dziesiątych. Oblicz błąd bezwzględny i błąd względny tego przybliżenia (błąd względny podaj w procentach z dokładnością do 0,01%).`,
  a:`przybliżenie ${dec(ap/100)}, błąd bezwzględny ${d2(ab)}, błąd względny ≈ ${rs}%`,
  s:[`Zaokrąglamy do części dziesiątych: ${d2(v)} ≈ ${dec(ap/100)}.`,`Błąd bezwzględny: |x − a| = |${d2(v)} − ${dec(ap/100)}| = ${d2(ab)}.`,`Błąd względny: ${fr('|x − a|','|x|')} · 100% = ${fr(d2(ab),d2(v))} · 100% ≈ ${rs}%.`]}}
function cPctPoints(){const p=pick([2,4,5,10]);let d;do d=ri(1,p===10?6:3)*(rnd()<.35?-1:1);while(p+d<=0);const q=p+d,rel=Math.abs(d/p*100),w=d>0?'wzrosło':'zmalało',ad=Math.abs(d),pp_=x=>pl(x,'punkt procentowy','punkty procentowe','punktów procentowych');
  return pf(`Oprocentowanie kredytu ${w} z ${p}% do ${q}%.`,shuffle([[`Oprocentowanie ${w} o ${ad} ${pp_(ad)}.`,true],[`Oprocentowanie ${w} o ${ad}%.`,false],[`Oprocentowanie ${w} o ${rel}%.`,true],[`Oprocentowanie ${w} o ${rel} ${pp_(rel)}.`,false]]).slice(0,3))}

/* --- podstawa: wielomiany i wyrażenia wymierne --- */
function gGroupFactor(){let k,c,b,r0;do{k=pick([1,1,2,3]);c=riNZ(-6,6);b=pick([1,2,3,4,5,7,9,16,25,-1,-4,-9]);r0=F(-c,k)}while(gcd(k,c)!==1||(b>0&&simp(b).m===1&&r0.d===1&&Math.abs(r0.n)===Math.sqrt(b)));
  const cs=[k,c,-k*b,-c*b],L=poly([k,c]),ab=Math.abs(b),R=[[r0.n/r0.d,fH(r0)]];if(b>0)R.push([-Math.sqrt(b),M+sq(b)],[Math.sqrt(b),sq(b)]);R.sort((u,v)=>u[0]-v[0]);
  const fact=b>0?`(${L})(x − ${sq(b)})(x + ${sq(b)})`:`(${L})(x² + ${ab})`;
  return{q:`Rozłóż wielomian W(x) = ${poly(cs)} na czynniki metodą grupowania wyrazów i rozwiąż równanie W(x) = 0.`,
  a:`W(x) = ${fact}; ${b>0?'x ∈ {'+R.map(r=>r[1]).join(', ')+'}':`jedyne rozwiązanie x = ${fH(r0)} (x² + ${ab} > 0)`}`,
  s:[`Grupujemy wyrazy po dwa: W(x) = (${poly([k,c,0,0])}) ${b>0?'−':'+'} (${poly([ab*k,ab*c])}) = x²(${L}) ${b>0?'−':'+'} ${ab===1?'':ab}(${L}).`,`Wyłączamy wspólny czynnik: W(x) = (${L})(x² ${b>0?'−':'+'} ${ab}).`,
    b>0?`x² − ${ab} = (x − ${sq(b)})(x + ${sq(b)}), więc W(x) = ${fact}.`:`x² + ${ab} > 0 dla każdego x, więc ten czynnik nie daje rozwiązań.`,
    `${L} = 0 ⇒ x = ${fH(r0)}${b>0?`; x² = ${ab} ⇒ x = ${M}${sq(b)} lub x = ${sq(b)}`:''}.`]}}
function gPolyDivB(){const a=riNZ(-4,4),Q=[pick([1,2,-1,3]),ri(-5,5),ri(-6,6)],R=rnd()<.5?0:riNZ(-9,9),W=[Q[0],Q[1]-a*Q[0],Q[2]-a*Q[1],R-a*Q[2]];
  return{q:`Podziel wielomian W(x) = ${poly(W)} przez dwumian (${sh(a)}). Podaj iloraz i resztę.`,a:`iloraz: ${poly(Q)}, reszta: ${N(R)}`,
  s:[`Schemat Hornera dla a = ${N(a)}; współczynniki W: ${W.map(N).join(', ')}.`,`Pierwszy współczynnik przepisujemy: ${N(Q[0])}. Następne: ${N(W[1])} + ${pN(a)} · ${pN(Q[0])} = ${N(Q[1])}; ${N(W[2])} + ${pN(a)} · ${pN(Q[1])} = ${N(Q[2])}; reszta: ${N(W[3])} + ${pN(a)} · ${pN(Q[2])} = ${N(R)}.`,
    `Iloraz: ${poly(Q)}, reszta: ${N(R)}. Sprawdzenie: W(${N(a)}) = ${N(ev(W,a))} (twierdzenie o reszcie).`]}}
function gIntRootsB(){const r=riNZ(-4,4),p=ri(-4,4),q=riNZ(-6,6),W=[1,p-r,q-p*r,-q*r],c=Math.abs(W[3]),ds=[];for(let d=1;d<=c;d++)if(c%d===0)ds.push(d,-d);
  const rt=ds.filter(d=>ev(W,d)===0).sort((x,y)=>x-y);
  return{q:`Wyznacz wszystkie pierwiastki całkowite wielomianu W(x) = ${poly(W)}.`,a:rt.map(N).join(', '),
  s:[`Pierwiastek całkowity wielomianu o współczynnikach całkowitych jest dzielnikiem wyrazu wolnego (${N(W[3])}).`,`Kandydaci: ${ds.map(N).join(', ')}.`,`Sprawdzamy (np. schematem Hornera): ${rt.map(d=>`W(${N(d)}) = 0`).join(', ')}; pozostałe dzielniki dają wartości różne od zera.`,`Pierwiastki całkowite: ${rt.map(N).join(', ')}.`]}}
function gPolyOps(){const W=[riNZ(-3,3),ri(-5,5),riNZ(-5,5)],P=[riNZ(-3,3),riNZ(-5,5)],k=riNZ(-3,3),pr=pmul(W,P),kp=P.map(x=>-k*x),dk=padd(W,kp),kk=`${k>0?'−':'+'} ${Math.abs(k)===1?'':Math.abs(k)}P(x)`;
  return{q:`Dane są wielomiany W(x) = ${poly(W)} oraz P(x) = ${poly(P)}. Wyznacz wielomiany W(x) · P(x) oraz W(x) ${kk} i podaj ich stopnie.`,
  a:`W(x) · P(x) = ${poly(pr)} (stopień 3), W(x) ${kk} = ${poly(dk)} (stopień 2)`,
  s:[`Mnożymy każdy wyraz pierwszego wielomianu przez każdy wyraz drugiego i redukujemy wyrazy podobne: (${poly(W)})(${poly(P)}) = ${poly(pr)}.`,`${kk} = ${poly(kp)}.`,`W(x) ${kk} = ${poly(W)} ${poly(kp).startsWith(M)?'− '+poly(kp).slice(1):'+ '+poly(kp)} = ${poly(dk)}.`,`Stopień iloczynu to suma stopni: 2 + 1 = 3. Stopień drugiego wielomianu to 2.`]}}
function gRatSimp(){let a,c,d;do{a=riNZ(-6,6);c=ri(-6,6);d=ri(-6,6)}while(d===a||c===-d);let x0;do x0=ri(-4,5);while(x0===a||x0===d);
  const nu=expand([a,-c]),de=expand([a,d]),Dm=[...new Set([a,d])].sort((x,y)=>x-y),res=fr(sh(-c),sh(d)),v=F(x0+c,x0-d);
  return{q:`Dane jest wyrażenie ${fr(poly(nu),poly(de))}. Wyznacz jego dziedzinę, zapisz je w najprostszej postaci i oblicz jego wartość dla x = ${N(x0)}.`,
  a:`dziedzina: x ∈ ℝ \\ {${Dm.map(N).join(', ')}}; po skróceniu ${res}; wartość dla x = ${N(x0)}: ${fH(v)}`,
  s:[`Rozkładamy mianownik: ${poly(de)} = ${pp(a)}${pp(d)}. Mianownik nie może być zerem, więc x ≠ ${N(a)} i x ≠ ${N(d)}.`,`Rozkładamy licznik: ${poly(nu)} = ${pp(a)}${pp(-c)}.`,`Skracamy wspólny czynnik ${pp(a)}: ${res}.`,`Dla x = ${N(x0)}: ${fr(plusN(x0,c),plusN(x0,-d))} = ${fH(v)}.`]}}
function gRatAddB(){const[r1,r2]=distinct(2,-5,5),A=riNZ(-5,5),B0=ri(1,5),sgn=sg(),B=sgn*B0,num=[A+B,-(A*r2+B*r1)],den=expand([r1,r2]);
  return{q:`Wykonaj działanie i zapisz wynik w postaci jednego ułamka: ${fr(N(A),sh(r1))} ${sgn>0?'+':'−'} ${fr(B0,sh(r2))}. Podaj, dla jakich x wyrażenie ma sens.`,
  a:`${fr(poly(num),poly(den))}, dla x ≠ ${N(Math.min(r1,r2))} i x ≠ ${N(Math.max(r1,r2))}`,
  s:[`Wspólny mianownik: ${pp(r1)}${pp(r2)} = ${poly(den)}; musi być x ≠ ${N(r1)} i x ≠ ${N(r2)}.`,`Rozszerzamy ułamki: ${fr(`${N(A)}${pp(r2)}`,`${pp(r1)}${pp(r2)}`)} ${sgn>0?'+':'−'} ${fr(`${B0}${pp(r1)}`,`${pp(r1)}${pp(r2)}`)}.`,`Licznik: ${N(A)}${pp(r2)} ${sgn>0?'+':'−'} ${B0}${pp(r1)} = ${poly(num)}.`]}}
function gRatEqB(){const[a,b,c]=distinct(3,-6,6),d=rnd()<.6?a:ri(-6,6),ex=[...new Set([c,d])].sort((x,y)=>x-y),sol=[a,b].filter(x=>!ex.includes(x)).sort((x,y)=>x-y),bad=[a,b].filter(x=>ex.includes(x));
  return{q:`Rozwiąż równanie ${fr(`${pp(a)}${pp(b)}`,`${pp(c)}${pp(d)}`)} = 0.`,a:`x = ${sol.map(N).join(' lub x = ')}`,
  s:[`Dziedzina: mianownik ≠ 0, więc x ≠ ${ex.map(N).join(' i x ≠ ')}.`,`Ułamek jest równy zeru, gdy licznik jest równy zeru: x = ${N(a)} lub x = ${N(b)}.`,bad.length?`x = ${N(bad[0])} nie należy do dziedziny, więc go odrzucamy.`:'Oba należą do dziedziny.',`Odpowiedź: x = ${sol.map(N).join(' lub x = ')}.`]}}

/* --- podstawa: równania, przekształcanie wzorów, układy --- */
const FORMULAS=[['P = '+fr('(a + b) · h',2),'h',fr('2P','a + b')],['P = '+fr('(a + b) · h',2),'a',fr('2P','h')+' − b'],['V = '+fr('πr²h',3),'h',fr('3V','πr²')],
  [fr(1,'R')+' = '+fr(1,'R<sub>1</sub>')+' + '+fr(1,'R<sub>2</sub>'),'R',fr('R<sub>1</sub>R<sub>2</sub>','R<sub>1</sub> + R<sub>2</sub>')],['s = vt + '+fr('at²',2),'a',fr('2(s − vt)','t²')],
  ['E = '+fr('mv²',2),'v','√('+fr('2E','m')+')'],['a<sub>n</sub> = a<sub>1</sub> + (n − 1)r','n',fr('a<sub>n</sub> − a<sub>1</sub>','r')+' + 1'],['S<sub>n</sub> = '+fr('(a<sub>1</sub> + a<sub>n</sub>) · n',2),'a<sub>n</sub>',fr('2S<sub>n</sub>','n')+' − a<sub>1</sub>'],
  ['P = 2πr² + 2πrh','h',fr('P − 2πr²','2πr')],['K = K<sub>0</sub>(1 + p)²','p','√('+fr('K','K<sub>0</sub>')+') − 1'],['F = '+fr('9','5')+'C + 32','C',fr('5(F − 32)',9)]];
function gFormula(){if(rnd()<.5){const[f,v,ans]=pick(FORMULAS);return{q:`Przekształć wzór ${f} tak, aby wyznaczyć ${v} (wszystkie występujące wielkości są dodatnie).`,a:`${v} = ${ans}`}}
  const a=riNZ(-5,5),b=riNZ(-6,6);let d;do d=riNZ(-5,5);while(a*d===b);const nu=poly([-d,b],'y'),de=poly([1,-a],'y');
  return{q:`Wyznacz x z równania y = ${fr(poly([a,b]),poly([1,d]))} (x ≠ ${N(-d)}).`,a:`x = ${fr(nu,de)}, dla y ≠ ${N(a)}`,
  s:[`Mnożymy obie strony przez (${poly([1,d])}): y(${poly([1,d])}) = ${poly([a,b])}, czyli xy ${d<0?'−':'+'} ${Math.abs(d)===1?'':Math.abs(d)}y = ${poly([a,b])}.`,`Wyrazy z x przenosimy na lewą stronę, resztę na prawą: xy ${a>0?'−':'+'} ${Math.abs(a)===1?'':Math.abs(a)}x = ${nu}.`,`x(${de}) = ${nu}, więc x = ${fr(nu,de)} (y ≠ ${N(a)}).`]}}
function cIdentity(){const T=['tożsamościowe','sprzeczne','ma dokładnie jedno rozwiązanie'],used=new Set(),st=[];
  while(st.length<3){const a=riNZ(2,5)*sg(),b=riNZ(-6,6),t=ri(0,2),k=riNZ(-5,5);let R;
    if(t===0)R=poly([a,a*b]);else if(t===1)R=poly([a,a*b+k]);else{let m;do m=riNZ(-6,6);while(m===a);R=poly([m,ri(-9,9)])}
    const E=`${N(a)}(${poly([1,b])}) = ${R}`;if(used.has(E))continue;used.add(E);const cl=rnd()<.5?t:pick([0,1,2].filter(x=>x!==t));
    st.push([`Równanie ${E} ${cl===2?'':'jest '}${T[cl]}.`,cl===t])}
  return pf('Dane są równania z niewiadomą x.',st)}
function gSysType(){const t=ri(0,2),a=riNZ(-4,4),b=riNZ(-4,4),x=ri(-4,4),y=ri(-4,4),c=a*x+b*y,k=pick([2,-2,3,-1,-3]);let a2,b2,c2;
  if(t===0){do{a2=riNZ(-4,4);b2=riNZ(-4,4)}while(a*b2-a2*b===0);c2=a2*x+b2*y}else{a2=k*a;b2=k*b;c2=t===1?k*c:k*c+riNZ(-5,5)}
  const E=(p,q,r)=>`${lead(p,'x')}${term(q,'y')} = ${N(r)}`;
  const ans=t===0?`układ oznaczony (jedno rozwiązanie): x = ${N(x)}, y = ${N(y)}; proste przecinają się w punkcie (${N(x)}, ${N(y)})`:t===1?'układ nieoznaczony (nieskończenie wiele rozwiązań); proste się pokrywają':'układ sprzeczny (brak rozwiązań); proste są równoległe i różne';
  return{q:`Określ liczbę rozwiązań układu równań<br>${E(a,b,c)}<br>${E(a2,b2,c2)}<br>i podaj jego interpretację geometryczną.`,a:ans,
  s:t===0?[`Współczynniki przy x i y nie są proporcjonalne: ${N(a)} · ${pN(b2)} − ${pN(a2)} · ${pN(b)} = ${N(a*b2-a2*b)} ≠ 0, więc układ ma dokładnie jedno rozwiązanie.`,`Rozwiązujemy go (np. metodą przeciwnych współczynników): x = ${N(x)}, y = ${N(y)}.`,`Proste przecinają się w jednym punkcie (${N(x)}, ${N(y)}).`]
   :[`Lewa strona drugiego równania to lewa strona pierwszego pomnożona przez ${N(k)}.`,`Prawa strona: ${N(c2)} ${t===1?'=':'≠'} ${N(k)} · ${pN(c)} = ${N(k*c)}.`,t===1?'Równania są równoważne, więc każda para (x, y) spełniająca pierwsze równanie jest rozwiązaniem. Proste się pokrywają.':'Równania są sprzeczne: ta sama lewa strona (z dokładnością do mnożnika) daje różne wartości. Proste są równoległe i nie mają punktów wspólnych.']}}
function gSysLineCircle(){const r=pick([5,5,10,13,25]),P=lattice(r);let A,B;do{A=pick(P);B=pick(P)}while(A===B||A[0]===B[0]||(B[1]-A[1])%(B[0]-A[0]));
  const p=ri(-3,3),q=ri(-3,3),x1=A[0]+p,y1=A[1]+q,x2=B[0]+p,y2=B[1]+q,m=(y2-y1)/(x2-x1),n=y1-m*x1,qa=1+m*m,qb=-2*p+2*m*(n-q),qc=p*p+(n-q)**2-r*r,pts=[[x1,y1],[x2,y2]].sort((u,v)=>u[0]-v[0]),yt=poly([m,n-q]);
  return{q:`Wyznacz współrzędne punktów wspólnych prostej y = ${poly([m,n])} i okręgu ${sqT(p)} + ${sqT(q,'y')} = ${r*r}.`,a:pts.map(([x,y])=>`(${N(x)}, ${N(y)})`).join(' oraz '),
  s:[`Podstawiamy y = ${poly([m,n])} do równania okręgu: ${sqT(p)} + ${yt==='0'?'0':`(${yt})²`} = ${r*r}.`,`Po uporządkowaniu: ${poly([qa,qb,qc])} = 0.`,...deltaSteps(qa,qb,qc),`Obliczamy y z równania prostej: ${pts.map(([x,y])=>`x = ${N(x)} ⇒ y = ${N(y)}`).join('; ')}.`]}}
function gSysLinePara(){const a=pick([1,-1,2]),b=ri(-4,4),c=ri(-5,5),[x1,x2]=distinct(2,-4,4).sort((u,v)=>u-v),f=x=>a*x*x+b*x+c,m=a*(x1+x2)+b,n=f(x1)-m*x1;
  return{q:`Rozwiąż układ równań:<br>y = ${poly([a,b,c])}<br>y = ${poly([m,n])}<br>Podaj interpretację geometryczną rozwiązania.`,a:`(x, y) = (${N(x1)}, ${N(f(x1))}) lub (${N(x2)}, ${N(f(x2))}) — to punkty przecięcia paraboli z prostą`,
  s:[`Porównujemy prawe strony: ${poly([a,b,c])} = ${poly([m,n])}, czyli ${poly([a,b-m,c-n])} = 0.`,...deltaSteps(a,b-m,c-n),`Z równania prostej: dla x = ${N(x1)} y = ${N(f(x1))}, dla x = ${N(x2)} y = ${N(f(x2))}.`]}}
function gSysWord(){const t=ri(0,2);
  if(t===0){const x=ri(2,15),y=ri(2,15),a1=ri(1,5),b1=ri(1,5);let a2,b2;do{a2=ri(1,5);b2=ri(1,5)}while(a1*b2===a2*b1);const s=n=>`${n} ${pl(n,'sztukę','sztuki','sztuk')}`;
    return{q:`Za ${s(a1)} towaru A i ${s(b1)} towaru B zapłacono ${a1*x+b1*y} zł, a za ${s(a2)} towaru A i ${s(b2)} towaru B zapłacono ${a2*x+b2*y} zł. Oblicz cenę jednej sztuki każdego towaru.`,a:`A: ${x} zł, B: ${y} zł`,
    s:[`Oznaczamy: x — cena towaru A, y — cena towaru B.`,`${lead(a1,'x')} + ${lead(b1,'y')} = ${a1*x+b1*y}<br>${lead(a2,'x')} + ${lead(b2,'y')} = ${a2*x+b2*y}`,`Rozwiązujemy układ (np. metodą przeciwnych współczynników): x = ${x}, y = ${y}.`]}}
  if(t===1){const a=ri(1,7),b=ri(a+1,9);return{q:`Suma cyfr liczby dwucyfrowej jest równa ${a+b}. Jeśli przestawimy jej cyfry, otrzymamy liczbę większą o ${9*(b-a)}. Wyznacz tę liczbę.`,a:`${10*a+b}`,
    s:[`Oznaczamy cyfrę dziesiątek przez a, a cyfrę jedności przez b. Liczba to 10a + b, po przestawieniu 10b + a.`,`a + b = ${a+b}<br>(10b + a) − (10a + b) = ${9*(b-a)}, czyli 9(b − a) = ${9*(b-a)}, b − a = ${b-a}.`,`Dodajemy równania: 2b = ${2*b}, b = ${b}, a = ${a}. Liczba: ${10*a+b}.`]}}
  const x=ri(3,20),y=ri(3,20),[u,v]=pick([[2,5],[1,2],[2,5],[5,10]]);return{q:`W skarbonce jest ${x+y} monet o nominałach ${u} zł i ${v} zł o łącznej wartości ${u*x+v*y} zł. Ile jest monet każdego rodzaju?`,a:`${x} monet po ${u} zł i ${y} monet po ${v} zł`,
    s:[`x — liczba monet ${u} zł, y — liczba monet ${v} zł.`,`x + y = ${x+y}<br>${u===1?'':u}x + ${v}y = ${u*x+v*y}`,`Z pierwszego: x = ${x+y} − y. Podstawiamy: ${u}(${x+y} − y) + ${v}y = ${u*x+v*y}, ${v-u}y = ${u*x+v*y-u*(x+y)}, y = ${y}, x = ${x}.`]}}

/* --- podstawa: funkcja kwadratowa, logarytmiczna --- */
function gQuadForms(){const a=pick([1,-1,2,-2,3,-3]),[x1,x2]=distinct(2,-6,6).sort((u,v)=>u-v),cs=expand([x1,x2],a),p=F(x1+x2,2),q=F(-a*(x2-x1)**2,4);
  const can=`${lead(a,'')}${sqF(p)}${q.n===0?'':(q.n<0?' − ':' + ')+fH(F(Math.abs(q.n),q.d))}`,ilo=`${lead(a,'')}${pp(x1)}${pp(x2)}`;
  return{q:`Zapisz funkcję kwadratową f(x) = ${poly(cs)} w postaci kanonicznej i w postaci iloczynowej.`,a:`postać kanoniczna: f(x) = ${can}; postać iloczynowa: f(x) = ${ilo}`,
  s:[...deltaSteps(...cs),`Wierzchołek: p = ${fr('−b','2a')} = ${fH(p)}, q = ${fr('−Δ','4a')} = ${fH(q)}.`,`Postać kanoniczna: f(x) = a(x − p)² + q = ${can}.`,`Postać iloczynowa: f(x) = a(x − x<sub>1</sub>)(x − x<sub>2</sub>) = ${ilo}.`]}}
function gQuadFromVertex(){const a=pick([1,-1,2,-2,3,-3]),p=ri(-4,4),q=ri(-6,6),d=pick([1,2,-1,-2,3,-3]),x0=p+d,y0=a*d*d+q,cs=[a,-2*a*p,a*p*p+q],qq=q?(q<0?' − ':' + ')+Math.abs(q):'';
  return{q:`Wierzchołkiem paraboli będącej wykresem funkcji kwadratowej f jest punkt W = (${N(p)}, ${N(q)}), a do wykresu należy punkt A = (${N(x0)}, ${N(y0)}). Wyznacz wzór funkcji f w postaci ogólnej i podaj jej przedziały monotoniczności.`,
  a:`f(x) = ${poly(cs)}; f jest ${a>0?'malejąca':'rosnąca'} w (${M}∞, ${N(p)}⟩ i ${a>0?'rosnąca':'malejąca'} w ⟨${N(p)}, +∞)`,
  s:[`Postać kanoniczna: f(x) = a${sqT(p)}${qq}.`,`Podstawiamy punkt A: ${N(y0)} = a · ${pN(d)}²${qq}, więc ${d*d}a = ${N(y0-q)} i a = ${N(a)}.`,`f(x) = ${lead(a,'')}${sqT(p)}${qq} = ${poly(cs)}.`,`a ${a>0?'> 0, ramiona w górę: funkcja maleje do wierzchołka, potem rośnie':'< 0, ramiona w dół: funkcja rośnie do wierzchołka, potem maleje'}.`]}}
function gQuadOptPrice(){let p0,xs,k,n0;do{p0=ri(15,40);xs=ri(2,10);k=pick([5,10,20]);n0=k*(p0-2*xs)}while(n0<50);const pr=p0-xs,R=pr*(n0+k*xs);
  return{q:`Kino sprzedaje bilety po ${p0} zł i przychodzi wtedy ${n0} widzów. Każda obniżka ceny biletu o 1 zł zwiększa liczbę widzów o ${k}. Przy jakiej cenie biletu przychód kina będzie największy? Oblicz ten przychód.`,a:`cena ${pr} zł, przychód ${R} zł`,
  s:[`x — liczba złotówek obniżki. Cena: ${p0} − x, liczba widzów: ${n0} + ${k}x.`,`Przychód: P(x) = (${p0} − x)(${n0} + ${k}x) = ${poly([-k,k*p0-n0,p0*n0])}.`,`To parabola o ramionach w dół; maksimum w wierzchołku: x<sub>w</sub> = ${fr(N(k*p0-n0),2*k)} = ${xs}.`,`Cena: ${p0} − ${xs} = ${pr} zł, przychód: ${pr} · ${n0+k*xs} = ${R} zł.`]}}
function gLogFn(){const A=toF(pick([2,3,4,5,F(1,2),F(1,3)])),pw=k=>k>=0?F(A.n**k,A.d**k):F(A.d**-k,A.n**-k),k=pick([2,3,-1,-2]),k2=pick([1,2,-1,3,-2].filter(x=>x!==k)),P=pw(k),X=pw(k2),bs=A.d>1?`(${fH(A)})`:fH(A);
  return{q:`Wykres funkcji f(x) = log<sub>a</sub>x przechodzi przez punkt P = (${fH(P)}, ${N(k)}). Wyznacz podstawę a, oblicz f(${fH(X)}) i określ monotoniczność funkcji f.`,
  a:`a = ${fH(A)}, f(${fH(X)}) = ${N(k2)}, funkcja f jest ${A.n>A.d?'rosnąca (a > 1)':'malejąca (0 < a < 1)'}`,
  s:[`log<sub>a</sub>${fH(P)} = ${N(k)} oznacza, że a<sup>${N(k)}</sup> = ${fH(P)}.`,`Stąd a = ${fH(A)} (podstawa logarytmu jest dodatnia i różna od 1).`,`f(${fH(X)}) = ${N(k2)}, bo ${bs}<sup>${N(k2)}</sup> = ${fH(X)}.`,`Dla a ${A.n>A.d?'> 1 funkcja logarytmiczna jest rosnąca':'∈ (0, 1) funkcja logarytmiczna jest malejąca'}.`]}}

/* --- podstawa: ciągi --- */
function gSeqCount(){const m=ri(0,2);
  if(m===0){let c,d;do{d=ri(2,7);c=ri(10,70)}while(c%d===0&&rnd()<.5);const k=Math.ceil(c/d)-1;
    return{q:`Ciąg (a<sub>n</sub>) jest określony wzorem a<sub>n</sub> = ${c} − ${d}n dla n ≥ 1. Ile wyrazów tego ciągu jest dodatnich?`,a:`${k}`,
    s:[`Rozwiązujemy nierówność ${c} − ${d}n > 0, czyli n < ${fH(F(c,d))}${c%d?` ≈ ${dec(c/d)}`:''}.`,`n jest liczbą naturalną dodatnią, więc n ∈ {1, 2, …, ${k}}.`,`Dodatnich wyrazów jest ${k}.`]}}
  if(m===1){const p=ri(1,5),q=p+ri(2,9),cs=[1,-(p+q),p*q],set=q-p-1===1?`{${p+1}}`:`{${p+1}, …, ${q-1}}`;
    return{q:`Ciąg (a<sub>n</sub>) jest określony wzorem a<sub>n</sub> = ${poly(cs,'n')} dla n ≥ 1. Ile wyrazów tego ciągu jest ujemnych? Które wyrazy są równe zeru?`,a:`ujemnych jest ${q-p-1}; a<sub>${p}</sub> = a<sub>${q}</sub> = 0`,
    s:[`a<sub>n</sub> = (n − ${p})(n − ${q}) (pierwiastki trójmianu: ${p} i ${q}).`,`Parabola ma ramiona w górę, więc wyrazy są ujemne dla ${p} < n < ${q}, czyli n ∈ ${set}.`,`Ujemnych wyrazów jest ${q-p-1}; zerowe są a<sub>${p}</sub> i a<sub>${q}</sub>.`]}}
  let s,b,c,D,cnt;do{s=pick([1,2,3]);b=ri(8,30);c=ri(1,Math.floor(b*b/(4*s)));D=b*b-4*s*c;cnt=0;for(let n=1;n<=b;n++)if(s*n*n-b*n+c<0)cnt++}while(D<=0||Number.isInteger(Math.sqrt(D))||!cnt);
  const r1=(b-Math.sqrt(D))/(2*s),r2=(b+Math.sqrt(D))/(2*s),lo=Math.max(Math.floor(r1)+1,1),hi=Math.ceil(r2)-1,cs=[s,-b,c];
  return{q:`Ciąg (a<sub>n</sub>) jest określony wzorem a<sub>n</sub> = ${poly(cs,'n')} dla n ≥ 1. Ile wyrazów tego ciągu jest ujemnych?`,a:`${cnt}`,
  s:[`Rozwiązujemy nierówność ${poly(cs,'n')} < 0.`,`Δ = ${b*b} − ${4*s*c} = ${D}, n<sub>1</sub> = ${fr(`${b} − √${D}`,2*s)} ≈ ${dec(r1)}, n<sub>2</sub> = ${fr(`${b} + √${D}`,2*s)} ≈ ${dec(r2)}.`,`Wyrazy są ujemne dla n leżących między pierwiastkami: n ∈ {${lo}, …, ${hi}}.`.replace(`{${lo}, …, ${lo}}`,`{${lo}}`),`Takich n jest ${cnt}.`]}}
function gSeqCheck(){const t=ri(0,2);
  if(t===0){const p=riNZ(-6,6),r=ri(-9,9),an=poly([p,r],'n');return{q:`Sprawdź, czy ciąg określony wzorem a<sub>n</sub> = ${an} (n ≥ 1) jest arytmetyczny, czy geometryczny. Podaj różnicę lub iloraz.`,a:`arytmetyczny, r = ${N(p)}, a<sub>1</sub> = ${N(p+r)}`,
    s:[`a<sub>n+1</sub> − a<sub>n</sub> = ${lead(p,'')}(n + 1)${tail([r])} − (${an}) = ${N(p)}.`,`Różnica jest stała (nie zależy od n), więc ciąg jest arytmetyczny o różnicy ${N(p)}.`,`a<sub>1</sub> = ${N(p+r)}, a<sub>2</sub> = ${N(2*p+r)}, a<sub>3</sub> = ${N(3*p+r)}, więc nie jest geometryczny (${N(2*p+r)}² ≠ ${pN(p+r)} · ${pN(3*p+r)}).`]}}
  if(t===1){const c=riNZ(-5,5),b=pick([2,3,-2,-3,5]),an=`${c===1?'':c===-1?M:N(c)+' · '}${pN(b)}<sup>n</sup>`;
    return{q:`Sprawdź, czy ciąg określony wzorem a<sub>n</sub> = ${an} (n ≥ 1) jest arytmetyczny, czy geometryczny. Podaj różnicę lub iloraz.`,a:`geometryczny, q = ${N(b)}, a<sub>1</sub> = ${N(c*b)}`,
    s:[`a<sub>n</sub> ≠ 0, więc badamy iloraz: ${fr('a<sub>n+1</sub>','a<sub>n</sub>')} = ${fr(`${N(c)} · ${pN(b)}<sup>n+1</sup>`,`${N(c)} · ${pN(b)}<sup>n</sup>`)} = ${N(b)}.`,`Iloraz jest stały, więc ciąg jest geometryczny o ilorazie ${N(b)}, a<sub>1</sub> = ${N(c*b)}.`,`Różnice a<sub>2</sub> − a<sub>1</sub> = ${N(c*b*b-c*b)} i a<sub>3</sub> − a<sub>2</sub> = ${N(c*b**3-c*b*b)} są różne, więc nie jest arytmetyczny.`]}}
  const k=ri(-5,5),an=poly([1,k,0],'n');return{q:`Sprawdź, czy ciąg określony wzorem a<sub>n</sub> = ${an} (n ≥ 1) jest arytmetyczny, czy geometryczny.`,a:'ani arytmetyczny, ani geometryczny',
    s:[`a<sub>n+1</sub> − a<sub>n</sub> = ${poly([2,1+k],'n')} zależy od n, więc ciąg nie jest arytmetyczny.`,`a<sub>1</sub> = ${N(1+k)}, a<sub>2</sub> = ${N(4+2*k)}, a<sub>3</sub> = ${N(9+3*k)}; a<sub>2</sub>² = ${(4+2*k)**2} ≠ a<sub>1</sub> · a<sub>3</sub> = ${N((1+k)*(9+3*k))}, więc nie jest geometryczny.`]}}
function gThreeTerms(){if(rnd()<.5){let a1,a2,a3,D;do{a1=riNZ(-3,3);a2=riNZ(-3,3);a3=riNZ(-3,3);D=2*a2-a1-a3}while(!D);const x0=ri(-5,6),b1=ri(-6,6),b2=ri(-6,6),b3=2*(a2*x0+b2)-(a1*x0+b1)-a3*x0;
    const E=[[a1,b1],[a2,b2],[a3,b3]].map(([a,b])=>poly([a,b])),V=[a1*x0+b1,a2*x0+b2,a3*x0+b3];
    return{q:`Liczby ${E.join(', ')} tworzą (w podanej kolejności) ciąg arytmetyczny. Wyznacz x oraz te liczby.`,a:`x = ${N(x0)}; liczby: ${V.map(N).join(', ')}`,
    s:[`W ciągu arytmetycznym środkowy wyraz jest średnią arytmetyczną sąsiednich: 2(${E[1]}) = (${E[0]}) + (${E[2]}).`,`${poly([2*a2,2*b2])} = ${poly([a1+a3,b1+b3])}, więc ${lead(D,'x')} = ${N(b1+b3-2*b2)} i x = ${N(x0)}.`,`Liczby: ${V.map(N).join(', ')} (różnica ${N(V[1]-V[0])}).`]}}
  const t=riNZ(-4,4),q=pick([2,3,-2,-3]),x0=ri(-4,6),U=[t,t*q,t*q*q],[al,be,ga]=U.map(u=>u-x0),E=[al,be,ga].map(c=>poly([1,c]));
  return{q:`Liczby ${E.join(', ')} tworzą (w podanej kolejności) ciąg geometryczny. Wyznacz x oraz iloraz tego ciągu.`,a:`x = ${N(x0)}; liczby: ${U.map(N).join(', ')}, q = ${N(q)}`,
  s:[`W ciągu geometrycznym kwadrat środkowego wyrazu jest równy iloczynowi sąsiednich: (${E[1]})² = (${E[0]})(${E[2]}).`,`${poly([1,2*be,be*be])} = ${poly([1,al+ga,al*ga])}, więc ${lead(2*be-al-ga,'x')} = ${N(al*ga-be*be)}.`,`x = ${N(x0)}; liczby ${U.map(N).join(', ')}, iloraz q = ${N(q)}.`]}}

/* --- podstawa: trygonometria i rozwiązywanie trójkątów --- */
const SINV={30:[1,1],45:[1,2],60:[1,3],90:[2,1],120:[1,3],135:[1,2],150:[1,1]};
const sinS=g=>{const[k,m]=SINV[g];return g===90?'1':fr(m===1?'1':'√'+m,2)};
const NICE_TRI=(()=>{const o=[];for(let a=1;a<=16;a++)for(let b=a;b<=16;b++)for(const[s,g]of[[-1,60],[1,120]]){const c2=a*a+b*b+s*a*b,c=Math.round(Math.sqrt(c2));if(c*c===c2&&(g===120||a!==b))o.push([a,b,c,g])}return o})();
function gCosLawB(){if(rnd()<.55){for(;;){const a=ri(2,10),b=ri(2,10),cs=pick([F(1,2),F(-1,2),F(1,3),F(-1,3),F(1,4),F(-1,4),F(2,3),F(1,5),F(3,5),F(-3,5)]),t=2*a*b*cs.n;if(t%cs.d)continue;const c2=a*a+b*b-t/cs.d;if(c2<=0)continue;
    return{q:`W trójkącie ABC: |AC| = ${b}, |BC| = ${a}, a cosinus kąta ACB jest równy ${fH(cs)}. Oblicz długość boku AB.`,a:`|AB| = ${sq(c2)}`,
    s:[`Twierdzenie cosinusów: |AB|² = |AC|² + |BC|² − 2 · |AC| · |BC| · cos∢ACB.`,`|AB|² = ${b*b} + ${a*a} − 2 · ${b} · ${a} · ${pF(cs)} = ${c2}.`,`|AB| = √${c2}${sq(c2)!=='√'+c2?' = '+sq(c2):''}.`]}}}
  const[a,b,c,g]=pick(NICE_TRI),k=ri(1,2);return{q:`Trójkąt ma boki długości ${a*k}, ${b*k} i ${c*k}. Oblicz miarę kąta leżącego naprzeciw boku długości ${c*k}.`,a:`${g}°`,
  s:[`Z twierdzenia cosinusów: cos γ = ${fr('a² + b² − c²','2ab')}.`,`cos γ = ${fr(`${(a*k)**2} + ${(b*k)**2} − ${(c*k)**2}`,`2 · ${a*k} · ${b*k}`)} = ${fr(N((a*a+b*b-c*c)*k*k),2*a*b*k*k)} = ${fH(F(a*a+b*b-c*c,2*a*b))}.`,`Kąt w trójkącie leży w (0°, 180°), więc γ = ${g}°.`]}}
function gSinLawB(){let al,be;do{al=pick([30,45,60,90,120,135,150]);be=pick([30,45,60,90,120,135])}while(al+be>=180||(al===be&&rnd()<.7));
  const a=ri(2,12),[ka,ma]=SINV[al],[kb,mb]=SINV[be],s=simp(ma*mb),b=fsq(F(a*kb*s.k,ka*ma),s.m),R=fsq(F(a,ka*ma),ma);
  return{q:`W trójkącie ABC: |BC| = ${a}, |∢BAC| = ${al}°, |∢ABC| = ${be}°. Oblicz długość boku AC oraz promień okręgu opisanego na tym trójkącie.`,a:`|AC| = ${b}, R = ${R}`,
  s:[`Twierdzenie sinusów: ${fr('|BC|','sin∢BAC')} = ${fr('|AC|','sin∢ABC')} = 2R.`,`sin ${al}° = ${sinS(al)}, sin ${be}° = ${sinS(be)}.`,`|AC| = ${fr(`|BC| · sin ${be}°`,`sin ${al}°`)} = ${a} · ${sinS(be)} : ${sinS(al)} = ${b}.`,`2R = ${fr(a,`sin ${al}°`)}, więc R = ${R}.`]}}
function gTriAreaSin(){const g=pick([30,45,60,120,135,150]),[k,m]=SINV[g],a=ri(2,12),b=ri(2,12),P=fsq(F(a*b*k,4),m),md=ri(0,2),g0=Math.min(g,180-g);
  if(md===0)return{q:`Dwa boki trójkąta mają długości ${a} i ${b}, a kąt między nimi ma miarę ${g}°. Oblicz pole trójkąta.`,a:`P = ${P}`,s:[`P = ½ · a · b · sin γ.`,`sin ${g}° = ${sinS(g)}.`,`P = ½ · ${a} · ${b} · ${sinS(g)} = ${P}.`]};
  if(md===1)return{q:`Dwa boki trójkąta mają długości ${a} i ${b}, a jego pole jest równe ${P}. Oblicz miarę kąta między tymi bokami.`,a:`${g0}° lub ${180-g0}°`,
    s:[`P = ½ab sin γ, więc sin γ = ${fr('2P','ab')} = ${sinS(g)}.`,`Sinus ma tę samą wartość dla γ i 180° − γ, a kąt trójkąta leży w (0°, 180°): γ = ${g0}° lub γ = ${180-g0}°.`]};
  return{q:`Równoległobok ma boki długości ${a} i ${b}, a jego kąt ostry ma miarę ${g0}°. Oblicz pole równoległoboku.`,a:`P = ${fsq(F(a*b*k,2),m)}`,
    s:[`Przekątna dzieli równoległobok na dwa przystające trójkąty, więc P = a · b · sin α.`,`P = ${a} · ${b} · ${sinS(g0)} = ${fsq(F(a*b*k,2),m)}.`]}}
function gTrigTable(){const m=ri(0,2),D=x=>Math.round(x*180/Math.PI);
  if(m===0){const f=pick(['sin','cos','tg']),v=ri(10,f==='tg'?300:98)/100,g=D(f==='sin'?Math.asin(v):f==='cos'?Math.acos(v):Math.atan(v));
    return{q:`Kąt α jest ostry i ${f} α = ${dec(v)}. Korzystając z tablic lub kalkulatora, wyznacz miarę kąta α z dokładnością do 1°.`,a:`α ≈ ${g}°`,s:[`W tablicach wartości funkcji trygonometrycznych szukamy kąta, dla którego ${f} jest najbliższy ${dec(v)} (albo liczymy ${f}<sup>−1</sup>(${dec(v)}) na kalkulatorze).`,`α ≈ ${g}°.`]}}
  if(m===1){const a=ri(2,15),b=ri(2,15),g=D(Math.atan(a/b));return{q:`Przyprostokątne trójkąta prostokątnego mają długości ${a} i ${b}. Wyznacz z dokładnością do 1° miarę kąta ostrego leżącego naprzeciw przyprostokątnej długości ${a}.`,a:`≈ ${g}°`,s:[`tg α = ${fr('przyprostokątna naprzeciw','przyprostokątna przy kącie')} = ${fr(a,b)} ≈ ${dec(a/b)}.`,`Z tablic lub kalkulatora: α ≈ ${g}°.`]}}
  const L=ri(3,8),d=ri(5,L*10-5)/10,g=D(Math.acos(d/L));return{q:`Drabina o długości ${L} m jest oparta o pionową ścianę. Dolny koniec drabiny jest oddalony od ściany o ${dec(d)} m. Wyznacz z dokładnością do 1° kąt nachylenia drabiny do podłoża.`,a:`≈ ${g}°`,
    s:[`Drabina, ściana i podłoże tworzą trójkąt prostokątny; drabina jest przeciwprostokątną.`,`cos α = ${fr(dec(d),L)} ≈ ${dec(d/L)}.`,`α ≈ ${g}°.`]}}
function gTriType(){let a,b,c;if(rnd()<.3){const k=ri(1,2);[a,b,c]=pickTriple(k===1?41:k===2?25:13).map(v=>v*k)}else{do{[a,b,c]=[ri(2,14),ri(2,14),ri(2,14)].sort((x,y)=>x-y)}while(a+b<=c||b===c)}
  const d=a*a+b*b-c*c,t=d>0?'ostrokątny':d===0?'prostokątny':'rozwartokątny';
  return{q:`Trójkąt ma boki długości ${shuffle([a,b,c]).join(', ')}. Określ, czy jest ostrokątny, prostokątny czy rozwartokątny. Naprzeciw którego boku leży jego największy kąt? Oblicz cosinus tego kąta.`,
  a:`trójkąt ${t}; największy kąt leży naprzeciw boku ${c}; cos = ${fH(F(d,2*a*b))}`,
  s:[`Naprzeciw najdłuższego boku (${c}) leży największy kąt.`,`Porównujemy kwadrat najdłuższego boku z sumą kwadratów pozostałych: ${c}² = ${c*c}, ${a}² + ${b}² = ${a*a+b*b}.`,`${c*c} ${d>0?'<':d===0?'=':'>'} ${a*a+b*b}, więc największy kąt jest ${d>0?'ostry':d===0?'prosty (twierdzenie odwrotne do twierdzenia Pitagorasa)':'rozwarty'} — trójkąt jest ${t}.`,`cos γ = ${fr(`${a*a} + ${b*b} − ${c*c}`,`2 · ${a} · ${b}`)} = ${fH(F(d,2*a*b))}.`]}}

/* --- podstawa: planimetria --- */
function gSector(){const r=ri(2,12),al=pick([20,30,36,40,45,60,72,80,90,100,108,120,135,150,160,210,240,270,300]),L=F(2*r*al,360),P=F(r*r*al,360),fa=fH(F(al,360));
  if(rnd()<.6)return{q:`Promień koła jest równy ${r}. Oblicz długość łuku i pole wycinka koła wyznaczonych przez kąt środkowy o mierze ${al}°.`,a:`l = ${piF(L)}, P = ${piF(P)}`,
    s:[`Kąt ${al}° to ${fr(al,360)} = ${fa} kąta pełnego, więc łuk i wycinek to ${fa} okręgu i koła.`,`l = ${fa} · 2πr = ${fa} · ${2*r}π = ${piF(L)}.`,`P = ${fa} · πr² = ${fa} · ${r*r}π = ${piF(P)}.`]};
  return{q:`Łuk okręgu o promieniu ${r} ma długość ${piF(L)}. Oblicz miarę kąta środkowego opartego na tym łuku oraz pole odpowiadającego mu wycinka koła.`,a:`α = ${al}°, P = ${piF(P)}`,
    s:[`l = ${fr('α','360°')} · 2πr, więc ${piF(L)} = ${fr('α','360°')} · ${2*r}π.`,`${fr('α','360°')} = ${fa}, α = ${al}°.`,`P = ${fa} · ${r*r}π = ${piF(P)} (albo P = ½ · l · r).`]}}
function gBisector(){let a,b,c;do{a=ri(3,12);b=ri(3,12);c=ri(3,15)}while(a===b||a+b<=c||Math.abs(a-b)>=c);const AD=F(c*b,a+b),DB=F(c*a,a+b);
  return{q:`W trójkącie ABC: |AC| = ${b}, |BC| = ${a}, |AB| = ${c}. Dwusieczna kąta ACB przecina bok AB w punkcie D. Oblicz długości odcinków AD i DB.`,a:`|AD| = ${fH(AD)}, |DB| = ${fH(DB)}`,
  s:[`Twierdzenie o dwusiecznej: ${fr('|AD|','|DB|')} = ${fr('|AC|','|BC|')} = ${fr(b,a)}.`,`Oznaczamy |AD| = ${b}t, |DB| = ${a}t. Wtedy ${b}t + ${a}t = ${c}, więc t = ${fH(F(c,a+b))}.`,`|AD| = ${fH(AD)}, |DB| = ${fH(DB)}.`]}}
function gTangentLen(){if(rnd()<.5){const k=ri(1,3),[p,q,c]=pickTriple(k===1?41:k===2?25:13).map(v=>v*k),sw=rnd()<.5,r=sw?p:q,t=sw?q:p;
    return{q:`Punkt P leży w odległości ${c} od środka O okręgu o promieniu ${r}. Prosta przechodząca przez P jest styczna do okręgu w punkcie A. Oblicz |PA|.`,a:`|PA| = ${t}`,
    s:[`Promień OA jest prostopadły do stycznej, więc trójkąt OAP jest prostokątny z kątem prostym przy A.`,`|PA|² = |OP|² − |OA|² = ${c*c} − ${r*r} = ${t*t}, |PA| = ${t}.`]}}
  let a,b,c;do{a=ri(4,15);b=ri(4,15);c=ri(4,15)}while(a+b<=c||a+c<=b||b+c<=a||(b+c-a)%2);
  return{q:`W trójkąt ABC o bokach |BC| = ${a}, |AC| = ${b}, |AB| = ${c} wpisano okrąg, który jest styczny do boku AB w punkcie K. Oblicz |AK| i |KB|.`,a:`|AK| = ${(b+c-a)/2}, |KB| = ${(a+c-b)/2}`,
  s:[`Odcinki stycznych poprowadzonych z jednego punktu do okręgu mają równe długości. Oznaczamy je: x (z A), y (z B), z (z C).`,`x + y = ${c}, y + z = ${a}, x + z = ${b}.`,`Dodajemy stronami: 2(x + y + z) = ${a+b+c}, więc x + y + z = ${(a+b+c)/2}.`,`x = ${(a+b+c)/2} − ${a} = ${(b+c-a)/2}, y = ${(a+b+c)/2} − ${b} = ${(a+c-b)/2}.`]}}
function gQuadAngles(){const m=ri(0,2);
  if(m===0){const k=pick([2,3,4,5,F(3,2),F(5,4)]),K=toF(k),x=F(180*K.d,K.n+K.d),y=F(180*K.n,K.n+K.d);
    return{q:`W równoległoboku ABCD kąt ABC jest ${K.d===1?K.n+' razy większy od':`w stosunku ${K.n} : ${K.d} do`} kąta BAD. Oblicz miary kątów równoległoboku.`,a:`|∢BAD| = |∢BCD| = ${fH(x)}°, |∢ABC| = |∢ADC| = ${fH(y)}°`,
    s:[`Sąsiednie kąty równoległoboku sumują się do 180°, a przeciwległe są równe.`,`|∢BAD| = ${K.d}t, |∢ABC| = ${K.n}t, ${K.n+K.d}t = 180°, t = ${fH(F(180,K.n+K.d))}°.`,`|∢BAD| = ${fH(x)}°, |∢ABC| = ${fH(y)}°.`]}}
  if(m===1){const b=ri(15,75);return{q:`Przekątna AC rombu ABCD tworzy z bokiem AB kąt o mierze ${b}°. Oblicz miary kątów rombu oraz kąt między przekątną BD a bokiem AB.`,a:`kąty rombu: ${2*b}° i ${180-2*b}°; kąt między BD a AB: ${90-b}°`,
    s:['Przekątne rombu są dwusiecznymi jego kątów i przecinają się pod kątem prostym.',`|∢DAB| = 2 · ${b}° = ${2*b}°, |∢ABC| = 180° − ${2*b}° = ${180-2*b}°.`,`W trójkącie ABS (S — punkt przecięcia przekątnych): |∢ABS| = 90° − ${b}° = ${90-b}°.`]}}
  const al=ri(40,85),be=ri(10,al-5);return{q:`W trapezie równoramiennym ABCD (AB ∥ CD) kąt przy dłuższej podstawie AB ma miarę ${al}°, a przekątna AC tworzy z podstawą AB kąt ${be}°. Oblicz miary kątów trapezu oraz miarę kąta ACB.`,a:`kąty trapezu: ${al}°, ${al}°, ${180-al}°, ${180-al}°; |∢ACB| = ${180-al-be}°`,
    s:['W trapezie równoramiennym kąty przy jednej podstawie są równe, a kąty przy jednym ramieniu sumują się do 180°.',`Kąty przy AB: ${al}°, kąty przy CD: ${180-al}°.`,`W trójkącie ABC: |∢CAB| = ${be}°, |∢ABC| = ${al}°, więc |∢ACB| = 180° − ${be}° − ${al}° = ${180-al-be}°.`]}}
function gRhombus(){const k=ri(1,3),[p,q,c]=pickTriple(k===1?41:k===2?25:13).map(v=>v*k),e=2*p,f=2*q,P=e*f/2,h=F(P,c);
  if(rnd()<.6)return{q:`Przekątne rombu mają długości ${e} i ${f}. Oblicz długość boku, pole i wysokość rombu.`,a:`a = ${c}, P = ${P}, h = ${fH(h)}`,
    s:[`Przekątne rombu są prostopadłe i dzielą się na połowy: ${p} i ${q}.`,`a² = ${p}² + ${q}² = ${c*c}, a = ${c}.`,`P = ${fr('e · f',2)} = ${fr(`${e} · ${f}`,2)} = ${P}.`,`P = a · h, więc h = ${fr(P,c)} = ${fH(h)}.`]};
  return{q:`Bok rombu ma długość ${c}, a jedna z jego przekątnych ma długość ${e}. Oblicz długość drugiej przekątnej i pole rombu.`,a:`f = ${f}, P = ${P}`,
    s:[`Połowa podanej przekątnej: ${p}. Z twierdzenia Pitagorasa druga połowa: √(${c*c} − ${p*p}) = ${q}.`,`f = ${f}, P = ${fr('e · f',2)} = ${P}.`]}}
function gChord(){const k=ri(1,3),[p,q,c]=pickTriple(k===1?41:k===2?25:13).map(v=>v*k),sw=rnd()<.5,d=sw?p:q,h=sw?q:p;
  if(rnd()<.5)return{q:`Cięciwa okręgu o promieniu ${c} jest oddalona od środka okręgu o ${d}. Oblicz długość tej cięciwy.`,a:`${2*h}`,s:['Odcinek poprowadzony ze środka okręgu prostopadle do cięciwy dzieli ją na połowy.',`Połowa cięciwy: √(${c*c} − ${d*d}) = ${h}, cała cięciwa: ${2*h}.`]};
  return{q:`Cięciwa okręgu ma długość ${2*h} i jest oddalona od środka okręgu o ${d}. Oblicz promień okręgu.`,a:`r = ${c}`,s:[`Połowa cięciwy ma długość ${h}.`,`r² = ${h}² + ${d}² = ${c*c}, r = ${c}.`]}}
function gSimilarTri(){let a,b,c;do{[a,b,c]=[ri(3,12),ri(3,12),ri(3,12)].sort((x,y)=>x-y)}while(a+b<=c||a===c);const k=toF(pick([2,3,F(1,2),F(3,2),F(5,2),F(2,3),F(4,3)])),m=x=>fH(fmul(F(x),k));
  return{q:`Trójkąt ABC ma boki długości ${a}, ${b}, ${c}. Trójkąt A′B′C′ jest do niego podobny, a jego najkrótszy bok ma długość ${m(a)}. Oblicz długości pozostałych boków trójkąta A′B′C′, jego obwód oraz stosunek pola trójkąta A′B′C′ do pola trójkąta ABC.`,
  a:`boki: ${m(a)}, ${m(b)}, ${m(c)}; obwód ${m(a+b+c)}; stosunek pól ${fH(fmul(k,k))}`,
  s:[`Najkrótszy bok odpowiada najkrótszemu, więc skala podobieństwa k = ${m(a)} : ${a} = ${fH(k)}.`,`Pozostałe boki: ${b} · ${fH(k)} = ${m(b)}, ${c} · ${fH(k)} = ${m(c)}.`,`Obwód: ${m(a+b+c)} (obwody figur podobnych są w stosunku k).`,`Stosunek pól to k² = ${fH(fmul(k,k))}.`]}}

/* --- podstawa: geometria analityczna --- */
function gSymFigure(){const t=ri(0,2),nm=['osi Ox','osi Oy','początku układu współrzędnych'][t],T=([x,y])=>t===0?[x,-y]:t===1?[-x,y]:[-x,-y],how=['zmieniamy znak drugiej współrzędnej','zmieniamy znak pierwszej współrzędnej','zmieniamy znaki obu współrzędnych'][t];
  if(rnd()<.5){const a=riNZ(-6,6),b=riNZ(-6,6),r=ri(1,7),[a2,b2]=T([a,b]);
    return{q:`Okrąg o ma równanie ${sqT(a)} + ${sqT(b,'y')} = ${r*r}. Wyznacz równanie okręgu symetrycznego do okręgu o względem ${nm}.`,a:`${sqT(a2)} + ${sqT(b2,'y')} = ${r*r}`,
    s:[`Środek okręgu o: S = (${N(a)}, ${N(b)}), promień r = ${r}.`,`Symetria nie zmienia promienia, a środek przechodzi na S′ = (${N(a2)}, ${N(b2)}) (${how}).`,`Równanie: ${sqT(a2)} + ${sqT(b2,'y')} = ${r*r}.`]}}
  let P;do P=[0,1,2].map(()=>[ri(-6,6),ri(-6,6)]);while((P[1][0]-P[0][0])*(P[2][1]-P[0][1])===(P[1][1]-P[0][1])*(P[2][0]-P[0][0]));const Q=P.map(T),L='ABC';
  return{q:`Trójkąt ma wierzchołki ${P.map((p,i)=>`${L[i]} = (${N(p[0])}, ${N(p[1])})`).join(', ')}. Wyznacz wierzchołki trójkąta A′B′C′ symetrycznego do niego względem ${nm}. Czy pole trójkąta się zmieni?`,
  a:`${Q.map((p,i)=>`${L[i]}′ = (${N(p[0])}, ${N(p[1])})`).join(', ')}; pole się nie zmienia`,s:[`W symetrii względem ${nm} ${how}.`,`${Q.map((p,i)=>`${L[i]}′ = (${N(p[0])}, ${N(p[1])})`).join(', ')}.`,'Symetria jest izometrią (zachowuje odległości), więc trójkąt A′B′C′ jest przystający do ABC i ma to samo pole.']}}
function gCircleB(){const m=ri(0,2);
  if(m===0){const a=ri(-5,5),b=ri(-5,5),dx=riNZ(-6,6),dy=ri(-6,6),r2=dx*dx+dy*dy;return{q:`Wyznacz równanie okręgu o środku S = (${N(a)}, ${N(b)}), przechodzącego przez punkt P = (${N(a+dx)}, ${N(b+dy)}).`,a:`${sqT(a)} + ${sqT(b,'y')} = ${r2}`,
    s:[`Promień to odległość |SP| = √(${pN(dx)}² + ${pN(dy)}²) = ${sq(r2)}, więc r² = ${r2}.`,`Równanie okręgu: (x − a)² + (y − b)² = r², czyli ${sqT(a)} + ${sqT(b,'y')} = ${r2}.`]}}
  if(m===1){const a=ri(-5,5),b=ri(-5,5),dx=riNZ(-5,5),dy=ri(-5,5),r2=dx*dx+dy*dy;return{q:`Punkty A = (${N(a-dx)}, ${N(b-dy)}) i B = (${N(a+dx)}, ${N(b+dy)}) są końcami średnicy okręgu. Wyznacz równanie tego okręgu.`,a:`${sqT(a)} + ${sqT(b,'y')} = ${r2}`,
    s:[`Środek okręgu to środek średnicy AB: S = (${N(a)}, ${N(b)}).`,`r = |SB| = √(${pN(dx)}² + ${pN(dy)}²) = ${sq(r2)}, r² = ${r2}.`,`Równanie: ${sqT(a)} + ${sqT(b,'y')} = ${r2}.`]}}
  const a=ri(-4,4),b=ri(-4,4),r=ri(2,6),x=ri(-8,8),y=ri(-8,8),d2=(x-a)**2+(y-b)**2,w=d2<r*r?'wewnątrz okręgu':d2===r*r?'na okręgu':'na zewnątrz okręgu';
  return{q:`Dany jest okrąg ${sqT(a)} + ${sqT(b,'y')} = ${r*r}. Ustal, czy punkt P = (${N(x)}, ${N(y)}) leży wewnątrz tego okręgu, na nim, czy na zewnątrz.`,a:`P leży ${w}`,
  s:[`Środek S = (${N(a)}, ${N(b)}), r = ${r}, r² = ${r*r}.`,`|SP|² = ${pN(x-a)}² + ${pN(y-b)}² = ${d2}.`,`${d2} ${d2<r*r?'<':d2===r*r?'=':'>'} ${r*r}, więc P leży ${w}.`]}}
function gLinesPos(){const t=ri(0,2),A=toF(pick([1,-1,2,-2,3,-3,F(1,2),F(-1,2),F(2,3),F(-3,2)])),x0=A.d*ri(-3,3),y0=ri(-5,5),b=y0-A.n*x0/A.d,s=sg();
  let A2,B2;if(t===0){A2=A.n*s;B2=-A.d*s}else if(t===1){A2=A.d*s;B2=A.n*s}else{let n2,d2;do{n2=riNZ(-4,4);d2=ri(1,3)}while(n2*A.d===A.n*d2||n2*A.n===-d2*A.d);A2=n2*s;B2=-d2*s}
  let C2=-(A2*x0+B2*y0);if(t===0)C2+=riNZ(-4,4)*Math.abs(B2);const sl=F(-A2,B2);
  const ans=t===0?'proste są równoległe i różne (brak punktów wspólnych)':`proste ${t===1?'są prostopadłe i ':''}przecinają się w punkcie (${N(x0)}, ${N(y0)})`;
  return{q:`Zbadaj wzajemne położenie prostych k: y = ${poly([A,b])} oraz l: ${genEq(A2,B2,C2)}. Jeśli się przecinają, wyznacz punkt przecięcia.`,a:ans,
  s:[`Przekształcamy l do postaci kierunkowej: y = ${poly([sl,F(-C2,B2)])}.`,`Współczynniki kierunkowe: a<sub>k</sub> = ${fH(A)}, a<sub>l</sub> = ${fH(sl)}.`,
    t===0?`Są równe, a wyrazy wolne różne (${fH(F(b))} i ${fH(F(-C2,B2))}), więc proste są równoległe i różne.`:`${t===1?`a<sub>k</sub> · a<sub>l</sub> = −1, więc proste są prostopadłe.`:'Współczynniki są różne, więc proste się przecinają (nie są prostopadłe, bo iloczyn współczynników ≠ −1).'} Rozwiązujemy układ równań: x = ${N(x0)}, y = ${N(y0)}.`]}}
function gTangentB(){const r=pick([5,5,10,13]),[dx,dy]=pick(lattice(r)),a=ri(-4,4),b=ri(-4,4),px=a+dx,py=b+dy,g=gcd(dx,dy),A=dx/g,B=dy/g,Cc=-(A*px+B*py);
  return{q:`Punkt A = (${N(px)}, ${N(py)}) leży na okręgu ${sqT(a)} + ${sqT(b,'y')} = ${r*r}. Wyznacz równanie stycznej do tego okręgu w punkcie A.`,a:genEq(A,B,Cc),
  s:[`Środek okręgu: S = (${N(a)}, ${N(b)}). Styczna jest prostopadła do promienia SA.`,`Wektor SA = [${N(dx)}, ${N(dy)}] jest prostopadły do stycznej, więc styczna ma równanie postaci ${genEq(A,B,0).replace(' = 0',' + C = 0')}.`,`Podstawiamy A: ${N(A)} · ${pN(px)} + ${pN(B)} · ${pN(py)} + C = 0, więc C = ${N(Cc)}.`,`Styczna: ${genEq(A,B,Cc)}.`]}}

/* --- podstawa: stereometria --- */
function gConeB(){if(rnd()<.6){const al=pick([30,45,60]),l=2*ri(1,6),h=l/2;
    const D={30:[fsq(h,3),fH(h),piF(F(l**3,8)),fsq(F(l*l,2),3)+'π',120],45:[fsq(h,2),fsq(h,2),fsq(F(l**3,12),2)+'π',fsq(F(l*l,2),2)+'π',90],60:[fH(h),fsq(h,3),fsq(F(l**3,24),3)+'π',piF(F(l*l,2)),60]}[al];
    return{q:`Tworząca stożka ma długość ${l} i jest nachylona do płaszczyzny podstawy pod kątem ${al}°. Oblicz promień podstawy, wysokość, pole powierzchni bocznej i objętość stożka oraz miarę kąta rozwarcia stożka.`,
    a:`r = ${D[0]}, h = ${D[1]}, P<sub>b</sub> = ${D[3]}, V = ${D[2]}, kąt rozwarcia: ${D[4]}°`,
    s:[`W przekroju osiowym tworząca l = ${l}, promień r i wysokość h tworzą trójkąt prostokątny z kątem ${al}° między l i r.`,`r = l · cos ${al}° = ${D[0]}, h = l · sin ${al}° = ${D[1]}.`,`P<sub>b</sub> = πrl = ${D[3]}, V = ⅓πr²h = ${D[2]}.`,`Kąt rozwarcia (między tworzącymi w przekroju osiowym) = 180° − 2 · ${al}° = ${D[4]}°.`]}}
  const a=ri(2,12);return{q:`Przekrój osiowy stożka jest trójkątem równobocznym o boku ${a}. Oblicz objętość i pole powierzchni całkowitej stożka.`,a:`r = ${fH(F(a,2))}, h = ${fsq(F(a,2),3)}, V = ${fsq(F(a**3,24),3)}π, P<sub>c</sub> = ${piF(F(3*a*a,4))}`,
  s:[`Tworząca l = ${a}, średnica podstawy 2r = ${a}, więc r = ${fH(F(a,2))}. Wysokość stożka to wysokość trójkąta równobocznego: h = ${fr('a√3',2)} = ${fsq(F(a,2),3)}.`,`V = ⅓πr²h = ${fsq(F(a**3,24),3)}π.`,`P<sub>c</sub> = πr² + πrl = πr(r + l) = ${piF(F(3*a*a,4))}.`]}}
function gSphere(){const m=ri(0,3),r=ri(1,9);
  if(m===0)return{q:`Kula ma promień ${r}. Oblicz jej pole powierzchni i objętość.`,a:`P = ${piF(4*r*r)}, V = ${piF(F(4*r**3,3))}`,s:[`P = 4πr², V = ${fr(4,3)}πr³.`,`P = 4π · ${r*r} = ${piF(4*r*r)}.`,`V = ${fr(4,3)}π · ${r**3} = ${piF(F(4*r**3,3))}.`]};
  if(m===1)return{q:`Pole powierzchni kuli jest równe ${piF(4*r*r)}. Oblicz objętość tej kuli.`,a:`r = ${r}, V = ${piF(F(4*r**3,3))}`,s:[`4πr² = ${piF(4*r*r)}, więc r² = ${r*r}, r = ${r}.`,`V = ${fr(4,3)}πr³ = ${piF(F(4*r**3,3))}.`]};
  if(m===2){const a=2*r;return{q:`W sześcian o krawędzi ${a} wpisano kulę, a na sześcianie opisano drugą kulę. Oblicz promienie obu kul i stosunek objętości kuli opisanej do objętości kuli wpisanej.`,a:`r = ${r}, R = ${fsq(r,3)}, stosunek objętości: 3√3`,
    s:[`Kula wpisana jest styczna do ścian, więc jej średnica to krawędź: r = ${fr(a,2)} = ${r}.`,`Kula opisana przechodzi przez wierzchołki, więc jej średnica to przekątna sześcianu: R = ${fr(`${a}√3`,2)} = ${fsq(r,3)}.`,`Stosunek objętości = (R : r)³ = (√3)³ = 3√3.`]}}
  const R=r+1;return{q:`Metalową kulę o promieniu ${R} przetopiono na walec o promieniu podstawy ${R}. Oblicz wysokość walca.`,a:`h = ${fH(F(4*R,3))}`,s:[`Objętość się nie zmienia: ${fr(4,3)}πr³ = πr²h.`,`Dzielimy przez πr²: h = ${fr(4,3)}r = ${fH(F(4*R,3))}.`]}}
const CUBE_FACTS=[['Proste AB i CG są skośne.','Proste AB i CG przecinają się.'],['Proste AB i HG są równoległe.','Proste AB i HG są skośne.'],['Proste AF i CH są skośne.','Proste AF i CH są równoległe.'],
  ['Proste BD i FH są równoległe.','Proste BD i FH są skośne.'],['Proste BD i EG są prostopadłe, choć się nie przecinają.','Proste BD i EG są równoległe.'],['Kąt między przekątnymi ścian AC i AF ma miarę 60°.','Kąt między przekątnymi ścian AC i AF ma miarę 90°.'],
  ['Tangens kąta nachylenia przekątnej sześcianu AG do płaszczyzny podstawy jest równy '+fr('√2',2)+'.','Tangens kąta nachylenia przekątnej sześcianu AG do płaszczyzny podstawy jest równy √2.'],['Kąt między przekątną ściany AF a krawędzią AB ma miarę 45°.','Kąt między przekątną ściany AF a krawędzią AB ma miarę 60°.'],
  ['Proste AE i CG są równoległe.','Proste AE i CG są skośne.'],['Krawędź AE jest prostopadła do płaszczyzny podstawy ABCD.','Krawędź AE jest równoległa do płaszczyzny podstawy ABCD.'],
  ['Przekrój sześcianu płaszczyzną ACGE jest prostokątem, który nie jest kwadratem.','Przekrój sześcianu płaszczyzną ACGE jest kwadratem.'],['Trójkąt ACF jest równoboczny.','Trójkąt ACF jest prostokątny.'],['Proste DH i BC są skośne.','Proste DH i BC przecinają się.']];
function gSkewLines(){return pf('Dany jest sześcian ABCDEFGH (ABCD to dolna podstawa, a krawędzie AE, BF, CG, DH są pionowe).',shuffle(CUBE_FACTS).slice(0,4).map(([t,f])=>rnd()<.5?[t,true]:[f,false]))}
function gPyrTri(){const k=ri(1,8),al=pick([30,45,60]),a=6*k,H={30:fH(2*k),45:fsq(2*k,3),60:fH(6*k)}[al],L={30:fH(4*k),45:fsq(2*k,6),60:fsq(4*k,3)}[al],V={30:fsq(6*k**3,3),45:fH(18*k**3),60:fsq(18*k**3,3)}[al];
  return{q:`Ostrosłup prawidłowy trójkątny ma krawędź podstawy długości ${a}. Krawędź boczna jest nachylona do płaszczyzny podstawy pod kątem ${al}°. Oblicz wysokość ostrosłupa, długość krawędzi bocznej i objętość ostrosłupa.`,a:`H = ${H}, krawędź boczna: ${L}, V = ${V}`,
  s:[`Spodek wysokości to środek okręgu opisanego na podstawie: R = ${fr('a√3',3)} = ${fsq(2*k,3)}.`,`Wysokość H, promień R i krawędź boczna b tworzą trójkąt prostokątny: H = R · tg ${al}° = ${H}, b = ${fr('R',`cos ${al}°`)} = ${L}.`,`P<sub>p</sub> = ${fr('a²√3',4)} = ${fsq(9*k*k,3)}.`,`V = ⅓ · P<sub>p</sub> · H = ${V}.`]}}
function gCylSection(){if(rnd()<.5){const r=ri(1,8);return{q:`Przekrój osiowy walca jest kwadratem o polu ${4*r*r}. Oblicz objętość i pole powierzchni całkowitej walca.`,a:`r = ${r}, h = ${2*r}, V = ${piF(2*r**3)}, P<sub>c</sub> = ${piF(6*r*r)}`,
    s:[`Przekrój osiowy to prostokąt o bokach 2r i h. Jest kwadratem, więc h = 2r oraz (2r)² = ${4*r*r}, r = ${r}.`,`V = πr²h = π · ${r*r} · ${2*r} = ${piF(2*r**3)}.`,`P<sub>c</sub> = 2πr² + 2πrh = ${2*r*r}π + ${4*r*r}π = ${piF(6*r*r)}.`]}}
  const k=ri(1,3),T=pickTriple(k===1?41:k===2?25:13).map(v=>v*k),D=T[0]%2===0?T[0]:T[1],h=D===T[0]?T[1]:T[0],d=T[2],r=D/2;
  return{q:`Przekątna przekroju osiowego walca ma długość ${d}, a średnica podstawy walca ma długość ${D}. Oblicz wysokość i objętość walca oraz tangens kąta nachylenia przekątnej przekroju osiowego do płaszczyzny podstawy.`,a:`h = ${h}, V = ${piF(r*r*h)}, tg α = ${fH(F(h,D))}`,
  s:[`Przekrój osiowy to prostokąt ${D} × h, którego przekątna ma długość ${d}.`,`h = √(${d*d} − ${D*D}) = ${h}.`,`V = πr²h = π · ${r*r} · ${h} = ${piF(r*r*h)}; tg α = ${fr('h','2r')} = ${fH(F(h,D))}.`]}}

/* --- podstawa: prawdopodobieństwo i statystyka --- */
function gProbUnion(){const n=pick([10,12,20]),ab=ri(1,4);let a,b;do{a=ri(ab+1,n-2);b=ri(ab+1,n-2)}while(a+b-ab>n);const P=x=>fH(F(x,n));
  if(rnd()<.6)return{q:`A i B są zdarzeniami takimi, że P(A) = ${P(a)}, P(B) = ${P(b)} oraz P(A ∩ B) = ${P(ab)}. Oblicz P(A ∪ B), P(A′) oraz P(A \\ B).`,a:`P(A ∪ B) = ${P(a+b-ab)}, P(A′) = ${P(n-a)}, P(A \\ B) = ${P(a-ab)}`,
    s:[`P(A ∪ B) = P(A) + P(B) − P(A ∩ B) = ${P(a)} + ${P(b)} − ${P(ab)} = ${P(a+b-ab)}.`,`P(A′) = 1 − P(A) = ${P(n-a)}.`,`P(A \\ B) = P(A) − P(A ∩ B) = ${P(a-ab)}.`]};
  return{q:`A i B są zdarzeniami takimi, że P(A) = ${P(a)}, P(B) = ${P(b)} oraz P(A ∪ B) = ${P(a+b-ab)}. Oblicz P(A ∩ B) i P(B \\ A).`,a:`P(A ∩ B) = ${P(ab)}, P(B \\ A) = ${P(b-ab)}`,
    s:[`Z wzoru P(A ∪ B) = P(A) + P(B) − P(A ∩ B): P(A ∩ B) = ${P(a)} + ${P(b)} − ${P(a+b-ab)} = ${P(ab)}.`,`P(B \\ A) = P(B) − P(A ∩ B) = ${P(b-ab)}.`]}}
function gCoins(){const n=pick([3,4,5]),k=ri(1,n-1),E=pick([['dokładnie',x=>x===k],['co najmniej',x=>x>=k],['co najwyżej',x=>x<=k]]),ok=[...Array(n+1).keys()].filter(E[1]);let c=0;ok.forEach(i=>c+=C(n,i));const T=2**n,res=`${fr(c,T)}${F(c,T).d!==T?' = '+fH(F(c,T)):''}`;
  return{q:`Rzucamy ${n} razy symetryczną monetą. Oblicz prawdopodobieństwo, że orzeł wypadnie ${E[0]} ${k} ${k===1?'raz':'razy'}.`,a:`P = ${res}`,
  s:[`Wszystkich wyników (ciągów orłów i reszek) jest 2<sup>${n}</sup> = ${T}.`,`Liczymy wyniki z odpowiednią liczbą orłów (wybieramy, w których rzutach wypadł orzeł): ${ok.map(i=>`${i} ${pl(i,'orzeł','orły','orłów')}: ${C(n,i)}`).join(', ')}; razem ${c}.`,`P = ${res}.`]}}
function gWeightedMean(){if(rnd()<.5){const n=ri(4,9),m=ri(3,15),m2=m+riNZ(-3,3),x=(n+1)*m2-n*m;
    return{q:`Średnia arytmetyczna ${n} liczb jest równa ${m}. Po dopisaniu jeszcze jednej liczby średnia arytmetyczna wszystkich liczb jest równa ${m2}. Jaką liczbę dopisano?`,a:N(x),s:[`Suma ${n} liczb: ${n} · ${m} = ${n*m}.`,`Suma ${n+1} liczb: ${n+1} · ${m2} = ${(n+1)*m2}.`,`Dopisana liczba: ${(n+1)*m2} − ${n*m} = ${N(x)}.`]}}
  const g=[ri(2,6),ri(2,6),ri(2,6),ri(1,6)],w=[1,2,3,ri(1,3)],nm=['kartkówka','odpowiedź ustna','sprawdzian','praca domowa'],S=g.reduce((s,x,i)=>s+x*w[i],0),W=w.reduce((s,x)=>s+x,0);
  return{q:`Uczeń otrzymał oceny: ${g.map((x,i)=>`${x} (${nm[i]}, waga ${w[i]})`).join(', ')}. Oblicz średnią ważoną jego ocen z dokładnością do 0,01.`,a:`${dec(S/W)}`,
  s:[`Średnia ważona = ${fr('suma iloczynów (ocena · waga)','suma wag')}.`,`Licznik: ${g.map((x,i)=>`${x} · ${w[i]}`).join(' + ')} = ${S}; mianownik: ${w.join(' + ')} = ${W}.`,`${fr(S,W)} ≈ ${dec(S/W)}.`]}}

/* --- rozszerzenie: wielomiany, symbol Newtona --- */
function gRatRoots(){const a=pick([2,3,4,6]);let b;do b=riNZ(-5,5);while(gcd(a,b)!==1);const irr=rnd()<.5;let Q,rs=[];if(!irr){do rs=distinct(2,-4,4);while(rs.includes(0));Q=expand(rs)}else Q=[1,0,ri(1,6)];
  const W=pmul([a,-b],Q),ev2=(n,d)=>W.reduce((s,c,i)=>s+c*n**(W.length-1-i)*d**i,0),dv=x=>{const o=[];for(let i=1;i<=Math.abs(x);i++)if(x%i===0)o.push(i);return o},P=dv(W[3]),L=dv(W[0]);
  const seen=new Set(),R=[];for(const p of P)for(const q of L)for(const s of[1,-1]){const f=F(s*p,q),k=f.n+'/'+f.d;if(seen.has(k))continue;seen.add(k);if(ev2(f.n,f.d)===0)R.push(f)}R.sort((u,v)=>u.n/u.d-v.n/v.d);
  const fact=irr?`(${poly([a,-b])})(x² + ${Q[2]})`:`(${poly([a,-b])})${pp(rs[0])}${pp(rs[1])}`;
  return{q:`Wyznacz wszystkie pierwiastki wymierne wielomianu W(x) = ${poly(W)} i rozłóż ten wielomian na czynniki.`,a:`pierwiastki wymierne: ${R.map(fH).join(', ')}; W(x) = ${fact}`,
  s:[`Jeśli ułamek nieskracalny ${fr('p','q')} jest pierwiastkiem, to p dzieli wyraz wolny (${N(W[3])}), a q dzieli współczynnik przy najwyższej potędze (${N(W[0])}).`,`p ∈ {±${P.join(', ±')}}, q ∈ {${L.join(', ')}}.`,`Sprawdzamy kandydatów (np. schematem Hornera): ${R.map(f=>`W(${fH(f)}) = 0`).join(', ')}.`,`W(x) = ${fact}${irr?`, a x² + ${Q[2]} > 0 nie ma pierwiastków`:''}.`]}}
function gNewtonEq(){const m=ri(0,3);
  if(m===0){const n=ri(4,20),v=C(n,2);return{q:`Rozwiąż równanie ${bn('n',2)} = ${v}, gdzie n ≥ 2 jest liczbą naturalną.`,a:`n = ${n}`,
    s:[`${bn('n',2)} = ${fr('n!','2!(n − 2)!')} = ${fr('n(n − 1)',2)}, więc n(n − 1) = ${2*v}.`,`n² − n − ${2*v} = 0, Δ = 1 + ${8*v} = ${1+8*v} = ${2*n-1}².`,`n = ${fr(`1 + ${2*n-1}`,2)} = ${n} (drugi pierwiastek jest ujemny).`]}}
  if(m===1){const n=ri(5,25),v=C(n,2);return{q:`W turnieju szachowym każdy zawodnik rozegrał z każdym innym dokładnie jedną partię. Rozegrano ${v} partii. Ilu zawodników brało udział w turnieju?`,a:`${n}`,
    s:[`Liczba partii to liczba par zawodników: ${bn('n',2)} = ${fr('n(n − 1)',2)}.`,`n(n − 1) = ${2*v}, n² − n − ${2*v} = 0.`,`Δ = ${1+8*v} = ${2*n-1}², n = ${n}.`]}}
  if(m===2){const k=ri(2,9),n=3*k+2;return{q:`Wyznacz liczbę naturalną n ≥ 3, dla której ${bn('n',3)} = ${k} · ${bn('n',2)}.`,a:`n = ${n}`,
    s:[`${bn('n',3)} = ${fr('n(n − 1)(n − 2)',6)}, ${bn('n',2)} = ${fr('n(n − 1)',2)}.`,`Dzielimy obie strony przez ${fr('n(n − 1)',2)} > 0: ${fr('n − 2',3)} = ${k}.`,`n − 2 = ${3*k}, n = ${n}.`]}}
  const n=ri(4,16),v=n*(n+1)/2;return{q:`Rozwiąż równanie ${bn('n','n − 2')} + ${bn('n',1)} = ${v}, gdzie n ≥ 2 jest liczbą naturalną.`,a:`n = ${n}`,
    s:[`Z własności symbolu Newtona: ${bn('n','n − 2')} = ${bn('n',2)} = ${fr('n(n − 1)',2)} oraz ${bn('n',1)} = n.`,`${fr('n(n − 1)',2)} + n = ${fr('n(n + 1)',2)} = ${v}.`,`n² + n − ${2*v} = 0, Δ = ${1+8*v} = ${2*n+1}², n = ${n}.`]}}
function gNewtonProps(){const m=ri(0,2),n=ri(6,15),k=ri(2,Math.min(5,n-3)),v=C(n,k);
  if(m===0)return mcV(`Liczba ${bn(n,k)} + ${bn(n,k+1)} jest równa`,bn(n+1,k+1),C(n+1,k+1),[[bn(n,2*k+1),C(n,2*k+1)],[bn(n+1,k),C(n+1,k)],[bn(2*n,2*k+1),C(2*n,2*k+1)],[bn(n+1,k+2),C(n+1,k+2)],[bn(n,k+2),C(n,k+2)]],`własność trójkąta Pascala: ${bn('n','k')} + ${bn('n','k + 1')} = ${bn('n + 1','k + 1')}`);
  if(m===1)return mcV(`Liczba ${bn(n,n-k)} jest równa`,bn(n,k),v,[[bn(n,k+1),C(n,k+1)],[bn(n-k,k),C(n-k,k)],[bn(n,k-1),C(n,k-1)],[bn(n+1,k),C(n+1,k)],[bn(n-1,k),C(n-1,k)]],`symetria: ${bn('n','k')} = ${bn('n','n − k')}`);
  return mcV(`Liczba ${bn(n,k)} jest równa`,''+v,v,[[''+C(n,k-1),C(n,k-1)],[''+C(n,k+1),C(n,k+1)],[''+n*k,n*k],[''+2*v,2*v],[''+C(n-1,k),C(n-1,k)]],`${bn(n,k)} = ${fr(`${n}!`,`${k}! · ${n-k}!`)} = ${v}`)}
function gBinomCoef(){if(rnd()<.6){const n=ri(4,8),k=ri(1,n-1),a=pick([1,2,3,-1,-2]),b=pick([1,2,3,-1,-2,-3]),v=C(n,k)*a**k*b**(n-k);
    return{q:`Wyznacz współczynnik przy x<sup>${k}</sup> w rozwinięciu wyrażenia (${poly([a,b])})<sup>${n}</sup>.`,a:N(v),
    s:[`Wzór dwumianowy Newtona: (u + w)<sup>n</sup> = suma wyrazów ${bn('n','i')} u<sup>i</sup> w<sup>n − i</sup> dla i = 0, 1, …, n.`,`Wyraz z x<sup>${k}</sup> to ${bn(n,k)} · (${lead(a,'x')})<sup>${k}</sup> · ${pN(b)}<sup>${n-k}</sup>.`,`Współczynnik: ${C(n,k)} · ${pN(a**k)} · ${pN(b**(n-k))} = ${N(v)}.`]}}
  const n=pick([4,6,8]),c=pick([1,2,3]),k=n/2,v=C(n,k)*c**k;
  return{q:`Oblicz wyraz wolny (niezawierający x) w rozwinięciu wyrażenia (x + ${fr(c,'x')})<sup>${n}</sup>.`,a:`${v}`,
  s:[`Wyraz ogólny: ${bn(n,'i')} x<sup>${n} − i</sup> · ${fr(`${c}<sup>i</sup>`,'x<sup>i</sup>')} = ${bn(n,'i')} · ${c}<sup>i</sup> · x<sup>${n} − 2i</sup>.`,`Wyraz wolny: ${n} − 2i = 0, czyli i = ${k}.`,`${bn(n,k)} · ${c}<sup>${k}</sup> = ${C(n,k)} · ${c**k} = ${v}.`]}}
function gRatEqR(){for(;;){const[p,q]=distinct(2,-5,5),[r1,r2]=distinct(2,-6,6);if([p,q].includes(r1)||[p,q].includes(r2))continue;const D=r1+r2-p-q,num=r1*r2-p*q-D*p;if(num%(q-p))continue;const A=num/(q-p),B=A-D;if(!A||!B||Math.abs(A)>12||Math.abs(B)>12)continue;
  const s=[r1,r2].sort((x,y)=>x-y),qb=-(p+q+D),qc=p*q+A*q-B*p;
  return{q:`Rozwiąż równanie ${fr(N(A),sh(p))} ${B>0?'−':'+'} ${fr(Math.abs(B),sh(q))} = 1.`,a:`x = ${N(s[0])} lub x = ${N(s[1])}`,
  s:[`Dziedzina: x ≠ ${N(p)} i x ≠ ${N(q)}.`,`Mnożymy obie strony przez ${pp(p)}${pp(q)}: ${N(A)}${pp(q)} ${B>0?'−':'+'} ${Math.abs(B)}${pp(p)} = ${pp(p)}${pp(q)}.`,`Po uporządkowaniu: ${poly([1,qb,qc])} = 0.`,...deltaSteps(1,qb,qc),'Oba pierwiastki należą do dziedziny.']}}}
function gLogIneq(){const A=toF(pick([2,3,5,F(1,2),F(1,3)])),p=ri(-5,5),k=ri(-1,3),rel=pick(RELS),bk=k>=0?F(A.n**k,A.d**k):F(A.d**-k,A.n**-k),t=fadd(bk,F(p)),up=A.n>A.d,lt=(rel[0]==='<')===up,cl=rel.length>1;
  const ans=lt?`x ∈ (${N(p)}, ${fH(t)}${cl?'⟩':')'}`:`x ∈ ${cl?'⟨':'('}${fH(t)}, +∞)`,bs=A.d>1?fr(A.n,A.d):N(A.n);
  return{q:`Rozwiąż nierówność log<sub>${bs}</sub>(${sh(p)}) ${REL[rel]} ${N(k)}.`,a:ans,
  s:[`Dziedzina: ${p?`${sh(p)} > 0, czyli `:''}x > ${N(p)}.`,`${N(k)} = log<sub>${bs}</sub>${fH(bk)}, więc nierówność ma postać log<sub>${bs}</sub>(${sh(p)}) ${REL[rel]} log<sub>${bs}</sub>${fH(bk)}.`,
    `Podstawa ${up?'jest większa od 1, więc funkcja logarytmiczna jest rosnąca i znak nierówności się nie zmienia':'należy do (0, 1), więc funkcja logarytmiczna jest malejąca i zmieniamy znak nierówności'}: ${sh(p)} ${REL[lt?(cl?'<=':'<'):(cl?'>=':'>')]} ${fH(bk)}.`,`Uwzględniając dziedzinę: ${ans}.`]}}

/* --- rozszerzenie: geometria analityczna, układy równań kwadratowych --- */
const CTYPES=['rozłączne zewnętrznie (brak punktów wspólnych)','styczne zewnętrznie (jeden punkt wspólny)','przecinają się w dwóch punktach','styczne wewnętrznie (jeden punkt wspólny)','rozłączne wewnętrznie — jeden leży wewnątrz drugiego (brak punktów wspólnych)'];
function gTwoCircles(){if(rnd()<.55){const k=ri(1,2),[u,v,d]=pickTriple(k===1?17:5).map(t=>t*k),t=ri(0,4),a1=ri(-4,4),b1=ri(-4,4),sw=rnd()<.5,dx=(sw?u:v)*sg(),dy=(sw?v:u)*sg(),a2=a1+dx,b2=b1+dy;
    let r1,r2;if(t===0){r1=ri(1,d-2);r2=ri(1,d-1-r1)}else if(t===1){r1=ri(1,d-1);r2=d-r1}else if(t===2){r1=ri(2,d);r2=ri(Math.max(d-r1+1,r1-d+1,1),r1+d-1)}else if(t===3){r2=ri(1,6);r1=r2+d}else{r2=ri(1,4);r1=r2+d+ri(1,3)}
    const gen=rnd()<.5,E=(a,b,r)=>gen?genCirc(a,b,r*r):`${sqT(a)} + ${sqT(b,'y')} = ${r*r}`,tp=t===1||t===3?` Punkt styczności: ${pt(F(a1*d+r1*dx,d),F(b1*d+r1*dy,d))}.`:'';
    return{q:`Zbadaj wzajemne położenie okręgów o<sub>1</sub>: ${E(a1,b1,r1)} oraz o<sub>2</sub>: ${E(a2,b2,r2)}.${t===1||t===3?' Wyznacz punkt styczności.':''}`,a:`okręgi są ${CTYPES[t]}.${tp}`,
    s:[`${gen?'Sprowadzamy równania do postaci kanonicznej. ':''}S<sub>1</sub> = (${N(a1)}, ${N(b1)}), r<sub>1</sub> = ${r1}; S<sub>2</sub> = (${N(a2)}, ${N(b2)}), r<sub>2</sub> = ${r2}.`,`|S<sub>1</sub>S<sub>2</sub>| = √(${pN(dx)}² + ${pN(dy)}²) = ${d}; r<sub>1</sub> + r<sub>2</sub> = ${r1+r2}, |r<sub>1</sub> − r<sub>2</sub>| = ${Math.abs(r1-r2)}.`,
      [`${d} > ${r1+r2}, więc okręgi są rozłączne zewnętrznie.`,`${d} = r<sub>1</sub> + r<sub>2</sub>, więc okręgi są styczne zewnętrznie.`,`${Math.abs(r1-r2)} < ${d} < ${r1+r2}, więc okręgi przecinają się w dwóch punktach.`,`${d} = |r<sub>1</sub> − r<sub>2</sub>|, więc okręgi są styczne wewnętrznie.`,`${d} < |r<sub>1</sub> − r<sub>2</sub>|, więc mniejszy okrąg leży wewnątrz większego.`][t],
      ...(tp?[`Punkt styczności leży na prostej S<sub>1</sub>S<sub>2</sub> w odległości r<sub>1</sub> od S<sub>1</sub>: T = S<sub>1</sub> + ${fr(r1,d)} · [${N(dx)}, ${N(dy)}] = ${pt(F(a1*d+r1*dx,d),F(b1*d+r1*dy,d))}.`]:[])]}}
  const p=ri(-3,3),q=ri(-3,3),t=ri(1,4),e1=ri(1,5),e2=ri(1,5),swp=rnd()<.5,f=P=>swp?[P[1],P[0]]:P;
  const S1=f([p-e1,q]),S2=f([p+e2,q]),P1=f([p,q+t]),P2=f([p,q-t]),r1=e1*e1+t*t,r2=e2*e2+t*t,c1=S1[0]**2+S1[1]**2-r1,c2=S2[0]**2+S2[1]**2-r2,pts=[P1,P2].sort((u,v)=>u[0]-v[0]||u[1]-v[1]);
  let LA=-2*S1[0]+2*S2[0],LB=-2*S1[1]+2*S2[1],LC=c1-c2;const g=gcd(gcd(LA,LB),LC)||1;LA/=g;LB/=g;LC/=g;
  return{q:`Wyznacz współrzędne punktów wspólnych okręgów o równaniach ${genCirc(S1[0],S1[1],r1)} oraz ${genCirc(S2[0],S2[1],r2)}.`,a:pts.map(P=>`(${N(P[0])}, ${N(P[1])})`).join(' oraz '),
  s:[`Odejmujemy równania stronami (znikają x² i y²): ${genEq(LA,LB,LC)}, czyli ${swp?'y':'x'} = ${N(p)}.`,`Podstawiamy ${swp?'y':'x'} = ${N(p)} do pierwszego równania i rozwiązujemy równanie kwadratowe z jedną niewiadomą: ${swp?'x':'y'} = ${N(q-t)} lub ${swp?'x':'y'} = ${N(q+t)}.`,`Punkty wspólne: ${pts.map(P=>`(${N(P[0])}, ${N(P[1])})`).join(' i ')}.`]}}
function gHomothety(){const S=[ri(-3,3),ri(-3,3)],K=toF(pick([2,3,-1,-2,F(1,2),F(-1,2),F(3,2)])),A=[ri(-5,5),ri(-5,5)],img=([x,y])=>[F(S[0]*K.d+(x-S[0])*K.n,K.d),F(S[1]*K.d+(y-S[1])*K.n,K.d)],A2=img(A),a=ri(-4,4),b=ri(-4,4),r=ri(1,5),O2=img([a,b]),r2=F(K.n*K.n*r*r,K.d*K.d);
  return{q:`Jednokładność o środku S = (${N(S[0])}, ${N(S[1])}) i skali k = ${fH(K)} przekształca punkt A = (${N(A[0])}, ${N(A[1])}) na punkt A′, a okrąg ${sqT(a)} + ${sqT(b,'y')} = ${r*r} na okrąg o′. Wyznacz A′, równanie okręgu o′ oraz stosunek pola koła ograniczonego okręgiem o′ do pola koła wyjściowego.`,
  a:`A′ = ${pt(...A2)}; o′: ${sqF(O2[0])} + ${sqF(O2[1],'y')} = ${fH(r2)}; stosunek pól: ${fH(fmul(K,K))}`,
  s:[`Jednokładność: X′ = S + k · [X − S] (wektorowo).`,`A′ = (${N(S[0])}, ${N(S[1])}) + ${pF(K)} · [${N(A[0]-S[0])}, ${N(A[1]-S[1])}] = ${pt(...A2)}.`,`Środek okręgu (${N(a)}, ${N(b)}) przechodzi na ${pt(...O2)}, a promień mnoży się przez |k|: r′ = ${fH(fmul(F(Math.abs(K.n),K.d),F(r)))}.`,`Pola figur jednokładnych są w stosunku k² = ${fH(fmul(K,K))}.`]}}
function gReflectLine(){const[a,b]=pick([[1,1],[1,-1],[1,2],[2,1],[1,-2],[2,-1],[1,3],[3,1],[3,-1]]),M0=[ri(-4,4),ri(-4,4)],t=riNZ(-2,2),c=-(a*M0[0]+b*M0[1]),P=[M0[0]+t*a,M0[1]+t*b],P2=[M0[0]-t*a,M0[1]-t*b];
  return{q:`Wyznacz współrzędne punktu P′ symetrycznego do punktu P = (${N(P[0])}, ${N(P[1])}) względem prostej ${genEq(a,b,c)}.`,a:`P′ = (${N(P2[0])}, ${N(P2[1])})`,
  s:[`Prosta k przechodząca przez P prostopadle do danej prostej ma równanie ${genEq(b,-a,-(b*P[0]-a*P[1]))}.`,`Rozwiązujemy układ równań obu prostych: punkt przecięcia M = (${N(M0[0])}, ${N(M0[1])}).`,`M jest środkiem odcinka PP′, więc P′ = (2 · ${pN(M0[0])} − ${pN(P[0])}, 2 · ${pN(M0[1])} − ${pN(P[1])}) = (${N(P2[0])}, ${N(P2[1])}).`]}}

/* --- rozszerzenie: funkcje, granice, ciągłość --- */
function gCompose(){const a=riNZ(-3,3),b=ri(-5,5),c=ri(-5,5),x0=ri(-3,3),f=x=>a*x+b,g=x=>x*x+c,fg=[a,0,a*c+b],gf=[a*a,2*a*b,b*b+c];
  return{q:`Dane są funkcje f(x) = ${poly([a,b])} oraz g(x) = ${poly([1,0,c])}. Wyznacz wzory funkcji f∘g i g∘f oraz oblicz (f∘g)(${N(x0)}) i (g∘f)(${N(x0)}).`,
  a:`(f∘g)(x) = ${poly(fg)}, (g∘f)(x) = ${poly(gf)}; (f∘g)(${N(x0)}) = ${N(f(g(x0)))}, (g∘f)(${N(x0)}) = ${N(g(f(x0)))}`,
  s:[`(f∘g)(x) = f(g(x)) = ${lead(a,'')}(${poly([1,0,c])})${tail([b])} = ${poly(fg)}.`,`(g∘f)(x) = g(f(x)) = (${poly([a,b])})²${tail([c])} = ${poly(gf)}.`,`(f∘g)(${N(x0)}) = f(g(${N(x0)})) = f(${N(g(x0))}) = ${N(f(g(x0)))}; (g∘f)(${N(x0)}) = g(f(${N(x0)})) = g(${N(f(x0))}) = ${N(g(f(x0)))}.`,'Złożenie funkcji na ogół nie jest przemienne: f∘g ≠ g∘f.']}}
function gContinuity(){if(rnd()<.5){const a=riNZ(-6,6);let b;do b=ri(-6,6);while(b===-a);const nu=expand([a,-b]);
    return{q:`Funkcja f jest określona wzorem f(x) = ${fr(poly(nu),sh(a))} dla x ≠ ${N(a)} oraz f(${N(a)}) = m. Wyznacz m, dla którego funkcja f jest ciągła w punkcie x = ${N(a)}.`,a:`m = ${N(a+b)}`,
    s:[`f jest ciągła w x<sub>0</sub> = ${N(a)}, gdy lim<sub>x→${N(a)}</sub> f(x) = f(${N(a)}).`,`Licznik: ${poly(nu)} = ${pp(a)}${pp(-b)}.`,`Dla x ≠ ${N(a)}: f(x) = ${sh(-b)}, więc granica w ${N(a)} wynosi ${plusN(a,b)} = ${N(a+b)}.`,`m = ${N(a+b)}.`]}}
  const k=pick([1,2,-1,-2,3]),p=ri(-4,4),m=riNZ(-5,5),q=k*k+p*k-m*k;
  return{q:`Funkcja f jest określona wzorem f(x) = ${poly([1,p,0])} dla x < ${N(k)} oraz f(x) = mx${tail([q])} dla x ≥ ${N(k)}. Wyznacz m, dla którego funkcja f jest ciągła.`,a:`m = ${N(m)}`,
  s:[`Obie części są ciągłe, więc wystarczy zbadać punkt x = ${N(k)}: granica lewostronna musi być równa f(${N(k)}).`,`lim<sub>x→${N(k)}<sup>−</sup></sub> f(x) = ${pN(k)}² ${p<0?'−':'+'} ${Math.abs(p)} · ${pN(k)} = ${N(k*k+p*k)}; f(${N(k)}) = ${lead(k,'m')}${tail([q])}.`,`${lead(k,'m')}${tail([q])} = ${N(k*k+p*k)}, więc m = ${N(m)}.`]}}
function gAsymptote(){const a=riNZ(-4,4),c=ri(-5,5);let b;do b=ri(-8,8);while(b===-a*c);const Nc=a*c+b,L=Nc>0?`${M}∞`:'+∞',R=Nc>0?'+∞':`${M}∞`;
  return{q:`Dana jest funkcja f(x) = ${fr(poly([a,b]),sh(c))}. Oblicz granice jednostronne funkcji f w punkcie x = ${N(c)} oraz granice w ±∞. Podaj równania asymptot wykresu funkcji f.`,
  a:`lim<sub>x→${N(c)}<sup>−</sup></sub> f(x) = ${L}, lim<sub>x→${N(c)}<sup>+</sup></sub> f(x) = ${R}, lim<sub>x→±∞</sub> f(x) = ${N(a)}; asymptota pionowa x = ${N(c)}, pozioma y = ${N(a)}`,
  s:[`W x = ${N(c)} mianownik dąży do 0, a licznik do ${N(a)} · ${pN(c)}${tail([b])} = ${N(Nc)} ${Nc>0?'> 0':'< 0'}.`,`Dla x → ${N(c)}<sup>−</sup> mianownik jest ujemny, a dla x → ${N(c)}<sup>+</sup> dodatni, więc granice to ${L} i ${R}.`,`Dla x → ±∞ dzielimy licznik i mianownik przez x: f(x) → ${N(a)}.`,`Asymptoty: pionowa x = ${N(c)}, pozioma y = ${N(a)}.`]}}

/* --- rozszerzenie: trygonometria --- */
const TVX={sin:{0:'0',30:fr(1,2),45:fr('√2',2),60:fr('√3',2),90:'1'},cos:{0:'1',30:fr('√3',2),45:fr('√2',2),60:fr(1,2),90:'0'},tg:{0:'0',30:fr('√3',3),45:'1',60:'√3'}};
function trigExact(f,t){t=((t%360)+360)%360;const ref=t<=90?t:t<=180?180-t:t<=270?t-180:360-t,r=t*Math.PI/180,v=f==='sin'?Math.sin(r):f==='cos'?Math.cos(r):Math.tan(r);if(Math.abs(v)<1e-9)return'0';return(v<0?M:'')+TVX[f][ref]}
function gRadian(){const m=ri(0,2),[n,d]=pick([[1,6],[1,4],[1,3],[1,2],[2,3],[3,4],[5,6],[1,1],[7,6],[5,4],[4,3],[3,2],[5,3],[7,4],[11,6],[2,1],[5,2],[1,5],[2,5],[1,12],[5,12],[7,12],[1,9],[1,10],[3,5],[4,9]]),deg=180*n/d;
  if(m===0)return{q:`Zamień miarę stopniową ${deg}° na miarę łukową.`,a:`${piF(F(n,d))} rad`,s:[`180° = π rad, więc 1° = ${fr('π',180)} rad.`,`${deg}° = ${deg} · ${fr('π',180)} = ${piF(F(n,d))} rad.`]};
  if(m===1)return{q:`Zamień miarę łukową ${piF(F(n,d))} rad na miarę stopniową.`,a:`${deg}°`,s:['π rad = 180°.',`${piF(F(n,d))} = ${fH(F(n,d))} · 180° = ${deg}°.`]};
  const r=ri(2,12);return{q:`Kąt środkowy ma miarę ${piF(F(n,d))} rad. Oblicz długość łuku i pole wycinka koła o promieniu ${r} wyznaczonych przez ten kąt.`,a:`l = ${piF(F(n*r,d))}, P = ${piF(F(n*r*r,2*d))}`,
    s:['W mierze łukowej: l = α · r oraz P = ½ · α · r².',`l = ${piF(F(n,d))} · ${r} = ${piF(F(n*r,d))}.`,`P = ½ · ${piF(F(n,d))} · ${r*r} = ${piF(F(n*r*r,2*d))}.`]}}
function gReduceAny(){const f=pick(['sin','cos','tg']),base=pick([0,30,45,60,90,120,135,150,180,210,225,240,270,300,315,330].filter(b=>f!=='tg'||b%180!==90)),k=pick([-2,-1,1,2,3,4]),t=base+360*k,rad=rnd()<.45,t0=((t%360)+360)%360;
  const disp=rad?`(${piF(F(t,180))})`:`${N(t)}°`,ref=t0<=90?t0:t0<=180?180-t0:t0<=270?t0-180:360-t0,quad=t0%90===0?'leży na osi układu':`leży w ${['I','II','III','IV'][Math.floor(t0/90)]} ćwiartce`,val=trigExact(f,t);
  return{q:`Oblicz ${f} ${disp}.`,a:val,
  s:[rad?`Zamieniamy na stopnie: ${piF(F(t,180))} = ${N(t)}°.`:`Kąt ${N(t)}°.`,`Funkcja ${f} jest okresowa (okres ${f==='tg'?'180°':'360°'}), więc ${f} ${N(t)}° = ${f} ${t0}° (${N(t)}° ${k>0?'−':'+'} ${Math.abs(k)} · 360°).`,`Kąt ${t0}° ${quad}; kąt odniesienia: ${ref}°.`,`${f} ${t0}° = ${val}${t0%90===0?'':` (znak zależy od ćwiartki, a wartość bezwzględna to ${f} ${ref}°)`}.`]}}
function gSumAngle(){let[a1,b1,c1]=pickTriple(41);if(rnd()<.5)[a1,b1]=[b1,a1];let[a2,b2,c2]=pickTriple(41);if(rnd()<.5)[a2,b2]=[b2,a2];const ob=rnd()<.5,sa=F(a1,c1),ca=F(b1,c1),sb=F(a2,c2),cb=F(ob?-b2:b2,c2),m=ri(0,2);
  if(m<2){const v=m===0?fadd(fmul(sa,cb),fmul(ca,sb)):fadd(fmul(ca,cb),fmul(sa,sb)),nm=m===0?'sin(α + β)':'cos(α − β)';
    return{q:`Kąt α jest ostry i sin α = ${fH(sa)}, a kąt β jest ${ob?'rozwarty':'ostry'} i sin β = ${fH(sb)}. Oblicz ${nm}.`,a:`${nm} = ${fH(v)}`,
    s:[`cos α = √(1 − sin²α) = ${fH(ca)} (α ostry, więc cos α > 0); cos β = ${fH(cb)} (β ${ob?'rozwarty, więc cos β < 0':'ostry, więc cos β > 0'}).`,m===0?`sin(α + β) = sin α cos β + cos α sin β = ${fH(sa)} · ${pF(cb)} + ${fH(ca)} · ${fH(sb)} = ${fH(v)}.`:`cos(α − β) = cos α cos β + sin α sin β = ${fH(ca)} · ${pF(cb)} + ${fH(sa)} · ${fH(sb)} = ${fH(v)}.`]}}
  const s2=fmul(F(2),fmul(sa,ca)),c2v=fadd(fmul(ca,ca),fmul(F(-1),fmul(sa,sa))),t2=F(s2.n*c2v.d,s2.d*c2v.n);
  return{q:`Kąt α jest ostry i sin α = ${fH(sa)}. Oblicz sin 2α, cos 2α oraz tg 2α.`,a:`sin 2α = ${fH(s2)}, cos 2α = ${fH(c2v)}, tg 2α = ${fH(t2)}`,
  s:[`cos α = ${fH(ca)} (α ostry).`,`sin 2α = 2 sin α cos α = 2 · ${fH(sa)} · ${fH(ca)} = ${fH(s2)}.`,`cos 2α = cos²α − sin²α = ${fr(b1*b1,c1*c1)} − ${fr(a1*a1,c1*c1)} = ${fH(c2v)}.`,`tg 2α = ${fr('sin 2α','cos 2α')} = ${fH(t2)}.`]}}
function gPeriod(){const f=pick(['sin','cos','sin','cos','tg']),K=toF(pick([2,3,4,F(1,2),F(1,3),F(2,3)])),A=f==='tg'?pick([1,2,-1]):riNZ(-4,4),B=f==='tg'?0:ri(-4,4),T=f==='tg'?F(K.d,K.n):F(2*K.d,K.n),arg=K.d===1?`${K.n}x`:fr(K.n===1?'x':K.n+'x',K.d);
  return{q:`Wyznacz okres podstawowy funkcji f(x) = ${A===1?'':A===-1?M:N(A)}${f} ${arg}${tail([B])}${f==='tg'?'':' oraz jej zbiór wartości'}.`,a:`T = ${piF(T)}${f==='tg'?'':`, ZW = ⟨${N(B-Math.abs(A))}, ${N(B+Math.abs(A))}⟩`}`,
  s:[`Funkcja ${f} x ma okres ${f==='tg'?'π':'2π'}, a funkcja ${f}(kx) ma okres ${f==='tg'?'π : k':'2π : k'}. Tu k = ${fH(K)}, więc T = ${piF(T)}.`,...(f==='tg'?[`Sprawdzenie: f(x + ${piF(T)}) = f(x), bo argument tangensa zwiększa się wtedy o π.`]:[`${f} ${arg} ∈ ⟨−1, 1⟩, więc ${A===1?'':A===-1?M:N(A)+' · '}${f} ${arg} ∈ ⟨${N(-Math.abs(A))}, ${Math.abs(A)}⟩.`,`Po dodaniu ${N(B)}: ZW = ⟨${N(B-Math.abs(A))}, ${N(B+Math.abs(A))}⟩.`])]}}
const SOL={sin:{'-1':[[3,2]],'-1/2':[[7,6],[11,6]],'0':[[0,1],[1,1],[2,1]],'1/2':[[1,6],[5,6]],'1':[[1,2]]},cos:{'-1':[[1,1]],'-1/2':[[2,3],[4,3]],'0':[[1,2],[3,2]],'1/2':[[1,3],[5,3]],'1':[[0,1],[2,1]]}};
function gTrigQuadEq(){const f=pick(['sin','cos']),g2=f==='sin'?'cos':'sin',H=[-4,-3,-2,-1,0,1,2,3,4];let p,q;do{p=pick(H);q=pick(H)}while(p===q||(Math.abs(p)>2&&Math.abs(q)>2));
  let cs=[4,-2*(p+q),p*q];const g=gcd(gcd(cs[0],cs[1]),cs[2])||1;cs=cs.map(x=>x/g);const key=v=>{const fv=F(v,2);return fv.d===1?''+fv.n:fv.n+'/'+fv.d};
  const ok=[p,q].filter(v=>Math.abs(v)<=2),bad=[p,q].filter(v=>Math.abs(v)>2),sols=[];ok.forEach(v=>SOL[f][key(v)].forEach(s=>sols.push(s)));sols.sort((u,v)=>u[0]/u[1]-v[0]/v[1]);
  const cf=c=>c===1?'':c===-1?M:N(c),mixed=rnd()<.5,eq=mixed?`${cf(-cs[0])}${g2}²x${term(cs[1],`${f} x`)}${term(cs[0]+cs[2],'')} = 0`:`${cf(cs[0])}${f}²x${term(cs[1],`${f} x`)}${term(cs[2],'')} = 0`;
  return{q:`Rozwiąż równanie ${eq} w przedziale ⟨0, 2π⟩.`,a:`x ∈ {${sols.map(s=>piF(F(s[0],s[1]))).join(', ')}}`,
  s:[...(mixed?[`Z jedynki trygonometrycznej: ${g2}²x = 1 − ${f}²x. Po podstawieniu: ${cf(cs[0])}${f}²x${term(cs[1],`${f} x`)}${term(cs[2],'')} = 0.`]:[]),`Podstawiamy t = ${f} x, gdzie t ∈ ⟨−1, 1⟩: ${poly(cs,'t')} = 0.`,`Pierwiastki: t = ${fH(F(p,2))} lub t = ${fH(F(q,2))}.${bad.length?` t = ${fH(F(bad[0],2))} ∉ ⟨−1, 1⟩, więc odrzucamy.`:''}`,
    ...ok.map(v=>`${f} x = ${fH(F(v,2))} w ⟨0, 2π⟩: x ∈ {${SOL[f][key(v)].map(s=>piF(F(s[0],s[1]))).join(', ')}}.`)]}}

/* --- rozszerzenie: planimetria --- */
function gCyclicQuad(){const m=ri(0,2);
  if(m===0){const a=ri(50,130),b=ri(50,130);return{q:`Czworokąt ABCD jest wpisany w okrąg. |∢DAB| = ${a}°, |∢ABC| = ${b}°. Oblicz miary pozostałych kątów czworokąta.`,a:`|∢BCD| = ${180-a}°, |∢CDA| = ${180-b}°`,
    s:['Czworokąt można wpisać w okrąg wtedy i tylko wtedy, gdy sumy jego przeciwległych kątów są równe 180°.',`|∢BCD| = 180° − ${a}° = ${180-a}°, |∢CDA| = 180° − ${b}° = ${180-b}°.`]}}
  if(m===1){let a,b,c;do{a=ri(3,15);b=ri(3,15);c=ri(3,15)}while(a+c-b<=1);const d=a+c-b;return{q:`W czworokąt ABCD wpisano okrąg. |AB| = ${a}, |BC| = ${b}, |CD| = ${c}. Oblicz |DA| oraz obwód czworokąta.`,a:`|DA| = ${d}, obwód = ${2*(a+c)}`,
    s:['W czworokąt można wpisać okrąg wtedy i tylko wtedy, gdy sumy długości przeciwległych boków są równe: |AB| + |CD| = |BC| + |DA|.',`${a} + ${c} = ${b} + |DA|, więc |DA| = ${d}.`,`Obwód = 2(|AB| + |CD|) = ${2*(a+c)}.`]}}
  const k=ri(1,3),T=pickTriple(k===1?41:k===2?25:13).map(v=>v*k),sw=rnd()<.5,u=sw?T[0]:T[1],t=sw?T[1]:T[0],c=T[2],A=c+u,B=c-u;
  return{q:`Trapez równoramienny jest opisany na okręgu. Ramię trapezu ma długość ${c}, a różnica długości podstaw jest równa ${2*u}. Oblicz długości podstaw, wysokość i pole trapezu oraz promień okręgu wpisanego.`,a:`podstawy ${A} i ${B}, h = ${t}, P = ${c*t}, r = ${fH(F(t,2))}`,
  s:[`W trapez wpisano okrąg, więc suma podstaw jest równa sumie ramion: a + b = ${2*c}.`,`a − b = ${2*u}; stąd a = ${A}, b = ${B}.`,`Rzut ramienia na dłuższą podstawę: ${fr('a − b',2)} = ${u}, więc h = √(${c*c} − ${u*u}) = ${t}.`,`P = ${fr('a + b',2)} · h = ${c} · ${t} = ${c*t}; r = ${fr('h',2)} = ${fH(F(t,2))}.`]}}
function gPowerPoint(){if(rnd()<.5){const a=ri(1,9),b=ri(1,12),v=a*(a+b);return{q:`Z punktu P leżącego poza okręgiem poprowadzono sieczną, która przecina okrąg w punktach A i B (A leży między P i B), oraz styczną do okręgu w punkcie T. |PA| = ${a}, |AB| = ${b}. Oblicz |PT|.`,a:`|PT| = ${sq(v)}`,
    s:['Twierdzenie o stycznej i siecznej: |PT|² = |PA| · |PB|.',`|PB| = ${a} + ${b} = ${a+b}.`,`|PT|² = ${a} · ${a+b} = ${v}, |PT| = ${sq(v)}.`]}}
  let a,b,c;do{a=ri(2,8);b=ri(a+1,16);c=ri(1,9)}while((a*b)%c||a*b/c<=c||c===a);const d=a*b/c;
  return{q:`Z punktu P poprowadzono dwie sieczne okręgu. Pierwsza przecina okrąg w punktach A i B, a druga w punktach C i D (A leży między P i B, a C między P i D). |PA| = ${a}, |AB| = ${b-a}, |PC| = ${c}. Oblicz |CD|.`,a:`|CD| = ${d-c}`,
  s:['Twierdzenie o siecznych: |PA| · |PB| = |PC| · |PD|.',`|PB| = ${b}; ${a} · ${b} = ${c} · |PD|, więc |PD| = ${d}.`,`|CD| = |PD| − |PC| = ${d} − ${c} = ${d-c}.`]}}

/* --- rozszerzenie: stereometria --- */
function gShortestPath(){const m=ri(0,2);
  if(m===0){const[a,b,c]=[ri(1,8),ri(1,8),ri(2,12)].sort((x,y)=>x-y),v=(a+b)**2+c*c;return{q:`Mrówka idzie po powierzchni prostopadłościanu o wymiarach ${shuffle([a,b,c]).join(' × ')} z wierzchołka A do przeciwległego wierzchołka G (A i G to końce przekątnej prostopadłościanu). Oblicz długość najkrótszej drogi mrówki.`,a:sq(v),
    s:['Rozkładamy dwie sąsiednie ściany na płaszczyznę (siatka); najkrótsza droga to odcinek łączący A i G na tej siatce.',`Możliwe długości: ${[[a,b,c],[a,c,b],[b,c,a]].map(([x,y,z])=>`√(${x+y}² + ${z}²) = ${sq((x+y)**2+z*z)}`).join(', ')}.`,`Najkrótsza jest wtedy, gdy osobno zostaje najdłuższa krawędź: ${sq(v)}.`]}}
  if(m===1){const[d,ang]=pick([[3,120],[4,90],[6,60]]),r=ri(1,5),l=d*r,ans=d===3?fsq(l,3):d===4?fsq(l,2):''+l;
    return{q:`Stożek ma promień podstawy ${r} i tworzącą długości ${l}. Mrówka startuje z punktu A na okręgu podstawy, okrąża powierzchnię boczną stożka i wraca do punktu A. Oblicz długość najkrótszej takiej drogi.`,a:ans,
    s:[`Rozwijamy powierzchnię boczną: to wycinek koła o promieniu l = ${l}, którego łuk ma długość obwodu podstawy 2π · ${r}.`,`Kąt wycinka: ${fr('r','l')} · 360° = ${fr(r,l)} · 360° = ${ang}°.`,`Najkrótsza droga to cięciwa łącząca końce łuku: 2l · sin ${ang/2}° = ${ans}.`]}}
  const r=ri(1,6),h=ri(2,15);return{q:`Na walec o promieniu podstawy ${r} i wysokości ${h} nawinięto sznurek, który okrąża walec dokładnie raz: od punktu A na brzegu dolnej podstawy do punktu B na brzegu górnej podstawy, leżącego dokładnie nad A. Oblicz najmniejszą możliwą długość sznurka.`,a:`√(${4*r*r}π² + ${h*h})`,
    s:['Rozcinamy powierzchnię boczną wzdłuż tworzącej AB i rozkładamy ją w prostokąt.',`Prostokąt ma wymiary 2πr × h = ${2*r}π × ${h}; sznurek to jego przekątna.`,`d = √((${2*r}π)² + ${h}²) = √(${4*r*r}π² + ${h*h}).`]}}
function gSphereSolids(){if(rnd()<.5){const r=ri(1,8);return{q:`W walec wpisano kulę o promieniu ${r} (kula jest styczna do obu podstaw i do powierzchni bocznej walca). Oblicz stosunek objętości walca do objętości kuli oraz stosunek ich pól powierzchni.`,a:'oba stosunki są równe 3 : 2',
    s:[`Walec ma promień ${r} i wysokość ${2*r}: V<sub>w</sub> = π · ${r*r} · ${2*r} = ${piF(2*r**3)}, P<sub>w</sub> = 2π · ${r*r} + 2π · ${r} · ${2*r} = ${piF(6*r*r)}.`,`Kula: V<sub>k</sub> = ${piF(F(4*r**3,3))}, P<sub>k</sub> = ${piF(4*r*r)}.`,`V<sub>w</sub> : V<sub>k</sub> = 3 : 2 i P<sub>w</sub> : P<sub>k</sub> = 3 : 2.`]}}
  const a=ri(2,12);return{q:`Przekrój osiowy stożka jest trójkątem równobocznym o boku ${a}. Oblicz promień kuli wpisanej w ten stożek i promień kuli opisanej na nim.`,a:`r = ${fsq(F(a,6),3)}, R = ${fsq(F(a,3),3)}`,
  s:['Kula wpisana w stożek ma w przekroju osiowym okrąg wpisany w trójkąt, a kula opisana — okrąg opisany na trójkącie.',`Dla trójkąta równobocznego: r = ${fr('a√3',6)} = ${fsq(F(a,6),3)}, R = ${fr('a√3',3)} = ${fsq(F(a,3),3)}.`]}}

/* --- rozszerzenie: prawdopodobieństwo (wartość oczekiwana) --- */
function gExpected(){if(rnd()<.5){const W=ri(8,30),V=ri(0,6),L=ri(1,8),E=F(W+2*V-3*L,6);
    return{q:`Gra polega na jednokrotnym rzucie symetryczną kostką. Za wyrzucenie szóstki gracz dostaje ${W} zł, za wyrzucenie czwórki lub piątki ${V} zł, a w pozostałych przypadkach płaci ${L} zł. Oblicz wartość oczekiwaną wygranej. Czy gra jest korzystna dla gracza?`,
    a:`E = ${fH(E)} zł ≈ ${dec(E.n/E.d)} zł; gra jest ${E.n>0?'korzystna':E.n<0?'niekorzystna':'sprawiedliwa'} dla gracza`,
    s:[`Wygrana X: ${W} z prawdopodobieństwem ${fr(1,6)}, ${V} z prawdopodobieństwem ${fr(2,6)}, ${N(-L)} z prawdopodobieństwem ${fr(3,6)}.`,`EX = ${W} · ${fr(1,6)} + ${V} · ${fr(2,6)} + ${pN(-L)} · ${fr(3,6)} = ${fr(N(W+2*V-3*L),6)} = ${fH(E)}.`,`${E.n>0?'EX > 0, więc gra jest korzystna dla gracza.':E.n<0?'EX < 0, więc gra jest niekorzystna dla gracza.':'EX = 0, więc gra jest sprawiedliwa.'}`]}}
  const n=pick([10,12]),xs=distinct(3,-3,8).sort((a,b)=>a-b);let p1,p2;do{p1=ri(1,n-2);p2=ri(1,n-2)}while(p1+p2>=n);const p3=n-p1-p2,E=F(xs[0]*p1+xs[1]*p2+xs[2]*p3,n);
  return{q:`Zmienna losowa X przyjmuje wartości ${xs.map(N).join(', ')} odpowiednio z prawdopodobieństwami ${fH(F(p1,n))}, ${fH(F(p2,n))} i p. Wyznacz p oraz wartość oczekiwaną EX.`,a:`p = ${fH(F(p3,n))}, EX = ${fH(E)}`,
  s:[`Suma prawdopodobieństw jest równa 1: p = 1 − ${fH(F(p1,n))} − ${fH(F(p2,n))} = ${fH(F(p3,n))}.`,`EX = ${xs.map((x,i)=>`${pN(x)} · ${fH(F([p1,p2,p3][i],n))}`).join(' + ')} = ${fH(E)}.`]}}

/* --- rozszerzenie: pochodne --- */
function gDerivPow(){const m=ri(0,2);
  if(m===0){const a=riNZ(-3,3)*2,b=riNZ(-8,8),x0=pick([1,4,9,16]),s=Math.sqrt(x0),d=fadd(F(a,2*s),F(-b,x0*x0)),y0=fadd(F(a*s),F(b,x0)),bb=fr(Math.abs(b),'x');
    return{q:`Dana jest funkcja f(x) = ${N(a)}√x ${b<0?'−':'+'} ${bb} dla x > 0. Wyznacz f′(x) oraz równanie stycznej do wykresu funkcji f w punkcie o odciętej x<sub>0</sub> = ${x0}.`,
    a:`f′(x) = ${fr(N(a/2),'√x')} ${b>0?'−':'+'} ${fr(Math.abs(b),'x²')}; styczna: y = ${poly([d,fadd(y0,fmul(F(-x0),d))])}`,
    s:[`(√x)′ = ${fr(1,'2√x')}, (${fr(1,'x')})′ = (x<sup>−1</sup>)′ = −x<sup>−2</sup> = ${M}${fr(1,'x²')}.`,`f′(x) = ${N(a)} · ${fr(1,'2√x')} ${b>0?'−':'+'} ${fr(Math.abs(b),'x²')} = ${fr(N(a/2),'√x')} ${b>0?'−':'+'} ${fr(Math.abs(b),'x²')}.`,`f(${x0}) = ${fH(y0)}, f′(${x0}) = ${fH(d)}.`,`y = f′(x<sub>0</sub>)(x − x<sub>0</sub>) + f(x<sub>0</sub>) = ${fH(d)}(x − ${x0}) + ${pF(y0)}, czyli y = ${poly([d,fadd(y0,fmul(F(-x0),d))])}.`]}}
  if(m===1){const p=pick([2,3,-1,-2]),q=riNZ(-5,5),n=pick([3,4,5]),x0=ri(-2,2),u=p*x0+q,d=n*p*u**(n-1);
    return{q:`Oblicz pochodną funkcji f(x) = (${poly([p,q])})<sup>${n}</sup> oraz wartość f′(${N(x0)}).`,a:`f′(x) = ${N(n*p)}(${poly([p,q])})<sup>${n-1}</sup>, f′(${N(x0)}) = ${N(d)}`,
    s:['Pochodna funkcji złożonej: [g(x)<sup>n</sup>]′ = n · g(x)<sup>n − 1</sup> · g′(x).',`g(x) = ${poly([p,q])}, g′(x) = ${N(p)}, więc f′(x) = ${n} · (${poly([p,q])})<sup>${n-1}</sup> · ${pN(p)} = ${N(n*p)}(${poly([p,q])})<sup>${n-1}</sup>.`,`f′(${N(x0)}) = ${N(n*p)} · ${pN(u)}<sup>${n-1}</sup> = ${N(d)}.`]}}
  let[t0,x0,s]=pickTriple(41);if(rnd()<.5)[t0,x0]=[x0,t0];const c=t0*t0;
  return{q:`Oblicz pochodną funkcji f(x) = √(x² + ${c}) oraz wartość f′(${x0}).`,a:`f′(x) = ${fr('x',`√(x² + ${c})`)}, f′(${x0}) = ${fH(F(x0,s))}`,
  s:[`(√u)′ = ${fr('u′','2√u')}, gdzie u = x² + ${c} i u′ = 2x.`,`f′(x) = ${fr('2x',`2√(x² + ${c})`)} = ${fr('x',`√(x² + ${c})`)}.`,`f′(${x0}) = ${fr(x0,`√${x0*x0+c}`)} = ${fH(F(x0,s))}.`]}}
function gTangentPar(){let r1,r2;do[r1,r2]=distinct(2,-3,3);while((r1+r2)%2);const b=-3*(r1+r2)/2,c=ri(-6,6),k=c-3*r1*r2,d=ri(-5,5),cs=[1,b,c,d],f=x=>ev(cs,x),xs=[r1,r2].sort((x,y)=>x-y),ints=xs.map(x=>f(x)-k*x);let m0;do m0=ri(-6,6);while(ints.includes(m0));
  return{q:`Wyznacz równania stycznych do wykresu funkcji f(x) = ${poly(cs)}, które są równoległe do prostej y = ${poly([k,m0])}.`,a:xs.map((x,i)=>`y = ${poly([k,ints[i]])}`).join(' oraz '),
  s:[`Styczna równoległa ma współczynnik kierunkowy ${N(k)}, więc szukamy x, dla których f′(x) = ${N(k)}.`,`f′(x) = ${poly([3,2*b,c])} = ${N(k)} ⇔ ${poly([3,2*b,c-k])} = 0 ⇔ x = ${N(xs[0])} lub x = ${N(xs[1])}.`,`f(${N(xs[0])}) = ${N(f(xs[0]))}, f(${N(xs[1])}) = ${N(f(xs[1]))}.`,`Styczne: ${xs.map((x,i)=>`y = ${N(k)}${pp(x)} + ${pN(f(x))}, czyli y = ${poly([k,ints[i]])}`).join('; ')}.`]}}
function gDerivDef(){const a=riNZ(-3,3),b=ri(-5,5),x0=ri(-3,3),d=2*a*x0+b,bt=b?` ${b<0?'−':'+'} ${Math.abs(b)===1?'':Math.abs(b)}(${N(x0)} + h)`:'';
  return{q:`Korzystając z definicji pochodnej, oblicz f′(${N(x0)}) dla funkcji f(x) = ${poly([a,b,0])}.`,a:`f′(${N(x0)}) = ${N(d)}`,
  s:[`f′(x<sub>0</sub>) = lim<sub>h→0</sub> ${fr('f(x<sub>0</sub> + h) − f(x<sub>0</sub>)','h')}.`,`f(${N(x0)} + h) − f(${N(x0)}) = ${lead(a,'')}(${N(x0)} + h)²${bt} − ${pN(a*x0*x0+b*x0)} = ${poly([a,d,0],'h')}.`,`Iloraz różnicowy: ${fr(poly([a,d,0],'h'),'h')} = ${poly([a,d],'h')} (dla h ≠ 0).`,`Dla h → 0: f′(${N(x0)}) = ${N(d)}.`]}}

const BASIC=[
 {name:'Potęgi, pierwiastki, procenty',g:[gPow,gProc,gLokata,gPensja,gCbrt,gAbsRoot,gSciNot,cMonoPow,cPctPoints]},
 {name:'Przedziały liczbowe i przybliżenia',g:[gIntervals,gIntervals,gApprox,cMonoPow]},
 {name:'Wyrażenia algebraiczne',g:[gShortMult,gShortMult,gIrrDen,gSciNot,gPolyOps]},
 {name:'Wielomiany i wyrażenia wymierne',g:[gGroupFactor,gGroupFactor,gPolyDivB,gIntRootsB,gPolyOps,gRatSimp,gRatSimp,gRatAddB,gRatEqB,gRatEqB]},
 {name:'Proporcjonalność odwrotna',g:[gInverse]},
 {name:'Logarytmy',g:[gLog,gLogVal,gLogDiff,gLogFn]},
 {name:'Wartość bezwzględna',g:[gAbsB,gAbsB2]},
 {name:'Równania i nierówności',g:[gQuadIneq,gRatEq,gLinIneqFrac,gQuadIneq2,gFormula,cIdentity]},
 {name:'Układy równań',g:[gSystem,gSysType,gSysType,gSysLineCircle,gSysLinePara,gSysWord,gSysWord]},
 {name:'Funkcja liniowa',g:[gLine2,gPerp,gLineProps,gLineParamB]},
 {name:'Funkcja kwadratowa',g:[gVertex,gQuadInt,gQuadFromAxis,gFence,gQuadForms,gQuadForms,gQuadFromVertex,gQuadOptPrice]},
 {name:'Ciągi',g:[gArith,gGeom,gRecur,gArithProof,gSeqMono,gSeqCount,gSeqCount,gSeqCheck,gThreeTerms,gThreeTerms]},
 {name:'Trygonometria',g:[gTrigB,gTrigObt,cRedukcja,gTrigTable]},
 {name:'Twierdzenie sinusów i cosinusów',g:[gCosLawB,gCosLawB,gSinLawB,gTriAreaSin,gTriType,gTriType,gSinSmall,gMedian]},
 {name:'Planimetria',g:[gTales,gEquil,gInscribed,gIncircleRight,gCentroid,gTangentChord,gTrapRight,gEquiDist,gPolygon,gSimilarArea,gSector,gSector,gBisector,gTangentLen,gQuadAngles,gRhombus,gChord,gSimilarTri,gTriType]},
 {name:'Geometria analityczna',g:[gSeg,gIsoOx,gDiagInter,gSymPoint,gVector,gSymFigure,gSymFigure,gCircleB,gCircleB,gLinesPos,gLinesPos,gTangentB]},
 {name:'Stereometria',g:[gCube,gPrism,gSimilarSolids,gPyrAngle,gCylinder,gCuboidSec,gCone,gConeB,gSphere,gSphere,gSkewLines,gCuboidDiag,gPyrTri,gCylSection]},
 {name:'Kombinatoryka i prawdopodobieństwo',g:[gDiceB,()=>gDigits(3),gChoose,gProbDigits,gBraille,gReplace,gProbUnion,gCoins]},
 {name:'Statystyka',g:[gStats,gStatTable,gStatBars,gWeightedMean]},
 {name:'Dowody',g:[staticGen(PROOF_B),gModProof,gPowProof,gProofGen,gProofGen,staticProof(PROOF_B2),staticProof(PROOF_B2)]},
 {name:'Funkcje: wykresy i przekształcenia',g:[gGraphRead,gTransform,gQuadGraph,gPiecewise,gExpFn,gLogFn]},
 {name:'Zadania zamknięte (ABCD, P/F)',g:[cLog,cPow,cProc,cArith,cTrig,cVertex,cParallel,cCircle,cDice,cCubeMC,cStat,cPFLinear,cPFQuad,cDelta,cMonoPow,cPctPoints,cIdentity,gSkewLines]},
 {name:'Zadania z treścią',g:[gField,gAmphi,gBacteria,gTravel,gLokata,gFence,gInverse,gQuadOptPrice,gSysWord]},
 {name:'Zadania wieloczęściowe',g:[gMultiQuad,gMultiTri]}];
const EXT=[
 {id:'zbiory',name:'Liczby rzeczywiste i zbiory',g:[gSets,gSetsR,gSetsR]},
 {id:'log',name:'Logarytmy',g:[gLogExpr,gLogExpr,gLogEq,gLogEq,gLogExpr2,gLogIneq,gLogIneq]},
 {id:'abs',name:'Wartość bezwzględna',g:[gAbsR,gAbsEq,gAbsParam,gAbsQuad,gAbsQuad]},
 {id:'lin',name:'Funkcja liniowa',g:[gLinParam2,gLinParam2,gParamLines,gLinParam]},
 {id:'kw',name:'Funkcja kwadratowa',g:[gViete,gParamDelta,gParamDelta,gRootsDiff,gSumSqParam]},
 {id:'wiel',name:'Wielomiany i symbol Newtona',g:[gPolyIneq,gBezout,gRemainder2,gPolyOneRoot,gDarboux,gRatRoots,gRatRoots,gNewtonEq,gBinomCoef]},
 {id:'dow',name:'Dowody algebraiczne',g:[staticGen(PROOF_A),gProofGen,gModProof,gPowProof,staticProof(PROOF_A2),staticProof(PROOF_A2)]},
 {id:'wym',name:'Funkcje wymierne',g:[gRatIneq,gLattice,gMonoProof,gRatEqR,gRatEqR,gAsymptote]},
 {id:'wyk',name:'Funkcja wykładnicza',g:[gExpEq,gExpIneq]},
 {id:'ciagi',name:'Ciągi i szeregi',g:[gSeriesInf,gSeriesX,gArithS,gGeomOddEven,gArithGeom,gSeqMono]},
 {id:'gran',name:'Granice i ciągłość',g:[gLimSeq,gLimFn,gLimSqrt,gLimRoot,gLimParam,gContinuity,gContinuity,gAsymptote]},
 {id:'poch',name:'Pochodne i optymalizacja',g:[gDeriv,gTangent,gOptBox,gOptProd,gProfit,gMotion,gQuarticMin,gDerivPow,gDerivPow,gTangentPar,gDerivDef]},
 {id:'tryg',name:'Trygonometria',g:[gTrigEqGen,gTrigEqGen,gTrigEq,gTrigIneq,gTrigId,gTrigTg,gRadian,gRadian,gReduceAny,gSumAngle,gSumAngle,gPeriod,gTrigQuadEq,gTrigQuadEq]},
 {id:'plan',name:'Planimetria i dowody geometryczne',g:[gCosLaw,gSinLaw,staticGen(PROOF_G),staticGen(PROOF_G2),staticProof(PROOF_G3),gMedian,gSinSmall,gMedianPara,gTrapPerp,gCyclicQuad,gCyclicQuad,gPowerPoint,gBisector]},
 {id:'anal',name:'Geometria analityczna',g:[gCircle,gDistPL,gDistPL,gTangentLines,gTriArea,gParaVec,gTwoCircles,gTwoCircles,gHomothety,gReflectLine]},
 {id:'dorys',name:'Geometria z dorysowaniem (tricky)',g:[staticGen(PROOF_T),staticGen(PROOF_G2),gTrapPerp,gCommonTangent,gTrapRight,gEquiDist,gMedianPara,gPowerPoint,gCyclicQuad]},
 {id:'graf',name:'Wykresy funkcji i przekształcenia',g:[gTransformR,gTransformR,gAbsParam,gQuadGraph,gCompose,gCompose]},
 {id:'model',name:'Modelowanie i optymalizacja z treścią',g:[gTravel,gBoxMin,gCanMin,gBounce,gProfit,gMotion,gOptBox]},
 {id:'multi',name:'Zadania wieloetapowe',g:[gMultiPoly,gMultiTri,gMultiQuad]},
 {id:'stereo',name:'Stereometria',g:[gPyramid,gCuboidDiag,gPyrAngle,gCubeSec,gCuboidSec,gPyrEdge,gDihedral,gShortestPath,gShortestPath,gSphereSolids,gCone]},
 {id:'komb',name:'Kombinatoryka i prawdopodobieństwo',g:[gBernoulli,gCond,()=>gDigits(pick([4,5])),gBernoulliN,gBayes,gUrns,gNoReplace,gGridPaths,gWordPerm,gNewtonEq,gNewtonProps,gExpected]}];
const DEF=['zbiory','abs','lin','kw','wiel','dow'];
globalThis.__T={BASIC,EXT,seed:f=>{rnd=f}};

/* antypowtórki: av = {q: Set skrótów treści z ostatnich dni, g: Set typów zadań z ostatnich dni} */
const qKey=q=>hashStr(q.replace(/<div class="mc"[\s\S]*$/,'').replace(/<[^>]+>/g,'')).toString(36);
const gKey=(t,g)=>t.name+'#'+t.g.indexOf(g);
function make(t,lvl,av){let best=null;
  for(let k=0;k<14;k++){const g=pick(t.g);try{const r=g();if(!r||!r.q)continue;const o={...r,lvl,topic:t.name,qk:qKey(r.q),gk:gKey(t,g)};
    if(!best)best=o;if(!av)return o;const newQ=!av.q.has(o.qk),newG=!av.g.has(o.gk);
    if(newQ&&(newG||k>=7))return o;if(newQ&&av.q.has(best.qk))best=o}catch(e){console.error(e)}}
  return best||{q:'Nie udało się wylosować zadania — wylosuj inny zestaw.',a:'',lvl,topic:t.name}}

/* ---------- więcej zadań zamkniętych (do arkuszy) ---------- */
function cAbs(){const a=riNZ(-5,5),b=ri(1,6);return mc(`Zbiorem wszystkich rozwiązań nierówności |${sh(a)}| ≤ ${b} jest przedział`,`⟨${N(a-b)}, ${N(a+b)}⟩`,[`⟨${N(-a-b)}, ${N(-a+b)}⟩`,`(${M}∞, ${N(a-b)}⟩ ∪ ⟨${N(a+b)}, +∞)`,`⟨${N(b-a)}, ${N(a+b)}⟩`,`⟨${N(a)}, ${N(a+b)}⟩`])}
function cQuadSet(){const[r1,r2]=distinct(2,-6,6).sort((x,y)=>x-y);return mc(`Zbiorem wszystkich rozwiązań nierówności (${sh(r1)})(${sh(r2)}) < 0 jest`,`(${N(r1)}, ${N(r2)})`,[`(${N(-r2)}, ${N(-r1)})`,`(${M}∞, ${N(r1)}) ∪ (${N(r2)}, +∞)`,`⟨${N(r1)}, ${N(r2)}⟩`])}
function cSystemMC(){const x=riNZ(-5,5),y=riNZ(-5,5);let a,b;do{a=riNZ(-3,3);b=riNZ(-3,3)}while(a===b);
  return mc(`Rozwiązaniem układu równań x + y = ${N(x+y)} oraz ${lead(a,'x')}${term(b,'y')} = ${N(a*x+b*y)} jest para`,`x = ${N(x)}, y = ${N(y)}`,[`x = ${N(y)}, y = ${N(x)}`,`x = ${N(-x)}, y = ${N(y)}`,`x = ${N(x)}, y = ${N(-y)}`,`x = ${N(x+1)}, y = ${N(y-1)}`])}
function cDomain(){const k=ri(1,6);return rnd()<.5?mc(`Dziedziną funkcji f(x) = ${fr(1,`x² − ${k*k}`)} jest zbiór`,`ℝ \\ {${M}${k}, ${k}}`,[`ℝ \\ {${k}}`,`ℝ \\ {${k*k}}`,`(${M}${k}, ${k})`])
  :mc(`Dziedziną funkcji f(x) = √<span class="ov">x − ${k}</span> jest zbiór`,`⟨${k}, +∞)`,[`(${k}, +∞)`,`⟨${M}${k}, +∞)`,`(${M}∞, ${k}⟩`])}
function cRootMC(){const m=pick([2,3,5]),a=ri(1,3),b=ri(2,4);return mc(`Liczba ∛${a**3*m} + ∛${b**3*m} jest równa`,`${a+b}∛${m}`,[`∛${(a**3+b**3)*m}`,`${a*b}∛${m}`,`${a+b}∛${2*m}`])}
function cLokataMC(){const K=pick([1000,2000,5000]),p=pick([2,3,4,5]),n=ri(2,4),f=v=>Math.round(v).toLocaleString('pl-PL')+' zł';
  return mc(`Kwotę ${K} zł wpłacono na lokatę oprocentowaną ${p}% w skali roku z roczną kapitalizacją odsetek. Po ${n} latach na lokacie będzie (w zaokrągleniu do 1 zł)`,f(K*(1+p/100)**n),[f(K*(1+n*p/100)),f(K*(1+p/100)**(n+1)),f(K*(1+p/100)**(n-1))])}
function cSlope(){const a=riNZ(-4,4),b=ri(-5,5),[x1,x2]=distinct(2,-4,4);return mc(`Współczynnik kierunkowy prostej przechodzącej przez punkty (${N(x1)}, ${N(a*x1+b)}) i (${N(x2)}, ${N(a*x2+b)}) jest równy`,N(a),[N(-a),fH(F(1,a)),N(b),fH(F(-1,a))])}
function cPerpMC(){const a=pick([2,3,4,-2,-3,-4]),b=ri(-5,5);return mc(`Prosta prostopadła do prostej y = ${poly([a,b])} ma współczynnik kierunkowy równy`,fH(F(-1,a)),[fH(F(1,a)),N(-a),N(a)])}
function cGeomMC(){const a1=riNZ(-4,4),q=pick([2,-2,3]),n=ri(4,6);return mc(`W ciągu geometrycznym a<sub>1</sub> = ${N(a1)} i q = ${N(q)}. Wyraz a<sub>${n}</sub> jest równy`,N(a1*q**(n-1)),[N(a1*q**n),N(a1*q**(n-2)),N(a1*q*(n-1))])}
function cSumArith(){const a1=ri(-5,8),r=riNZ(-3,4),n=ri(6,12),an=a1+(n-1)*r;return mc(`Suma ${n} początkowych wyrazów ciągu arytmetycznego, w którym a<sub>1</sub> = ${N(a1)} i r = ${N(r)}, jest równa`,N(n*(a1+an)/2),[N(n*(a1+an)),N((n-1)*(2*a1+(n-2)*r)/2),N(an)])}
function cInscribedMC(){const al=ri(20,80);return mc(`Kąt środkowy w okręgu ma miarę ${2*al}°. Kąt wpisany oparty na tym samym łuku (o wierzchołku na dłuższym łuku) ma miarę`,`${al}°`,[`${2*al}°`,`${180-al}°`,`${90-al}°`])}
function cTalesMC(){const a=ri(2,5),s=ri(2,4),c=ri(2,8);return mc(`Ramiona kąta o wierzchołku O przecięto prostymi równoległymi AC i BD (A, B na jednym ramieniu, C, D na drugim). |OA| = ${a}, |AB| = ${a*s}, |OC| = ${c}. Długość odcinka CD jest równa`,''+s*c,[''+c*(s+1),fH(F(c,s)),''+(c+s)])}
function cMidMC(){const x1=ri(-6,6),y1=ri(-6,6),x2=x1+2*riNZ(-4,4),y2=y1+2*riNZ(-4,4);return mc(`Środkiem odcinka o końcach (${N(x1)}, ${N(y1)}) i (${N(x2)}, ${N(y2)}) jest punkt`,`(${N((x1+x2)/2)}, ${N((y1+y2)/2)})`,[`(${N((x2-x1)/2)}, ${N((y2-y1)/2)})`,`(${N(x1+x2)}, ${N(y1+y2)})`,`(${N((x1+x2)/2)}, ${N((y2-y1)/2)})`])}
function cCylMC(){const r=ri(2,6),h=ri(2,9);return mc(`Objętość walca o promieniu podstawy ${r} i wysokości ${h} jest równa`,`${r*r*h}π`,[`${2*r*h}π`,`${r*h*h}π`,`${2*r*r*h}π`])}
function cChooseMC(){const n=ri(5,12);return mc(`Z ${n} osób wybieramy dwuosobową delegację. Liczba możliwych wyborów jest równa`,''+C(n,2),[''+n*(n-1),''+n*n,''+2*n])}
function cMeanW(){const c=[ri(1,5),ri(1,5),ri(1,5),ri(1,5)],n=c.reduce((a,b)=>a+b,0),s=c.reduce((a,v,i)=>a+v*(i+2),0);
  return mc(`Uczniowie otrzymali oceny: 2 – ${c[0]} osób, 3 – ${c[1]} osób, 4 – ${c[2]} osób, 5 – ${c[3]} osób. Średnia ocen jest równa`,fH(F(s,n)),[fH(F(14,4)),fH(F(s,4)),fH(F(s+n,n))])}
/* ---------- arkusze ---------- */
const CLOSED=[[cLog,1],[cPow,1],[cProc,1],[cRootMC,1],[cLokataMC,1],[cAbs,2],[cQuadSet,2],[cSystemMC,2],[cDomain,3],[cSlope,3],[cParallel,3],[cPerpMC,3],[cVertex,3],[cDelta,3],[cPFLinear,3],[cPFQuad,3],
 [cArith,4],[cGeomMC,4],[cSumArith,4],[cTrig,5],[cRedukcja,5],[cInscribedMC,6],[cTalesMC,6],[cCircle,7],[cMidMC,7],[cCubeMC,8],[cCylMC,8],[cDice,9],[cChooseMC,9],[cStat,9],[cMeanW,9]];
const OPEN_P=[{p:2,r:1,g:[staticGen(PROOF_B),gModProof,gPowProof,gProofGen]},{p:2,r:2,g:[gQuadIneq,gQuadIneq2]},{p:2,r:2,g:[gRatEq,gLinIneqFrac]},{p:2,r:3,g:[gGraphRead,gQuadFromAxis,gTransform]},
 {p:4,r:3.5,g:[gFence,gField,gTravel]},{p:2,r:4,g:[gArith,gGeom,gRecur]},{p:3,r:6,g:[gMedian,gSinSmall,gTrapRight]},{p:3,r:7,g:[gIsoOx,gDiagInter]},{p:3,r:8,g:[gPyrAngle,gCuboidSec,gCylinder]},{p:2,r:9,g:[gDiceB,gProbDigits,gReplace]}];
const OPEN_R=[{p:2,g:[gLimSeq,gLimRoot,gLimFn,gLimSqrt]},{p:2,g:[gLogExpr2,gLogExpr,gLogDiff]},{p:2,g:[gAbsR,gAbsEq]},{p:3,g:[gPolyIneq,gBezout,gPolyOneRoot]},{p:3,g:[staticGen(PROOF_A),gProofGen]},{p:3,g:[gTrigEqGen,gTrigEq,gTrigIneq]},
 {p:4,g:[gArithGeom,gGeomOddEven,gSeriesX]},{p:5,g:[gParamDelta,gRootsDiff,gSumSqParam]},{p:3,g:[gTangent,gDeriv,gMonoProof]},{p:6,g:[gOptBox,gBoxMin,gCanMin,gProfit]},{p:3,g:[staticGen(PROOF_G),staticGen(PROOF_T),staticGen(PROOF_G2)]},
 {p:4,g:[gTangentLines,gTriArea,gMultiTri]},{p:4,g:[gCubeSec,gDihedral,gPyrEdge]},{p:4,g:[gBayes,gUrns,gCond,gBernoulliN]},{p:2,g:[()=>gDigits(pick([4,5])),gGridPaths]}];
const EXAMS={p:{name:'Arkusz: poziom podstawowy',short:'podstawa'},r:{name:'Arkusz: poziom rozszerzony',short:'rozszerzenie'}};
function gen(gs){for(let k=0;k<8;k++){try{const r=pick(gs)();if(r&&r.q)return r}catch(e){console.error(e)}}return{q:'Nie udało się wylosować zadania.',a:''}}
function buildExam(type,seed){rnd=mulberry(seed);const out=[];
  if(type==='p'){shuffle(CLOSED).slice(0,25).forEach(([g,r])=>out.push({...gen([g]),pts:1,closed:true,r}));OPEN_P.forEach(o=>out.push({...gen(o.g),pts:o.p,r:o.r}));out.sort((a,b)=>a.r-b.r)}
  else OPEN_R.forEach(o=>out.push({...gen(o.g),pts:o.p}));
  return out}
globalThis.__T.CLOSED=CLOSED;globalThis.__T.buildExam=buildExam;globalThis.__T.make=make;globalThis.__T.shuffle=shuffle;globalThis.__T.mulberry=mulberry;

/* ---------- aplikacja ---------- */
if(typeof document!=='undefined'){
const $=s=>document.querySelector(s);
const store={get(k,d){try{const v=localStorage.getItem(k);return v==null?d:JSON.parse(v)}catch(e){return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
const now=new Date(),p2=n=>String(n).padStart(2,'0'),dstr=d=>`${d.getFullYear()}-${p2(d.getMonth()+1)}-${p2(d.getDate())}`,day=dstr(now),recentCut=dstr(new Date(now.getTime()-3*864e5));
const hist=(h=>h&&typeof h==='object'?h:{})(store.get('mm_hist',{}));
let done=new Set(store.get('mm_ext',DEF)),cnt=store.get('mm_cnt',{b:5,r:3}),st=store.get('mm_day',{}),mode=store.get('mm_mode','d');
const EX={p:store.get('mm_exam_p',{}),r:store.get('mm_exam_r',{})};
if(st.day!==day)st={day,roll:0,done:[]};
let tasks=[];
const save=()=>{store.set('mm_ext',[...done]);store.set('mm_cnt',cnt);store.set('mm_day',st);store.set('mm_mode',mode);store.set('mm_exam_p',EX.p);store.set('mm_exam_r',EX.r)};
$('#date').textContent=now.toLocaleDateString('pl-PL',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
/* motyw */
const TH={auto:'automatyczny',light:'jasny',dark:'ciemny'};let theme=store.get('mm_theme','auto');
const applyTheme=()=>{if(theme==='auto')delete document.documentElement.dataset.theme;else document.documentElement.dataset.theme=theme;$('#theme').textContent='Motyw: '+TH[theme]};
if(theme!=='auto')applyTheme();else $('#theme').textContent='Motyw: '+TH[theme];

function build(){
  rnd=mulberry(hashStr([day,st.roll,cnt.b,cnt.r,[...done].sort().join('.')].join('|')));
  const out=[],bt=shuffle(BASIC),et=shuffle(EXT.filter(t=>done.has(t.id)));
  /* historia z poprzednich dni (bez dzisiejszego), więc zestaw na dziś jest stały przez cały dzień */
  const av={q:new Set(),g:new Set()};Object.entries(hist).forEach(([d,h])=>{if(d===day)return;(h.q||[]).forEach(x=>av.q.add(x));if(d>=recentCut)(h.g||[]).forEach(x=>av.g.add(x))});
  const add=o=>{out.push(o);if(o.qk)av.q.add(o.qk);if(o.gk)av.g.add(o.gk)};
  for(let i=0;i<cnt.b;i++)add(make(bt[i%bt.length],'Podstawa',av));
  if(et.length)for(let i=0;i<cnt.r;i++)add(make(et[i%et.length],'Rozszerzenie',av));
  hist[day]={q:out.map(o=>o.qk).filter(Boolean),g:out.map(o=>o.gk).filter(Boolean)};
  Object.keys(hist).sort().slice(0,-30).forEach(d=>delete hist[d]);store.set('mm_hist',hist);
  return out}
function progress(){if(mode!=='d')return;const n=tasks.length,d=st.done.filter(i=>i<n).length;$('#pn').textContent=`${d} / ${n}`;$('#pl').textContent='zrobione';$('#pb').style.width=n?d/n*100+'%':'0'}
function renderDaily(){
  tasks=build();$('#nb').textContent=cnt.b;$('#nr').textContent=cnt.r;
  $('#topics').innerHTML=EXT.map(t=>`<label><input type="checkbox" value="${t.id}" ${done.has(t.id)?'checked':''}>${t.name}</label>`).join('');
  $('#tc').textContent=`(${done.size} z ${EXT.length})`;
  let html=tasks.map((t,i)=>{const d=st.done.includes(i);return`<article class="task${d?' is-done':''}" data-i="${i}">
    <div class="meta"><span class="lvl ${t.lvl==='Podstawa'?'b':'r'}">${t.lvl}</span><span>${t.topic}</span></div>
    <h3>Zadanie ${i+1}</h3><div class="q">${t.q}</div>
    <div class="acts"><button data-act="ans" aria-expanded="false">Pokaż odpowiedź</button>${t.s?'<button data-act="sol" aria-expanded="false">Pokaż rozwiązanie</button>':''}<button class="chk" data-act="done" aria-pressed="${d}">${d?'✓ Zrobione':'Oznacz jako zrobione'}</button></div>
    <div class="ans" hidden>${t.a}</div>${t.s?`<ol class="sol" hidden>${t.s.map(x=>`<li>${x}</li>`).join('')}</ol>`:''}</article>`}).join('');
  if(cnt.r>0&&!done.size)html+='<div class="empty">Zaznacz przerobione działy z rozszerzenia, a pojawią się tu zadania z rozszerzenia.</div>';
  if(!tasks.length&&done.size)html='<div class="empty">Ustaw liczbę zadań przyciskiem +.</div>';
  $('#list').innerHTML=html;progress()}
/* arkusz */
const TOTAL=180*60*1000;
const elapsed=e=>(e.acc||0)+(e.running?Date.now()-e.t0:0);
const fmt=ms=>{const s=Math.max(0,Math.round(ms/1000)),h=Math.floor(s/3600),m=Math.floor(s%3600/60),x=s%60;return`${h}:${String(m).padStart(2,'0')}:${String(x).padStart(2,'0')}`};
function tick(){if(mode==='d')return;const e=EX[mode],left=TOTAL-elapsed(e);$('#pn').textContent=e.done?'koniec':fmt(left);$('#pl').textContent=e.done?'':left<=0?'czas minął':e.running?'do końca':'pauza';$('#pb').style.width=Math.min(100,elapsed(e)/TOTAL*100)+'%';
  $('#estart').textContent=e.running?'Pauza':elapsed(e)>0?'Wznów':'Start (180 min)';$('#estart').disabled=!!e.done}
function score(){const e=EX[mode];let s=0,g=0,max=0;tasks.forEach((t,i)=>{max+=t.pts;if(e.pts[i]!==undefined&&e.pts[i]!==''){s+=+e.pts[i];g++}});
  $('#escore').innerHTML=e.done?`<b>Wynik: ${s} / ${max} pkt (${Math.round(s/max*100)}%)</b>${g<tasks.length?` · oceń jeszcze ${tasks.length-g} ${tasks.length-g===1?'zadanie':'zadań'} otwartych, porównując rozwiązanie z odpowiedzią`:''}`:''}
function renderExam(){const e=EX[mode];if(!e.seed){Object.assign(e,{seed:Math.floor(Math.random()*1e9),acc:0,running:false,done:false,pts:{},sel:{}});save()}
  /* arkusz zapisujemy, żeby aktualizacja generatorów nie zmieniła rozpoczętego arkusza */
  if(!Array.isArray(e.tasks)){e.tasks=buildExam(mode,e.seed);save()}
  tasks=e.tasks;const max=tasks.reduce((a,t)=>a+t.pts,0),nc=tasks.filter(t=>t.closed).length;
  $('#einfo').innerHTML=`<b>${EXAMS[mode].name}</b> · 180 minut · ${max} punktów · ${tasks.length} zadań${nc?` (${nc} zamkniętych za 1 pkt, ${tasks.length-nc} otwartych)`:', wszystkie otwarte'}. Rozwiązuj na kartce; odpowiedzi zobaczysz po kliknięciu „Zakończ i sprawdź”.`;
  $('#list').innerHTML=tasks.map((t,i)=>`<article class="task" data-i="${i}"><div class="meta"><span class="lvl ${mode==='p'?'b':'r'}">${t.closed?'Zamknięte':'Otwarte'}</span></div>
    <h3>Zadanie ${i+1}. <span class="pts">(0–${t.pts})</span></h3><div class="q">${t.q}</div>
    ${e.done?`<div class="ans">${t.a}</div>${t.s?`<details class="soldet"><summary>Rozwiązanie krok po kroku</summary><ol class="sol">${t.s.map(x=>`<li>${x}</li>`).join('')}</ol></details>`:''}<label class="score">Punkty: <select data-pts="${i}"><option value="">–</option>${Array.from({length:t.pts+1},(_,k)=>`<option ${String(e.pts[i])===String(k)?'selected':''}>${k}</option>`).join('')}</select> / ${t.pts}</label>`:''}</article>`).join('');
  document.querySelectorAll('#list .task').forEach(a=>{const i=+a.dataset.i;a.querySelectorAll('.mc,.pf').forEach((g,gi)=>{const k=e.sel[`${i}-${gi}`];if(e.done){g.dataset.done=1;const c=g.querySelector(`[data-k="${g.dataset.ok}"]`);c.classList.add('good');if(k&&k!==g.dataset.ok)g.querySelector(`[data-k="${k}"]`).classList.add('bad')}else if(k)g.querySelector(`[data-k="${k}"]`).classList.add('sel')})});
  $('#efinish').disabled=!!e.done;score();tick()}
function finish(){const e=EX[mode];if(e.running){e.acc=elapsed(e);e.running=false}
  document.querySelectorAll('#list .task').forEach(a=>{const i=+a.dataset.i;if(!tasks[i].closed)return;const gs=[...a.querySelectorAll('.mc,.pf')];e.pts[i]=gs.every((g,gi)=>e.sel[`${i}-${gi}`]===g.dataset.ok)?1:0});
  e.done=true;save();renderExam();window.scrollTo({top:0,behavior:'smooth'})}
function render(){document.querySelectorAll('.tabs button').forEach(b=>b.setAttribute('aria-current',b.dataset.mode===mode));
  $('#dailyUI').hidden=mode!=='d';$('#examUI').hidden=mode==='d';$('h1').textContent=mode==='d'?'Dzienna dawka matmy':EXAMS[mode].name.replace('Arkusz: ','Matura – ');
  $('footer').textContent=mode==='d'?'Zestaw zmienia się codziennie o północy. Zadania i odpowiedzi są generowane automatycznie; przy wielu typach zadań jest też rozwiązanie krok po kroku, a w dowodach wskazówka lub pełny dowód. Zaznaczone działy i postęp zapisują się w tej przeglądarce.':'Arkusz jest generowany losowo według układu matury (formuła 2023): czas 180 minut, 50 punktów. Zadania otwarte oceniasz sam, porównując swoje rozwiązanie z odpowiedzią; za częściowo poprawne rozwiązanie przyznaj część punktów.';
  mode==='d'?renderDaily():renderExam()}
const reset=()=>{st.done=[];save();render()};
let confirmNew=0;
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
  if(b.classList.contains('opt')){const g=b.closest('.mc,.pf');if(!g||g.dataset.done)return;
    if(mode!=='d'){const a=b.closest('.task'),i=+a.dataset.i,gi=[...a.querySelectorAll('.mc,.pf')].indexOf(g);g.querySelectorAll('.opt').forEach(o=>o.classList.remove('sel'));b.classList.add('sel');EX[mode].sel[`${i}-${gi}`]=b.dataset.k;save();return}
    g.dataset.done=1;const ok=b.dataset.k===g.dataset.ok;b.classList.add(ok?'good':'bad');if(!ok)g.querySelector(`[data-k="${g.dataset.ok}"]`).classList.add('good');return}
  if(b.dataset.mode){mode=b.dataset.mode;save();render();return}
  if(b.id==='theme'){theme={auto:'dark',dark:'light',light:'auto'}[theme];store.set('mm_theme',theme);applyTheme();return}
  if(b.id==='estart'){const x=EX[mode];if(x.running){x.acc=elapsed(x);x.running=false}else{x.t0=Date.now();x.running=true}save();tick();return}
  if(b.id==='efinish'){finish();return}
  if(b.id==='enew'){if(!confirmNew&&EX[mode].seed&&!EX[mode].done){confirmNew=1;b.textContent='Na pewno? Kliknij jeszcze raz';setTimeout(()=>{confirmNew=0;b.textContent='Nowy arkusz'},3500);return}
    confirmNew=0;b.textContent='Nowy arkusz';EX[mode]={};save();render();window.scrollTo({top:0});return}
  if(b.dataset.s){const k=b.dataset.s;cnt[k]=Math.max(0,Math.min(15,cnt[k]+ +b.dataset.d));reset()}
  else if(b.id==='roll'){st.roll++;reset()}
  else if(b.id==='all'){EXT.forEach(t=>done.add(t.id));reset()}
  else if(b.id==='none'){done.clear();reset()}
  else if(b.dataset.act==='ans'){const a=b.closest('.task').querySelector('.ans'),o=a.hidden;a.hidden=!o;b.textContent=o?'Ukryj odpowiedź':'Pokaż odpowiedź';b.setAttribute('aria-expanded',o)}
  else if(b.dataset.act==='sol'){const a=b.closest('.task').querySelector('.sol'),o=a.hidden;a.hidden=!o;b.textContent=o?'Ukryj rozwiązanie':'Pokaż rozwiązanie';b.setAttribute('aria-expanded',o)}
  else if(b.dataset.act==='done'){const art=b.closest('.task'),i=+art.dataset.i,on=!st.done.includes(i);
    st.done=on?[...st.done,i]:st.done.filter(x=>x!==i);art.classList.toggle('is-done',on);b.setAttribute('aria-pressed',on);b.textContent=on?'✓ Zrobione':'Oznacz jako zrobione';save();progress()}});
document.addEventListener('change',e=>{if(e.target.matches('#topics input')){e.target.checked?done.add(e.target.value):done.delete(e.target.value);reset();$('#det').open=true}
  if(e.target.matches('select[data-pts]')){EX[mode].pts[e.target.dataset.pts]=e.target.value;save();score()}});
setInterval(tick,1000);
render()}
}

</script>
</body>
